    const fmtDate=v=>{if(!v)return'';try{return new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric'}).format(new Date(Number(v)));}catch(e){return'';}};
    const fmtRelative=v=>{if(typeof getAppSettings==='function'&&getAppSettings().dateStyle==='full'){try{return new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}).format(new Date(Number(v)));}catch(e){}}const d=now()-num(v);if(d<60000)return'agora';if(d<3600000)return Math.floor(d/60000)+' min';if(d<86400000)return Math.floor(d/3600000)+' h';return fmtDate(v);};
    const fmtCommentDate=v=>{if(!v)return'';try{return new Intl.DateTimeFormat('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}).format(new Date(Number(v))).replace(',',' às');}catch(e){return fmtDate(v);}};
