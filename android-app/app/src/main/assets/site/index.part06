    function firebaseMessage(code){return ({'auth/email-already-in-use':'Este e-mail já está cadastrado.','auth/invalid-email':'E-mail inválido.','auth/weak-password':'A senha precisa ter pelo menos 6 caracteres.','auth/invalid-credential':'E-mail ou senha incorretos.','auth/user-not-found':'Conta não encontrada.','auth/too-many-requests':'Muitas tentativas. Tente novamente mais tarde.','auth/operation-not-allowed':'Ative este método de login no Firebase Authentication.','auth/popup-closed-by-user':'A janela do Google foi fechada antes de concluir o login.','auth/popup-blocked':'O navegador bloqueou a janela do Google. Tente novamente.','auth/cancelled-popup-request':'Já existe uma tentativa de login com Google aberta.','auth/account-exists-with-different-credential':'Este e-mail já está cadastrado usando outro método de entrada. Entre com o método original.','auth/unauthorized-domain':'Este domínio ainda não está autorizado no Firebase Authentication.','auth/network-request-failed':'Não foi possível conectar ao Firebase. Confira sua internet.'})[code]||'Não foi possível concluir esta ação.';}

    let initializeApp,getAuth,onAuthStateChanged,createUserWithEmailAndPassword,signInWithEmailAndPassword,signOut,sendPasswordResetEmail,updateProfile,signInAnonymously,sendEmailVerification,reload;
    let getDatabase,ref,get,set,update,push,remove,onValue,runTransaction;
    let auth,db;
    const firebaseConfig={apiKey:'AIzaSyAbpqQIxWuEnFolv3lNjNDoPKTGm0mtrxU',authDomain:'nnnsss-23f2f.firebaseapp.com',databaseURL:'https://nnnsss-23f2f-default-rtdb.firebaseio.com',projectId:'nnnsss-23f2f',storageBucket:'nnnsss-23f2f.firebasestorage.app',messagingSenderId:'319942326245',appId:'1:319942326245:web:ae708c886881311e76610c',measurementId:'G-MC7GK71256'};

    const pathRef=p=>{if(!db||!ref)throw new Error('Firebase Database ainda não está pronto.');return ref(db,p.replace(/^\//,''));};
    const dbGet=async p=>(await get(pathRef(p))).val();
    const dbSet=(p,v)=>set(pathRef(p),v);
    const dbUpdate=(p,v)=>update(pathRef(p),v);
