iaUploadState(previewSel,false);if(status)status.textContent=statusText||'';}
    function previewAdminSingle(input,previewSel,statusSel,label){const file=input?.files?.[0];if(!file){clearAdminSinglePreview(previewSel,statusSel,'Nenhuma imagem selecionada.');return;}if(file.type&&!file.type.startsWith('image/')){input.value='';clearAdminSinglePreview(previewSel,statusSel,'Escolha um arquivo de imagem.');ui.toast('Esse arquivo não é uma imagem.');return;}const box=$(previewSel),status=$(statusSel),niceLabel=label||'Imagem selecionada';if(box){const old=box.dataset.objectUrl;if(old){try{URL.revokeObjectURL(old);}catch(e){}}const url=URL.createObjectURL(file);box.dataset.objectUrl=url;box.classList.add('has-image');box.innerHTML="<img src='"+url+"' alt='Pré-visualização'/><span class='admin-preview-check'>✓ "+escapeHtml(niceLabel)+"</span>";const img=box.querySelector('img');img?.addEventListener('load',()=>{if(status)status.textContent='✓ '+niceLabel+': '+file.name+' • '+formatFileSize(file.size)+' • '+img.naturalWidth+'×'+img.naturalHeight+' px';},{once:true});}setAdminMediaUploadState(previewSel,true);if(status)status.textContent='✓ '+niceLabel+': '+file.name+' • '+formatFileSize(file.size);}
    function showStoredAdminImage(previewSel,statusSel,dataUrl,label){const box=$(previewSel),status=$(statusSel);if(!box)return;const old=box.dataset.objectUrl;if(old){try{URL.revokeObjectURL(old);}catch(e){}delete box.dataset.objectUrl;}if(dataUrl){const nice=label||'Imagem atual';box.classList.add('has-image');box.innerHTML="<img src='"+escapeAttr(dataUrl)+"' alt='"+escapeAttr(nice)+"'/><span class='admin-preview-check'>✓ "+escapeHtml(nice)+"</span>";setAdminMediaUploadState(previewSel,true);if(status)status.textContent='✓ '+nice+' carregada.';}else{box.classList.remove('has-image');box.innerHTML='';setAdminMediaUploadState(previewSel,false);if(status)status.textContent='Nenhuma imagem cadastrada.';}}
    function updateChapterFilesStatus(){const status=$('#chapterFilesStatus'),files=state.adminPageFiles||[];if(!status)return;const total=files.reduce((sum,f)=>sum+(Number(f?.size)||0),0);status.innerHTML=files.length?"<span class='chapter-page-count'>✓ "+files.length+' página'+(files.length===1?'':'s')+" pronta"+(files.length===1?'':'s')+"</span> • "+escapeHtml(formatFileSize(total)):'Nenhuma página selecionada.';}
    function handleChapterFiles(input){const picked=[...(input?.files||[])],files=picked.filter(f=>!f.type||f.type.startsWith('image/'));state.adminPageFiles=files;if(picked.length!==files.length)ui.toast((picked.length-files.length)+' arquivo(s) que não eram imagem foram ignorados.');updateChapterFilesStatus();setChapterUploadProgress(0,0,'', 'hidden');renderChapterPreview();if(files.length)ui.toast(files.length+' página'+(files.length===1?' selecionada.':'s selecionadas.'));}
    function setChapterUploadProgress(current,total,label,mode='working'){const box=$('#chapterUploadProgress'),bar=$('#chapterUploadBar'),pct=$('#chapterUploadPercent'),lab=$('#chapterUploadLabel');if(!box)return;if(mode==='hidden'){box.classList.add('hidden');box.classList.remove('is-complete','is-error');if(bar)bar.style.width='0%';if(pct)pct.textContent='0%';if(lab)lab.textContent='';return;}box.classList.remove('hidden','is-complete','is-error');if(mode==='complete')box.classList.add('is-complete');if(mode==='error')box.classList.add('is-error');const percent=mode==='complete'?100:(total>0?Math.max(0,Math.min(100,Math.round((current/total)*100))):0);if(bar)bar.style.width=percent+'%';if(pct)pct.textContent=percent+'%';if(lab)lab.textContent=label||'Preparando envio…';}

    function refreshChapterWorkOptions(){const select=$('#chapterWork');if(!select)return;const current=select.value,disabled=select.disabled;const options=state.allWorks.map(w=>"<option value='"+w.id+"'>"+escapeHtml(w.name)+"</option>").join('');if(select.innerHTML!==options){select.innerHTML=options;if(current&&state.allWorkMap[current])select.value=current;select.disabled=disabled;}}
    function clearChapterForm(keepProgress=false){state.adminPageFiles=[];state.editingChapter=null;if($('#chapterWork'))$('#chapterWork').disabled=false;if($('#chapterNumber'))$('#chapterNumber').value='';if($('#chapterTitle'))$('#chapterTitle').value='';if($('#editingChapterId'))$('#editingChapterId').value='';if($('#chapterFiles'))$('#chapterFiles').value='';updateChapterFilesStatus();renderChapterPreview();if(!keepProgress)setChapterUploadProgress(0,0,'','hidden');renderAdminChapterList();}
    function renderChapterPreview(){const el=$('#chapterPreview');if(!el)return;(state.previewUrls||[]).forEach(u=>{try{URL.revokeObjectURL(u);}catch(e){}});state.previewUrls=[];el.innerHTML=(state.adminPageFiles||[]).map((f,i)=>{const u=URL.createObjectURL(f);state.previewUrls.push(u);return "<div class='preview-tile'><span class='preview-page-number'>"+(i+1)+"</span><img src='"+u+"' alt='Página "+(i+1)+"'/><div class='preview-actions'><button class='btn ghost' type='button' data-move-page='up' data-index='"+i+"' aria-label='Mover página para cima'>↑</button><button class='btn ghost' type='button' data-move-page='down' data-index='"+i+"' aria-label='Mover página para baixo'>↓</button><button class='btn danger' type='button' data-remove-page='"+i+"' aria-label='Remover página'>×</button></div></div>";}).join('');updateChapterFilesStatus();}
    function renderAdminChapterList(){const el=$('#adminChapterList'),workId=$('#chapterWork')?.value;if(!el||!workId)return;const list=state.chapters[workId]||[];el.innerHTML=list.length?list.map(c=>"<div class='admin-item'><h4>Capítulo "+escapeHtml(c.number)+(c.title?' — '+escapeHtml(c.title):'')+"</h4><div class='row'><a class='btn ghost' href='#"+chapterRoute(c)+"' data-route='"+chapterRoute(c)+"'>Abrir</a><button type='button' class='btn' data-edit-chapter='"+c.id+"' data-work-id='"+workId+"'>Editar</button><button type='button' class='btn danger' data-delete-chapter='"+c.id+"' data-work-id='"+workId+"'>Excluir</button></div></div>").join(''):"<div class='empty'>Nenhum capítulo nesta obra.</div>";}
    async function saveChapter(){
      if(!isAdmin()||window.__mpChapterSaving)return;
      const workEl=$('#chapterWork'),numberEl=$('#chapterNumber'),titleEl=$('#chapterTitle'),editEl=$('#editingChapterId'),publishBtn=$('#publishChapter');
      const workId=state.editingChapter?.workId||workEl?.value||'',number=(numberEl?.value||'').trim(),title=(titleEl?.value||'').trim(),editing=(editEl?.value||'').trim(),files=[...(state.adminPageFiles||[])];
      if(!workId||number===''){ui.toast('Escolha a obra e informe o número do capítulo.');return;}
      if(!editing&&!files.length){setChapterUploadProgress(0,1,'Selecione as imagens do capítulo antes de publicar.','error');ui.toast('Selecione pelo menos uma página para o novo capítulo.');return;}
      const id=editing||push(pathRef('capitulos/'+workId)).key;
      if(!id){ui.toast('Não foi possível criar o identificador do capítulo.');return;}
      window.__mpChapterSaving=true;
      if(publishBtn){publishBtn.disabled=true;publishBtn.dataset.oldText=publishBtn.textContent;publishBtn.textContent='Publicando…';}
      const uploadedKeys=[];
      let oldPageKeys=[];
      try{
        setChapterUploadProgress(0,Math.max(1,files.length),'Preparando o capítulo…');
        const old=editing?await dbGet('capitulos/'+workId+'/'+id):null;
        if(editing&&files.length){const oldPages=await dbGet('capitulosPaginas/'+workId+'/'+id).catch(()=>({}));oldPageKeys=Object.keys(oldPages||{});}
        if(files.length){
          for(let i=0;i<files.length;i++){
            const file=files[i];
            setChapterUploadProgress(i,files.length,'Preparando página '+(i+1)+' de '+files.length+' • '+(file.name||'imagem'));
            let dataUrl;
            try{dataUrl=await fileData(file);}catch(readErr){throw new Error('Não consegui ler a página '+(i+1)+'. Tente selecionar essa imagem novamente.');}
            if(!dataUrl||!String(dataUrl).startsWith('data:image'))throw new Error('A página '+(i+1)+' não pôde ser reconhecida como imagem.');
            setChapterUploadProgress(i,files.length,'Enviando página '+(i+1)+' de '+files.length+'…');
            const pageRef=push(pathRef('capitulosPaginas/'+workId+'/'+id));
            await set(pageRef,{ordem:i,dataUrl});
            uploadedKeys.push(pageRef.key);
            setChapterUploadProgress(i+1,files.length,'Página '+(i+1)+' de '+files.length+' enviada.');
          }
        }
        const payload={...(old||{}),id,obraId:workId,numero:number,titulo:title,publicado:true,criadoEm:old?.criadoEm||now(),atualizadoEm:now()};
        await dbSet('capitulos/'+workId+'/'+id,payload);
        if(files.length&&oldPageKeys.length){await Promise.all(oldPageKeys.filter(k=>!uploadedKeys.includes(k)).map(k=>dbRemove('capitulosPaginas/'+workId+'/'+id+'/'+k).catch(err=>console.warn('Não foi possível remover página antiga',k,err))));}
        await dbUpdate('obras/'+workId,{atualizadoEm:now()}).catch(err=>console.warn('Capítulo salvo, mas não foi possível atualizar a data da obra.',err));
        await notifyChapterFollowers(workId,id,number,title).catch(err=>console.warn('Capítulo salvo, mas a notificação falhou.',err));
        clearChapterForm(true);
        setChapterUploadProgress(1,1,(editing?'Capítulo atualizado':'Capítulo publicado')+' com sucesso.','complete');
        ui.toast(editing?'Capítulo atualizado com sucesso.':'Capítulo publicado com sucesso.');
        renderAdminChapterList();
      }catch(e){
        console.error('Falha ao publicar capítulo',e);
        if(uploadedKeys.length){await Promise.all(uploadedKeys.map(k=>dbRemove('capitulosPaginas/'+workId+'/'+id+'/'+k).catch(()=>{})));}
        const msg=String(e?.message||'Não foi possível publicar o capítulo.');
        setChapterUploadProgress(0,1,msg,'error');
        ui.toast(msg.length>110?'Não foi possível publicar o capítulo. Confira a mensagem no painel.':msg);
      }finally{
        window.__mpChapterSaving=false;
        if(publishBtn){publishBtn.disabled=false;publishBtn.textContent=publishBtn.dataset.oldText||'Publicar capítulo';delete publishBtn.dataset.oldText;}
      }
    }
    async function notifyChapterFollowers(workId,chapterId,number,title){try{const prefs=await dbGet('notificacoesPreferencias')||{},w=state.allWorkMap[workId];for(const [uid,works] of objEntries(prefs)){if(works?.[workId])await sendNotification(uid,{tipo:'chapter',titulo:'Novo capítulo',texto:(w?.name||'Obra')+' — Capítulo '+number+(title?' — '+title:''),link:'/capitulo/'+workId+'/'+chapterId});}}catch(e){console.warn('notificações de capítulo',e);}}


    function contentReactionDefPath(scope,workId,chapterId=''){
      return scope==='work'?'contentReactions/definitions/work/'+workId:'contentReactions/definitions/chapter/'+workId+'/'+chapterId;
    }
    function contentReactionGlobalDefPath(scope){
      return 'contentReactions/definitions/global/'+(scope==='work'?'work':'chapter');
    }
    function contentReactionVotePath(scope,workId,chapterId=''){
      return scope==='work'?'contentReactions/votes/work/'+workId:'contentReactions/votes/chapter/'+workId+'/'+chapterId;
    }
    function reactionCompositeKey(source,id){return (source==='global'?'global:':'specific:')+String(id||'');}
    async function renderContentReactions(scope,workId,chapterId,selector){
      const root=$(selector);if(!root)return;
      try{
        const [globalRaw,specificRaw,votesRaw]=await Promise.all([
          dbGet(contentReactionGlobalDefPath(scope)).catch(()=>({})),
          dbGet(contentReactionDefPath(scope,workId,chapterId)).catch(()=>({})),
          dbGet(contentReactionVotePath(scope,workId,chapterId)).catch(()=>({}))
        ]);
        const globals=objEntries(globalRaw||{}).map(([id,r])=>({id,source:'global',...(r||{})}));
        const specifics=objEntries(specificRaw||{}).map(([id,r])=>({id,source:'specific',...(r||{})}));
        const defs=[...globals,...specifics].filter(r=>r.active!==false&&r.imageUrl&&r.label).sort((a,b)=>num(a.createdAt)-num(b.createdAt));
        if(!defs.length){root.innerHTML='';root.classList.add('hidden');return;}
        root.classList.remove('hidden');
        const votes=votesRaw||{},counts={};
        Object.values(votes).forEach(v=>{if(v?.reactionId){const source=v.source==='global'?'global':'specific',k=reactionCompositeKey(source,v.reactionId);counts[k]=(counts[k]||0)+1;}});
        const mine=isMember()?votes?.[state.user.uid]:null,mineSource=mine?.source==='global'?'global':'specific',hasVote=!!mine;
        const subject=scope==='work'?'esta obra':'este capítulo';
        root.innerHTML="<div class='content-reaction-zone'><div class='content-reaction-panel'><div class='content-reaction-head'><div><h3>✨ Qual foi sua reação?</h3><p>Escolha uma reação criada pela equipe para "+subject+".</p></div>"+(hasVote?"<span class='content-reaction-lock'>✓ 1 REAÇÃO ATIVA</span>":"")+"</div><div class='content-reaction-list'>"+defs.map(r=>{const selected=mine?.reactionId===r.id&&mineSource===r.source,count=counts[reactionCompositeKey(r.source,r.id)]||0;return "<button type='button' class='content-reaction-btn "+(selected?'selected':'')+"' data-content-reaction='"+escapeAttr(r.id)+"' data-content-source='"+escapeAttr(r.source)+"' data-content-scope='"+scope+"' data-work-id='"+escapeAttr(workId)+"' data-chapter-id='"+escapeAttr(chapterId||'')+"'><img class='content-reaction-img' src='"+escapeAttr(r.imageUrl)+"' alt='' loading='lazy'/><span class='content-reaction-label'>"+escapeHtml(r.label)+"</span>"+(r.source==='global'?"<span class='content-reaction-global-mark'>PARA TODOS</span>":"")+"<span class='content-reaction-count'>"+(selected?'Sua reação • ':'')+count+" voto"+(count===1?'':'s')+"</span></button>";}).join('')+"</div><div class='content-reaction-note'>"+(hasVote?"Você pode <strong>trocar sua reação</strong> tocando em outra opção. Seu voto anterior será substituído.":(isMember()?"Escolha uma reação. Depois, você poderá trocá-la sem criar votos duplicados.":"Entre na sua conta para escolher uma reação."))+"</div></div></div>";
        $$('.content-reaction-btn',root).forEach(btn=>btn.addEventListener('click',async e=>{
          e.preventDefault();e.stopPropagation();
          if(!requireMember())return;
          const reactionId=btn.dataset.contentReaction,source=btn.dataset.contentSource==='global'?'global':'specific';if(!reactionId)return;
          btn.disabled=true;
          try{
            const voteBase=contentReactionVotePath(scope,workId,chapterId),existing=await dbGet(voteBase+'/'+state.user.uid);
            if(existing?.reactionId===reactionId&&(existing?.source==='global'?'global':'specific')===source){ui.toast('Esta já é a sua reação. Toque em outra para trocar.');await renderContentReactions(scope,workId,chapterId,selector);return;}
            await dbSet(voteBase+'/'+state.user.uid,{uid:state.user.uid,reactionId,source,data:now()});
            ui.toast(existing?'Reação trocada com sucesso ✨':'Reação registrada ✨');
            await renderContentReactions(scope,workId,chapterId,selector);
          }catch(err){console.error('content reaction vote',err);ui.toast('Não foi possível salvar sua reação agora. Tente novamente.');await renderContentReactions(scope,workId,chapterId,selector);}
        }));
      }catch(err){console.warn('render content reactions',err);root.innerHTML='';}
    }

    function adminReactionChapterOptions(workId){
      const list=(state.chapters[workId]||[]).slice().sort((a,b)=>num(b.number)-num(a.number));
      return list.map(c=>"<option value='"+escapeAttr(c.id)+"'>Capítulo "+escapeHtml(String(c.number))+(c.title?' — '+escapeHtml(c.title):'')+"</option>").join('');
    }
    function clearAdminContentReactionEditor(keepTarget=true){
      window.__adminReactionEditingId='';window.__adminReactionImageData='';
      const n=$('#adminReactionLabel'),f=$('#adminReactionFile'),a=$('#adminReactionActive');if(n)n.value='';if(f)f.value='';if(a)a.checked=true;
      const pi=$('#adminReactionPreviewImage'),pc=$('#adminReactionPreviewCopy');if(pi)pi.innerHTML='✨';if(pc)pc.innerHTML='<strong>Prévia da reação</strong><span>Escolha uma imagem e escreva a frase.</span>';
      const st=$('#adminReactionFileStatus');if(st)st.textContent='Nenhuma imagem selecionada.';
      const save=$('#adminReactionSave');if(save)save.textContent='Criar reação';
      if(!keepTarget){const scope=$('#adminReactionScopeWork');if(scope)scope.click();}
    }
    function adminReactionCurrentTarget(){
      const scope=$('[data-admin-reaction-scope].active')?.dataset.adminReactionScope||'work',workId=$('#adminReactionWork')?.value||'',all=workId==='__all__',chapterId=scope==='chapter'&&!all?($('#adminReactionChapter')?.value||''):'';
      return {scope,workId,chapterId,global:all};
    }
    function adminReactionDefinitionPath(t){return t.global?contentReactionGlobalDefPath(t.scope):contentReactionDefPath(t.scope,t.workId,t.chapterId);}
    function updateAdminReactionTargetNote(){
      const note=$('#adminReactionTargetNote'),t=adminReactionCurrentTarget();if(!note)return;
      if(t.global)note.innerHTML=t.scope==='work'?'<strong>🌐 Todas as obras:</strong> cada reação criada aqui aparecerá automaticamente em todas as obras atuais e futuras.':'<strong>🌐 Todos os capítulos:</strong> cada reação criada aqui aparecerá automaticamente em todos os capítulos atuais e futuros.';
      else note.innerHTML=t.scope==='work'?'<strong>Alvo específico:</strong> estas reações aparecem somente na obra selecionada.':'<strong>Alvo específico:</strong> estas reações aparecem somente no capítulo selecionado.';
    }
    function updateAdminReactionPreview(){
      const label=$('#adminReactionLabel')?.value.trim()||'Prévia da reação',img=window.__adminReactionImageData||'';
      const pi=$('#adminReactionPreviewImage'),pc=$('#adminReactionPreviewCopy');if(pi)pi.innerHTML=img?"<img src='"+escapeAttr(img)+"' alt=''/>":'✨';if(pc)pc.innerHTML='<strong>'+escapeHtml(label)+'</strong><span>Assim a reação aparecerá para o leitor.</span>';
    }
    async function loadAdminContentReactionList(){
      const listEl=$('#adminReactionItems');if(!listEl)return;const t=adminReactionCurrentTarget(),defPath=adminReactionDefinitionPath(t);
      if(!t.global&&!t.workId){listEl.innerHTML="<div class='empty'>Escolha uma obra.</div>";return;}
      if(!t.global&&t.scope==='chapter'&&!t.chapterId){listEl.innerHTML="<div class='empty'>Escolha o capítulo.</div>";return;}
      listEl.innerHTML="<div class='skeleton'></div>";
      try{
        const defs=await dbGet(defPath)||{};
        let counts={};
        if(!t.global){const votes=await dbGet(contentReactionVotePath(t.scope,t.workId,t.chapterId)).catch(()=>({}))||{};Object.values(votes).forEach(v=>{if(v?.reactionId&&(v.source||'specific')!=='global')counts[v.reactionId]=(counts[v.reactionId]||0)+1;});}
        const rows=objEntries(defs).map(([id,r])=>({id,...(r||{})})).sort((a,b)=>num(b.updatedAt)-num(a.updatedAt));
        const targetText=t.global?(t.scope==='work'?'TODAS AS OBRAS':'TODOS OS CAPÍTULOS'):(t.scope==='work'?'OBRA ESPECÍFICA':'CAPÍTULO ESPECÍFICO');
        listEl.innerHTML=rows.length?rows.map(r=>"<div class='admin-reaction-item "+(r.active===false?'off':'')+"'><img src='"+escapeAttr(r.imageUrl||'')+"' alt=''/><div class='admin-reaction-item-copy'><strong>"+escapeHtml(r.label||'Reação')+"</strong><span>"+(r.active===false?'OCULTA':'PUBLICADA')+" • "+targetText+(t.global?'':" • "+(counts[r.id]||0)+" votos")+"</span></div><div class='admin-reaction-item-actions'><button type='button' class='btn ghost' data-admin-reaction-edit='"+escapeAttr(r.id)+"'>Editar</button><button type='button' class='btn' data-admin-reaction-toggle='"+escapeAttr(r.id)+"'>"+(r.active===false?'Publicar':'Ocultar')+"</button><button type='button' class='btn danger' data-admin-reaction-delete='"+escapeAttr(r.id)+"'>Excluir</button></div></div>").join(''):"<div class='empty'>Nenhuma reação criada para "+(t.global?(t.scope==='work'?'todas as obras':'todos os capítulos'):(t.scope==='work'?'esta obra':'este capítulo'))+".</div>";
        $$('[data-admin-reaction-edit]',listEl).forEach(b=>b.addEventListener('click',async()=>{const data=defs[b.dataset.adminReactionEdit];if(!data)return;window.__adminReactionEditingId=b.dataset.adminReactionEdit;window.__adminReactionImageData=data.imageUrl||'';$('#adminReactionLabel').value=data.label||'';$('#adminReactionActive').checked=data.active!==false;$('#adminReactionFile').value='';$('#adminReactionFileStatus').textContent=data.imageUrl?'Imagem atual carregada. Escolha outra apenas para substituir.':'Nenhuma imagem atual.';$('#adminReactionSave').textContent='Salvar alterações';updateAdminReactionPreview();$('#adminReactionLabel').focus();}));
        $$('[data-admin-reaction-toggle]',listEl).forEach(b=>b.addEventListener('click',async()=>{const id=b.dataset.adminReactionToggle,data=defs[id];if(!data)return;try{await dbUpdate(defPath+'/'+id,{active:data.active===false,updatedAt:now()});await loadAdminContentReactionList();}catch(e){ui.toast('Não foi possível alterar a reação.');}}));
        $$('[data-admin-reaction-delete]',listEl).forEach(b=>b.addEventListener('click',async()=>{if(!confirm('Excluir esta reação?'))return;try{await dbRemove(defPath+'/'+b.dataset.adminReactionDelete);if(window.__adminReactionEditingId===b.dataset.adminReactionDelete)clearAdminContentReactionEditor();await loadAdminContentReactionList();}catch(e){ui.toast('Não foi possível excluir a reação.');}}));
      }catch(err){console.error(err);listEl.innerHTML="<div class='empty'>Não foi possível carregar as reações deste alvo.</div>";}
    }
    async function saveAdminContentReaction(){
      if(!isAdmin())return;const t=adminReactionCurrentTarget(),defPath=adminReactionDefinitionPath(t),label=$('#adminReactionLabel')?.value.trim()||'',active=!!$('#adminReactionActive')?.checked;
      if(!t.global&&!t.workId){ui.toast('Escolha uma obra ou selecione Todas.');return;}if(!t.global&&t.scope==='chapter'&&!t.chapterId){ui.toast('Escolha o capítulo ou selecione Todos os capítulos.');return;}if(label.length<2){ui.toast('Escreva o nome ou frase da reação.');return;}if(!window.__adminReactionImageData){ui.toast('Escolha a imagem da reação.');return;}
      const btn=$('#adminReactionSave'),id=window.__adminReactionEditingId||push(pathRef(defPath)).key,wasEditing=!!window.__adminReactionEditingId;
      try{
        if(btn){btn.disabled=true;btn.textContent='Salvando...';}
        const old=wasEditing?await dbGet(defPath+'/'+id):null;
        await dbSet(defPath+'/'+id,{id,label,imageUrl:window.__adminReactionImageData,active,createdAt:old?.createdAt||now(),updatedAt:now()});
        ui.toast(wasEditing?'Reação atualizada.':(t.global?'Reação criada para todos ✨':'Reação criada ✨'));clearAdminContentReactionEditor();await loadAdminContentReactionList();
      }catch(err){console.error(err);ui.toast('Não foi possível salvar a reação. Confira as regras v52.');}
      finally{if(btn){btn.disabled=false;btn.textContent='Criar reação';}}
    }
    async function renderAdminContentReactions(el){
      window.__adminReactionEditingId='';window.__adminReactionImageData='';
      const workOptions="<option value='__all__'>🌐 Todas as obras</option>"+state.allWorks.map(w=>"<option value='"+escapeAttr(w.id)+"'>"+escapeHtml(w.name)+"</option>").join('');
      el.dataset.adminView='reactions';
      el.innerHTML="<div class='admin-section-card admin-panel-stable'><div class='admin-section-title'><div><h2>✨ Reações de obras e capítulos</h2><p>Crie uma vez para um alvo específico ou publique para todos de uma só vez. Obra e capítulo continuam com catálogos separados.</p></div></div><div class='admin-reaction-layout'><div class='admin-reaction-editor'><div class='admin-reaction-target-tabs'><button type='button' id='adminReactionScopeWork' class='admin-reaction-target-btn active' data-admin-reaction-scope='work'>▣ Para obra</button><button type='button' class='admin-reaction-target-btn' data-admin-reaction-scope='chapter'>☷ Para capítulo</button></div><div class='field'><label id='adminReactionWorkLabel'>Destino</label><select id='adminReactionWork'>"+workOptions+"</select></div><div class='admin-reaction-global-note' id='adminReactionTargetNote'></div><div class='field hidden' id='adminReactionChapterField'><label>Capítulo</label><select id='adminReactionChapter'></select></div><div class='field'><label>Nome / frase da reação</label><input id='adminReactionLabel' maxlength='80' autocomplete='off' placeholder='Ex.: Nossa, que doido!'/></div><div class='field'><label>Imagem da reação</label><div class='admin-upload'><button type='button' class='admin-file-pick' id='adminReactionPick'>🖼 Escolher imagem</button><input id='adminReactionFile' class='admin-file-hidden' type='file' accept='image/*'/><div class='admin-file-status' id='adminReactionFileStatus'>Nenhuma imagem selecionada.</div></div></div><label class='toggle-row'><span><strong>Publicada</strong><small>Se desligar, a reação fica oculta para os leitores.</small></span><input id='adminReactionActive' type='checkbox' checked='checked'/></label><div class='admin-reaction-preview'><div class='admin-reaction-preview-img' id='adminReactionPreviewImage'>✨</div><div class='admin-reaction-preview-copy' id='adminReactionPreviewCopy'><strong>Prévia da reação</strong><span>Escolha uma imagem e escreva a frase.</span></div></div><div class='row'><button type='button' class='btn primary' id='adminReactionSave'>Criar reação</button><button type='button' class='btn ghost' id='adminReactionClear'>Limpar</button></div></div><div class='admin-reaction-list-card'><div class='section-head'><div><h3 class='section-title'>Reações deste destino</h3><div class='section-sub'>Selecione “Todas” para manter um catálogo global sem cadastrar uma por uma.</div></div></div><div class='admin-reaction-items' id='adminReactionItems'></div></div></div></div>";
      const syncTargetUi=()=>{const t=adminReactionCurrentTarget(),cf=$('#adminReactionChapterField'),cs=$('#adminReactionChapter'),wl=$('#adminReactionWorkLabel'),ws=$('#adminReactionWork');if(wl)wl.textContent=t.scope==='work'?'Obra / destino':'Obra / destino dos capítulos';if(ws&&ws.options?.[0])ws.options[0].textContent=t.scope==='work'?'🌐 Todas as obras':'🌐 Todos os capítulos';if(t.scope==='chapter'&&!t.global){cf.classList.remove('hidden');cs.innerHTML=adminReactionChapterOptions($('#adminReactionWork').value);if(!cs.value&&cs.options.length)cs.selectedIndex=0;}else cf.classList.add('hidden');updateAdminReactionTargetNote();};
      $$('[data-admin-reaction-scope]',el).forEach(b=>b.addEventListener('click',()=>{$$('[data-admin-reaction-scope]',el).forEach(x=>x.classList.toggle('active',x===b));clearAdminContentReactionEditor();syncTargetUi();loadAdminContentReactionList();}));
      $('#adminReactionWork')?.addEventListener('change',()=>{clearAdminContentReactionEditor();syncTargetUi();loadAdminContentReactionList();});
      $('#adminReactionChapter')?.addEventListener('change',()=>{clearAdminContentReactionEditor();updateAdminReactionTargetNote();loadAdminContentReactionList();});
      $('#adminReactionLabel')?.addEventListener('input',updateAdminReactionPreview);
      $('#adminReactionPick')?.addEventListener('click',()=>{const input=$('#adminReactionFile');if(!input)return;try{if(typeof input.showPicker==='function')input.showPicker();else input.click();}catch(e){input.click();}});
      $('#adminReactionFile')?.addEventListener('change',async e=>{const f=e.target.files?.[0];if(!f)return;try{if(f.size>10*1024*1024){ui.toast('Escolha uma imagem com até 10 MB.');return;}$('#adminReactionFileStatus').textContent='Preparando imagem...';window.__adminReactionImageData=await prepareUiImage(f,'photo');$('#adminReactionFileStatus').textContent=f.name;updateAdminReactionPreview();}catch(err){console.error(err);ui.toast('Não foi possível preparar esta imagem.');}});
      $('#adminReactionSave')?.addEventListener('click',saveAdminContentReaction);$('#adminReactionClear')?.addEventListener('click',()=>clearAdminContentReactionEditor());
      syncTargetUi();await loadAdminContentReactionList();
    }

    async function renderAdminUsers(el){
      el.innerHTML="<div class='admin-section-card'><div class='skeleton'></div></div>";
      let users={};try{users=await dbGet('usuarios')||{};}catch(e){console.error('admin users: usuarios',e);throw e;}
      const rows=objEntries(users).filter(([,u])=>u&&typeof u==='object'&&u.anonimo!==true);
      const requestPairs=await Promise.all(rows.map(async([uid])=>{try{return[uid,await dbGet('pedidosAcessoSensivel/'+uid)||{}];}catch(e){return[uid,{}];}}));
      const requests=Object.fromEntries(requestPairs);
      const html=rows.map(([uid,u])=>{
        const req=requests[uid]||{},age=u.ageVerified?'18+ confirmado':u.ageVerificationStatus==='minor'?'Menor de 18':'Não informada';
        const reqStatus=u.minorSensitiveApproved?'Aprovado':req.status==='pending'?'Pendente':req.status==='denied'?'Recusado':'Sem pedido';
        const photo=typeof u.foto==='string'?u.foto:(typeof u.photo==='string'?u.photo:'');
        const avatar=photo?"<img src='"+escapeAttr(photo)+"' alt=''/>":'👤';
        const role=u.admin===true||u.papel==='ADM'||u.papel==='Administrador'?'ADM':String(u.papel||'').toLowerCase().includes('moder')?'Moderador':'Usuário';
        const username=String(u.nomeUsuario||u.username||'').replace(/^@/,'');
        const display=String(u.nome||u.name||u.email||'Usuário');
        const secondary=username?'@'+username:String(u.email||uid);
        const pending=req.status==='pending';
        return "<div class='admin-item'><div class='admin-user-card-head'><div class='admin-user-avatar'>"+avatar+"</div><div class='admin-user-meta'><strong>"+escapeHtml(display)+"</strong><span>"+escapeHtml(secondary)+"</span></div></div><div class='admin-user-badges'><span class='admin-user-badge accent'>"+escapeHtml(role)+"</span><span class='admin-user-badge'>"+escapeHtml(age)+"</span>"+(reqStatus!=='Sem pedido'?"<span class='admin-user-badge'>Sensível: "+escapeHtml(reqStatus)+"</span>":'')+"</div>"+
          (u.ageVerificationStatus==='minor'?"<div class='panel' style='margin-top:10px'><strong>Pedido de conteúdo sensível</strong><div class='tiny' style='margin-top:6px'>Status: "+escapeHtml(reqStatus)+"</div>"+(req.mensagem?"<p style='white-space:pre-wrap'>"+escapeHtml(String(req.mensagem))+"</p>":"<p class='tiny'>Nenhuma mensagem enviada.</p>")+(pending?"<div class='row'><button type='button' class='btn primary' data-approve-minor-sensitive='"+escapeAttr(uid)+"'>Aprovar</button><button type='button' class='btn danger' data-deny-minor-sensitive='"+escapeAttr(uid)+"'>Recusar</button></div>":'')+(u.minorSensitiveApproved?"<div class='row'><button type='button' class='btn danger' data-revoke-minor-sensitive='"+escapeAttr(uid)+"'>Remover permissão</button></div>":'')+"</div>":'')+
          "<div class='field' style='margin-bottom:0'><label>Função da conta</label><select data-user-role='"+escapeAttr(uid)+"'><option value='usuario' "+(role==='Usuário'?'selected':'')+">Usuário</option><option value='moderador' "+(role==='Moderador'?'selected':'')+">Moderador</option><option value='ADM' "+(role==='ADM'?'selected':'')+">ADM</option></select></div></div>";
      }).join('');
      el.innerHTML="<div class='admin-section-card'><div class='admin-section-title'><div><h2>Usuários</h2><p>"+rows.length+" conta"+(rows.length===1?'':'s')+" cadastrada"+(rows.length===1?'':'s')+". Gerencie funções, verificações e pedidos.</p></div><button type='button' class='btn ghost' data-route='/adm/usuarios'>↻ Atualizar</button></div><div class='admin-grid'>"+(html||"<div class='empty'>Nenhum usuário cadastrado.</div>")+"</div></div>";
    }
    async function renderAdminCommentFrames(el){
      if(!el||!isAdmin())return;
      // Enquanto o editor estiver aberto ele é considerado estável. Atualizações em tempo real
      // não podem reconstruir os controles enquanto o ADM escolhe uma cor ou move um slider.
      if(el.dataset.adminView==='frames'&&document.getElementById('adminFrameEditor')&&state.adminFrameEditing)return;
      let frames=state.commentFrames||{};
      if(!Object.keys(frames).length){try{frames=await dbGet('config/commentFrames')||{};state.commentFrames=frames;}catch(e){frames={};}}
      const list=objEntries(frames).map(([id,f])=>normalizedCommentFrame({id,...f})).sort((a,b)=>num(b.criadoEm)-num(a.criadoEm));
      const defaults=normalizedCommentFrame({});
      const draft={...defaults,...(state.adminFrameDraft||{})};
      state.adminFrameDraft=draft;
      const range=(key,label,min,max,step,suffix='')=>"<div class='admin-frame-range'><div class='admin-frame-range-head'><label>"+label+"</label><output data-admin-frame-value='"+key+"'>"+escapeHtml(String(draft[key]))+suffix+"</output></div><input type='range' min='"+min+"' max='"+max+"' step='"+step+"' value='"+escapeAttr(String(draft[key]))+"' data-admin-frame-setting='"+key+"' data-suffix='"+escapeAttr(suffix)+"'/></div>";
      const color=(key,label)=>"<div class='admin-frame-color'><label>"+label+"</label><div class='admin-frame-color-control'><input type='color' value='"+escapeAttr(safeFrameColor(draft[key],'#7b4dff'))+"' data-admin-frame-setting='"+key+"' aria-label='"+escapeAttr(label)+"'/><input class='admin-frame-hex' type='text' maxlength='7' spellcheck='false' autocomplete='off' value='"+escapeAttr(safeFrameColor(draft[key],'#7b4dff').toUpperCase())+"' data-admin-frame-hex='"+key+"' aria-label='Código HEX — "+escapeAttr(label)+"'/></div></div>";
      const effectBtn=(value,label)=>"<button type='button' class='admin-frame-effect "+(draft.effect===value?'active':'')+"' data-admin-frame-effect='"+value+"'>"+label+"</button>";
      const listCard=f=>"<div class='admin-frame-item "+(f.ativo===false?'off':'')+"'><div class='admin-frame-thumb frame-style-preview"+commentFrameEffectClass(f)+"' style='"+escapeAttr(commentFrameInlineStyle(f))+"'><div class='admin-frame-thumb-inner'><strong>"+escapeHtml(f.nome||'Moldura')+"</strong><span>Prévia do comentário</span></div>"+(f.imagemUrl?"<img class='admin-frame-thumb-art' src='"+escapeAttr(f.imagemUrl)+"' alt=''/>":'')+"</div><div class='comment-frame-meta'><strong>"+escapeHtml(f.nome||'Moldura')+"</strong><span class='comment-frame-status'>"+(f.exclusiveToUid?'EXCLUSIVA':f.ativo===false?'OCULTA':'PUBLICADA')+"</span></div>"+(f.exclusiveToUid?"<div class='tiny' style='margin:7px 0'>🎁 Evento • exclusiva para "+escapeHtml(f.exclusiveToUid)+"</div>":'')+"<div class='admin-frame-style-chips'><span class='admin-frame-style-chip'>Brilho "+f.brightness+"%</span><span class='admin-frame-style-chip'>Fundo "+f.bgOpacity+"%</span><span class='admin-frame-style-chip'>"+commentFrameEffectLabel(f.effect)+"</span><span class='admin-frame-style-chip'>Glow "+f.glow+"%</span></div><div class='row'><button type='button' class='btn ghost' data-admin-frame-edit='"+escapeAttr(f.id)+"'>Editar</button><button type='button' class='btn' data-admin-frame-test='"+escapeAttr(f.id)+"'>Testar no meu perfil</button><button type='button' class='btn' data-admin-frame-toggle='"+escapeAttr(f.id)+"'>"+(f.ativo===false?'Publicar':'Ocultar')+"</button><button type='button' class='btn danger' data-admin-frame-delete='"+escapeAttr(f.id)+"'>Excluir</button></div></div>";
      el.dataset.adminView='frames';
      el.innerHTML="<div class='admin-section-card'><div class='admin-section-title'><div><h2>Molduras de comentário</h2><p>Crie molduras completas: imagem, cores, brilho, transparência, espaço, vidro e animação. Todas as alterações aparecem na prévia sem recarregar a tela.</p></div></div>"+(state.referralFrameTarget?"<div class='referral-studio-target'><strong>🎁 Moldura exclusiva do evento</strong><span>Preparando para "+escapeHtml(state.referralFrameTarget.nome||state.referralFrameTarget.uid)+" • pedido de 10 indicações</span><small>Você pode salvar como rascunho, testar no seu perfil ADM e depois entregar somente para esse leitor.</small></div>":'')+"<div class='admin-frame-layout'><div class='admin-frame-editor' id='adminFrameEditor'><div class='field'><label>Nome da moldura</label><input id='adminFrameName' maxlength='80' autocomplete='off' placeholder='Ex.: Noite de Rubi' value='"+escapeAttr(draft.name||'')+"'/><div class='tiny' style='margin-top:6px'>O rascunho fica preservado enquanto você personaliza.</div></div><div class='field'><label>Imagem da moldura</label><button type='button' class='admin-file-pick' id='adminFramePick'>🖼 Escolher imagem</button><input id='adminFrameFile' class='admin-file-hidden' type='file' accept='image/png,image/webp,image/jpeg'/><div class='tiny' id='adminFrameFileStatus' style='margin-top:8px'>"+(draft.file?'Imagem selecionada: '+escapeHtml(draft.file.name||'arquivo'):draft.imageUrl?'Usando a imagem atual. Escolha outra somente se quiser substituir.':'PNG/WebP com centro transparente costuma ficar melhor.')+"</div></div><div class='admin-frame-preview frame-style-preview"+commentFrameEffectClass(draft)+"' id='adminFramePreview' style='"+escapeAttr(commentFrameInlineStyle(draft))+"'><div class='comment-frame-preview-card'><div class='comment-frame-preview-head'><div class='comment-frame-preview-avatar'>💗</div><div class='comment-frame-preview-meta'><strong>Prévia do comentário</strong><span>@mpscan • agora</span></div></div><div class='comment-frame-preview-inner'><strong>Veja exatamente como vai aparecer</strong><p>Cores, brilho, vidro, moldura e movimento já aparecem aqui em tempo real.</p></div><div class='comment-frame-preview-copy'><span>🎞 Foto com movimento</span><span>✨ Estilo profissional</span></div></div></div><div class='admin-frame-style-panel'><div class='admin-frame-style-title'><strong>✨ Aparência do comentário</strong><span>Prévia em tempo real</span></div><div class='admin-frame-preset-grid'><button type='button' class='admin-frame-preset' data-admin-frame-preset='classic'>Clássico</button><button type='button' class='admin-frame-preset' data-admin-frame-preset='neon'>Neon</button><button type='button' class='admin-frame-preset' data-admin-frame-preset='glass'>Cristal</button><button type='button' class='admin-frame-preset' data-admin-frame-preset='ruby'>Rubi</button><button type='button' class='admin-frame-preset' data-admin-frame-preset='aurora'>Aurora</button><button type='button' class='admin-frame-preset' data-admin-frame-preset='royal'>Real</button><button type='button' class='admin-frame-preset' data-admin-frame-preset='galaxy'>Galáxia</button><button type='button' class='admin-frame-preset' data-admin-frame-preset='rose'>Rosé</button><button type='button' class='admin-frame-preset' data-admin-frame-preset='ocean'>Oceano</button></div><div class='admin-frame-color-grid'>"+color('bgColor','Cor do comentário')+color('textColor','Cor do texto')+color('accentColor','Cor de destaque')+color('glowColor','Cor do brilho')+"</div>"+range('bgOpacity','Transparência do fundo',20,100,5,'%')+range('brightness','Brilho da moldura',50,160,5,'%')+range('saturation','Saturação da moldura',0,200,5,'%')+range('frameOpacity','Opacidade da moldura',20,100,5,'%')+range('glow','Intensidade do brilho',0,100,5,'%')+range('radius','Arredondamento',8,40,1,'px')+range('padding','Espaço interno',10,34,1,'px')+range('spread','Expansão da moldura',0,24,1,'px')+range('blur','Efeito de vidro',0,20,1,'px')+"<div><div class='admin-frame-style-title'><strong>Animação</strong><span>Respeita reduzir animações</span></div><div class='admin-frame-effect-grid' style='margin-top:8px'>"+effectBtn('none','Estática')+effectBtn('pulse','Pulso suave')+effectBtn('shine','Brilho')+effectBtn('float','Flutuar')+effectBtn('aurora','Aurora')+effectBtn('sparkle','Faíscas')+effectBtn('breathe','Respirar')+effectBtn('orbit','Orbitar')+effectBtn('rainbow','Arco-íris')+"</div></div><button type='button' class='btn ghost' id='resetAdminFrameStyle'>↺ Restaurar só o estilo</button></div><div id='adminFrameEditorStatus' class='admin-frame-editor-status'>Toque em uma cor ou mova uma barra para personalizar.</div><label class='settings-option-row' style='margin-top:14px'><div class='settings-option-copy'><strong>Publicada</strong><small>Quando ligada, leitores podem pegar esta moldura.</small></div><span class='app-toggle'><input id='adminFrameActive' type='checkbox' "+(draft.active!==false?"checked='checked'":'')+"/><span></span></span></label><input id='editingCommentFrameId' type='hidden' value='"+escapeAttr(draft.editingId||'')+"'/><div class='row' style='margin-top:14px'><button type='button' class='btn primary' id='saveAdminFrame'>Salvar moldura</button>"+(state.referralFrameTarget?"<button type='button' class='btn primary' id='saveAdminFrameDeliver'>🎁 Salvar e entregar</button>":'')+"<button type='button' class='btn ghost' id='clearAdminFrame'>Nova</button></div></div><div><div class='section-head'><h3 class='section-title'>Molduras criadas</h3><span class='section-sub'>"+list.length+" cadastrada"+(list.length===1?'':'s')+"</span></div><div class='admin-frame-list'>"+(list.length?list.map(listCard).join(''):"<div class='empty'>Nenhuma moldura criada ainda.</div>")+"</div></div></div></div>";

      let previewUrl='';
      const editor=$('#adminFrameEditor');
      // A tela fica bloqueada contra re-render até o ADM salvar, tocar em Nova ou sair da rota.
      state.adminFrameEditing=true;
      const markDirty=()=>{state.adminFrameEditing=true;const st=$('#adminFrameEditorStatus');if(st){st.textContent='Alterações prontas para salvar.';st.classList.add('dirty');}};
      const previewImage=img=>{const p=$('#adminFramePreview');if(!p)return;p.querySelector('.admin-frame-preview-art')?.remove();if(img)p.insertAdjacentHTML('beforeend',"<img class='admin-frame-preview-art' src='"+escapeAttr(img)+"' alt=''/>");};
      const currentDraft=()=>normalizedCommentFrame(state.adminFrameDraft||{});
      const syncColorControls=(key,value)=>{const safe=safeFrameColor(value,'');if(!safe)return;const picker=editor?.querySelector("input[type='color'][data-admin-frame-setting='"+key+"']"),hex=editor?.querySelector("[data-admin-frame-hex='"+key+"']");if(picker&&picker.value.toLowerCase()!==safe.toLowerCase())picker.value=safe;if(hex&&hex.value.toLowerCase()!==safe.toLowerCase())hex.value=safe.toUpperCase();hex?.classList.remove('invalid');};
      const applyPreview=()=>{const p=$('#adminFramePreview');if(!p)return;const s=currentDraft();p.style.cssText=commentFrameInlineStyle(s);['pulse','shine','float','aurora','sparkle','breathe','orbit','rainbow'].forEach(fx=>p.classList.toggle('frame-effect-'+fx,s.effect===fx));$$('[data-admin-frame-effect]',el).forEach(b=>b.classList.toggle('active',b.dataset.adminFrameEffect===s.effect));const chips=p.querySelectorAll('.comment-frame-preview-copy span');if(chips[0])chips[0].textContent='✦ '+commentFrameEffectLabel(s.effect);if(chips[1])chips[1].textContent='Glow '+String(s.glow)+'%';for(const key of ['bgColor','textColor','accentColor','glowColor'])syncColorControls(key,s[key]);for(const key of ['bgOpacity','brightness','saturation','frameOpacity','glow','radius','padding','spread','blur']){const o=el.querySelector('[data-admin-frame-value="'+key+'"]');if(o){const inp=el.querySelector('[data-admin-frame-setting="'+key+'"]');o.textContent=String(s[key])+(inp?.dataset.suffix||'');}}};
      const restorePreview=()=>{if(state.adminFrameDraft?.file){if(previewUrl){try{URL.revokeObjectURL(previewUrl);}catch(_e){}}previewUrl=URL.createObjectURL(state.adminFrameDraft.file);previewImage(previewUrl);}else previewImage(state.adminFrameDraft?.imageUrl||'');applyPreview();};
      restorePreview();

      // Um único controlador para todos os controles. Usa INPUT + CHANGE porque alguns
      // navegadores só disparam CHANGE ao fechar o seletor nativo de cores.
      const handleEditorControl=e=>{
        const t=e.target;if(!t||!editor?.contains(t))return;
        if(t.id==='adminFrameName'){state.adminFrameDraft.name=t.value;markDirty();return;}
        if(t.id==='adminFrameActive'){state.adminFrameDraft.active=!!t.checked;markDirty();return;}
        if(t.matches('[data-admin-frame-setting]')){
          const key=t.dataset.adminFrameSetting;
          if(t.type==='color')state.adminFrameDraft[key]=safeFrameColor(t.value,state.adminFrameDraft[key]||'#7b4dff');
          else state.adminFrameDraft[key]=Number(t.value);
          markDirty();applyPreview();return;
        }
        if(t.matches('[data-admin-frame-hex]')){
          const key=t.dataset.adminFrameHex,raw=String(t.value||'').trim();
          if(/^#[0-9a-f]{6}$/i.test(raw)){state.adminFrameDraft[key]=raw.toLowerCase();t.classList.remove('invalid');markDirty();applyPreview();}
          else if(raw.length>=7)t.classList.add('invalid');
        }
      };
      editor?.addEventListener('input',handleEditorControl,true);
      editor?.addEventListener('change',handleEditorControl,true);

      const presets={
        classic:{bgColor:'#17171d',textColor:'#f7f7f8',accentColor:'#7b4dff',glowColor:'#7b4dff',bgOpacity:94,brightness:100,saturation:100,frameOpacity:100,glow:18,radius:22,padding:16,spread:10,blur:0,effect:'none'},
        neon:{bgColor:'#0d0b16',textColor:'#ffffff',accentColor:'#d875ff',glowColor:'#a84cff',bgOpacity:88,brightness:118,saturation:125,frameOpacity:100,glow:70,radius:24,padding:17,spread:12,blur:4,effect:'pulse'},
        glass:{bgColor:'#151924',textColor:'#f8fbff',accentColor:'#71b8ff',glowColor:'#8fd3ff',bgOpacity:58,brightness:105,saturation:95,frameOpacity:88,glow:34,radius:26,padding:18,spread:9,blur:14,effect:'shine'},
        ruby:{bgColor:'#180b12',textColor:'#fff7fa',accentColor:'#d83d72',glowColor:'#ff5e92',bgOpacity:91,brightness:112,saturation:120,frameOpacity:100,glow:58,radius:24,padding:17,spread:13,blur:3,effect:'sparkle'},
        aurora:{bgColor:'#0c1520',textColor:'#f5ffff',accentColor:'#4fe6c2',glowColor:'#8b5cff',bgOpacity:78,brightness:118,saturation:138,frameOpacity:96,glow:66,radius:28,padding:18,spread:14,blur:10,effect:'aurora'},
        royal:{bgColor:'#171020',textColor:'#fffaf0',accentColor:'#d7ae5c',glowColor:'#f0d889',bgOpacity:93,brightness:108,saturation:108,frameOpacity:100,glow:45,radius:22,padding:18,spread:12,blur:2,effect:'float'},
        galaxy:{bgColor:'#0d1127',textColor:'#f7f5ff',accentColor:'#9d7cff',glowColor:'#53c7ff',bgOpacity:82,brightness:118,saturation:145,frameOpacity:98,glow:78,radius:28,padding:18,spread:15,blur:10,effect:'orbit'},
        rose:{bgColor:'#22111a',textColor:'#fff8fb',accentColor:'#ff78b0',glowColor:'#ffb6d9',bgOpacity:90,brightness:111,saturation:112,frameOpacity:100,glow:48,radius:26,padding:18,spread:12,blur:6,effect:'breathe'},
        ocean:{bgColor:'#0c1a20',textColor:'#f0fbff',accentColor:'#47d3ff',glowColor:'#7ffff0',bgOpacity:84,brightness:116,saturation:135,frameOpacity:96,glow:62,radius:25,padding:17,spread:13,blur:8,effect:'rainbow'}
      };
      const applyPreset=name=>{const p=presets[name];if(!p)return;Object.assign(state.adminFrameDraft,p);for(const [key,val] of Object.entries(p)){const inp=editor?.querySelector('[data-admin-frame-setting="'+key+'"]');if(inp)inp.value=val;if(['bgColor','textColor','accentColor','glowColor'].includes(key))syncColorControls(key,val);}markDirty();applyPreview();};
      editor?.querySelectorAll('[data-admin-frame-preset]').forEach(b=>b.addEventListener('click',e=>{e.preventDefault();applyPreset(b.dataset.adminFramePreset);}));
      editor?.querySelectorAll('[data-admin-frame-effect]').forEach(b=>b.addEventListener('click',e=>{e.preventDefault();state.adminFrameDraft.effect=b.dataset.adminFrameEffect;markDirty();applyPreview();}));
      $('#resetAdminFrameStyle')?.addEventListener('click',e=>{e.preventDefault();applyPreset('classic');});

      $('#adminFramePick')?.addEventListener('click',e=>{e.preventDefault();const input=$('#adminFrameFile');try{input?.showPicker?input.showPicker():input?.click();}catch(err){try{input?.click();}catch(_e){ui.toast('Não foi possível abrir a galeria neste navegador.');}}});
      $('#adminFrameFile')?.addEventListener('change',e=>{const file=e.target.files?.[0]||null;state.adminFrameDraft.file=file;markDirty();if(previewUrl){try{URL.revokeObjectURL(previewUrl);}catch(_e){}}previewUrl=file?URL.createObjectURL(file):'';previewImage(previewUrl||state.adminFrameDraft.imageUrl||'');if($('#adminFrameFileStatus'))$('#adminFrameFileStatus').textContent=file?'Imagem selecionada: '+file.name:(state.adminFrameDraft.imageUrl?'Usando a imagem atual.':'Nenhuma imagem selecionada.');applyPreview();});

      const blankDraft=()=>({name:'',active:true,editingId:'',imageUrl:'',file:null,...normalizedCommentFrame({})});
      const clear=()=>{if(previewUrl){try{URL.revokeObjectURL(previewUrl);}catch(_e){}}previewUrl='';state.adminFrameDraft=blankDraft();state.adminFrameEditing=false;renderAdminCommentFrames(el);};
      $('#clearAdminFrame')?.addEventListener('click',e=>{e.preventDefault();clear();});

      const saveFrameCore=async(deliver=false)=>{
        const name=String(state.adminFrameDraft?.name??$('#adminFrameName')?.value??'').trim(),id=state.adminFrameDraft?.editingId||$('#editingCommentFrameId')?.value||push(pathRef('config/commentFrames')).key,old=frames[id]||{},selectedFile=state.adminFrameDraft?.file||null,target=deliver?state.referralFrameTarget:null;
        if(!name){ui.toast('Dê um nome para a moldura.');$('#adminFrameName')?.focus();return;}if(!selectedFile&&!old.imagemUrl&&!state.adminFrameDraft?.imageUrl){ui.toast('Escolha a imagem da moldura.');return;}const btn=deliver?$('#saveAdminFrameDeliver'):$('#saveAdminFrame');if(btn){btn.disabled=true;btn.textContent=deliver?'Entregando…':'Salvando…';}
        try{if(selectedFile&&selectedFile.size>8*1024*1024)throw new Error('Imagem muito grande');const imagemUrl=selectedFile?await prepareUiImage(selectedFile,'cover'):(old.imagemUrl||state.adminFrameDraft?.imageUrl||''),fs=normalizedCommentFrame(state.adminFrameDraft||{}),exclusiveToUid=state.referralFrameTarget?.uid||target?.uid||old.exclusiveToUid||'';await dbSet('config/commentFrames/'+id,{id,nome:name,imagemUrl,ativo:exclusiveToUid?true:state.adminFrameDraft?.active!==false,bgColor:fs.bgColor,textColor:fs.textColor,accentColor:fs.accentColor,glowColor:fs.glowColor,bgOpacity:fs.bgOpacity,brightness:fs.brightness,saturation:fs.saturation,frameOpacity:fs.frameOpacity,glow:fs.glow,radius:fs.radius,padding:fs.padding,spread:fs.spread,blur:fs.blur,effect:fs.effect,exclusiveToUid,origem:exclusiveToUid?'evento-divulgacao':(old.origem||''),criadoEm:old.criadoEm||now(),atualizadoEm:now()});if(target?.uid){await dbSet('commentFrameInventory/'+target.uid+'/'+id,{data:now(),origem:'evento-divulgacao'});await dbUpdate('eventoDivulgacao/premios/'+target.uid+'/10',{status:'entregue',assetId:id,assetName:name,atualizadoEm:now(),respondidoEm:now(),respondidoPor:state.user.uid});await referralNotify(target.uid,'Sua moldura personalizada chegou','O ADM terminou e entregou sua moldura exclusiva. Abra Perfil → Molduras para usar.','/perfil');state.referralFrameTarget=null;ui.toast('Moldura exclusiva entregue.');}else ui.toast('Moldura salva.');state.commentFrames=await dbGet('config/commentFrames')||{};state.adminFrameDraft=blankDraft();state.adminFrameEditing=false;await renderAdminCommentFrames(el);}catch(err){console.error(err);ui.toast(deliver?'Não foi possível entregar a moldura.':'Não foi possível salvar a moldura.');if(btn){btn.disabled=false;btn.textContent=deliver?'🎁 Salvar e entregar':'Salvar moldura';}state.adminFrameEditing=true;}
      };
      $('#saveAdminFrame')?.addEventListener('click',e=>{e.preventDefault();saveFrameCore(false);});
      $('#saveAdminFrameDeliver')?.addEventListener('click',e=>{e.preventDefault();saveFrameCore(true);});


      el.querySelectorAll('[data-admin-frame-edit]').forEach(b=>b.addEventListener('click',e=>{e.preventDefault();const f=state.commentFrames?.[b.dataset.adminFrameEdit];if(!f)return;const fs=normalizedCommentFrame(f);state.adminFrameDraft={name:f.nome||'',active:f.ativo!==false,editingId:f.id,imageUrl:f.imagemUrl||'',file:null,...fs};state.adminFrameEditing=false;renderAdminCommentFrames(el).then(()=>{$('#adminFrameName')?.focus();window.scrollTo({top:0,behavior:'smooth'});});}));
      el.querySelectorAll('[data-admin-frame-test]').forEach(b=>b.addEventListener('click',async e=>{e.preventDefault();const id=b.dataset.adminFrameTest,f=state.commentFrames?.[id];if(!f)return;try{await dbSet('commentFrameInventory/'+state.user.uid+'/'+id,{data:now(),origem:'teste-adm'});state.commentFrameInventory={...(state.commentFrameInventory||{}),[id]:{data:now(),origem:'teste-adm'}};await dbUpdate('usuarios/'+state.user.uid,{molduraComentarioId:id,atualizadoEm:now()});state.profile={...(state.profile||{}),molduraComentarioId:id};await syncPublicProfile(state.user.uid,state.profile);ui.toast('Moldura aplicada ao seu perfil ADM para teste.');}catch(err){console.error(err);ui.toast('Não foi possível testar esta moldura.');}}));
      el.querySelectorAll('[data-admin-frame-toggle]').forEach(b=>b.addEventListener('click',async e=>{e.preventDefault();const id=b.dataset.adminFrameToggle,f=state.commentFrames?.[id];if(!f)return;await dbUpdate('config/commentFrames/'+id,{ativo:f.ativo===false,atualizadoEm:now()});state.commentFrames=await dbGet('config/commentFrames')||{};state.adminFrameEditing=false;await renderAdminCommentFrames(el);}));
      el.querySelectorAll('[data-admin-frame-delete]').forEach(b=>b.addEventListener('click',async e=>{e.preventDefault();if(!confirm('Excluir esta moldura? Quem já a usa ficará sem moldura até escolher outra.'))return;await dbRemove('config/commentFrames/'+b.dataset.adminFrameDelete);state.commentFrames=await dbGet('config/commentFrames')||{};if(state.adminFrameDraft?.editingId===b.dataset.adminFrameDelete)state.adminFrameDraft=blankDraft();state.adminFrameEditing=false;await renderAdminCommentFrames(el);}));
    }

    async function renderAdminComments(el){const root=await dbGet('comentariosV1')||{},items=[];for(const [wid,comments] of objEntries(root.obra||{}))for(const [id,c] of objEntries(comments||{}))items.push({path:'comentariosV1/obra/'+wid+'/'+id,id,c,where:'Obra'});for(const [wid,chs] of objEntries(root.capitulo||{}))for(const [cid,comments] of objEntries(chs||{}))for(const [id,c] of objEntries(comments||{}))items.push({path:'comentariosV1/capitulo/'+wid+'/'+cid+'/'+id,id,c,where:'Capítulo'});items.sort((a,b)=>num(b.c.data)-num(a.c.data));el.innerHTML="<div class='admin-section-card'><div class='admin-section-title'><div><h2>Moderação de comentários</h2><p>Revise comentários recentes de obras e capítulos.</p></div></div><div class='admin-grid'>"+(items.length?items.slice(0,100).map(i=>"<div class='admin-item'><div class='tiny'>"+i.where+' • '+fmtRelative(i.c.data)+"</div><p>"+escapeHtml(i.c.texto||'[imagem]')+"</p><button type='button' class='btn danger' data-admin-delete-path='"+escapeAttr(i.path)+"'>Excluir</button></div>").join(''):"<div class='empty'>Nenhum comentário.</div>")+"</div></div>";}
    function renderAdminBanners(el){
      const list=objEntries(state.banners).map(([id,b])=>({id,...b}));
      el.innerHTML="<div class='admin-section-card'><div class='admin-section-title'><div><h2>Banners</h2><p>Gerencie destaques visuais usados pelo MP SCAN.</p></div></div><div class='field'><label>Título</label><input id='bannerTitle' placeholder='Título do banner'/></div><div class='field'><label>Subtítulo</label><input id='bannerSubtitle' placeholder='Texto de apoio'/></div><div class='field'><label>Imagem</label><input id='bannerFile' type='file' accept='image/*'/></div><button type='button' class='btn primary' id='saveBanner'>＋ Adicionar banner</button><div class='admin-grid' style='margin-top:16px'>"+(list.length?list.map(b=>"<div class='admin-item'><h4>"+escapeHtml(b.titulo||'Banner')+"</h4><div class='tiny'>"+escapeHtml(b.subtitulo||'Sem subtítulo')+"</div><div class='row'><button type='button' class='btn danger' data-delete-banner='"+b.id+"'>Excluir</button></div></div>").join(''):"<div class='empty'>Nenhum banner cadastrado.</div>")+"</div></div>";
      $('#saveBanner')?.addEventListener('click',saveBanner);
    }
    async function saveBanner(){const file=$('#bannerFile').files?.[0];if(!file){ui.toast('Escolha uma imagem.');return;}try{const imagem=await fileData(file);await dbPush('config/banners',{titulo:$('#bannerTitle').value.trim(),subtitulo:$('#bannerSubtitle').value.trim(),imagem,ativo:true,data:now()});ui.toast('Banner adicionado.');}catch(e){ui.toast('Não foi possível salvar o banner.');}}
    const ADMIN_NOTIFY_DRAFT_KEY='mp_admin_notification_draft_v1';
    function readAdminNotificationDraft(){
      try{const d=JSON.parse(sessionStorage.getItem(ADMIN_NOTIFY_DRAFT_KEY)||'{}');return d&&typeof d==='object'?d:{};}catch(e){return {};}
    }
    function writeAdminNotificationDraft(d){
      try{sessionStorage.setItem(ADMIN_NOTIFY_DRAFT_KEY,JSON.stringify(d||{}));}catch(e){}
    }
    function captureAdminNotificationDraft(){
      const title=$('#adminNotifyTitle'),msg=$('#adminNotifyText'),link=$('#adminNotifyLink'),target=$('#adminNotifyTarget'),uid=$('#adminNotifyUid');
      if(!title&&!msg&&!link&&!target&&!uid)return readAdminNotificationDraft();
      const d={target:target?.value||'all',uid:uid?.value||'',title:title?.value||'',message:msg?.value||'',link:link?.value||'/inicio'};
      writeAdminNotificationDraft(d);return d;
    }
    function resetAdminNotificationDraftAfterSend(){
      const current=captureAdminNotificationDraft();
      const next={target:current.target||'all',uid:current.uid||'',title:'',message:'',link:current.link||'/inicio'};
      writeAdminNotificationDraft(next);return next;
    }
    async function renderAdminNotifications(el){
      if(!el)return;
      // Nunca reconstrói o formulário enquanto ele já está aberto. Isso evita que
      // atualizações em tempo real do Firebase apaguem destino, título, mensagem ou link.
      if(el.dataset.adminView==='notifications'&&el.querySelector('#adminNotifyTitle'))return;
      const draft=readAdminNotificationDraft();
      let users={};try{users=await dbGet('usuarios')||{};}catch(e){console.warn('Não foi possível carregar lista de usuários para notificações',e);}
      // Se outra renderização terminou primeiro enquanto esta aguardava o Firebase,
      // mantém a que já está na tela em vez de substituir os campos que o ADM está editando.
      if(el.dataset.adminView==='notifications'&&el.querySelector('#adminNotifyTitle'))return;
      const rows=objEntries(users).filter(([,u])=>u&&typeof u==='object'&&u.anonimo!==true);
      const options=rows.map(([uid,u])=>{const label=(u.nome||u.name||u.email||'Usuário')+(u.email?' — '+u.email:'');return "<option value='"+escapeAttr(uid)+"'>"+escapeHtml(label)+"</option>";}).join('');
      el.dataset.adminView='notifications';
      el.innerHTML="<div class='admin-section-card admin-panel-stable'><div class='admin-section-title'><div><h2>Central de notificações</h2><p>Envie avisos reais sem perder o que está escrevendo.</p></div></div><div class='admin-notify-grid'><div><div class='field'><label>Destino</label><select id='adminNotifyTarget'><option value='all'>Todos os usuários cadastrados</option><option value='one'>Um usuário específico</option></select></div><div class='field hidden' id='adminNotifyUserField'><label>Usuário</label><select id='adminNotifyUid'><option value=''>Selecione um usuário</option>"+options+"</select></div><div class='field'><label>Título</label><input id='adminNotifyTitle' maxlength='100' autocomplete='off' placeholder='Ex.: Novo aviso do MP SCAN'/></div><div class='field'><label>Mensagem</label><textarea id='adminNotifyText' maxlength='1200' placeholder='Escreva sua mensagem...'></textarea></div><div class='field'><label>Link interno</label><input id='adminNotifyLink' autocomplete='off' placeholder='/inicio'/><div class='tiny'>Ex.: /inicio, /buscar ou /obra/ID</div></div><button type='button' class='btn primary' id='sendAdminNotification'>🔔 Enviar notificação</button><div id='adminNotifyStatus' class='admin-status-box' style='margin-top:12px'>Seu rascunho fica salvo enquanto esta sessão estiver aberta.</div></div><div><div class='admin-notify-preview'><strong id='adminNotifyPreviewTitle'>Prévia da notificação</strong><p id='adminNotifyPreviewText'>Sua mensagem aparecerá aqui.</p><div class='tiny' id='adminNotifyPreviewLink' style='margin-top:9px'>Abrirá: /inicio</div></div><div class='admin-status-box' style='margin-top:12px'>Os avisos do ADM aparecem no sino de notificações dos leitores. O contador de não lidas é atualizado normalmente.</div></div></div></div>";
      const target=$('#adminNotifyTarget'),userField=$('#adminNotifyUserField'),uid=$('#adminNotifyUid'),title=$('#adminNotifyTitle'),msg=$('#adminNotifyText'),link=$('#adminNotifyLink');
      target.value=draft.target==='one'?'one':'all';
      if(uid&&draft.uid&&Array.from(uid.options).some(o=>o.value===draft.uid))uid.value=draft.uid;
      if(title)title.value=String(draft.title||'');
      if(msg)msg.value=String(draft.message||'');
      if(link)link.value=String(draft.link||'/inicio');
      const syncTarget=()=>{userField?.classList.toggle('hidden',target?.value!=='one');captureAdminNotificationDraft();};
      const preview=()=>{const pt=$('#adminNotifyPreviewTitle'),pm=$('#adminNotifyPreviewText'),pl=$('#adminNotifyPreviewLink');if(pt)pt.textContent=title?.value.trim()||'Prévia da notificação';if(pm)pm.textContent=msg?.value.trim()||'Sua mensagem aparecerá aqui.';if(pl)pl.textContent='Abrirá: '+(link?.value.trim()||'/inicio');};
      const saveAndPreview=e=>{e?.stopPropagation?.();captureAdminNotificationDraft();preview();};
      target?.addEventListener('change',e=>{e.stopPropagation();syncTarget();preview();});
      uid?.addEventListener('change',e=>{e.stopPropagation();captureAdminNotificationDraft();});
      [title,msg,link].forEach(x=>x?.addEventListener('input',saveAndPreview));
      syncTarget();preview();
      $('#sendAdminNotification')?.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();captureAdminNotificationDraft();sendAdminNotification();});
    }
    async function sendAdminNotification(){
      const btn=$('#sendAdminNotification'),status=$('#adminNotifyStatus'),target=$('#adminNotifyTarget')?.value||'all',title=$('#adminNotifyTitle')?.value.trim()||'',message=$('#adminNotifyText')?.value.trim()||'',rawLink=$('#adminNotifyLink')?.value.trim()||'/inicio',link=rawLink.startsWith('/')?rawLink:'/inicio';
      if(!title||!message){ui.toast('Preencha título e mensagem.');return;}
      if(!isAdmin()){ui.toast('Sem permissão administrativa.');return;}
      let recipients=[];
      try{
        if(target==='one'){
          const uid=$('#adminNotifyUid')?.value.trim()||'';if(!uid){ui.toast('Selecione um usuário.');return;}recipients=[uid];
        }else{
          const users=await dbGet('usuarios')||{};recipients=objEntries(users).filter(([uid,u])=>u&&typeof u==='object'&&u.anonimo!==true&&uid!==state.user?.uid).map(([uid])=>uid);
        }
        if(!recipients.length){ui.toast('Nenhum destinatário encontrado.');return;}
        if(btn){btn.disabled=true;btn.textContent='Enviando 0/'+recipients.length+'...';}
        if(status){status.className='admin-status-box';status.textContent='Preparando envio para '+recipients.length+' destinatário'+(recipients.length===1?'':'s')+'...';}
        let sent=0,failed=0;
        for(let i=0;i<recipients.length;i++){
          const uid=recipients[i];
          try{await dbPush('notificacoes/'+uid,{tipo:'admin',titulo:title,texto:message,link,data:now(),lida:false,fromUid:state.user?.uid||''});sent++;}catch(e){failed++;console.error('Falha ao notificar '+uid,e);}
          if(btn)btn.textContent='Enviando '+(i+1)+'/'+recipients.length+'...';
        }
        if(status){status.className='admin-status-box '+(failed?'error':'success');status.textContent=failed?('Envio concluído: '+sent+' enviada'+(sent===1?'':'s')+' e '+failed+' falha'+(failed===1?'':'s')+'.'):('Pronto! '+sent+' notificação'+(sent===1?' enviada.':' enviadas.'));}
        if(sent){ui.toast(sent+' notificação'+(sent===1?' enviada.':' enviadas.'));const nextDraft=resetAdminNotificationDraftAfterSend();if($('#adminNotifyTitle'))$('#adminNotifyTitle').value=nextDraft.title;if($('#adminNotifyText'))$('#adminNotifyText').value=nextDraft.message;if($('#adminNotifyLink'))$('#adminNotifyLink').value=nextDraft.link;if($('#adminNotifyPreviewTitle'))$('#adminNotifyPreviewTitle').textContent='Prévia da notificação';if($('#adminNotifyPreviewText'))$('#adminNotifyPreviewText').textContent='Sua mensagem aparecerá aqui.';if($('#adminNotifyPreviewLink'))$('#adminNotifyPreviewLink').textContent='Abrirá: '+nextDraft.link;}
        if(!sent&&failed)ui.toast('O Firebase recusou o envio. Confira as regras/permissões.');
      }catch(e){console.error('sendAdminNotification',e);if(status){status.className='admin-status-box error';status.textContent='Não foi possível concluir o envio: '+String(e?.code||e?.message||'erro desconhecido');}ui.toast('Não foi possível enviar a notificação.');}
      finally{if(btn){btn.disabled=false;btn.textContent='🔔 Enviar notificação';}}
    }
    function readAdminDocumentDrafts(){
      let draft={};
      try{draft=JSON.parse(sessionStorage.getItem('mp_admin_document_drafts')||'{}')||{};}catch(e){}
      return draft&&typeof draft==='object'?draft:{};
    }
    function persistAdminDocumentDrafts(){
      try{sessionStorage.setItem('mp_admin_document_drafts',JSON.stringify(state.adminDocDrafts||{}));}catch(e){}
    }
    function clearAdminDocumentDrafts(){
      state.adminDocDrafts={};state.adminDocDirty=false;
      try{sessionStorage.removeItem('mp_admin_document_drafts');}catch(e){}
    }
    function adminDocStatus(key,message,kind=''){
      const el=document.querySelector('[data-admin-doc-status="'+key+'"]');if(!el)return;
      el.textContent=message||'';el.className='admin-doc-state'+(kind?' '+kind:'');
    }
    function captureAdminDocumentDrafts(){
      const map={termos:'adminTermsUse',privacidade:'adminTermsPrivacy',seguranca:'adminTermsSecurity'};
      for(const [key,id] of Object.entries(map)){const box=document.getElementById(id);if(box)state.adminDocDrafts[key]=box.value;}
      state.adminDocDirty=true;persistAdminDocumentDrafts();
    }
    function bindAdminDocumentEditor(){
      const root=document.getElementById('adminDocumentsEditor');if(!root||root.dataset.bound==='1')return;root.dataset.bound='1';
      root.querySelectorAll('[data-admin-doc-key]').forEach(box=>{
        box.addEventListener('focus',()=>{state.adminDocEditing=true;},{passive:true});
        box.addEventListener('blur',()=>{setTimeout(()=>{state.adminDocEditing=!!document.activeElement?.closest?.('#adminDocumentsEditor textarea');},120);},{passive:true});
        box.addEventListener('input',()=>{
          const key=box.dataset.adminDocKey;state.adminDocDrafts[key]=box.value;state.adminDocDirty=true;persistAdminDocumentDrafts();
          adminDocStatus(key,'Alterações ainda não publicadas.','dirty');
          const status=document.getElementById('adminDocumentsStatus');if(status){status.className='admin-status-box';status.textContent='Você tem alterações não publicadas.';}
        });
      });
      root.querySelectorAll('[data-save-admin-doc]').forEach(btn=>btn.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();saveSingleAdminDocument(btn.dataset.saveAdminDoc);}));
      document.getElementById('saveAdminDocuments')?.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();saveAdminDocuments();});
      document.getElementById('reloadAdminDocuments')?.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();reloadAdminDocuments();});
    }
    async function renderAdminDocuments(el,force=false){
      if(!force&&el.dataset.adminView==='documents'&&document.getElementById('adminDocumentsEditor'))return;
      let docs={};try{docs=await dbGet('config/termos')||{};}catch(e){console.warn('admin docs load',e);}
      const remote={termos:typeof docs.termos==='string'?docs.termos:'',privacidade:typeof docs.privacidade==='string'?docs.privacidade:'',seguranca:typeof docs.seguranca==='string'?docs.seguranca:''};
      const stored=readAdminDocumentDrafts(),hasStored=['termos','privacidade','seguranca'].some(k=>typeof stored[k]==='string'&&stored[k]!==remote[k]);
      state.adminDocDrafts=hasStored?{...remote,...stored}:{...remote};state.adminDocDirty=hasStored;
      const d=state.adminDocDrafts;
      el.dataset.adminView='documents';
      el.innerHTML="<div class='admin-section-card admin-document-editor' id='adminDocumentsEditor'><div class='admin-section-title'><div><h2>Documentos do MP SCAN</h2><p>Escreva e publique cada documento com calma. Esta tela não será reconstruída enquanto você estiver editando.</p></div></div><div class='admin-document-grid'>"+
        "<section class='admin-document-card'><h3>≡ Termos de uso</h3><p>Regras de utilização do MP SCAN, responsabilidades da conta e condições de uso.</p><div class='field admin-doc-field'><label for='adminTermsUse'>Texto dos Termos de uso</label><textarea class='admin-doc-textarea' id='adminTermsUse' data-admin-doc-key='termos' spellcheck='true' placeholder='Escreva aqui os Termos de uso...'>"+escapeHtml(d.termos||'')+"</textarea></div><div class='admin-doc-actions'><span class='admin-doc-state "+(hasStored?'dirty':'')+"' data-admin-doc-status='termos'>"+(hasStored?'Rascunho recuperado neste aparelho.':'Texto publicado carregado.')+"</span><button type='button' class='btn primary' data-save-admin-doc='termos'>Salvar Termos de uso</button></div></section>"+
        "<section class='admin-document-card'><h3>▤ Política de privacidade</h3><p>Explique como dados, perfil, comentários, histórico e preferências são tratados.</p><div class='field admin-doc-field'><label for='adminTermsPrivacy'>Texto da Política de privacidade</label><textarea class='admin-doc-textarea' id='adminTermsPrivacy' data-admin-doc-key='privacidade' spellcheck='true' placeholder='Escreva aqui a Política de privacidade...'>"+escapeHtml(d.privacidade||'')+"</textarea></div><div class='admin-doc-actions'><span class='admin-doc-state "+(hasStored?'dirty':'')+"' data-admin-doc-status='privacidade'>"+(hasStored?'Rascunho recuperado neste aparelho.':'Texto publicado carregado.')+"</span><button type='button' class='btn primary' data-save-admin-doc='privacidade'>Salvar Privacidade</button></div></section>"+
        "<section class='admin-document-card'><h3>🛡 Política de segurança</h3><p>Orientações de segurança, proteção da conta, denúncias e condutas da plataforma.</p><div class='field admin-doc-field'><label for='adminTermsSecurity'>Texto da Política de segurança</label><textarea class='admin-doc-textarea' id='adminTermsSecurity' data-admin-doc-key='seguranca' spellcheck='true' placeholder='Escreva aqui a Política de segurança...'>"+escapeHtml(d.seguranca||'')+"</textarea></div><div class='admin-doc-actions'><span class='admin-doc-state "+(hasStored?'dirty':'')+"' data-admin-doc-status='seguranca'>"+(hasStored?'Rascunho recuperado neste aparelho.':'Texto publicado carregado.')+"</span><button type='button' class='btn primary' data-save-admin-doc='seguranca'>Salvar Segurança</button></div></section>"+
        "</div><div class='admin-doc-toolbar'><div class='row'><button type='button' class='btn primary' id='saveAdminDocuments'>Salvar e publicar os 3 documentos</button><button type='button' class='btn ghost' id='reloadAdminDocuments'>Recarregar textos publicados</button><a class='btn ghost' href='#/configuracoes/termos' data-route='/configuracoes/termos'>Ver como usuário</a></div><div id='adminDocumentsStatus' class='admin-status-box' style='margin-top:10px'>"+(hasStored?'Rascunho local recuperado. Nada foi perdido.':'Pronto para editar. Clique em qualquer campo e escreva normalmente.')+"</div></div></div>";
      bindAdminDocumentEditor();
    }
    async function saveSingleAdminDocument(key){
      if(!isAdmin()){ui.toast('Sem permissão administrativa.');return;}
      const ids={termos:'adminTermsUse',privacidade:'adminTermsPrivacy',seguranca:'adminTermsSecurity'},labels={termos:'Termos de uso',privacidade:'Política de privacidade',seguranca:'Política de segurança'};
      if(!ids[key])return;const box=document.getElementById(ids[key]);if(!box)return;
      const btn=document.querySelector('[data-save-admin-doc="'+key+'"]'),old=btn?.textContent||'';
      try{
        if(btn){btn.disabled=true;btn.textContent='Salvando...';}
        const patch={};patch[key]=box.value||'';patch.atualizadoEm=now();patch.atualizadoPor=state.user?.uid||'';
        await dbUpdate('config/termos',patch);
        state.adminDocDrafts[key]=box.value||'';persistAdminDocumentDrafts();
        adminDocStatus(key,'Publicado agora.','');ui.toast(labels[key]+' publicada.');
        const root=document.getElementById('adminDocumentsStatus');if(root){root.className='admin-status-box success';root.textContent=labels[key]+' foi salva sem mexer nos outros documentos.';}
      }catch(e){console.error('saveSingleAdminDocument',key,e);adminDocStatus(key,'Não foi possível publicar. O texto continua salvo como rascunho neste aparelho.','dirty');const root=document.getElementById('adminDocumentsStatus');if(root){root.className='admin-status-box error';root.textContent='Não foi possível salvar: '+String(e?.code||e?.message||'erro desconhecido');}ui.toast('Não foi possível publicar '+labels[key]+'.');}
      finally{if(btn){btn.disabled=false;btn.textContent=old;}}
    }
    async function saveAdminDocuments(){
      if(!isAdmin()){ui.toast('Sem permissão administrativa.');return;}
      captureAdminDocumentDrafts();const btn=document.getElementById('saveAdminDocuments'),status=document.getElementById('adminDocumentsStatus');
      try{
        if(btn){btn.disabled=true;btn.textContent='Salvando os 3 documentos...';}
        const payload={termos:state.adminDocDrafts.termos||'',privacidade:state.adminDocDrafts.privacidade||'',seguranca:state.adminDocDrafts.seguranca||'',atualizadoEm:now(),atualizadoPor:state.user?.uid||''};
        await dbUpdate('config/termos',payload);clearAdminDocumentDrafts();
        ['termos','privacidade','seguranca'].forEach(k=>adminDocStatus(k,'Publicado agora.',''));
        if(status){status.className='admin-status-box success';status.textContent='Os três documentos foram salvos e publicados com sucesso.';}ui.toast('Documentos publicados.');
      }catch(e){console.error('saveAdminDocuments',e);persistAdminDocumentDrafts();if(status){status.className='admin-status-box error';status.textContent='Não foi possível salvar: '+String(e?.code||e?.message||'erro desconhecido')+'. O rascunho ficou guardado neste aparelho.';}ui.toast('Não foi possível publicar os documentos.');}
      finally{if(btn){btn.disabled=false;btn.textContent='Salvar e publicar os 3 documentos';}}
    }
    async function reloadAdminDocuments(){
      if(state.adminDocDirty&&!confirm('Descartar o rascunho deste aparelho e recarregar o que está publicado?'))return;
      clearAdminDocumentDrafts();const el=document.getElementById('adminDynamic');if(!el)return;el.innerHTML="<div class='admin-section-card'><div class='loading'>Recarregando documentos...</div></div>";el.dataset.adminView='';await renderAdminDocuments(el,true);
    }
    async function renderAdminStats(el){
      const users=await dbGet('usuarios').catch(()=>({}))||{},comments=await dbGet('comentariosV1').catch(()=>({}))||{};
      let chapterCount=0,reads=0;for(const w of state.allWorks){chapterCount+=(state.chapters[w.id]?.length||0);reads+=num(w.reads);}
      let commentCount=0;const countObj=o=>{for(const v of Object.values(o||{})){if(v&&typeof v==='object'&&'uid'in v)commentCount++;else if(v&&typeof v==='object')countObj(v);}};countObj(comments);
      const members=objEntries(users).filter(([,u])=>u&&typeof u==='object'&&u.anonimo!==true).length;
      el.innerHTML="<div class='admin-section-card'><div class='admin-section-title'><div><h2>Estatísticas reais</h2><p>Números calculados com os dados atuais do Firebase.</p></div></div><div class='stats-grid'><div class='stat'><strong>"+state.works.length+"</strong><span>Obras publicadas</span></div><div class='stat'><strong>"+state.allWorks.length+"</strong><span>Obras totais</span></div><div class='stat'><strong>"+chapterCount+"</strong><span>Capítulos</span></div><div class='stat'><strong>"+members+"</strong><span>Usuários</span></div><div class='stat'><strong>"+reads+"</strong><span>Leituras</span></div><div class='stat'><strong>"+commentCount+"</strong><span>Comentários</span></div></div></div>";
    }


    async function refreshSettingsProfileSnapshot(){
      if(!state.firebaseReady||!isMember())return;
      try{const fresh=await dbGet('usuarios/'+state.user.uid);if(fresh&&typeof fresh==='object'){state.profile={...(state.profile||{}),...fresh};state.role=roleFromProfile(state.profile,state.user);}}
      catch(err){console.warn('Configurações: não foi possível atualizar o perfil agora.',err);}
    }
    function prepareSettingsInteractionSurface(){
      document.querySelectorAll('.profile-rank-intro').forEach(x=>x.remove());
      $('#readerSheetBackdrop')?.classList.remove('open');$('#readerChapterPanel')?.classList.remove('open');$('#readerCommentsPanel')?.classList.remove('open');
      $('#collectionModal')?.classList.remove('open');$('#collectionPickerModal')?.classList.remove('open');
      const guide=$('#firstAccessGuide');if(guide?.classList.contains('open'))guide.classList.remove('open');
      const active=document.querySelector('.page.active');if(active){active.style.pointerEvents='auto';active.style.touchAction='pan-y';}
    }
    async function stableSettingsActionClick(e){
      const el=e.target?.closest?.('#verifyAgeButton,#sendMinorAccessRequest,#sensitivePermissionButton,#resendVerify,#resetOwnPassword');if(!el)return;
      if(!el.closest("[data-page='age-settings'],[data-page='sensitive-settings'],[data-page='settings-detail']"))return;
      e.preventDefault();e.stopImmediatePropagation();
      try{
        if(el.id==='verifyAgeButton'){await verifyAge();return;}
        if(el.id==='sendMinorAccessRequest'){await sendMinorSensitiveRequest();return;}
        if(el.id==='sensitivePermissionButton'){await toggleSensitivePermission();return;}
        if(el.id==='resendVerify'){
          if(!state.firebaseReady||!isMember()){ui.toast('Entre na conta e conecte ao Firebase para continuar.');return;}
          if(state.user?.emailVerified){ui.toast('Seu e-mail já está confirmado.');return;}
          await sendEmailVerification(state.user);ui.toast('E-mail de confirmação reenviado.');return;
        }
        if(el.id==='resetOwnPassword'){
          if(!state.firebaseReady||!isMember()||!state.user?.email){ui.toast('Não há um e-mail disponível para alterar a senha.');return;}
          await sendPasswordResetEmail(auth,state.user.email);ui.toast('E-mail para alterar a senha enviado.');return;
        }
      }catch(err){console.error('Ação das configurações:',err);ui.toast('Não foi possível concluir esta ação agora. Tente novamente.');}
    }
    function setSettingsToggleRow(row,next){
      if(!row)return false;const id=String(row.dataset.settingsToggle||''),input=id?document.getElementById(id):null;if(!input||input.disabled)return false;
      input.checked=!!next;row.setAttribute('aria-checked',input.checked?'true':'false');
      input.dispatchEvent(new Event('input',{bubbles:true}));input.dispatchEvent(new Event('change',{bubbles:true}));
      return true;
    }
    function settingsToggleCapture(e){
      const row=e.target?.closest?.('[data-settings-toggle]');if(!row)return;
      if(!row.closest("[data-page='settings-detail'],[data-page='settings'],[data-page='age-settings'],[data-page='sensitive-settings']"))return;
      e.preventDefault();e.stopImmediatePropagation();
      const id=String(row.dataset.settingsToggle||''),input=id?document.getElementById(id):null;if(!input||input.disabled)return;
      const next=!input.checked;if(!setSettingsToggleRow(row,next))return;
      if(router.current()?.sub==='acessibilidade')setAccessibilityStatus((next?'Ativado: ':'Desativado: ')+(row.querySelector('.settings-option-copy strong')?.textContent||'opção')+'.','saved');
      try{if(next&&id!=='hapticsSetting'&&getAppSettings().haptics&&navigator.vibrate)navigator.vibrate(7);}catch(_e){}
    }
    function settingsToggleKeydown(e){
      const row=e.target?.closest?.('[data-settings-toggle]');if(!row||!(e.key==='Enter'||e.key===' '))return;
      if(!row.closest("[data-page='settings-detail'],[data-page='settings'],[data-page='age-settings'],[data-page='sensitive-settings']"))return;
      e.preventDefault();e.stopImmediatePropagation();
      const id=String(row.dataset.settingsToggle||''),input=id?document.getElementById(id):null;if(!input||input.disabled)return;
      setSettingsToggleRow(row,!input.checked);
    }
    function settingsRouteCapture(e){
      const route=e.target?.closest?.("[data-page='settings'] [data-route],[data-page='settings-detail'] [data-route],[data-page='age-settings'] [data-route],[data-page='sensitive-settings'] [data-route]");
      if(!route)return;e.preventDefault();e.stopImmediatePropagation();router.navigate(route.getAttribute('data-route'));
    }

    function readerDefaults(){return {width:100,gap:0,mode:'vertical',page:0,fit:'screen',direction:'ltr',brightness:100,contrast:100,grayscale:0,warmth:0,background:'black',progress:'show',keepAwake:false,uiMode:'stable',tapControls:'off',tapZones:'on',keyboard:'on',transition:'fade',zoom:100,resume:'on',preload:'2',scrollSpeed:2};}
    function appearanceDraftFromControls(base=getAppSettings()){return {...base,appearanceGlow:num($('#appearanceGlowSetting')?.value)||0,appearanceAmbient:num($('#appearanceAmbientSetting')?.value)||0,appearanceCardOpacity:num($('#appearanceCardOpacitySetting')?.value)||92,appearanceGlassBlur:num($('#appearanceGlassBlurSetting')?.value)||0,appearanceBackgroundDim:num($('#appearanceBackgroundDimSetting')?.value)||0,appearanceBackgroundBlur:num($('#appearanceBackgroundBlurSetting')?.value)||0,appearanceBgFit:$('#appearanceBgFitSetting')?.value||base.appearanceBgFit||'cover',appearanceBgPosition:$('#appearanceBgPositionSetting')?.value||base.appearanceBgPosition||'center',ambientMotion:$('#ambientMotionSetting')?.checked??base.ambientMotion,glassUi:$('#glassUiSetting')?.checked??base.glassUi,glowingUi:$('#glowingUiSetting')?.checked??base.glowingUi,shinyUi:$('#shinyUiSetting')?.checked??base.shinyUi,customAccent:safeAppearanceColor($('#appearanceAccentPrimary')?.value,base.customAccent||'#7b4dff'),customAccent2:safeAppearanceColor($('#appearanceAccentSecondary')?.value,base.customAccent2||'#ff5aa5'),appearanceGlowColor:safeAppearanceColor($('#appearanceGlowColor')?.value,base.appearanceGlowColor||'#9d7cff')};}
    function previewAppearanceFromControls(){if(router.current()?.sub!=='aparencia')return;const draft=appearanceDraftFromControls();applyAppSettings(draft);const img=$('#appearanceBackgroundPreview img'),live=$('#appearanceLiveBackground img');for(const el of [img,live].filter(Boolean)){el.style.objectFit=draft.appearanceBgFit==='contain'?'contain':'cover';el.style.objectPosition=draft.appearanceBgPosition||'center';}}
    let accessibilitySaveTimer=null;
    const ACCESSIBILITY_SETTING_MAP={readableFontSetting:'readableFont',highContrastSetting:'highContrast',largeTargetsSetting:'largeTargets',reduceMotionSetting:'reduceMotion',hapticsSetting:'haptics'};
    function accessibilityButtonValue(id,fallback=false){const b=document.querySelector('[data-accessibility-toggle="'+id+'"]');return b?b.getAttribute('aria-pressed')==='true':!!fallback;}
    function accessibilityDraftFromControls(base=getAppSettings()){return {...base,textScale:Math.max(90,Math.min(130,num($('#uiTextScaleSetting')?.value)||100)),readableFont:accessibilityButtonValue('readableFontSetting',base.readableFont),highContrast:accessibilityButtonValue('highContrastSetting',base.highContrast),largeTargets:accessibilityButtonValue('largeTargetsSetting',base.largeTargets),reduceMotion:accessibilityButtonValue('reduceMotionSetting',base.reduceMotion),haptics:accessibilityButtonValue('hapticsSetting',base.haptics)};}
    function setAccessibilityStatus(text,kind=''){const st=$('#accessibilitySaveStatus');if(!st)return;st.textContent=text;st.className='accessibility-save-status'+(kind?' '+kind:'');}
    function syncAccessibilityNativeRows(){document.querySelectorAll('[data-accessibility-toggle]').forEach(row=>{const id=row.dataset.accessibilityToggle||'',on=row.getAttribute('aria-pressed')==='true',stateEl=id?document.querySelector('[data-accessibility-state="'+id+'"]'):null;row.classList.toggle('is-on',on);row.setAttribute('aria-label',(row.querySelector('.settings-option-copy strong')?.textContent||'Opção')+': '+(on?'ativado':'desativado'));if(stateEl)stateEl.textContent=on?'Ativado':'Desativado';});}
    function previewAccessibilityFromControls(){if(router.current()?.sub!=='acessibilidade')return;const draft=accessibilityDraftFromControls();try{localStorage.setItem('mp_app_settings',JSON.stringify(draft));}catch(_e){}if(state.profile&&!state.user?.isAnonymous)state.profile={...state.profile,appSettings:draft};applyAppSettings(draft);updateSettingsHome();syncAccessibilityNativeRows();setAccessibilityStatus('Alterações aplicadas. Salvando…','saving');if(draft.reduceMotion){try{if(window.__mpHeroTimer){clearInterval(window.__mpHeroTimer);window.__mpHeroTimer=null;}}catch(_e){}}}
    function accessibilityToggleCapture(e){const btn=e.target?.closest?.('[data-accessibility-toggle]');if(!btn||router.current()?.sub!=='acessibilidade')return;e.preventDefault();e.stopImmediatePropagation();const id=String(btn.dataset.accessibilityToggle||''),key=ACCESSIBILITY_SETTING_MAP[id];if(!key)return;const next=btn.getAttribute('aria-pressed')!=='true';btn.setAttribute('aria-pressed',next?'true':'false');btn.classList.toggle('is-on',next);const stateEl=document.querySelector('[data-accessibility-state="'+id+'"]');if(stateEl)stateEl.textContent=next?'Ativado':'Desativado';const base=getAppSettings(),patch={...base,[key]:next,textScale:Math.max(90,Math.min(130,num($('#uiTextScaleSetting')?.value)||base.textScale||100))};try{localStorage.setItem('mp_app_settings',JSON.stringify(patch));}catch(_e){}if(state.profile&&!state.user?.isAnonymous)state.profile={...state.profile,appSettings:patch};applyAppSettings(patch);updateSettingsHome();setAccessibilityStatus((next?'Ativado: ':'Desativado: ')+(btn.querySelector('.settings-option-copy strong')?.textContent||'opção')+'.','saved');scheduleAccessibilitySave();try{if(next&&key!=='haptics'&&patch.haptics&&typeof navigator?.vibrate==='function')navigator.vibrate(7);}catch(_e){}}
    function scheduleAccessibilitySave(){if(router.current()?.sub!=='acessibilidade')return;clearTimeout(accessibilitySaveTimer);const draft=accessibilityDraftFromControls();accessibilitySaveTimer=setTimeout(async()=>{try{await saveAppSettings(draft);setAccessibilityStatus(state.firebaseReady&&isMember()?'Acessibilidade salva e sincronizada.':'Acessibilidade salva neste aparelho.','saved');}catch(err){console.error('Acessibilidade: falha ao salvar',err);setAccessibilityStatus('Aplicado neste aparelho, mas não foi possível sincronizar agora.','error');}},420);}
    function settingsGlobalInput(e){const el=e.target;if(el?.id==='settingsSearch'){filterSettingsHome();return;}const labels={readerWidthSetting:['#readerWidthValue','%'],readerGapSetting:['#readerGapValue','px'],readerZoomSetting:['#readerZoomValue','%'],readerBrightnessSetting:['#readerBrightnessValue','%'],readerContrastSetting:['#readerContrastValue','%'],readerGraySetting:['#readerGrayValue','%'],readerWarmSetting:['#readerWarmValue','%'],uiTextScaleSetting:['#uiTextScaleValue','%'],appearanceGlowSetting:['#appearanceGlowValue','%'],appearanceAmbientSetting:['#appearanceAmbientValue','%'],appearanceCardOpacitySetting:['#appearanceCardOpacityValue','%'],appearanceGlassBlurSetting:['#appearanceGlassBlurValue','px'],appearanceBackgroundDimSetting:['#appearanceBackgroundDimValue','%'],appearanceBackgroundBlurSetting:['#appearanceBackgroundBlurValue','px']};const pair=labels[el?.id];if(pair){const out=$(pair[0]);if(out)out.textContent=el.value+pair[1];}if(el?.id&&(/^appearance/.test(el.id)||['ambientMotionSetting','glassUiSetting','glowingUiSetting','shinyUiSetting'].includes(el.id)))previewAppearanceFromControls();if(el?.id==='uiTextScaleSetting'){previewAccessibilityFromControls();scheduleAccessibilitySave();return;}}
    function settingsGlobalChange(e){const el=e.target;if(!el)return;}
    async function settingsGlobalClick(e){const el=e.target.closest?.('button');if(!el)return;const id=el.id;if(!id)return;
      const handled=['saveAppearanceSettings','resetAppearanceEffects','useCustomPalette','appearanceBgPick','appearanceBgRemove','saveReaderSetting','resetReaderDefaults','saveNotificationSettings','settingsMarkAllRead','savePrivacySetting','settingsLogout','saveDataSettings','clearAllDownloadsSetting','clearReadingHistorySetting','saveAccessibilitySettings','resetAccessibilitySettings','testAccessibilityHaptics','accessibilityPreviewButton','saveRegionSettings'];if(!handled.includes(id))return;e.preventDefault();e.stopImmediatePropagation();
      try{
      if(id==='saveAppearanceSettings'){const draft=appearanceDraftFromControls();const custom={accent:safeAppearanceColor(draft.customAccent,'#7b4dff'),accent2:safeAppearanceColor(draft.customAccent2,'#ff5aa5')};try{localStorage.setItem('mp_custom_palette',JSON.stringify(custom));}catch(_e){}await saveAppSettings({...draft,heroAutoRotate:!!$('#heroAutoRotateSetting')?.checked,compactMode:!!$('#compactModeSetting')?.checked});if(document.documentElement.dataset.palette==='custom')ui.setPalette?.('custom');renderHomeHero();ui.toast('Aparência salva.');return;}
      if(id==='useCustomPalette'){const draft=appearanceDraftFromControls();try{localStorage.setItem('mp_custom_palette',JSON.stringify({accent:draft.customAccent,accent2:draft.customAccent2}));localStorage.setItem('mp_palette','custom');}catch(_e){}ui.setPalette?.('custom');applyAppSettings(draft);ui.toast('Suas cores estão em uso.');return;}
      if(id==='appearanceBgPick'){const input=$('#appearanceBackgroundFile');try{input?.showPicker?input.showPicker():input?.click();}catch(_e){input?.click();}return;}
      if(id==='appearanceBgRemove'){saveAppearanceBackground('');applyAppSettings(appearanceDraftFromControls());const pv=$('#appearanceBackgroundPreview'),live=$('#appearanceLiveBackground'),input=$('#appearanceBackgroundFile');if(pv)pv.textContent='Nenhuma imagem de fundo selecionada.';if(live)live.innerHTML='';if(input)input.value='';$('#appearanceBgRemove')?.classList.add('hidden');if($('#appearanceBackgroundStatus'))$('#appearanceBackgroundStatus').textContent='Imagem de fundo removida deste aparelho.';ui.toast('Fundo personalizado removido.');return;}
      if(id==='resetAppearanceEffects'){const d=defaultAppSettings(),ids={appearanceGlowSetting:d.appearanceGlow,appearanceAmbientSetting:d.appearanceAmbient,appearanceCardOpacitySetting:d.appearanceCardOpacity,appearanceGlassBlurSetting:d.appearanceGlassBlur,appearanceBackgroundDimSetting:d.appearanceBackgroundDim,appearanceBackgroundBlurSetting:d.appearanceBackgroundBlur};for(const [key,val] of Object.entries(ids)){const inp=$('#'+key);if(inp){inp.value=val;inp.dispatchEvent(new Event('input',{bubbles:true}));}}if($('#ambientMotionSetting'))$('#ambientMotionSetting').checked=d.ambientMotion;if($('#glassUiSetting'))$('#glassUiSetting').checked=d.glassUi;if($('#glowingUiSetting'))$('#glowingUiSetting').checked=d.glowingUi;if($('#shinyUiSetting'))$('#shinyUiSetting').checked=d.shinyUi;previewAppearanceFromControls();ui.toast('Efeitos visuais restaurados.');return;}
      if(id==='saveReaderSetting'){const r=readerSettings();r.width=num($('#readerWidthSetting')?.value)||100;r.gap=num($('#readerGapSetting')?.value);r.zoom=num($('#readerZoomSetting')?.value)||100;r.mode=$('#readerModeSetting')?.value||'vertical';r.direction=$('#readerDirectionSetting')?.value||'ltr';r.brightness=num($('#readerBrightnessSetting')?.value)||100;r.contrast=num($('#readerContrastSetting')?.value)||100;r.grayscale=num($('#readerGraySetting')?.value);r.warmth=num($('#readerWarmSetting')?.value);r.background=$('#readerBackgroundSetting')?.value||'black';r.resume=$('#readerResumeSetting')?.checked?'on':'off';r.progress=$('#readerProgressSetting')?.checked?'show':'hide';r.tapZones=$('#readerTapZonesSetting')?.checked?'on':'off';r.keyboard=$('#readerKeyboardSetting')?.checked?'on':'off';r.keepAwake=!!$('#readerWakeSetting')?.checked;r.preload=$('#readerPreloadSetting')?.value||'2';r.transition=$('#readerTransitionSetting')?.value||'fade';saveReaderSettings(r);applyReaderVisualSettings(r);ui.toast('Preferências do leitor salvas.');updateSettingsHome();return;}
      if(id==='resetReaderDefaults'){if(!confirm('Restaurar as configurações do leitor para o padrão?'))return;const r=readerDefaults();saveReaderSettings(r);applyReaderVisualSettings(r);await renderSettingsDetail('leitor');ui.toast('Leitor restaurado.');return;}
      if(id==='saveNotificationSettings'){await saveAppSettings({notifyReply:!!$('#notifyReplySetting')?.checked,notifyReaction:!!$('#notifyReactionSetting')?.checked,notifyFollower:!!$('#notifyFollowerSetting')?.checked,notifyChapter:!!$('#notifyChapterSetting')?.checked,notifyAdmin:!!$('#notifyAdminSetting')?.checked,showNotificationBadge:!!$('#notificationBadgeSetting')?.checked,autoMarkNotifications:!!$('#autoMarkNotificationsSetting')?.checked});ui.toast('Notificações atualizadas.');return;}
      if(id==='settingsMarkAllRead'){await markAllNotifications();renderNotifications();updateNotificationBadge();ui.toast('Notificações marcadas como lidas.');return;}
      if(id==='savePrivacySetting'){if(!state.firebaseReady||!requireMember())return;const publico=!$('#privacyToggle')?.checked,showFav=!!$('#showFavoritesPublicSetting')?.checked;await saveAppSettings({showFavoritesPublic:showFav});await dbUpdate('usuarios/'+state.user.uid,{publico});state.profile.publico=publico;await syncPublicProfile(state.user.uid,state.profile);updateSettingsHome();ui.toast('Privacidade atualizada.');return;}
      if(id==='settingsLogout'){if(isMember()){await signOut(auth);router.navigate('/inicio');ui.toast('Você saiu da conta.');}return;}
      if(id==='saveDataSettings'){await saveAppSettings({dataSaver:!!$('#dataSaverSetting')?.checked});ui.toast('Preferências de dados salvas.');return;}
      if(id==='clearAllDownloadsSetting'){if(!confirm('Apagar todos os capítulos baixados neste aparelho?'))return;try{const list=await offlineAll();for(const item of list)await offlineDelete(item.key);ui.toast('Downloads apagados deste aparelho.');await renderSettingsDetail('dados');}catch(err){ui.toast('Não foi possível limpar os downloads.');}return;}
      if(id==='clearReadingHistorySetting'){if(!isMember()||!confirm('Limpar todo o histórico de leitura desta conta?'))return;try{await dbRemove('historico_leitura/'+state.user.uid);state.history={};renderHome();renderLibrary();ui.toast('Histórico de leitura limpo.');await renderSettingsDetail('dados');}catch(err){ui.toast('Não foi possível limpar o histórico.');}return;}
      if(id==='accessibilityPreviewButton'){ui.toast('Botão de exemplo funcionando.');return;}if(id==='testAccessibilityHaptics'){if(typeof navigator?.vibrate!=='function'){ui.toast('Este navegador não oferece vibração.');return;}const ok=navigator.vibrate([25,35,25]);ui.toast(ok===false?'O aparelho não aceitou a vibração.':'Teste de vibração enviado.');return;}if(id==='resetAccessibilitySettings'){if(!confirm('Restaurar as opções de acessibilidade para o padrão?'))return;clearTimeout(accessibilitySaveTimer);const d=defaultAppSettings(),patch={textScale:d.textScale,readableFont:d.readableFont,highContrast:d.highContrast,largeTargets:d.largeTargets,reduceMotion:d.reduceMotion,haptics:d.haptics};await saveAppSettings(patch);await renderSettingsDetail('acessibilidade');setAccessibilityStatus('Acessibilidade restaurada para o padrão.','saved');ui.toast('Acessibilidade restaurada.');return;}if(id==='saveAccessibilitySettings'){clearTimeout(accessibilitySaveTimer);const patch=accessibilityDraftFromControls();setAccessibilityStatus('Salvando acessibilidade…','saving');await saveAppSettings(patch);setAccessibilityStatus(state.firebaseReady&&isMember()?'Acessibilidade salva e sincronizada.':'Acessibilidade salva neste aparelho.','saved');ui.toast('Acessibilidade salva.');return;}
      if(id==='saveRegionSettings'){await saveAppSettings({dateStyle:$('#dateStyleSetting')?.value||'relative'});ui.toast('Formato de data salvo.');return;}
    
      }catch(err){console.error('Configurações: ação falhou',id,err);ui.toast('Não foi possível salvar essa configuração agora. Tente novamente.');}
