if(el=g('[data-approve-minor-sensitive]')){if(!isAdmin())return;const uid=el.dataset.approveMinorSensitive;await dbUpdate('usuarios/'+uid,{minorSensitiveApproved:true,minorSensitiveRequestStatus:'approved',sensivelPermitido:false});await dbUpdate('pedidosAcessoSensivel/'+uid,{status:'approved',respondidoEm:now(),respondidoPor:state.user.uid});ui.toast('Permissão para conteúdo sensível apropriado aprovada.');await renderAdminUsers($('#adminDynamic'));return;}
if(el=g('[data-deny-minor-sensitive]')){if(!isAdmin())return;const uid=el.dataset.denyMinorSensitive;await dbUpdate('usuarios/'+uid,{minorSensitiveApproved:false,minorSensitiveRequestStatus:'denied',sensivelPermitido:false});await dbUpdate('pedidosAcessoSensivel/'+uid,{status:'denied',respondidoEm:now(),respondidoPor:state.user.uid});ui.toast('Pedido recusado.');await renderAdminUsers($('#adminDynamic'));return;}
if(el=g('[data-revoke-minor-sensitive]')){if(!isAdmin())return;const uid=el.dataset.revokeMinorSensitive;await dbUpdate('usuarios/'+uid,{minorSensitiveApproved:false,minorSensitiveRequestStatus:'denied',sensivelPermitido:false});await dbUpdate('pedidosAcessoSensivel/'+uid,{status:'denied',respondidoEm:now(),respondidoPor:state.user.uid});ui.toast('Permissão removida.');await renderAdminUsers($('#adminDynamic'));return;}if(el=g('[data-toggle-sensitive]')){e.preventDefault();await toggleSensitivePermission();return;}if(el=g('#saveSensitiveSettingStable')){e.preventDefault();if(!state.firebaseReady){ui.toast('Conecte ao Firebase para salvar esta preferência.');return;}if(!requireMember()||!state.profile?.ageVerified)return;const v=!!state.profile?.sensivelPermitido;await dbUpdate('usuarios/'+state.user.uid,{sensivelPermitido:v});state.profile.sensivelPermitido=v;refreshVisibleWorks();renderAll();updateSensitiveSettingsUI();ui.toast('Preferência salva.');return;}if(el=g('#saveSensitiveSetting')){if(!state.firebaseReady){ui.toast('Conecte ao Firebase para salvar esta preferência.');return;}if(!requireMember()||!state.profile?.ageVerified)return;const v=!!state.profile?.sensivelPermitido;await dbUpdate('usuarios/'+state.user.uid,{sensivelPermitido:v});state.profile.sensivelPermitido=v;refreshVisibleWorks();renderAll();ui.toast('Preferência salva.');return;}if(el=g('#resendVerify')){if(state.firebaseReady&&isMember()&&!state.user.emailVerified){try{await sendEmailVerification(state.user);ui.toast('E-mail de confirmação reenviado.');}catch(err){ui.toast('Não foi possível reenviar agora.');}}return;}if(el=g('#resetOwnPassword')){if(state.firebaseReady&&isMember()&&state.user?.email){try{await sendPasswordResetEmail(auth,state.user.email);ui.toast('E-mail para alterar a senha enviado.');}catch(err){ui.toast('Não foi possível enviar agora.');}}return;}}

    async function globalChange(e){const changed=e.target;if(changed?.id==='appearanceBackgroundFile'){const f=changed.files?.[0];if(!f)return;if(f.size>20*1024*1024){ui.toast('A foto de fundo precisa ter até 20 MB antes da otimização.');changed.value='';return;}const status=$('#appearanceBackgroundStatus');try{if(status)status.textContent='Otimizando a imagem de fundo…';const data=await prepareUiImage(f,'background');if(!saveAppearanceBackground(data)){if(status)status.textContent='A imagem ficou grande demais para o armazenamento deste navegador.';ui.toast('Não foi possível salvar esta imagem. Escolha uma foto menor.');return;}const pv=$('#appearanceBackgroundPreview'),live=$('#appearanceLiveBackground');if(pv)pv.innerHTML="<img src='"+escapeAttr(data)+"' alt='Prévia do fundo personalizado'/>";if(live)live.innerHTML="<img src='"+escapeAttr(data)+"' alt=''/>";$('#appearanceBgRemove')?.classList.remove('hidden');if(status)status.textContent=f.name+' • fundo otimizado, salvo neste aparelho e pronto para uso.';applyAppSettings(appearanceDraftFromControls());ui.toast('Foto de fundo aplicada.');}catch(err){console.error(err);if(status)status.textContent='Não foi possível preparar esta imagem.';ui.toast('Não foi possível usar essa foto de fundo.');}return;}if(changed?.id==='collectionCoverFile'){const f=changed.files?.[0];if(!f)return;if(f.size>20*1024*1024){ui.toast('Capa muito grande. Escolha uma imagem de até 20 MB.');changed.value='';return;}const url=URL.createObjectURL(f);updateCollectionCoverPreview(url);$('#collectionCoverStatus').textContent=f.name+' • '+(f.size/1024/1024).toFixed(2)+' MB';$('#removeCollectionCover').classList.remove('hidden');window.__removeCollectionCover=false;return;}if(changed?.id==='editProfilePhoto'||changed?.id==='editProfileCover'){const f=changed.files?.[0];if(!f)return;const isPhoto=changed.id==='editProfilePhoto',max=isPhoto?12*1024*1024:20*1024*1024;if(f.size>max){ui.toast((isPhoto?'Foto':'Capa')+' muito grande. Limite para selecionar: '+(isPhoto?'12':'20')+' MB.');changed.value='';return;}const url=URL.createObjectURL(f),preview=$(isPhoto?'#profilePhotoPreview':'#profileCoverPreview'),status=$(isPhoto?'#profilePhotoStatus':'#profileCoverStatus');if(preview){preview.dataset.preview='1';preview.innerHTML="<img src='"+url+"' alt='Prévia'/>";}if(status)status.textContent=f.name+' • '+(f.size/1024/1024).toFixed(2)+' MB • será otimizada para o perfil';if(isPhoto)window.__removeProfilePhoto=false;else window.__removeProfileCover=false;return;}if(e.target?.matches?.('[data-reader-range]')){const d=window.__readerPages;if(d){const key=e.target.dataset.readerRange;d.s[key]=num(e.target.value);saveReaderSettings(d.s);applyReaderVisualSettings(d.s);if(key==='zoom')renderReaderPages(d.pages,d.workId,d.id,d.c,d.s);syncReaderSheetUI(d.s);}return;}if(e.target?.matches?.('[data-comment-image]')){const box=e.target.closest('[data-comment-composer]'),name=box?.querySelector('[data-comment-file-name]'),f=e.target.files?.[0],key=commentKeyFromBox(box);if(key){if(f)state.commentFiles[key]=f;else delete state.commentFiles[key];state.commentLocks[key]=true;}if(name)name.textContent=f?'Imagem: '+f.name:'';return;}const el=e.target;if(el.id&&(/^appearance/.test(el.id)||['ambientMotionSetting','glassUiSetting','glowingUiSetting','shinyUiSetting'].includes(el.id))){previewAppearanceFromControls();}if(el.id==='workCoverFile'){previewAdminSingle(el,'#workCoverPreview','#workCoverStatus','Capa selecionada');return;}if(el.id==='workBannerFile'){previewAdminSingle(el,'#workBannerPreview','#workBannerStatus','Banner selecionado');return;}if(el.id==='chapterFiles'){handleChapterFiles(el);return;}if(el.matches('[data-user-role]')){if(!isAdmin())return;const uid=el.dataset.userRole,val=el.value;await dbUpdate('usuarios/'+uid,{papel:val,admin:val==='ADM'});ui.toast('Permissão atualizada.');}if(el.id==='readerWidthSetting')$('#readerWidthValue').textContent=el.value+'%';if(el.id==='readerGapSetting')$('#readerGapValue').textContent=el.value+'px';}

    async function sendComment(btn){
      if(!requireCommentMember())return;
      const box=btn.closest('[data-comment-composer]'),key=commentKeyFromBox(box),textEl=box?.querySelector('[data-comment-text]'),imageEl=box?.querySelector('[data-comment-image]'),spoilerEl=box?.querySelector('[data-comment-spoiler]'),statusEl=box?.querySelector('[data-comment-send-state]'),text=(textEl?.value||state.commentDrafts[key]||'').trim(),file=imageEl?.files?.[0]||state.commentFiles[key],spoiler=!!(spoilerEl?.checked||state.commentSpoilers[key]);
      if(key)state.commentLocks[key]=true;
      if(!text&&!file){ui.toast('Escreva algo ou escolha uma imagem.');textEl?.focus();return;}
      if(file&&file.size>10*1024*1024){ui.toast('A imagem do comentário precisa ter até 10 MB antes da otimização.');if(statusEl)statusEl.textContent='Escolha uma imagem menor.';return;}
      try{
        btn.disabled=true;btn.textContent='Enviando...';if(statusEl)statusEl.textContent='Publicando seu comentário...';
        // O comentário não espera a sincronização do perfil público; isso evita travar o envio.
        syncPublicProfile(state.user.uid,state.profile||{}).catch(err=>console.warn('Perfil público no comentário:',err));
        const image=file?await prepareCommentImage(file):'',path=commentPath(btn.dataset.commentType,btn.dataset.workId,btn.dataset.chapterId),p=push(pathRef(path));
        const payload={uid:state.user.uid,data:now(),texto:text,imagemUrl:image,spoiler};
        await set(p,payload);
        invalidateCommentLeaderboard();
        if(textEl)textEl.value='';if(imageEl)imageEl.value='';
        if(key){delete state.commentDrafts[key];delete state.commentFiles[key];delete state.commentSpoilers[key];state.commentLocks[key]=false;}
        const fn=box?.querySelector('[data-comment-file-name]');if(fn)fn.textContent='';
        if(spoilerEl)spoilerEl.checked=false;
        const spoilerBtn=box?.querySelector('[data-toggle-comment-spoiler]');if(spoilerBtn){spoilerBtn.classList.remove('active');spoilerBtn.textContent='⚠ Spoiler: desligado';}
        if(statusEl)statusEl.textContent='Comentário publicado.';
        ui.toast('Comentário enviado.');
        await renderComments(btn.dataset.commentType,btn.dataset.workId,btn.dataset.chapterId,btn.dataset.commentType==='obra'?'#workComments':'#chapterComments');
      }catch(e){
        console.error('sendComment',e);
        const code=String(e?.code||e?.message||'');
        let msg='Não foi possível publicar. Tente novamente.';
        if(/permission|denied/i.test(code))msg='O Firebase recusou o comentário pelas permissões da conta.';
        else if(/network|offline|connection/i.test(code))msg='Sem conexão suficiente para publicar agora.';
        if(statusEl)statusEl.textContent=msg;ui.toast(msg);
      }finally{btn.disabled=false;btn.textContent='Enviar';if(key&&!(state.commentDrafts[key]||state.commentFiles[key]||state.commentSpoilers[key]))state.commentLocks[key]=false;}
    }
    async function reactComment(btn){if(!requireCommentMember())return;try{const base=commentPath(btn.dataset.commentType,btn.dataset.workId,btn.dataset.chapterId)+'/'+btn.dataset.reactComment+'/reacoes/'+state.user.uid,current=await dbGet(base);if(current?.tipo===btn.dataset.reaction)await dbRemove(base);else await dbSet(base,{tipo:btn.dataset.reaction,data:now()});if(btn.dataset.owner!==state.user.uid)await sendNotification(btn.dataset.owner,{tipo:'reaction',titulo:'Reação no seu comentário',texto:(state.profile?.nome||'Alguém')+' reagiu '+btn.dataset.reaction+' ao seu comentário.',link:btn.dataset.commentType==='obra'?'/obra/'+btn.dataset.workId:'/capitulo/'+btn.dataset.workId+'/'+btn.dataset.chapterId});await renderComments(btn.dataset.commentType,btn.dataset.workId,btn.dataset.chapterId,btn.dataset.commentType==='obra'?'#workComments':'#chapterComments');}catch(e){console.error(e);ui.toast('Não foi possível reagir agora.');}}
    function inlineReplyDraftKey(type,workId,chapterId,commentId){return ['reply',type||'',workId||'',chapterId||'',commentId||''].join('|');}
    function inlineReplyDraftStore(){state.inlineReplyDrafts=state.inlineReplyDrafts||{};return state.inlineReplyDrafts;}
    function inlineReplyMetaFromButton(btn,replyToName=''){
      const commentId=String(btn?.dataset?.replyComment||btn?.dataset?.replyToReply||btn?.dataset?.sendInlineReply||'');
      return {type:String(btn?.dataset?.commentType||''),workId:String(btn?.dataset?.workId||''),chapterId:String(btn?.dataset?.chapterId||''),commentId,owner:String(btn?.dataset?.owner||''),replyToName:String(replyToName||btn?.dataset?.replyName||'').replace(/^@/,'')};
    }
    function mountInlineReplyComposer(box,meta,focus=true){
      if(!box||!meta?.commentId)return;
      const key=inlineReplyDraftKey(meta.type,meta.workId,meta.chapterId,meta.commentId),store=inlineReplyDraftStore(),old=store[key]||{};
      const prefix=meta.replyToName?'@'+meta.replyToName+' ':'';
      const text=old.text!==undefined?String(old.text):prefix;
      const draft={...old,...meta,text,open:true};store[key]=draft;
      box.dataset.inlineReplyKey=key;box.classList.remove('hidden');
      box.innerHTML="<div class='inline-reply-label'>"+(meta.replyToName?'Respondendo a @'+escapeHtml(meta.replyToName):'Escreva sua resposta')+"</div><textarea class='inline-reply-text' data-inline-reply-text='true' placeholder='Escreva uma resposta...' maxlength='3000'>"+escapeHtml(text)+"</textarea><div class='inline-action-row'><button type='button' class='inline-mini-btn' data-cancel-inline='true'>Cancelar</button><button type='button' class='inline-mini-btn primary' data-send-inline-reply='"+escapeAttr(meta.commentId)+"' data-comment-type='"+escapeAttr(meta.type)+"' data-work-id='"+escapeAttr(meta.workId)+"' data-chapter-id='"+escapeAttr(meta.chapterId)+"' data-owner='"+escapeAttr(meta.owner)+"'>Responder</button></div><div class='inline-reply-state' aria-live='polite'></div>";
      if(focus)setTimeout(()=>{const t=box.querySelector('[data-inline-reply-text]');if(t){try{t.focus({preventScroll:true});}catch(_e){t.focus();}const len=t.value.length;try{t.setSelectionRange(len,len);}catch(_e){}}},30);
    }
    function openReplyComposer(btn,replyToName=''){
      if(!requireCommentMember())return;
      const article=btn?.closest?.('.comment-v2');if(!article)return;
      const box=article.querySelector('.inline-reply-composer');if(!box)return;
      const meta=inlineReplyMetaFromButton(btn,replyToName);
      article.querySelectorAll('.inline-edit-box').forEach(x=>{x.innerHTML='';x.classList.add('hidden');});
      mountInlineReplyComposer(box,meta,true);
      try{box.scrollIntoView({block:'nearest',behavior:'smooth'});}catch(_e){}
    }
    function cancelInlineReply(btn){
      const box=btn?.closest?.('.inline-reply-composer');if(!box)return;
      const key=box.dataset.inlineReplyKey;if(key&&state.inlineReplyDrafts)delete state.inlineReplyDrafts[key];
      box.innerHTML='';box.classList.add('hidden');delete box.dataset.inlineReplyKey;
    }
    function restoreInlineReplyDrafts(root,type,workId,chapterId){
      if(!root||!state.inlineReplyDrafts)return;
      const drafts=Object.values(state.inlineReplyDrafts).filter(d=>d&&d.open&&String(d.type)===String(type||'')&&String(d.workId)===String(workId||'')&&String(d.chapterId||'')===String(chapterId||''));
      if(!drafts.length)return;
      const articles=[...root.querySelectorAll('.comment-v2')];
      drafts.forEach(d=>{const article=articles.find(a=>String(a.dataset.commentId||'')===String(d.commentId||'')),box=article?.querySelector('.inline-reply-composer');if(box)mountInlineReplyComposer(box,d,false);});
    }
    function wireCommentInteractionRoot(root){
      if(!root||root.dataset.commentInteractionsV45==='1')return;root.dataset.commentInteractionsV45='1';
      root.addEventListener('click',async e=>{
        const g=q=>e.target?.closest?.(q);let el;
        if(el=g('[data-comment-spoiler-reveal]')){e.preventDefault();e.stopPropagation();const shell=el.closest('[data-comment-spoiler]');if(shell){shell.classList.remove('is-hidden');shell.classList.add('revealed');el.setAttribute('aria-expanded','true');}return;}
        if(el=g('[data-reply-comment]')){e.preventDefault();e.stopPropagation();openReplyComposer(el);return;}
        if(el=g('[data-reply-to-reply]')){e.preventDefault();e.stopPropagation();openReplyComposer(el,el.dataset.replyName||'');return;}
        if(el=g('[data-send-inline-reply]')){e.preventDefault();e.stopPropagation();await sendInlineReply(el);return;}
        if(el=g('[data-cancel-inline]')){const box=el.closest('.inline-reply-composer');if(box){e.preventDefault();e.stopPropagation();cancelInlineReply(el);return;}}
      });
      root.addEventListener('input',e=>{
        const text=e.target?.closest?.('[data-inline-reply-text]');if(!text)return;
        const box=text.closest('.inline-reply-composer'),key=box?.dataset.inlineReplyKey;if(!key)return;
        const store=inlineReplyDraftStore();if(store[key])store[key].text=text.value;
      });
    }
    async function sendInlineReply(btn){
      if(!requireCommentMember())return;
      const box=btn?.closest?.('.inline-reply-composer'),text=box?.querySelector('[data-inline-reply-text]')?.value.trim(),status=box?.querySelector('.inline-reply-state');
      if(!text){ui.toast('Escreva uma resposta.');box?.querySelector('[data-inline-reply-text]')?.focus();return;}
      if(text.length>3000){ui.toast('A resposta está muito grande.');return;}
      const oldLabel=btn.textContent;btn.disabled=true;btn.textContent='Enviando…';if(status)status.textContent='Enviando sua resposta…';
      const base=commentPath(btn.dataset.commentType,btn.dataset.workId,btn.dataset.chapterId)+'/'+btn.dataset.sendInlineReply+'/respostas',p=push(pathRef(base));
      try{await set(p,{uid:state.user.uid,data:now(),texto:text,imagemUrl:'',spoiler:false,reacoes:{}});invalidateCommentLeaderboard();}catch(e){console.error('sendInlineReply',e);if(status)status.textContent='Não foi possível enviar. Tente novamente.';ui.toast('Não foi possível responder agora.');btn.disabled=false;btn.textContent=oldLabel||'Responder';return;}
      const key=box?.dataset.inlineReplyKey;if(key&&state.inlineReplyDrafts)delete state.inlineReplyDrafts[key];
      if(status)status.textContent='Resposta enviada.';ui.toast('Resposta enviada.');
      syncPublicProfile(state.user.uid,state.profile||{}).catch(()=>{});
      if(btn.dataset.owner!==state.user.uid)sendNotification(btn.dataset.owner,{tipo:'reply',titulo:'Responderam seu comentário',texto:(state.profile?.nome||'Alguém')+' respondeu ao seu comentário.',link:btn.dataset.commentType==='obr