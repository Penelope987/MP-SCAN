    document.addEventListener('click',e=>{const nav=e.target.closest('[data-calendar-nav]');if(nav){e.preventDefault();state.calendarMonthOffset+=nav.dataset.calendarNav==='prev'?-1:1;renderCalendar();return;}const today=e.target.closest('[data-calendar-today]');if(today){e.preventDefault();state.calendarMonthOffset=0;state.calendarSelectedKey=localDateKey(new Date());renderCalendar();return;}const day=e.target.closest('[data-calendar-date]');if(day){e.preventDefault();state.calendarSelectedKey=day.dataset.calendarDate;const d=dateFromLocalKey(state.calendarSelectedKey),nowD=new Date();state.calendarMonthOffset=(d.getFullYear()-nowD.getFullYear())*12+(d.getMonth()-nowD.getMonth());renderCalendar();return;}});
