re{display:none}
    .continue-copy{min-width:0;display:flex;flex-direction:column;gap:6px;padding:5px 3px 3px 0}
    .continue-eyebrow{display:flex;align-items:center;gap:6px;width:max-content;max-width:100%;font-size:.59rem;line-height:1;font-weight:1000;letter-spacing:.12em;text-transform:uppercase;color:var(--accent2)}
    .continue-eyebrow span{width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 0 4px color-mix(in srgb,currentColor 13%,transparent);flex:0 0 auto}
    .continue-title{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;white-space:normal;text-overflow:ellipsis;color:var(--text);font-size:1rem;font-weight:1000;line-height:1.18;letter-spacing:-.01em}
    .continue-title:hover{color:var(--accent)}
    .continue-chapter{font-size:.76rem;line-height:1.35;font-weight:850;color:color-mix(in srgb,var(--text) 86%,var(--muted));white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .continue-page{display:flex;align-items:center;gap:6px;min-height:20px;font-size:.69rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .continue-page-dot{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px color-mix(in srgb,var(--accent) 14%,transparent);flex:0 0 auto}
    .continue-progress{height:6px;border-radius:999px;background:color-mix(in srgb,var(--surface-2) 88%,var(--line));overflow:hidden;margin-top:1px}
    .continue-progress span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--accent),var(--accent2));box-shadow:0 0 12px color-mix(in srgb,var(--accent) 30%,transparent);transition:width .25s ease}
    .continue-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto;padding-top:1px}
    .continue-saved{min-width:0;font-size:.62rem;line-height:1.2;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .continue-percent{display:none}
    .continue-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:0 12px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;font-size:.66rem;font-weight:1000;white-space:nowrap;box-shadow:0 9px 20px color-mix(in srgb,var(--accent) 21%,transparent);transition:transform .16s ease,filter .16s ease}
    .continue-btn:hover{filter:brightness(1.06);transform:translateY(-1px)}
    .continue-btn b{font-size:.83rem;line-height:1}
    .reader-images img[data-reader-page]{background:var(--surface-2);min-height:1px}
    @media(max-width:759px){
      .continue-reading-pro .home-section-head p{display:block;font-size:.69rem;max-width:290px}
      .continue-track{grid-auto-columns:minmax(286px,88vw);gap:10px;margin-right:-10px;padding-bottom:10px}
      .continue-card{grid-template-columns:96px minmax(0,1fr);gap:11px;min-height:151px;padding:8px;border-radius:20px}
      .continue-cover{width:96px;height:134px;border-radius:15px}
      .continue-progress-badge{top:7px;right:7px;min-width:38px;padding:5px 7px}.continue-progress-badge b{font-size:.58rem}
      .continue-ch-pill{left:7px;bottom:7px;padding:5px 7px;font-size:.52rem}
      .continue-copy{gap:5px;padding:4px 1px 2px 0}
      .continue-eyebrow{display:flex;font-size:.53rem}.continue-eyebrow span{width:6px;height:6px}
      .continue-title{font-size:.88rem;line-height:1.16}
      .continue-chapter{font-size:.66rem}.continue-page{display:flex;font-size:.61rem}
      .continue-progress{height:5px}.continue-saved{font-size:.56rem}
      .continue-btn{min-height:33px;padding:0 10px;border-radius:11px;font-size:.59rem}
      .continue-foot{gap:7px}
    }
    @media(max-width:370px){.continue-track{grid-auto-columns:minmax(274px,90vw)}.continue-card{grid-template-columns:90px minmax(0,1fr)}.continue-cover{width:90px;height:128px}.continue-saved{display:none}.continue-foot{justify-content:flex-end}}

    /* ===== MP SCAN v72 — Assistente com contexto ===== */
    .support-bot-quick{display:flex;gap:7px;flex-wrap:wrap;margin:10px 0 2px}.support-bot-quick button{border:1px solid color-mix(in srgb,var(--accent) 24%,var(--line));background:color-mix(in srgb,var(--accent) 7%,var(--surface-2));color:var(--text);border-radius:999px;padding:8px 10px;font-size:.67rem;font-weight:850;transition:.18s transform,.18s border-color,.18s background}.support-bot-quick button:hover{border-color:color-mix(in srgb,var(--accent) 55%,var(--line));background:var(--accent-soft);transform:translateY(-1px)}.support-bot-compose .support-send:disabled{opacity:.65;cursor:wait}.support-bot-msg.bot{box-shadow:0 8px 22px rgba(0,0,0,.08)}
    @media(max-width:560px){.support-bot-quick{display:grid;grid-template-columns:1fr 1fr}.support-bot-quick button:last-child{grid-column:1/-1}.support-bot-quick button{border-radius:13px;text-align:left}}


    /* ===== MP SCAN v74 — EVENTO DIVULGUE & GANHE ===== */
    .referral-home-card{
      margin:18px 0 6px;padding:20px;border:1px solid color-mix(in srgb,var(--accent) 34%,var(--line));
      border-radius:26px;background:
        radial-gradient(circle at 10% 20%,color-mix(in srgb,var(--accent) 20%,transparent),transparent 42%),
        radial-gradient(circle at 90% 0,color-mix(in srgb,var(--accent2) 16%,transparent),transparent 34%),
        linear-gradient(145deg,var(--surface),color-mix(in srgb,var(--surface-2) 88%,var(--accent) 12%));
      box-shadow:var(--shadow);display:flex;align-items:center;justify-content:space-between;gap:18px;overflow:hidden;position:relative;
    }
    .referral-home-card:after{content:none}
    .referral-home-copy{display:flex;gap:15px;align-items:flex-start;min-width:0}
    .referral-home-icon{width:56px;height:56px;border-radius:18px;display:grid;place-items:center;flex:0 0 auto;font-size:1.55rem;background:linear-gradient(135deg,var(--accent),var(--accent2));color:white;box-shadow:0 12px 28px color-mix(in srgb,var(--accent) 28%,transparent)}
    .referral-home-copy strong{display:block;font-size:1.12rem;margin-bottom:5px}
    .referral-home-copy p{margin:0;color:var(--muted);line-height:1.55;max-width:710px}
    .referral-home-pill{display:inline-flex;margin-top:9px;padding:6px 10px;border-radius:999px;background:var(--accent-soft);font-size:.76rem;font-weight:800;color:var(--text)}
    .referral-home-action{flex:0 0 auto;border:0;border-radius:15px;padding:12px 17px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:white;font-weight:900;box-shadow:0 10px 24px color-mix(in srgb,var(--accent) 24%,transparent)}
    .telegram-home-card{margin:14px 0 6px;padding:18px 20px;border:1px solid color-mix(in srgb,#2AABEE 40%,var(--line));border-radius:24px;background:linear-gradient(145deg,color-mix(in srgb,var(--surface) 90%,#2AABEE 10%),color-mix(in srgb,var(--surface-2) 88%,#0d7cc1 12%));box-shadow:var(--shadow);display:flex;align-items:center;justify-content:space-between;gap:18px;overflow:hidden;position:relative}.telegram-home-card:before{content:'';position:absolute;left:-36px;bottom:-52px;width:150px;height:150px;border-radius:50%;background:#2AABEE;filter:blur(68px);opacity:.14;pointer-events:none}.telegram-home-copy{display:flex;align-items:flex-start;gap:14px;min-width:0;position:relative;z-index:1}.telegram-home-icon{width:56px;height:56px;border-radius:18px;display:grid;place-items:center;flex:0 0 auto;background:linear-gradient(135deg,#2AABEE,#229ED9);color:#fff;font-size:1.5rem;font-weight:1000;box-shadow:0 12px 28px rgba(42,171,238,.28)}.telegram-home-copy strong{display:block;font-size:1.08rem;font-weight:1000}.telegram-home-copy p{margin:4px 0 0;color:var(--muted);line-height:1.52;max-width:720px}.telegram-home-note{display:inline-flex;align-items:center;gap:6px;margin-top:8px;padding:6px 10px;border-radius:999px;background:color-mix(in srgb,#2AABEE 13%,transparent);color:#7ecfff;font-size:.74rem;font-weight:850}.telegram-home-action{position:relative;z-index:1;flex:0 0 auto;min-height:46px;padding:0 18px;border-radius:15px;border:1px solid color-mix(in srgb,#2AABEE 36%,transparent);background:linear-gradient(135deg,#2AABEE,#229ED9);color:#fff;font-size:.82rem;font-weight:1000;display:inline-flex;align-items:center;justify-content:center;gap:7px;text-decoration:none;box-shadow:0 12px 26px rgba(42,171,238,.24)}.telegram-auth-link{display:inline-flex;align-items:center;gap:8px;margin-top:12px;color:#7ecfff;font-size:.78rem;font-weight:900;text-decoration:none}.telegram-auth-link:hover{text-decoration:underline}
    .referral-page-shell{max-width:980px;margin:0 auto;padding:8px 0 28px}
    .referral-hero{position:relative;overflow:hidden;border:1px solid color-mix(in srgb,var(--accent) 28%,var(--line));border-radius:30px;padding:30px;background:
      radial-gradient(circle at 15% 0,color-mix(in srgb,var(--accent) 24%,transparent),transparent 42%),
      radial-gradient(circle at 92% 15%,color-mix(in srgb,var(--accent2) 20%,transparent),transparent 38%),
      var(--surface);box-shadow:var(--shadow)}
    .referral-kicker{display:inline-flex;padding:7px 11px;border-radius:999px;background:var(--accent-soft);font-weight:900;font-size:.76rem;letter-spacing:.08em}
    .referral-hero h1{font-size:clamp(2rem,6vw,3.6rem);line-height:1;margin:15px 0 11px;letter-spacing:-.04em}
    .referral-hero p{color:var(--muted);line-height:1.65;max-width:760px;margin:0}
    .referral-hero-note{margin-top:16px;display:flex;gap:8px;flex-wrap:wrap}
    .referral-hero-note span{padding:7px 10px;border:1px solid var(--line);border-radius:999px;font-size:.78rem;background:color-mix(in srgb,var(--surface-2) 85%,transparent)}
    .referral-section{margin-top:18px}
    .referral-section-head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin:0 2px 12px}
    .referral-section-head h2{margin:0;font-size:1.15rem}.referral-section-head p{margin:4px 0 0;color:var(--muted);font-size:.86rem}
    .referral-dashboard{display:grid;grid-template-columns:1.15fr .85fr;gap:14px}
    .referral-card{border:1px solid var(--line);border-radius:24px;background:var(--surface);padding:18px;box-shadow:0 10px 26px rgba(0,0,0,.12)}
    .referral-code-box{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:13px;padding:15px;border:1px dashed color-mix(in srgb,var(--accent) 50%,var(--line));border-radius:18px;background:var(--accent-soft)}
    .referral-code{font-size:clamp(1.25rem,5vw,2rem);font-weight:950;letter-spacing:.08em;overflow-wrap:anywhere}
    .referral-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
    .referral-actions button,.referral-actions a,.referral-claim-button{border:1px solid var(--line);background:var(--surface-2);border-radius:13px;padding:10px 13px;font-weight:800}
    .referral-actions .primary,.referral-claim-button.primary{border:0;background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff}
    .referral-count{display:flex;align-items:flex-end;gap:8px}.referral-count strong{font-size:3.1rem;line-height:1}.referral-count span{color:var(--muted);padding-bottom:7px}
    .referral-progress-track{height:11px;border-radius:999px;background:var(--surface-2);overflow:hidden;margin:14px 0 8px}.referral-progress-track span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .35s ease}
    .referral-next{font-size:.82rem;color:var(--muted)}
    .referral-use-form{display:grid;grid-template-columns:1fr auto;gap:9px;margin-top:13px}
    .referral-use-form input{width:100%;min-width:0;border:1px solid var(--line);border-radius:14px;background:var(--surface-2);padding:12px 13px;text-transform:uppercase;font-weight:800;letter-spacing:.04em}
    .referral-use-form button{border:0;border-radius:14px;padding:12px 15px;background:var(--text);color:var(--bg);font-weight:900}
    .referral-used-note{margin-top:12px;padding:11px 12px;border-radius:14px;background:color-mix(in srgb,var(--success) 13%,var(--surface-2));font-size:.86rem}
    .referral-rewards{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
    .referral-reward{position:relative;border:1px solid var(--line);border-radius:20px;padding:15px;background:var(--surface);min-height:178px;display:flex;flex-direction:column;gap:7px}
    .referral-reward.unlocked{border-color:color-mix(in srgb,var(--accent) 45%,var(--line));background:linear-gradient(160deg,var(--surface),color-mix(in srgb,var(--accent-soft) 48%,var(--surface)))}
    .referral-reward.delivered{border-color:color-mix(in srgb,var(--success) 48%,var(--line))}
    .referral-reward-step{width:39px;height:39px;border-radius:13px;display:grid;place-items:center;background:var(--surface-2);font-weight:950}
    .referral-reward.unlocked .referral-reward-step{background:linear-gradient(135deg,var(--accent),var(--accent2));color:white}
    .referral-reward strong{font-size:.93rem;line-height:1.25}.referral-reward small{color:var(--muted);line-height:1.45}
    .referral-reward-status{margin-top:auto;display:inline-flex;align-self:flex-start;padding:5px 8px;border-radius:999px;background:var(--surface-2);font-size:.7rem;font-weight:900;text-transform:uppercase;letter-spacing:.04em}
    .referral-reward.unlocked .referral-reward-status{background:var(--accent-soft)}
    .referral-request-card{margin-top:12px;border:1px solid var(--line);border-radius:20px;padding:16px;background:var(--surface)}
    .referral-request-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .referral-request-card input,.referral-request-card textarea{width:100%;border:1px solid var(--line);border-radius:13px;background:var(--surface-2);padding:11px 12px}
    .referral-request-card textarea{min-height:90px;resize:vertical}
    .referral-rules{border:1px solid var(--line);border-radius:22px;background:var(--surface);padding:18px}
    .referral-rules p{color:var(--muted);line-height:1.58;margin:8px 0}
    .referral-admin-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:14px}
    .referral-admin-stat{border:1px solid var(--line);background:var(--surface-2);border-radius:17px;padding:14px}.referral-admin-stat strong{display:block;font-size:1.65rem}.referral-admin-stat span{font-size:.78rem;color:var(--muted)}
    .referral-admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .referral-admin-list{display:grid;gap:9px}
    .referral-admin-item{border:1px solid var(--line);border-radius:16px;padding:13px;background:var(--surface-2)}
    .referral-admin-item h4{margin:0 0 5px}.referral-admin-item p{margin:6px 0;color:var(--muted);line-height:1.45}
    .referral-admin-meta{display:flex;gap:7px;flex-wrap:wrap;margin-top:7px}.referral-admin-meta span{padding:5px 8px;border-radius:999px;background:var(--surface);font-size:.72rem}
    /* ===== V75 — EVENTO 3 VENCEDORES / RECOMPENSAS PROFISSIONAIS ===== */
    .referral-cap-card{display:flex;align-items:center;justify-content:space-between;gap:14px;border:1px solid color-mix(in srgb,var(--accent) 35%,var(--line));background:linear-gradient(135deg,var(--surface),color-mix(in srgb,var(--accent-soft) 62%,var(--surface)));border-radius:20px;padding:15px 17px;margin-top:14px}.referral-cap-card strong{display:block;font-size:1.05rem}.referral-cap-card span{display:block;color:var(--muted);font-size:.82rem;margin-top:4px}.referral-cap-dots{display:flex;gap:7px}.referral-cap-dot{width:13px;height:13px;border-radius:50%;background:var(--surface-2);border:1px solid var(--line)}.referral-cap-dot.filled{background:linear-gradient(135deg,var(--accent),var(--accent2));border-color:transparent;box-shadow:0 0 16px color-mix(in srgb,var(--accent) 50%,transparent)}
    .referral-event-closed{border:1px solid color-mix(in srgb,#e04f73 45%,var(--line));background:color-mix(in srgb,#e04f73 10%,var(--surface));border-radius:17px;padding:14px 16px;margin-top:14px}.referral-event-closed strong{display:block;margin-bottom:4px}.referral-event-closed span{color:var(--muted);font-size:.84rem}
    .referral-priority-card{border:1px solid color-mix(in srgb,#e3b653 46%,var(--line));border-radius:22px;padding:17px;background:linear-gradient(145deg,var(--surface),color-mix(in srgb,#e3b653 8%,var(--surface)));margin-top:12px}.referral-priority-card h3{margin:0 0 6px}.referral-priority-meta{display:flex;gap:7px;flex-wrap:wrap;margin:10px 0}.referral-priority-meta span{padding:6px 9px;border-radius:999px;background:var(--surface-2);font-size:.75rem;font-weight:800}.referral-timeline{display:grid;gap:8px;margin-top:12px}.referral-timeline-item{border-left:2px solid color-mix(in srgb,var(--accent) 40%,var(--line));padding:3px 0 3px 12px}.referral-timeline-item strong{display:block;font-size:.82rem}.referral-timeline-item span{color:var(--muted);font-size:.77rem;white-space:pre-wrap}
    .referral-studio-target{display:grid;gap:4px;margin:0 0 15px;padding:14px 15px;border-radius:17px;border:1px solid color-mix(in srgb,#e3b653 38%,var(--line));background:color-mix(in srgb,#e3b653 8%,var(--surface-2))}.referral-studio-target span,.referral-studio-target small{color:var(--muted)}
    .referral-studio{border:1px solid color-mix(in srgb,var(--accent) 34%,var(--line));border-radius:24px;background:linear-gradient(155deg,var(--surface),color-mix(in srgb,var(--accent-soft) 30%,var(--surface)));padding:18px;margin:16px 0}.referral-studio-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}.referral-studio-head h3{margin:0}.referral-studio-head p{margin:5px 0 0;color:var(--muted);font-size:.84rem}.referral-studio-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.referral-studio-preview{min-height:126px;border:1px dashed color-mix(in srgb,var(--accent) 40%,var(--line));border-radius:18px;background:var(--surface-2);display:grid;place-items:center;padding:18px;margin:12px 0;overflow:hidden}.referral-studio-actions{display:flex;gap:8px;flex-wrap:wrap}
    .profile-referral-title{margin-top:7px;font-weight:950;font-size:.78rem;letter-spacing:.08em;color:var(--rr-accent,#d875ff);text-transform:uppercase;text-shadow:0 0 18px color-mix(in srgb,var(--rr-accent,#d875ff) 46%,transparent)}
    .profile-referral-badge,.comment-role-badge.referral-special{display:inline-flex;align-items:center;gap:5px;margin:8px 5px 0 0;padding:5px 9px;border-radius:999px;background:var(--rr-bg,#2a1838);color:var(--rr-text,#fff);border:1px solid color-mix(in srgb,var(--rr-accent,#d875ff) 62%,transparent);font-size:.68rem;font-weight:950;box-shadow:0 0 18px color-mix(in srgb,var(--rr-accent,#d875ff) 24%,transparent)}.comment-role-badge.referral-special{margin:0 0 0 5px}
    .profile-referral-banner{position:relative;overflow:hidden;min-height:92px;margin:16px 0 0;padding:16px 18px;border-radius:20px;border:1px solid color-mix(in srgb,var(--rr-accent,#8d2bff) 44%,var(--line));background-color:var(--rr-bg,#171222);background-size:cover;background-position:center;color:var(--rr-text,#fff);display:flex;align-items:center;justify-content:space-between;gap:15px;box-shadow:0 14px 34px rgba(0,0,0,.18)}.profile-referral-banner div{position:relative;z-index:1;display:grid;gap:3px}.profile-referral-banner small{font-size:.62rem;font-weight:950;letter-spacing:.13em;opacity:.82}.profile-referral-banner strong{font-size:1.05rem}.profile-referral-banner span{font-size:.78rem;opacity:.84}.profile-referral-banner b{position:relative;z-index:1;font-size:2rem;color:var(--rr-accent,#8d2bff);text-shadow:0 0 24px currentColor}
    @keyframes referralFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}@keyframes referralAurora{0%{filter:hue-rotate(0deg) saturate(1)}50%{filter:hue-rotate(55deg) saturate(1.25)}100%{filter:hue-rotate(0deg) saturate(1)}}@keyframes referralSparkle{0%,100%{filter:brightness(1)}45%{filter:brightness(1.2)}}
    .referral-fx-pulse{animation:commentFramePulse 2.4s ease-in-out infinite}.referral-fx-float{animation:referralFloat 2.8s ease-in-out infinite}.referral-fx-aurora{animation:referralAurora 5s linear infinite}.referral-fx-sparkle{animation:referralSparkle 2.2s ease-in-out infinite}.referral-fx-shine{position:relative;overflow:hidden}.referral-fx-shine:after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.24) 50%,transparent 70%);animation:commentFrameShine 3.2s ease-in-out infinite;pointer-events:none}
    @keyframes commentFrameFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}@keyframes commentFrameAurora{0%,100%{filter:brightness(var(--cf-brightness,1)) saturate(var(--cf-saturation,1)) hue-rotate(0deg)}50%{filter:brightness(1.08) saturate(1.2) hue-rotate(55deg)}}@keyframes commentFrameSparkle{0%,100%{opacity:var(--cf-frame-opacity,1)}35%{opacity:.82}55%{opacity:1}}@keyframes commentFrameBreathe{0%,100%{transform:scale(1);filter:brightness(var(--cf-brightness,1)) saturate(var(--cf-saturation,1))}50%{transform:scale(1.022);filter:brightness(1.1) saturate(calc(var(--cf-saturation,1) + .18))}}@keyframes commentFrameOrbit{0%{transform:translate3d(0,0,0)}25%{transform:translate3d(3px,-3px,0)}50%{transform:translate3d(0,-5px,0)}75%{transform:translate3d(-3px,-2px,0)}100%{transform:translate3d(0,0,0)}}@keyframes commentFrameRainbow{0%{filter:brightness(var(--cf-brightness,1)) saturate(1.1) hue-rotate(0deg)}50%{filter:brightness(1.12) saturate(1.3) hue-rotate(125deg)}100%{filter:brightness(var(--cf-brightness,1)) saturate(1.1) hue-rotate(360deg)}}@keyframes commentAvatarFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}@keyframes commentAvatarPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}@keyframes commentAvatarOrbit{0%{transform:translate3d(0,0,0)}25%{transform:translate3d(1px,-3px,0)}50%{transform:translate3d(0,-4px,0)}75%{transform:translate3d(-1px,-2px,0)}100%{transform:translate3d(0,0,0)}}
    .frame-effect-float .comment-frame-art,.frame-style-preview.frame-effect-float .comment-frame-preview-art,.frame-style-preview.frame-effect-float .admin-frame-preview-art,.frame-style-preview.frame-effect-float .admin-frame-thumb-art{animation:commentFrameFloat 2.8s ease-in-out infinite}.frame-effect-aurora .comment-frame-art,.frame-style-preview.frame-effect-aurora .comment-frame-preview-art,.frame-style-preview.frame-effect-aurora .admin-frame-preview-art,.frame-style-preview.frame-effect-aurora .admin-frame-thumb-art{animation:commentFrameAurora 5s ease-in-out infinite}.frame-effect-sparkle .comment-frame-art,.frame-style-preview.frame-effect-sparkle .comment-frame-preview-art,.frame-style-preview.frame-effect-sparkle .admin-frame-preview-art,.frame-style-preview.frame-effect-sparkle .admin-frame-thumb-art{animation:commentFrameSparkle 1.7s ease-in-out infinite}.frame-effect-breathe .comment-frame-art,.frame-style-preview.frame-effect-breathe .comment-frame-preview-art,.frame-style-preview.frame-effect-breathe .admin-frame-preview-art,.frame-style-preview.frame-effect-breathe .admin-frame-thumb-art{animation:commentFrameBreathe 2.9s ease-in-out infinite}.frame-effect-orbit .comment-frame-art,.frame-style-preview.frame-effect-orbit .comment-frame-preview-art,.frame-style-preview.frame-effect-orbit .admin-frame-preview-art,.frame-style-preview.frame-effect-orbit .admin-frame-thumb-art{animation:commentFrameOrbit 3.2s ease-in-out infinite}.frame-effect-rainbow .comment-frame-art,.frame-style-preview.frame-effect-rainbow .comment-frame-preview-art,.frame-style-preview.frame-effect-rainbow .admin-frame-preview-art,.frame-style-preview.frame-effect-rainbow .admin-frame-thumb-art{animation:commentFrameRainbow 5.8s linear infinite}
    .comment-v2.frame-effect-float .comment-v2-avatar img,.reply-bubble.frame-effect-float .reply-avatar img,.frame-style-preview.frame-effect-float .comment-frame-preview-avatar{animation:commentAvatarFloat 2.8s ease-in-out infinite}.comment-v2.frame-effect-pulse .comment-v2-avatar img,.reply-bubble.frame-effect-pulse .reply-avatar img,.frame-style-preview.frame-effect-pulse .comment-frame-preview-avatar,.frame-style-preview.frame-effect-breathe .comment-frame-preview-avatar,.comment-v2.frame-effect-breathe .comment-v2-avatar img,.reply-bubble.frame-effect-breathe .reply-avatar img{animation:commentAvatarPulse 2.5s ease-in-out infinite}.comment-v2.frame-effect-orbit .comment-v2-avatar img,.reply-bubble.frame-effect-orbit .reply-avatar img,.frame-style-preview.frame-effect-orbit .comment-frame-preview-avatar{animation:commentAvatarOrbit 3.2s ease-in-out infinite}.comment-v2.frame-effect-rainbow .comment-v2-avatar,.reply-bubble.frame-effect-rainbow .reply-avatar,.frame-style-preview.frame-effect-rainbow .comment-frame-preview-avatar{box-shadow:0 0 24px color-mix(in srgb,var(--cf-glow-color) 38%,transparent);animation:commentFrameRainbow 5.8s linear infinite}
    @media(prefers-reduced-motion:reduce){.referral-fx-pulse,.referral-fx-float,.referral-fx-aurora,.referral-fx-sparkle,.referral-fx-shine:after,.frame-effect-float .comment-frame-art,.frame-effect-aurora .comment-frame-art,.frame-effect-sparkle .comment-frame-art,.frame-effect-breathe .comment-frame-art,.frame-effect-orbit .comment-frame-art,.frame-effect-rainbow .comment-frame-art,.comment-v2.frame-effect-float .comment-v2-avatar img,.reply-bubble.frame-effect-float .reply-avatar img,.comment-v2.frame-effect-pulse .comment-v2-avatar img,.reply-bubble.frame-effect-pulse .reply-avatar img,.comment-v2.frame-effect-breathe .comment-v2-avatar img,.reply-bubble.frame-effect-breathe .reply-avatar img,.comment-v2.frame-effect-orbit .comment-v2-avatar img,.reply-bubble.frame-effect-orbit .reply-avatar img{animation:none!important}}
    @media(max-width:820px){.referral-dashboard,.referral-admin-grid{grid-template-columns:1fr}.referral-rewards{grid-template-columns:repeat(2,minmax(0,1fr))}.referral-admin-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.referral-home-card{align-items:stretch;flex-direction:column}.referral-home-action{align-self:flex-start}}
    @media(max-width:650px){.referral-studio-grid{grid-template-columns:1fr}.referral-studio-head{flex-direction:column}.referral-cap-card{align-items:flex-start}}
    @media(max-width:520px){.referral-hero{padding:22px 17px;border-radius:24px}.referral-card{padding:15px;border-radius:20px}.referral-code-box{align-items:flex-start;flex-direction:column}.referral-use-form{grid-template-columns:1fr}.referral-rewards{grid-template-columns:1fr}.referral-request-grid{grid-template-columns:1fr}.referral-admin-stats{grid-template-columns:1fr 1fr}.referral-home-card{padding:16px;border-radius:22px}}

  

    /* ===== V84 — CONFIGURAÇÕES: TOQUE ESTÁVEL E CONTROLES CLICÁVEIS ===== */
    .page[data-page='settings'],.page[data-page='settings-detail'],.page[data-page='age-settings'],.page[data-page='sensitive-settings']{position:relative;z-index:4;isolation:isolate;pointer-events:auto!important}
    .page[data-page='settings'] .settings-app,.page[data-page='settings-detail'] .settings-detail-card,.stable-settings-page .settings-app{position:relative;z-index:5;pointer-events:auto!important}
    .page[data-page='settings'] a,.page[data-page='settings'] button,.page[data-page='settings'] input,.page[data-page='settings'] select,.page[data-page='settings'] textarea,
    .page[data-page='settings-detail'] a,.page[data-page='settings-detail'] button,.page[data-page='settings-detail'] input,.page[data-page='settings-detail'] select,.page[data-page='settings-detail'] textarea,
    .stable-settings-page a,.stable-settings-page button,.stable-settings-page input,.stable-settings-page select,.stable-settings-page textarea,.stable-settings-page label{pointer-events:auto!important;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
    .settings-pro-card,.support-entry-card,.settings-actions .btn,.route-back,.sensitive-permission-btn,.appearance-mode,.palette-card{min-height:52px;cursor:pointer}
    .settings-option-clickable{cursor:pointer;user-select:none;-webkit-user-select:none;touch-action:manipulation}
    .settings-option-clickable .settings-option-copy{pointer-events:none}
    .settings-option-clickable .app-toggle,.settings-option-clickable .app-toggle *{pointer-events:none!important}
    .settings-option-clickable:focus-visible{outline:3px solid color-mix(in srgb,var(--accent) 62%,transparent);outline-offset:3px;border-radius:14px}
    .settings-option-clickable[aria-checked='true'] .settings-option-copy strong{color:var(--accent)}
    .settings-section-card:before,.settings-section-card:after,.settings-detail-hero:before,.settings-detail-hero:after,.settings-pro-hero:before,.settings-pro-hero:after{pointer-events:none!important}
    @media(max-width:760px){
      .settings-pro-card,.support-entry-card,.settings-actions .btn,.route-back,.sensitive-permission-btn{min-height:56px}
      .settings-pro-card:active,.support-entry-card:active,.settings-option-clickable:active{transform:none!important}
      .settings-option-row{gap:12px;padding-top:14px;padding-bottom:14px}
      .settings-option-row .app-toggle{flex:0 0 auto}
    }
    /* V85 — ACESSIBILIDADE FUNCIONAL */
    .accessibility-preview{border:1px solid color-mix(in srgb,var(--accent) 34%,var(--line));border-radius:20px;background:linear-gradient(145deg,var(--surface),color-mix(in srgb,var(--accent) 7%,var(--surface-2)));padding:16px;display:grid;gap:12px;overflow:hidden}
    .accessibility-preview-title{display:flex;align-items:center;gap:10px}.accessibility-preview-icon{width:42px;height:42px;border-radius:14px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;font-size:1.15rem;flex:0 0 auto}.accessibility-preview-title strong{display:block}.accessibility-preview-title small{display:block;color:var(--muted);margin-top:2px}
    .accessibility-preview-copy{padding:12px 13px;border:1px solid var(--line);border-radius:15px;background:var(--surface-2);line-height:1.55}.accessibility-preview-copy strong{display:block;margin-bottom:4px}.accessibility-preview-copy span{color:var(--muted)}
    .accessibility-preview-actions{display:flex;gap:8px;flex-wrap:wrap}.accessibility-preview-actions .btn{min-height:44px}.accessibility-save-status{min-height:22px;margin-top:8px;font-size:.74rem;color:var(--muted);font-weight:750}.accessibility-save-status.saving{color:var(--accent)}.accessibility-save-status.saved{color:var(--success)}.accessibility-save-status.error{color:var(--danger)}
    .accessibility-support-note{display:flex;gap:10px;align-items:flex-start;padding:12px 13px;border-radius:15px;background:color-mix(in srgb,var(--accent) 8%,var(--surface-2));border:1px solid color-mix(in srgb,var(--accent) 22%,var(--line));font-size:.74rem;line-height:1.5;color:var(--muted)}
    @media(max-width:560px){.accessibility-preview-actions{display:grid;grid-template-columns:1fr}.accessibility-preview-actions .btn{width:100%}}
    .settings-detail-shell [data-settings-toggle]{position:relative;z-index:1;min-height:58px}
    .settings-detail-shell [data-settings-toggle] .app-toggle{pointer-events:none!important}
    .settings-detail-shell input[type='range']{pointer-events:auto!important;touch-action:pan-x!important;min-height:34px}
    @media(max-width:760px){.settings-detail-shell [data-settings-toggle]{min-height:62px;padding-top:15px;padding-bottom:15px}.settings-detail-shell input[type='range']{min-height:42px}}

    /* ===== V87 — ACESSIBILIDADE: INTERRUPTORES NATIVOS E CONFIÁVEIS ===== */
    /* V88 — acessibilidade: controles de botão reais, sem checkbox invisível */
    .accessibility-native-row{position:relative;width:100%;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:14px;min-height:66px;padding:13px 0;border:0;border-top:1px solid var(--line);border-radius:0;background:transparent;color:var(--text);font:inherit;text-align:left;cursor:pointer;user-select:none;-webkit-user-select:none;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
    .accessibility-native-row:first-of-type{border-top:0}
    .accessibility-native-row .settings-option-copy{pointer-events:none;min-width:0}
    .accessibility-native-side{display:flex;align-items:center;gap:10px;flex:0 0 auto;pointer-events:none}
    .accessibility-toggle-state{min-width:72px;text-align:right;font-size:.68rem;font-weight:950;letter-spacing:.035em;color:var(--muted);text-transform:uppercase;pointer-events:none}
    .accessibility-switch-track{position:relative;width:50px;height:30px;border-radius:999px;background:var(--surface-2);border:1px solid var(--line);box-shadow:inset 0 1px 2px rgba(0,0,0,.12);transition:background .18s,border-color .18s,box-shadow .18s;pointer-events:none;flex:0 0 auto}
    .accessibility-switch-track:after{content:'';position:absolute;width:22px;height:22px;left:3px;top:3px;border-radius:50%;background:var(--muted);transition:transform .18s,background .18s;box-shadow:0 2px 7px rgba(0,0,0,.24)}
    .accessibility-native-row.is-on .accessibility-switch-track{background:var(--accent);border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 12%,transparent),inset 0 1px 1px rgba(255,255,255,.16)}
    .accessibility-native-row.is-on .accessibility-switch-track:after{transform:translateX(20px);background:#fff}
    .accessibility-native-row.is-on .accessibility-toggle-state,.accessibility-native-row.is-on .settings-option-copy strong{color:var(--accent)}
    .accessibility-native-row:active{background:color-mix(in srgb,var(--accent) 7%,transparent)}
    .accessibility-native-row:focus-visible{outline:3px solid color-mix(in srgb,var(--accent) 44%,transparent);outline-offset:3px;border-radius:14px}
    @media(max-width:760px){.accessibility-native-row{min-height:72px;padding:15px 0}.accessibility-toggle-state{display:none}.accessibility-switch-track{width:54px;height:32px}.accessibility-switch-track:after{width:24px;height:24px}.accessibility-native-row.is-on .accessibility-switch-track:after{transform:translateX(22px)}}

    /* ===== V83 — ESTABILIDADE MOBILE / SEM BLOQUEAR TOQUES ===== */
    /* A entrada do ranking deixa de ser uma camada em tela cheia. Continua animada,
       mas vira um cartão flutuante leve que nunca intercepta toque ou clique. */
    .profile-rank-intro{
      position:fixed!important;inset:auto!important;left:50%!important;top:max(12px,env(safe-area-inset-top))!important;
      width:min(92vw,560px)!important;height:auto!important;min-height:0!important;transform:translateX(-50%)!important;
      z-index:190!important;display:block!important;overflow:visible!important;pointer-events:none!important;touch-action:none!important;
      isolation:isolate!important;background:transparent!important;animation:profileRankSafeIn .34s cubic-bezier(.2,.8,.2,1) both!important;
      contain:layout style paint;
    }
    .profile-rank-intro,.profile-rank-intro *{pointer-events:none!important;user-select:none!important}
    .profile-rank-intro.leaving{animation:profileRankSafeOut .26s ease forwards!important}
    .profile-rank-intro-backdrop{display:none!important}
    .profile-rank-intro-core{
      width:100%!important;min-height:0!important;padding:14px 15px!important;border-radius:22px!important;
      border:1px solid color-mix(in srgb,var(--intro) 38%,rgba(255,255,255,.12))!important;
      background:linear-gradient(145deg,rgba(20,18,27,.96),rgba(10,9,14,.94))!important;
      box-shadow:0 14px 38px rgba(0,0,0,.34),0 0 28px var(--intro-soft)!important;
      backdrop-filter:none!important;-webkit-backdrop-filter:none!important;
    }
    .profile-rank-particles,.profile-rank-intro:before,.profile-rank-intro:after,.profile-rank-intro-ranks.dual:before{display:none!important}
    .profile-rank-intro-ranks{gap:8px!important;margin:0 0 8px!important}
    .profile-rank-intro-rank-card{min-width:110px!important;padding:8px 11px!important;border-radius:15px!important;box-shadow:0 7px 18px rgba(0,0,0,.18)!important;backdrop-filter:none!important;animation:profileRankSafeCard .38s ease both!important}
    .profile-rank-intro-rank-card .medal{font-size:1.48rem!important}.profile-rank-intro-rank-card strong{font-size:.88rem!important}.profile-rank-intro-rank-card span{font-size:.52rem!important}
    .profile-rank-intro-fusion-mark{width:30px!important;height:30px!important;font-size:.82rem!important;animation:none!important}
    .profile-rank-intro-title{font-size:1rem!important;line-height:1.15!important;animation:none!important;color:#fff!important;background:none!important;-webkit-background-clip:initial!important;background-clip:initial!important;text-shadow:none!important}
    .profile-rank-intro-sub{margin-top:5px!important;font-size:.68rem!important;line-height:1.35!important;max-width:100%!important}
    .profile-rank-intro-category-pills{margin-top:7px!important;gap:5px!important}.profile-rank-intro-category-pills span{padding:4px 7px!important;font-size:.54rem!important}
    .profile-rank-intro-place{margin-top:7px!important;padding:4px 7px!important;font-size:.5rem!important}
    @keyframes profileRankSafeIn{from{opacity:0;transform:translate(-50%,-16px) scale(.97)}to{opacity:1;transform:translate(-50%,0) scale(1)}}
    @keyframes profileRankSafeOut{to{opacity:0;transform:translate(-50%,-10px) scale(.98);visibility:hidden}}
    @keyframes profileRankSafeCard{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

    /* Evita GPU excessiva em celulares: imagem de fundo continua funcionando,
       porém sem animar/filtrar uma camada fixa gigante durante rolagem e toques. */
    @media(max-width:760px){
      #appearanceBackdrop{inset:0!important;filter:none!important;transform:none!important;will-change:auto!important;background-attachment:scroll!important}
      html[data-ambient-motion='true'] #appearanceBackdrop{animation:none!important}
      html[data-shiny-ui='true'] .btn.primary:after,html[data-shiny-ui='true'] .brand-mark:after{animation:none!important;display:none!important}
      .profile-rank-intro{top:max(8px,env(safe-area-inset-top))!important;width:min(94vw,480px)!important}
      .profile-rank-intro-core{padding:11px 12px!important;border-radius:18px!important}
      .profile-rank-intro-sub{display:none!important}.profile-rank-intro-place{display:none!important}
      .profile-rank-intro-rank-card{min-width:96px!important;padding:7px 9px!important}
      .profile-rank-intro-category-pills{margin-top:5px!important}
      /* Filtros com hue-rotate em imagens grandes são caros em Android; usa movimento leve. */
      .frame-effect-aurora .comment-frame-art,.frame-style-preview.frame-effect-aurora .comment-frame-preview-art,.frame-style-preview.frame-effect-aurora .admin-frame-preview-art,.frame-style-preview.frame-effect-aurora .admin-frame-thumb-art,
      .frame-effect-rainbow .comment-frame-art,.frame-style-preview.frame-effect-rainbow .comment-frame-preview-art,.frame-style-preview.frame-effect-rainbow .admin-frame-preview-art,.frame-style-preview.frame-effect-rainbow .admin-frame-thumb-art{animation:commentFramePulse 3.2s ease-in-out infinite!important}
      .referral-fx-aurora,.referral-fx-shine:after{animation:none!important}
    }

    /* Nada animado pode criar uma barreira invisível sobre a interface. */
    .profile-rank-intro,.profile-rank-intro *,.appearance-pro-preview-bg,#appearanceBackdrop{pointer-events:none!important}

</style>
</head>

<body class='splash-on'>
  <div aria-hidden='true' id='appearanceBackdrop'></div>

  <div aria-label='Carregando MP SCAN' aria-live='polite' class='app-splash' id='appSplash'>
    <div class='app-splash-card'>
      <div class='app-splash-brand'><span class='app-splash-brand-star'>&#10022;</span><span>MP SCAN</span></div>
      <h1 class='app-splash-title'>Preparando sua leitura&#8230;</h1>
      <div class='app-splash-sub'>Organizando tudo para você entrar com a experiência completa.</div>
      <div aria-hidden='true' class='app-splash-bar'><span></span></div>
      <div class='app-splash-status'><span class='app-splash-dot'></span><span>Quase pronto</span></div>
    </div>
  </div>
<div id='app'>
    <header class='topbar'>
      <div class='shell topbar-inner'>
        <a aria-label='MP SCAN — Início' class='brand' data-route='/inicio' href='#/inicio'>
          <div class='brand-mark'>&#10022;</div>
          <span>MP SCAN</span>
        </a>
        <div class='top-actions'>
          <button aria-label='Aparência' class='header-action' data-theme-panel-open='true' id='themeToggle' type='button'>&#9680;</button>
          <a aria-label='Calendário de atualizações' class='header-action calendar-header-button' data-route='/calendario' href='#/calendario' id='calendarButton' title='Calendário'>🗓</a>
          <a aria-label='Notificações' class='header-action' data-route='/notificacoes' href='#/notificacoes' id='notificationButton'><span class='notif-bell'>🔔</span><span class='notif-count' id='notificationCount'>0</span></a>
          <a aria-label='Perfil' class='header-action header-avatar' data-route='/perfil' href='#/perfil' id='accountButton'><span id='topProfileAvatar'>👤</span></a>
        </div>
      </div>
    </header>

    <main class='shell'>
      <section class='page active' data-page='home' id='/inicio'>
        <div class='home-feature' id='homeFeature'>
          <div class='home-feature-empty'>Nenhuma obra publicada para destacar ainda.</div>
        </div>

        <section aria-label='Baixar aplicativo Android do MP SCAN' class='install-app-card' id='downloadAndroidAppCard'>
          <button aria-label='Não mostrar novamente' class='install-app-close' id='dismissAndroidAppCard' type='button'>&#215;</button>
          <div class='install-app-copy'>
            <div class='install-app-icon'>📱</div>
            <div>
              <strong>Baixe o aplicativo MP SCAN</strong>
              <p>Tenha uma leitura mais confortável no Android, com acesso rápido ao MP SCAN e à sua biblioteca. Esta é a versão disponível no momento e uma nova atualização pode ser lançada a qualquer momento.</p>
              <span class='install-app-ready'>Android &#8226; APK oficial &#8226; download direto</span>
            </div>
          </div>
          <div class='install-app-actions'>
            <a class='install-app-main' download='MP-SCAN.apk' href='https://drive.usercontent.google.com/download?id=11ALcIUx6krOiEN9L5JIfV8Res8Gtsy3f&amp;export=download&amp;confirm=t' id='downloadAndroidAppButton' rel='noopener noreferrer' target='_blank'>&#11015; Baixar aplicativo Android</a>
          </div>
        </section>

        <section aria-label='Canal oficial do Telegram da MP SCAN' class='telegram-home-card'>
          <div class='telegram-home-copy'>
            <div class='telegram-home-icon'>&#9992;</div>
            <div>
              <strong>Entre no nosso canal do Telegram</strong>
              <p>Acompanhe avisos, novidades e atualizações da MP SCAN em um cantinho rápido e fácil de acessar.</p>
              <span class='telegram-home-note'>🔓 Acesso público &#8226; não precisa entrar na conta do site</span>
            </div>
          </div>
          <a aria-label='Entrar no canal do Telegram da MP SCAN' class='telegram-home-action' href='https://t.me/MPSCAN0' rel='noopener noreferrer' target='_blank'>Telegram &#8599;</a>
        </section>

        <section aria-label='Evento de divulgação MP SCAN' class='referral-home-card'>
          <div class='referral-home-copy'>
            <div class='referral-home-icon'>&#10022;</div>
            <div>
              <strong>Evento Divulgue &amp; Ganhe</strong>
              <p>Receba seu código exclusivo, convide novos leitores e desbloqueie prêmios conforme suas indicações forem confirmadas.</p>
              <span class='referral-home-pill'>10 &#8226; 20 &#8226; 30 &#8226; 40 &#8226; 50 indicações</span>
            </div>
          </div>
          <a class='referral-home-action' data-route='/evento-divulgacao' href='#/evento-divulgacao'>Ver meu código &#8594;</a>
        </section>

        <section class='home-section' id='homeRankingSection'>
          <div class='home-section-head'><div><h2>🔥 Em alta</h2><p>As 10 obras mais acessadas no MP SCAN.</p></div></div>
          <div class='ranking-track' id='trendingGrid'><div class='empty'>Nenhuma obra publicada ainda.</div></div>
        </section>

        <section class='home-section continue-reading-pro auth-only hidden' id='continueSection'>
          <div class='home-section-head'><div><h2>📖 Continuar lendo</h2><p>Volte ao capítulo e à página exata onde parou.</p></div></div>
          <div class='continue-track' id='continueGrid'></div>
        </section>

        <section class='home-section updates-section-pro'>
          <div class='home-section-head home-section-head-center'>
            <div class='home-section-title-fancy'>
              <span class='home-section-star'>&#10022;</span>
              <div>
                <h2>ATUALIZAÇÕES</h2>
                <p>Atualizações mais recentes</p>
              </div>
              <span class='home-section-face'>&#9685;</span>
            </div>
          </div>
          <div class='updates-modern' id='updatesGrid'><div class='empty'>As atualizações aparecerão aqui quando capítulos forem publicados.</div></div>
        </section>

        <section class='home-section community-league-section' id='communityLeagueSection'>
          <div class='community-league-title'>
            <div class='community-league-crown'>&#9819;</div>
            <div>
              <span class='community-league-kicker'>LIGA MP SCAN</span>
              <h2>Hall da Comunidade</h2>
              <p>Os leitores que mais participam aparecem aqui, do 1º ao 10º lugar.</p>
            </div>
            <div class='community-league-spark'>&#10022;</div>
          </div>
          <div class='community-league-grid'>
            <article class='community-board comments-board'>
              <div class='community-board-head'><div class='community-board-icon'>💬</div><div><strong>🏆 Ranking de Comentários</strong><span>1º ao 10º lugar &#8226; comentários + respostas</span></div></div>
              <div class='community-board-body' id='communityLeaderboardComments'><div class='community-board-loading'>Calculando placar&#8230;</div></div>
            </article>
            <article class='community-board reactions-board'>
              <div class='community-board-head'><div class='community-board-icon'>&#10024;</div><div><strong>&#10024; Ranking de Reações</strong><span>1º ao 10º lugar &#8226; participação com reações</span></div></div>
              <div class='community-board-body' id='communityLeaderboardReactions'><div class='community-board-loading'>Calculando placar&#8230;</div></div>
            </article>
          </div>
          <div class='community-league-tip'>🏆 Quanto mais você participa, mais perto fica do topo.</div>
        </section>
      </section>

      <section class='page' data-page='calendar' id='/calendario'>
        <div class='calendar-pro-shell'>
          <section class='calendar-hero-pro'>
            <div class='calendar-hero-glow'></div>
            <div class='calendar-hero-icon'>🗓</div>
            <div class='calendar-hero-copy'>
              <span class='calendar-kicker'>AGENDA MP SCAN</span>
              <h1>Calendário de atualizações</h1>
              <p>Veja em quais dias cada obra está prevista para receber atualização.</p>
            </div>
            <button class='calendar-today-btn' data-calendar-today='true' type='button'>Hoje</button>
          </section>
          <section class='calendar-layout-pro'>
            <div class='calendar-month-card'>
              <div class='calendar-month-head'>
                <button aria-label='Mês anterior' class='calendar-nav-btn' data-calendar-nav='prev' type='button'>&#8249;</button>
                <div><strong id='calendarMonthTitle'>Mês</strong><span id='calendarMonthSubtitle'>Agenda de obras</span></div>
                <button aria-label='Próximo mês' class='calendar-nav-btn' data-calendar-nav='next' type='button'>&#8250;</button>
              </div>
              <div class='calendar-week-head'><span>DOM</span><span>SEG</span><span>TER</span><span>QUA</span><span>QUI</span><span>SEX</span><span>SÁB</span></div>
              <div class='calendar-month-grid' id='calendarMonthGrid'></div>
            </div>
            <div class='calendar-day-card'>
              <div class='calendar-day-head'><div><span class='calendar-kicker'>SELECIONADO</span><h2 id='calendarSelectedTitle'>Hoje</h2><p id='calendarSelectedSubtitle'>Obras previstas para este dia.</p></div><span class='calendar-day-count' id='calendarSelectedCount'>0</span></div>
              <div class='calendar-day-list' id='calendarSelectedWorks'><div class='empty'>Nenhuma obra prevista para este dia.</div></div>
            </div>
          </section>
          <section class='calendar-upcoming-card'>
            <div class='calendar-section-head'><div><span class='calendar-kicker'>PRÓXIMOS DIAS</span><h2>Próximas atualizações</h2><p>Uma visão rápida das próximas datas programadas.</p></div></div>
            <div class='calendar-upcoming-list' id='calendarUpcomingList'></div>
          </section>
        </div>
      </section>


      <section class='page' data-page='referral' id='/evento-divulgacao'>
        <div class='referral-page-shell' id='referralEventContent'>
          <div class='skeleton'></div>
        </div>
      </section>

      <section class='page' data-page='search' id='/buscar'>
        <div class='search-pro'>
          <div class='search-pro-hero'>
            <div class='search-pro-kicker'>Descobrir</div>
            <h1 class='search-pro-title'>Encontre sua próxima leitura</h1>
            <p class='search-pro-sub'>Pesquise pelo nome e refine tudo em um único painel de filtros, sem poluir a tela.</p>
            <div class='search-pro-bar'>
              <input autocomplete='off' class='search-pro-input' id='searchInput' placeholder='Nome, autor, gênero, scan...'/>
              <button class='search-filter-trigger' id='openSearchFilters' type='button'>&#9776; Filtros <span class='search-filter-count' id='searchFilterCount'>0</span></button>
            </div>
          </div>

          <div class='search-summary'>
            <div><strong id='searchResultCount'>0 obras</strong><br/><span id='searchResultHint'>Todas as obras disponíveis para sua conta.</span></div>
          </div>
          <div class='search-active-filters' id='searchActiveFilters'></div>
          <div class='search-results-pro' id='searchResults'><div class='empty'>As obras publicadas aparecerão aqui.</div></div>
        </div>

        <div class='search-filter-backdrop' id='searchFilterSheet'>
          <div class='search-filter-sheet'>
            <div class='filter-sheet-head'>
              <div><h2>Filtros de busca</h2><p>Combine quantos filtros quiser.</p></div>
              <button aria-label='Fechar filtros' class='icon-btn' id='closeSearchFilters' type='button'>&#215;</button>
            </div>

            <div class='filter-grid'>
              <div class='filter-field'>
                <label>Status</label>
                <select class='filter-control' id='statusFilter'>
                  <option value=''>Todos os status</option>
                  <option value='ongoing'>Em andamento</option>
                  <option value='complete'>Completa</option>
                  <option value='paused'>Pausada</option>
                  <option value='cancelled'>Cancelada</option>
                  <option value='future'>Futura</option>
                </select>
              </div>
              <div class='filter-field'>
                <label>Tipo de obra</label>
                <select class='filter-control' id='typeFilter'>
                  <option value=''>Todos os tipos</option>
                  <option value='manga'>Mangá</option>
                  <option value='manhwa'>Manhwa</option>
                  <option value='manhua'>Manhua</option>
                  <option value='novel'>Novel</option>
                  <option value='webtoon'>Webtoon</option>
                  <option value='oneshot'>One-shot</option>
                  <option value='hq'>HQ</option>
                  <option value='other'>Outro</option>
                </select>
              </div>
              <div class='filter-field'>
                <label>Avaliação</label>
                <select class='filter-control' id='ratingFilter'>
                  <option value=''>Qualquer nota</option>
                  <option value='4.5'>4,5+ estrelas</option>
                  <option value='4'>4+ estrelas</option>
                  <option value='3'>3+ estrelas</option>
                  <option value='2'>2+ estrelas</option>
                </select>
              </div>
              <div class='filter-field'>
                <label>Ordenar</label>
                <select class='filter-control' id='sortFilter'>
                  <option value='recent'>Mais recentes</option>
                  <option value='updated'>Mais atualizadas</option>
                  <option value='read'>Mais lidas</option>
                  <option value='rating'>Melhor avaliadas</option>
                  <option value='old'>Mais antigas</option>
                  <option value='az'>A&#8211;Z</option>
                  <option value='za'>Z&#8211;A</option>
                </select>
              </div>
              <div class='filter-field'>
                <label>Autor</label>
                <input class='filter-control' id='authorFilter' placeholder='Nome do autor'/>
              </div>
              <div class='filter-field'>
                <label>Artista</label>
                <input class='filter-control' id='artistFilter' placeholder='Nome do artista'/>
              </div>
              <div class='filter-field'>
                <label>Scan</label>
                <input class='filter-control' id='scanFilter' placeholder='Nome da scan'/>
              </div>
              <div class='filter-field'>
                <label>Idioma</label>
                <input class='filter-control' id='languageFilter' placeholder='Ex.: Português'/>
              </div>
              <div class='filter-field'>
                <label>Conteúdo</label>
                <select class='filter-control' id='contentFilter'>
                  <option value=''>Todo conteúdo disponível</option>
                  <option value='normal'>Sem marcação sensível</option>
                  <option value='sensitive'>Sensível</option>
                  <option value='adult'>Restrição etária</option>
                </select>
              </div>
              <div class='filter-field'>
                <label>Capítulos</label>
                <select class='filter-control' id='chapterFilter'>
                  <option value=''>Com ou sem capítulos</option>
                  <option value='with'>Somente com capítulos</option>
                </select>
              </div>
              <div class='filter-field full'>
                <label>Gêneros</label>
                <div class='filter-genre-grid' id='searchGenreOptions'></div>
              </div>
            </div>

            <div class='filter-sheet-actions'>
              <button class='btn ghost' id='clearSearchFilters' type='button'>Limpar filtros</button>
              <button class='btn primary' id='applySearchFilters' type='button'>Ver resultados</button>
            </div>
          </div>
        </div>
      </section>

      <section class='page' data-page='library' id='/biblioteca'>
        <div class='library-hero'>
          <h1>Sua biblioteca</h1>
          <p>Organize suas leituras, crie coleções do seu jeito e descubra estantes públicas de outros leitores.</p>
          <div class='library-stats auth-only hidden'>
            <div class='library-stat'><strong id='libraryStatFavorites'>0</strong><span>Favoritos</span></div>
            <div class='library-stat'><strong id='libraryStatCollections'>0</strong><span>Coleções</span></div>
            <div class='library-stat'><strong id='libraryStatReading'>0</strong><span>Em leitura</span></div>
          </div>
        </div>
        <div class='library-tabs'>
          <a class='chip active' data-library-tab='favorites' data-route='/biblioteca/favoritos' href='#/biblioteca/favoritos'>&#9825; Favoritos</a>
          <a class='chip' data-library-tab='continue' data-route='/biblioteca/continuar' href='#/biblioteca/continuar'>&#9654; Continue lendo</a>
          <a class='chip' data-library-tab='collections' data-route='/biblioteca/colecoes' href='#/biblioteca/colecoes'>&#9638; Minhas coleções</a>
          <a class='chip' data-library-tab='public' data-route='/biblioteca/publico' href='#/biblioteca/publico'>🌐 Público</a>
          <a class='chip' data-library-tab='history' data-route='/biblioteca/historico' href='#/biblioteca/historico'>&#9719; Histórico</a>
          <a class='chip' data-library-tab='downloads' data-route='/biblioteca/downloads' href='#/biblioteca/downloads'>&#8595; Downloads</a>
        </div>
        <div class='panel guest-library'>
          <h3>Entre para usar sua biblioteca</h3>
          <p class='section-sub'>Favoritos, histórico, coleções e progresso sincronizado ficam disponíveis após o login.</p>
          <button class='btn primary open-auth' type='button'>Entrar ou criar conta</button>
        </div>
        <div class='auth-only hidden'>
          <div class='library-panel active' data-library-panel='favorites'><div class='library-section-head'><h2>Seus favoritos</h2></div><div class='cards' id='libraryFavorites'><div class='empty'>Você ainda não favoritou nenhuma obra.</div></div></div>
          <div class='library-panel' data-library-panel='continue'><div class='library-section-head'><h2>Continue de onde parou</h2></div><div class='cards' id='libraryContinue'><div class='empty'>Nenhuma leitura em andamento.</div></div></div>
          <div class='library-panel' data-library-panel='collections'><div class='library-section-head'><div><h2>Minhas coleções</h2><div class='section-sub'>Você escolhe se cada coleção é pública ou privada.</div></div><button class='btn primary' data-create-collection='true' type='button'>+ Nova coleção</button></div><div class='collection-grid' id='libraryCollections'><div class='empty'>Você ainda não criou coleções.</div></div></div>
          <div class='library-panel' data-library-panel='public'><div class='library-section-head'><div><h2>Coleções públicas</h2><div class='section-sub'>Veja o que outros leitores decidiram compartilhar.</div></div><button class='btn ghost' data-refresh-public-collections='true' type='button'>&#8635; Atualizar</button></div><div id='libraryPublic'><div class='skeleton'></div></div></div>
          <div class='library-panel' data-library-panel='history'><div class='library-section-head'><h2>Histórico</h2></div><div class='cards' id='libraryHistory'><div class='empty'>Seu histórico ainda está vazio.</div></div></div>
          <div class='library-panel' data-library-panel='downloads'><div class='library-section-head'><h2>Downloads</h2></div><div class='cards' id='libraryDownloads'><div class='empty'>Nenhum capítulo baixado neste aparelho.</div></div></div>
        </div>
      </section>

