  <div aria-labelledby='firstAccessGuideTitle' aria-modal='true' class='modal-backdrop first-guide-backdrop' id='firstAccessGuide' role='dialog'>
    <div class='first-guide-card'>
      <div class='first-guide-brand'>&#10022; Primeiros passos</div>
      <h2 id='firstAccessGuideTitle'>Encontre todas as obras permitidas para você</h2>
      <p>Algumas obras podem não aparecer nas listas porque o MP SCAN respeita filtros de idade e de conteúdo sensível. Veja como cada opção funciona:</p>
      <div class='first-guide-steps'>
        <div class='first-guide-step'><span>1</span><div><strong>Entre ou crie sua conta</strong><small>As preferências de idade e conteúdo ficam ligadas à sua conta para funcionarem corretamente.</small></div></div>
        <div class='first-guide-step'><span>18+</span><div><strong>Verificação etária</strong><small>Se você já tiver 18 anos, informe sua data verdadeira em Configurações &#8250; Verificação etária. Somente contas confirmadas como adultas podem visualizar obras marcadas como +18.</small></div></div>
        <div class='first-guide-step'><span>&#9671;</span><div><strong>Conteúdo sensível</strong><small>É um filtro separado. Depois da verificação, abra Configurações &#8250; Conteúdo sensível e escolha se deseja exibir essas obras. Conteúdo +18 continua proibido para menores.</small></div></div>
      </div>
      <div class='first-guide-note'>Se uma obra não aparecer, confira primeiro esses dois controles. O MP SCAN nunca ativa conteúdo restrito automaticamente e a data informada deve ser verdadeira.</div>
      <div class='first-guide-actions'>
        <a class='btn ghost' data-first-guide-route='/configuracoes/maioridade' href='#/configuracoes/maioridade'>Verificação etária</a>
        <a class='btn ghost' data-first-guide-route='/configuracoes/sensivel' href='#/configuracoes/sensivel'>Conteúdo sensível</a>
        <button class='btn primary' id='finishFirstAccessGuide' type='button'>Entendi e continuar</button>
      </div>
    </div>
  </div>

  <div class='modal-backdrop auth-backdrop' id='authModal'>
    <div class='modal auth-modal-shell'>
      <button aria-label='Fechar' class='icon-btn auth-close' id='closeAuth' type='button'>&#215;</button>

      <aside class='auth-visual'>
        <div class='auth-brand'><span class='auth-brand-mark'>&#10022;</span><span>MP SCAN</span></div>
        <div class='auth-visual-copy'>
          <div class='auth-kicker'>Sua leitura, do seu jeito</div>
          <h2>Entre e continue exatamente de onde parou.</h2>
          <p>Sincronize suas leituras, favoritos, coleções, avaliações e preferências em uma experiência feita para quem realmente gosta de ler.</p>
          <div class='auth-benefits'>
            <div class='auth-benefit'><span>&#9719;</span><span>Progresso de leitura sincronizado</span></div>
            <div class='auth-benefit'><span>&#9825;</span><span>Favoritos, coleções e histórico em um só lugar</span></div>
            <div class='auth-benefit'><span>&#10022;</span><span>Perfil, comentários e notificações personalizadas</span></div>
          </div>
        </div>
        <div class='tiny' style='position:relative;z-index:1;color:rgba(255,255,255,.58)'>MP SCAN &#8226; leitura confortável em qualquer tela</div>
      </aside>

      <section class='auth-form-side'>
        <div class='auth-tabs' id='authTabs'>
          <button class='auth-tab active' data-auth-view='login' id='showLogin' type='button'>Entrar</button>
          <button class='auth-tab' data-auth-view='register' id='showRegister' type='button'>Criar conta</button>
        </div>

        <div id='loginForm'>
          <div class='auth-view-head'>
            <div class='auth-kicker'>Bem-vindo de volta</div>
            <h2>Entre no MP SCAN</h2>
            <p>Acesse sua biblioteca, seu progresso e tudo o que você salvou.</p>
          </div>
          <div class='auth-field'><label for='loginEmail'>E-mail</label><div class='auth-input'><span class='auth-input-icon'>&#9993;</span><input autocomplete='email' id='loginEmail' inputmode='email' placeholder='voce@exemplo.com' type='email'/></div></div>
          <div class='auth-field'><label for='loginPassword'>Senha</label><div class='auth-input'><span class='auth-input-icon'>&#8961;</span><input autocomplete='current-password' id='loginPassword' placeholder='Sua senha' type='password'/><button aria-label='Mostrar ou ocultar senha' class='auth-password-toggle' data-password-toggle='loginPassword' type='button'>&#9673;</button></div></div>
          <div class='auth-between'><span class='tiny'>Sua sessão fica sincronizada neste aparelho.</span><button class='auth-link' id='forgotButton' type='button'>Esqueci minha senha</button></div>
          <button class='btn primary auth-main-btn' id='loginButton' type='button'>Entrar na minha conta</button>
          <div class='auth-divider'>ou entre com</div>
          <button class='auth-social-btn google-auth-button' data-google-auth='login' type='button'><span class='google-mark'>G</span><span>Continuar com Google</span></button>
          <div class='auth-provider-note'>Ao entrar com Google, o Firebase usa a conta escolhida para identificar seu perfil com segurança.</div>
          <div class='auth-divider'>ou</div>
          <button class='btn ghost auth-secondary-btn' id='guestButton' type='button'>Continuar como visitante</button>
          <a class='telegram-auth-link' href='https://t.me/MPSCAN0' rel='noopener noreferrer' target='_blank'>&#9992; Entrar no canal do Telegram</a>
          <div class='auth-note'><span>&#10003;</span><div><strong>E-mail verificado.</strong> Contas novas recebem um link de confirmação para comprovar que o endereço realmente pertence à pessoa cadastrada.</div></div>
        </div>

        <div class='hidden' id='registerForm'>
          <div class='auth-view-head'>
            <div class='auth-kicker'>Sua conta MP SCAN</div>
            <h2>Crie seu perfil</h2>
            <p>Leva só alguns instantes. Depois, enviaremos uma confirmação para o seu e-mail.</p>
          </div>
          <div class='auth-two-col'>
            <div class='auth-field'><label for='registerName'>Nome</label><div class='auth-input'><span class='auth-input-icon'>&#9786;</span><input autocomplete='name' id='registerName' maxlength='60' placeholder='Como quer ser chamado?'/></div></div>
            <div class='auth-field'><label for='registerUsername'>@username</label><div class='auth-input'><span class='auth-input-icon'>@</span><input autocomplete='username' id='registerUsername' maxlength='24' placeholder='seunome'/></div></div>
          </div>
          <div class='auth-field'><label for='registerEmail'>E-mail</label><div class='auth-input'><span class='auth-input-icon'>&#9993;</span><input autocomplete='email' id='registerEmail' inputmode='email' placeholder='voce@exemplo.com' type='email'/></div></div>
          <div class='auth-two-col'>
            <div class='auth-field'><label for='registerPassword'>Senha</label><div class='auth-input'><span class='auth-input-icon'>&#8961;</span><input autocomplete='new-password' id='registerPassword' placeholder='Crie uma senha' type='password'/><button aria-label='Mostrar ou ocultar senha' class='auth-password-toggle' data-password-toggle='registerPassword' type='button'>&#9673;</button></div><div class='password-strength' data-score='0' id='registerPasswordStrength'><span></span><span></span><span></span><span></span></div><div class='password-strength-label' id='registerPasswordStrengthLabel'>Use pelo menos 6 caracteres.</div></div>
            <div class='auth-field'><label for='registerPasswordConfirm'>Confirmar senha</label><div class='auth-input'><span class='auth-input-icon'>&#10003;</span><input autocomplete='new-password' id='registerPasswordConfirm' placeholder='Repita a senha' type='password'/><button aria-label='Mostrar ou ocultar senha' class='auth-password-toggle' data-password-toggle='registerPasswordConfirm' type='button'>&#9673;</button></div></div>
          </div>
          <button class='btn primary auth-main-btn' id='registerButton' type='button'>Criar minha conta</button>
          <div class='auth-divider'>ou cadastre-se com</div>
          <button class='auth-social-btn google-auth-button' data-google-auth='register' type='button'><span class='google-mark'>G</span><span>Continuar com Google</span></button>
          <div class='auth-provider-note'>Com Google, seu e-mail já vem confirmado pelo provedor e você entra mais rápido.</div>
          <div class='auth-note'><span>&#9993;</span><div><strong>Confirmação obrigatória no cadastro por senha.</strong> Se criar a conta com e-mail e senha, o Firebase enviará um link de confirmação antes de liberar a conta normalmente.</div></div>
        </div>

        <div class='hidden auth-verify' id='verifyEmailForm'>
          <div class='auth-verify-icon'>&#9993;</div>
          <div class='auth-kicker'>Último passo</div>
          <h2>Confirme seu e-mail</h2>
          <p>Enviamos um link de confirmação. Abra sua caixa de entrada, toque no link e depois volte aqui.</p>
          <div class='auth-email-pill'><span>&#9993;</span><span id='verifyEmailAddress'>Seu e-mail</span></div>
          <div class='auth-verify-actions'>
            <button class='btn primary auth-main-btn' id='checkEmailVerification' type='button'>Já confirmei meu e-mail</button>
            <button class='btn ghost auth-secondary-btn' id='resendVerificationEmail' type='button'>Reenviar e-mail de confirmação</button>
            <button class='auth-link' id='verificationBackToLogin' type='button'>Voltar para o login</button>
          </div>
          <div class='auth-status' id='verificationStatus'></div>
          <div class='auth-note' style='text-align:left'><span>&#8981;</span><div>Se não encontrar a mensagem, confira também as pastas <strong>Spam</strong> e <strong>Lixo eletrônico</strong>.</div></div>
        </div>
      </section>
    </div>
  </div>

  <div class='modal-backdrop collection-modal' id='collectionModal'>
    <div class='modal'>
      <div class='row' style='justify-content:space-between'>
        <div><h2 id='collectionModalTitle'>Nova coleção</h2><p>Monte uma estante do seu jeito.</p></div>
        <button class='icon-btn' data-collection-modal-close='true' type='button'>&#215;</button>
      </div>
      <div class='field'><label>Nome da coleção</label><input id='collectionName' maxlength='60' placeholder='Ex.: Favoritos de romance'/></div>
      <div class='field'><label>Descrição <span class='tiny'>(opcional)</span></label><textarea id='collectionDescription' maxlength='300' placeholder='Escreva um pouquinho sobre esta coleção...'></textarea></div>
      <div class='field'><label>Capa <span class='tiny'>(opcional)</span></label><button class='btn ghost' data-open-collection-cover='true' type='button'>🖼&#65039; Escolher capa</button><input accept='image/*' class='admin-file-hidden' id='collectionCoverFile' type='file'/><div class='tiny' id='collectionCoverStatus' style='margin-top:7px'>Nenhuma nova capa selecionada.</div><div class='collection-cover-preview' id='collectionCoverPreview'>Sem capa</div><button class='btn ghost hidden' data-remove-collection-cover='true' id='removeCollectionCover' type='button'>Remover capa</button></div>
      <div class='field'><label>Quem pode ver?</label><div class='privacy-choice'><button class='active' data-collection-privacy='private' type='button'><strong>🔒 Privada</strong><small>Só você consegue ver.</small></button><button data-collection-privacy='public' type='button'><strong>🌐 Pública</strong><small>Outros leitores podem descobrir.</small></button></div><input id='collectionPrivacy' type='hidden' value='private'/></div>
      <input id='editingCollectionId' type='hidden'/>
      <div class='row' style='justify-content:flex-end;margin-top:16px'><button class='btn ghost' data-collection-modal-close='true' type='button'>Cancelar</button><button class='btn primary' id='saveCollectionButton' type='button'>Salvar coleção</button></div>
    </div>
  </div>

  <div class='modal-backdrop collection-modal' id='collectionPickerModal'>
    <div class='modal'>
      <div class='row' style='justify-content:space-between'>
        <div><h2>Adicionar à coleção</h2><p>Toque nas coleções onde esta obra deve ficar.</p></div>
        <button class='icon-btn' data-collection-picker-close='true' type='button'>&#215;</button>
      </div>
      <div class='collection-picker-list' id='collectionPickerList'></div>
      <div class='row' style='justify-content:space-between;margin-top:14px'><button class='btn ghost' data-picker-create-collection='true' type='button'>+ Criar coleção</button><button class='btn primary' id='saveCollectionPicker' type='button'>Salvar alterações</button></div>
    </div>
  </div>

  <div class='modal-backdrop theme-panel-modal' id='themePanelModal'>
    <div class='modal'>
      <div class='row' style='justify-content:space-between'>
        <div><h2>Aparência</h2><p>Escolha o modo e uma paleta. A preferência fica salva neste aparelho.</p></div>
        <button class='icon-btn' data-theme-panel-close='true' type='button'>&#215;</button>
      </div>
      <div class='appearance-modes'>
        <button class='appearance-mode' data-appearance='light' type='button'>&#9728; Claro</button>
        <button class='appearance-mode' data-appearance='dark' type='button'>&#9790; Escuro</button>
        <button class='appearance-mode' data-appearance='system' type='button'>&#9680; Aparelho</button>
      </div>
      <div class='section-head'><h3 class='section-title'>Paletas</h3><span class='section-sub'>Prévia</span></div>
      <div class='palette-grid'>
        <button class='palette-card' data-palette-choice='default' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#7b4dff,#ff5aa5)'></div><strong>MP padrão</strong><small>Violeta + rosa</small></button>
        <button class='palette-card' data-palette-choice='wine' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#9d2449,#d9657f)'></div><strong>Vinho sofisticado</strong><small>Profundo e elegante</small></button>
        <button class='palette-card' data-palette-choice='purple' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#6d4aff,#a45cff)'></div><strong>Roxo noturno</strong><small>Vibrante sem exagero</small></button>
        <button class='palette-card' data-palette-choice='sky' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#286fd1,#52b7e8)'></div><strong>Azul celestial</strong><small>Limpo e moderno</small></button>
        <button class='palette-card' data-palette-choice='aurora' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#c23f7a,#f17ca8)'></div><strong>Rosa aurora</strong><small>Suave e marcante</small></button>
        <button class='palette-card' data-palette-choice='emerald' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#168466,#3fb98f)'></div><strong>Verde esmeralda</strong><small>Fresco e confortável</small></button>
        <button class='palette-card' data-palette-choice='gold' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#a96d12,#d6a536)'></div><strong>Dourado elegante</strong><small>Quente e sofisticado</small></button>
        <button class='palette-card' data-palette-choice='rose' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#d84b86,#ff9ac2)'></div><strong>Rosé</strong><small>Rosa refinado</small></button>
        <button class='palette-card' data-palette-choice='ocean' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#137fa4,#4dd7e8)'></div><strong>Oceano</strong><small>Azul turquesa</small></button>
        <button class='palette-card' data-palette-choice='midnight' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#4656d8,#9a70ff)'></div><strong>Meia-noite</strong><small>Azul + violeta</small></button>
        <button class='palette-card' data-palette-choice='sunset' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#e65c48,#f4a94b)'></div><strong>Pôr do sol</strong><small>Coral + dourado</small></button>
        <button class='palette-card' data-palette-choice='lavender' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#8d68cf,#d5a6ff)'></div><strong>Lavanda</strong><small>Delicado e luminoso</small></button>
        <button class='palette-card' data-palette-choice='cherry' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#c92f55,#ff6d8c)'></div><strong>Cereja</strong><small>Vermelho rosado</small></button>
        <button class='palette-card' data-palette-choice='cyber' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#00a6a6,#b25cff)'></div><strong>Cyber</strong><small>Turquesa + roxo</small></button>
        <button class='palette-card' data-palette-choice='ice' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#5897dc,#aee7ff)'></div><strong>Gelo</strong><small>Azul cristalino</small></button>
        <button class='palette-card' data-palette-choice='cocoa' type='button'><div class='palette-preview' style='background:linear-gradient(135deg,#8b5a45,#d69a74)'></div><strong>Cacau</strong><small>Marrom aconchegante</small></button>
        <button class='palette-card' data-palette-choice='custom' type='button'><div class='palette-preview' id='customPalettePreview' style='background:linear-gradient(135deg,#7b4dff,#ff5aa5)'></div><strong>Personalizado</strong><small>Suas próprias cores</small></button>
      </div>
    </div>
  </div>

  <div class='shell'><div class='firebase-status' id='firebaseStatus'></div></div>
  <div class='toast' id='toast'></div>

  <script type='text/javascript'>
//<![CDATA[

    (function(){
      'use strict';
      const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>Array.from(r.querySelectorAll(s));
      window.addEventListener('error',function(ev){const st=document.querySelector('#firebaseStatus');if(st){st.textContent='Erro no MP SCAN: '+(ev.message||'falha inesperada')+'.';st.classList.add('error');}});
      const pageRoots={'/inicio':'home','/buscar':'search','/biblioteca':'library','/perfil':'profile','/configuracoes':'settings','/adm':'admin','/obra':'work','/capitulo':'chapter','/notificacoes':'notifications','/colecao':'collection','/suporte':'support','/calendario':'calendar','/evento-divulgacao':'referral'};
      function toast(message){const el=$('#toast');if(!el)return;el.textContent=message;el.classList.add('show');clearTimeout(window.__toastTimer);window.__toastTimer=setTimeout(()=>el.classList.remove('show'),2800);}
      function cleanPath(raw){let p=(raw||'').trim();if(p.startsWith('#'))p=p.slice(1);if(!p.startsWith('/'))p='/'+p;p=p.replace(/\/{2,}/g,'/');if(p.length>1&&p.endsWith('/'))p=p.slice(0,-1);return p||'/inicio';}
      function routeInfo(path){const p=cleanPath(path),parts=p.split('/').filter(Boolean),root='/'+(parts[0]||'inicio');let page=pageRoots[root]||'home',id=null,sub=parts[1]||'',workId=null;
        if(root==='/obra'){page='work';id=parts[1]||null;}
        if(root==='/capitulo'){page='chapter';workId=parts[1]||null;id=parts[2]||parts[1]||null;}
        if(root==='/perfil'&&parts[1]&&parts[1]!=='editar'){page='public-profile';id=parts[1];}
        if(root==='/perfil'&&parts[1]==='editar'){page='profile-edit';}
        if(root==='/configuracoes'&&parts[1]){page='settings-detail';sub=parts[1];}
        if(root==='/configuracoes'&&parts[1]==='maioridade'){page='age-settings';sub='maioridade';}
        if(root==='/configuracoes'&&parts[1]==='sensivel'){page='sensitive-settings';sub='sensivel';}
        if(root==='/colecao'){page='collection';id=parts[1]||null;}
        return {path:p,root,page,id,sub,parts,workId};}
      let current=routeInfo('/inicio'),scrollTimer=null;
      function saveScroll(){try{sessionStorage.setItem('mp_scroll:'+current.path,String(window.scrollY||0));}catch(e){}}
      function restoreScroll(info){let y=0;try{y=parseInt(sessionStorage.getItem('mp_scroll:'+info.path)||'0',10)||0;}catch(e){}requestAnimationFrame(()=>requestAnimationFrame(()=>window.scrollTo(0,y)));}
      function applyLibrarySubroute(info){if(info.root!=='/biblioteca')return;const map={historico:'history',colecoes:'collections',publico:'public',continuar:'continue',downloads:'downloads',favoritos:'favorites','':'favorites'},key=map[info.sub]||'favorites';$$('[data-library-tab]').forEach(el=>el.classList.toggle('active',el.dataset.libraryTab===key));$$('[data-library-panel]').forEach(el=>el.classList.toggle('active',el.dataset.libraryPanel===key));}
      function applyAdminSubroute(info){
        if(info.root!=='/adm')return;
        const map={'visao-geral':'dashboard',dashboard:'dashboard',obras:'works',capitulos:'chapters',usuarios:'users',comentarios:'comments',reacoes:'reactions',molduras:'frames',banners:'banners',notificacoes:'notifications',divulgacao:'referrals',documentos:'documents',estatisticas:'stats','':'dashboard'},key=map[info.sub]||'dashboard';
        $$('[data-admin-tab]').forEach(el=>el.classList.toggle('active',el.dataset.adminTab===key));
        $('#adminWorks')?.classList.toggle('hidden',key!=='works');
        $('#adminPlaceholder')?.classList.toggle('hidden',key==='works');
      }
      function renderRoute(path,opts){saveScroll();current=routeInfo(path);try{localStorage.setItem('mp_last_route',current.path);}catch(e){}$$('.page').forEach(p=>p.classList.toggle('active',p.dataset.page===current.page));$$('[data-nav-root]').forEach(n=>n.classList.toggle('active',n.dataset.navRoot===({home:'home',search:'search',library:'library',profile:'profile','public-profile':'profile','profile-edit':'profile',settings:'settings','settings-detail':'settings','age-settings':'settings','sensitive-settings':'settings',support:'settings',referral:'home'}[current.page]||'')));$('#calendarButton')?.classList.toggle('active',current.page==='calendar');applyLibrarySubroute(current);applyAdminSubroute(current);document.body.setAttribute('data-route',current.path);document.dispatchEvent(new CustomEvent('mp:route',{detail:current}));if(!opts||!opts.keepScroll){if(current.page==='chapter')requestAnimationFrame(()=>window.scrollTo(0,0));else restoreScroll(current);}}
      function navigate(path,replace){const p=cleanPath(path);if(replace){history.replaceState(null,'','#'+p);renderRoute(p);}else if(location.hash==='#'+p){renderRoute(p);}else location.hash=p;}
      document.addEventListener('click',e=>{const back=e.target.closest('[data-back]');if(back){e.preventDefault();history.length>1?history.back():navigate('/inicio');return;}const copy=e.target.closest('[data-copy-link]');if(copy){e.preventDefault();const url=location.href;if(navigator.clipboard?.writeText)navigator.clipboard.writeText(url).then(()=>toast('Link copiado.')).catch(()=>toast('Copie o endereço do navegador.'));else toast('Copie o endereço do navegador.');return;}const route=e.target.closest('[data-route]');if(route){e.preventDefault();navigate(route.getAttribute('data-route'));}});
      window.addEventListener('hashchange',()=>renderRoute(location.hash.slice(1)));window.addEventListener('scroll',()=>{clearTimeout(scrollTimer);scrollTimer=setTimeout(saveScroll,120);},{passive:true});window.addEventListener('beforeunload',saveScroll);
      const systemTheme=window.matchMedia?.('(prefers-color-scheme: dark)');
      function savedAppearance(){try{return localStorage.getItem('mp_appearance')||localStorage.getItem('mp_theme')||'dark';}catch(e){return'dark';}}
      function savedPalette(){try{return localStorage.getItem('mp_palette')||'default';}catch(e){return'default';}}
      function storedCustomPalette(){try{const v=JSON.parse(localStorage.getItem('mp_custom_palette')||'{}')||{};return{accent:/^#[0-9a-f]{6}$/i.test(v.accent||'')?v.accent:'#7b4dff',accent2:/^#[0-9a-f]{6}$/i.test(v.accent2||'')?v.accent2:'#ff5aa5'};}catch(e){return{accent:'#7b4dff',accent2:'#ff5aa5'};}}
      function resolveAppearance(mode){return mode==='system'?(systemTheme?.matches?'dark':'light'):(mode==='light'?'light':'dark');}
      function syncThemePanel(){const appearance=savedAppearance(),palette=savedPalette(),custom=storedCustomPalette();$$('[data-appearance]').forEach(b=>b.classList.toggle('active',b.dataset.appearance===appearance));$$('[data-palette-choice]').forEach(b=>b.classList.toggle('active',b.dataset.paletteChoice===palette));const cp=$('#customPalettePreview');if(cp)cp.style.background='linear-gradient(135deg,'+custom.accent+','+custom.accent2+')';}
      function setTheme(mode){const allowed=['light','dark','system'];mode=allowed.includes(mode)?mode:'dark';document.documentElement.dataset.theme=resolveAppearance(mode);try{localStorage.setItem('mp_appearance',mode);localStorage.setItem('mp_theme',resolveAppearance(mode));}catch(e){}const meta=document.querySelector('meta[name="theme-color"]');if(meta)meta.content=resolveAppearance(mode)==='dark'?'#0b0b0d':'#f5f5f8';syncThemePanel();document.dispatchEvent(new CustomEvent('mp:appearance'));}
      function setPalette(palette){const allowed=['default','wine','purple','sky','aurora','emerald','gold','rose','ocean','midnight','sunset','lavender','cherry','cyber','ice','cocoa','custom'];palette=allowed.includes(palette)?palette:'default';const root=document.documentElement;root.dataset.palette=palette;if(palette==='custom'){const c=storedCustomPalette();root.style.setProperty('--accent',c.accent);root.style.setProperty('--accent2',c.accent2);root.style.setProperty('--accent-soft','color-mix(in srgb,'+c.accent+' 16%,transparent)');}else{root.style.removeProperty('--accent');root.style.removeProperty('--accent2');root.style.removeProperty('--accent-soft');}try{localStorage.setItem('mp_palette',palette);}catch(e){}syncThemePanel();document.dispatchEvent(new CustomEvent('mp:appearance'));}
      function openThemePanel(){syncThemePanel();$('#themePanelModal')?.classList.add('open');}
      function closeThemePanel(){$('#themePanelModal')?.classList.remove('open');}
      setPalette(savedPalette());setTheme(savedAppearance());
      systemTheme?.addEventListener?.('change',()=>{if(savedAppearance()==='system')setTheme('system');});
      document.addEventListener('click',e=>{const open=e.target.closest('[data-theme-panel-open]');if(open){e.preventDefault();openThemePanel();return;}const close=e.target.closest('[data-theme-panel-close]');if(close||e.target?.id==='themePanelModal'){e.preventDefault();closeThemePanel();return;}const mode=e.target.closest('[data-appearance]');if(mode){e.preventDefault();setTheme(mode.dataset.appearance);return;}const pal=e.target.closest('[data-palette-choice]');if(pal){e.preventDefault();setPalette(pal.dataset.paletteChoice);return;}});
      $('#settingsTheme')?.addEventListener('click',openThemePanel);
      const authModal=$('#authModal');
      function authView(view='login',email=''){
        const views={login:$('#loginForm'),register:$('#registerForm'),verify:$('#verifyEmailForm')};
        Object.entries(views).forEach(([k,el])=>el?.classList.toggle('hidden',k!==view));
        $$('.auth-tab').forEach(b=>b.classList.toggle('active',b.dataset.authView===view));
        $('#authTabs')?.classList.toggle('hidden',view==='verify');
        if(email&&$('#verifyEmailAddress'))$('#verifyEmailAddress').textContent=email;
        if(view==='login')setTimeout(()=>$('#loginEmail')?.focus(),80);
        if(view==='register')setTimeout(()=>$('#registerName')?.focus(),80);
      }
      function openAuth(view='login'){authModal?.classList.add('open');authView(view);}
      function closeAuth(){authModal?.classList.remove('open');}
      window.MPUI={toast,openAuth,closeAuth,setTheme,setPalette,authView};
      $$('.open-auth').forEach(b=>b.addEventListener('click',()=>openAuth('login')));
      $('#closeAuth')?.addEventListener('click',closeAuth);
      authModal?.addEventListener('click',e=>{if(e.target===authModal)closeAuth();});
      $('#showRegister')?.addEventListener('click',()=>authView('register'));
      $('#showLogin')?.addEventListener('click',()=>authView('login'));
      document.addEventListener('click',e=>{const b=e.target.closest('[data-password-toggle]');if(!b)return;const input=document.getElementById(b.dataset.passwordToggle);if(!input)return;input.type=input.type==='password'?'text':'password';b.textContent=input.type==='password'?'◉':'◌';});
      function authPasswordStrength(){const input=$('#registerPassword'),bar=$('#registerPasswordStrength'),label=$('#registerPasswordStrengthLabel');if(!input||!bar||!label)return;const p=input.value||'';let score=0;if(p.length>=6)score++;if(p.length>=9)score++;if(/[A-Z]/.test(p)&&/[a-z]/.test(p))score++;if(/\d/.test(p)&&/[^A-Za-z0-9]/.test(p))score++;bar.dataset.score=String(score);label.textContent=['Use pelo menos 6 caracteres.','Senha básica','Senha boa','Senha forte','Senha muito forte'][score]||'Use pelo menos 6 caracteres.';}
      $('#registerPassword')?.addEventListener('input',authPasswordStrength);
      const initial=(location.hash?location.hash.slice(1):(()=>{try{return localStorage.getItem('mp_last_route')||'/inicio';}catch(e){return'/inicio';}})());if(!location.hash)history.replaceState(null,'','#'+cleanPath(initial));renderRoute(initial);window.MPRouter={navigate,render:renderRoute,current:()=>current,routeInfo};
    })();
  
//]]>
</script>

  <script src='https://www.gstatic.com/firebasejs/12.18.0/firebase-app-compat.js'></script>
  <script src='https://www.gstatic.com/firebasejs/12.18.0/firebase-auth-compat.js'></script>
  <script src='https://www.gstatic.com/firebasejs/12.18.0/firebase-database-compat.js'></script>

  <script type='text/javascript'>
//<![CDATA[

    const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>Array.from(r.querySelectorAll(s));
    const ui=window.MPUI, router=window.MPRouter;
    const state={user:null,profile:null,role:'user',allWorks:[],allWorkMap:{},works:[],workMap:{},chapters:{},ratings:{},ratingStats:{},favorites:{},history:{},collections:{},notifications:{},genres:[],banners:{},firebaseReady:false,selectedGenres:new Set(),adminSelectedGenres:new Set(),unsubs:[],adminPageFiles:[],previewUrls:[],editingChapter:null,workTabs:{},profileTabs:{self:'overview'},profileRenderSeq:0,commentRenderSeq:{},commentDrafts:{},commentFiles:{},commentSpoilers:{},commentLocks:{},publicCollections:{},editingCollection:null,collectionPickerWorkId:null,collectionPickerSelected:new Set(),homeHeroIndex:0,rankPrevious:{},rankCurrent:{},adminDocDrafts:{},adminDocDirty:false,adminDocEditing:false,supportUnsubs:[],supportView:'home',supportTopic:'geral',supportSelectedUid:'',supportAdminTab:'chats',supportAdminChats:{},supportAdminRequests:{},supportAdminDrafts:{},supportBotLogs:{},supportBotMessages:[],supportBotLastQuestion:'',supportBotSessionId:'',supportDraft:{requestName:'',requestAlt:'',requestType:'',requestLink:'',requestNotes:'',chat:'',bot:''},supportEditing:false,supportViewMounted:'',commentFrames:{},commentFrameInventory:{},adminFrameDraft:{name:'',active:true,editingId:'',imageUrl:'',file:null,bgColor:'#17171d',textColor:'#f7f7f8',accentColor:'#7b4dff',glowColor:'#7b4dff',bgOpacity:92,brightness:100,saturation:100,frameOpacity:100,glow:18,radius:22,padding:16,spread:10,blur:0,effect:'none'},adminFrameEditing:false,adminUpdateDays:new Set(),calendarMonthOffset:0,calendarSelectedKey:'',referralProfile:null,referralInvites:{},referralRewards:{},referralUsed:null,referralStudio:{uid:'',tier:0},referralFrameTarget:null};

    function defaultAppSettings(){return {textScale:100,reduceMotion:false,highContrast:false,readableFont:false,largeTargets:false,compactMode:false,heroAutoRotate:true,dataSaver:false,haptics:false,autoMarkNotifications:true,showNotificationBadge:true,notifyReply:true,notifyReaction:true,notifyFollower:true,notifyChapter:true,notifyAdmin:true,showFavoritesPublic:true,dateStyle:'relative',appearanceGlow:34,appearanceAmbient:14,appearanceCardOpacity:92,appearanceGlassBlur:10,appearanceBackgroundDim:78,appearanceBackgroundBlur:0,appearanceBgPosition:'center',appearanceBgFit:'cover',ambientMotion:true,glassUi:false,glowingUi:true,shinyUi:true,customAccent:'#7b4dff',customAccent2:'#ff5aa5',appearanceGlowColor:'#9d7cff'};}
    function safeAppearanceColor(v,fallback){v=String(v||'').trim();return /^#[0-9a-f]{6}$/i.test(v)?v.toLowerCase():fallback;}
    function getAppearanceBackground(){try{return localStorage.getItem('mp_appearance_background')||'';}catch(e){return'';}}
    function saveAppearanceBackground(data){try{if(data)localStorage.setItem('mp_appearance_background',data);else localStorage.removeItem('mp_appearance_background');return true;}catch(e){return false;}}
    function getAppSettings(){let local={};try{local=JSON.parse(localStorage.getItem('mp_app_settings')||'{}')||{};}catch(e){}const remote=(state.profile&&state.profile.appSettings&&typeof state.profile.appSettings==='object')?state.profile.appSettings:{};return {...defaultAppSettings(),...local,...remote};}
    function applyAppSettings(p=getAppSettings()){
      const root=document.documentElement;root.style.setProperty('--ui-font-scale',String(Math.max(.9,Math.min(1.3,num(p.textScale)/100||1))));root.dataset.reduceMotion=p.reduceMotion?'true':'false';root.dataset.highContrast=p.highContrast?'true':'false';root.dataset.readableFont=p.readableFont?'true':'false';root.dataset.largeTargets=p.largeTargets?'true':'false';root.dataset.compactUi=p.compactMode?'true':'false';if(p.reduceMotion){try{if(window.__mpHeroTimer){clearInterval(window.__mpHeroTimer);window.__mpHeroTimer=null;}}catch(_e){}try{stopReaderAutoScroll?.();}catch(_e){}document.querySelectorAll('.profile-rank-intro').forEach(x=>x.remove());}
      const clamp=(v,min,max,fallback)=>{v=Number(v);return Number.isFinite(v)?Math.max(min,Math.min(max,v)):fallback;};
      root.style.setProperty('--ui-glow',clamp(p.appearanceGlow,0,100,34)+'%');root.style.setProperty('--ui-ambient',clamp(p.appearanceAmbient,0,70,14)+'%');root.style.setProperty('--ui-card-opacity',clamp(p.appearanceCardOpacity,55,100,92)+'%');root.style.setProperty('--ui-glass-blur',clamp(p.appearanceGlassBlur,0,24,10)+'px');root.style.setProperty('--app-bg-dim',clamp(p.appearanceBackgroundDim,0,100,78)+'%');root.style.setProperty('--app-bg-blur',clamp(p.appearanceBackgroundBlur,0,16,0)+'px');root.style.setProperty('--ui-glow-color',safeAppearanceColor(p.appearanceGlowColor,'#9d7cff'));
      root.style.setProperty('--app-bg-size',['cover','contain'].includes(String(p.appearanceBgFit||''))?p.appearanceBgFit:'cover');root.style.setProperty('--app-bg-position',['center','top','bottom','left','right'].includes(String(p.appearanceBgPosition||''))?p.appearanceBgPosition:'center');root.dataset.ambientMotion=p.ambientMotion&&!p.reduceMotion?'true':'false';root.dataset.glassUi=p.glassUi?'true':'false';root.dataset.glowingUi=p.glowingUi?'true':'false';root.dataset.shinyUi=p.shinyUi&&!p.reduceMotion?'true':'false';
      const bg=getAppearanceBackground();root.style.setProperty('--app-bg-image',bg?'url("'+bg.replace(/"/g,'%22')+'")':'none');root.dataset.customBackground=bg?'true':'false';
      const c1=safeAppearanceColor(p.customAccent,'#7b4dff'),c2=safeAppearanceColor(p.customAccent2,'#ff5aa5');try{localStorage.setItem('mp_custom_palette',JSON.stringify({accent:c1,accent2:c2}));}catch(e){}if(root.dataset.palette==='custom'){root.style.setProperty('--accent',c1);root.style.setProperty('--accent2',c2);root.style.setProperty('--accent-soft','color-mix(in srgb,'+c1+' 16%,transparent)');}
    }
    async function saveAppSettings(patch={},sync=true){const next={...getAppSettings(),...patch};try{localStorage.setItem('mp_app_settings',JSON.stringify(next));}catch(e){}if(state.profile&&!state.user?.isAnonymous)state.profile={...state.profile,appSettings:next};applyAppSettings(next);updateSettingsHome();renderNotifications();updateNotificationBadge();if(sync&&state.firebaseReady&&isMember())try{await dbUpdate('usuarios/'+state.user.uid,{appSettings:next});}catch(e){console.warn('Configurações da conta não sincronizadas:',e);}return next;}
    function settingModeLabel(){let m='dark',p='default';try{m=localStorage.getItem('mp_appearance')||localStorage.getItem('mp_theme')||'dark';p=localStorage.getItem('mp_palette')||'default';}catch(e){}const ml={dark:'Escuro',light:'Claro',system:'Sistema'}[m]||'Escuro',pl={default:'Padrão',wine:'Vinho',purple:'Roxo',sky:'Azul',aurora:'Aurora',emerald:'Esmeralda',gold:'Dourado',rose:'Rosé',ocean:'Oceano',midnight:'Meia-noite',sunset:'Pôr do sol',lavender:'Lavanda',cherry:'Cereja',cyber:'Cyber',ice:'Gelo',cocoa:'Cacau',custom:'Personalizado'}[p]||'Padrão';return ml+' • '+pl;}
    function notificationVisible(n){if(n?.tipo==='follow_request')return true;const p=getAppSettings(),map={reply:'notifyReply',reaction:'notifyReaction',follower:'notifyFollower',follow_request_accepted:'notifyFollower',follow_request_rejected:'notifyFollower',chapter:'notifyChapter',admin:'notifyAdmin'};const key=map[n?.tipo];return key?p[key]!==false:true;}
    function updateSettingsHome(){const p=getAppSettings(),s=readerSettings?.()||{},logged=isMember?.()||false,photo=state.profile?.foto||'',av=$('#settingsHomeAvatar'),user=$('#settingsHomeUser');if(av)av.innerHTML=photo?"<img src='"+escapeAttr(photo)+"' alt='Foto do perfil'/>":'👤';if(user)user.textContent=logged?((state.profile?.nome||'Usuário')+(state.profile?.nomeUsuario?' • @'+state.profile.nomeUsuario:'')):'Visitante • entre para sincronizar suas preferências';const set=(id,v)=>{const e=$(id);if(e)e.textContent=v;};set('#settingsHomeThemeValue',settingModeLabel());set('#settingsHomeReaderValue',s.mode==='one'?'Uma página':'Vertical');const accessActive=[p.readableFont,p.highContrast,p.largeTargets,p.reduceMotion,p.haptics,num(p.textScale)!==100].filter(Boolean).length;set('#settingsHomeAccessValue',accessActive?(accessActive+' recurso'+(accessActive===1?'':'s')):'Padrão');set('#settingsHomeNotifValue',[p.notifyReply,p.notifyReaction,p.notifyFollower,p.notifyChapter,p.notifyAdmin].filter(Boolean).length+'/5 ativas');set('#settingsHomeAccountValue',logged?(state.user?.emailVerified?'Confirmada':'Pendente'):'Visitante');set('#settingsHomePrivacyValue',state.profile?.publico===false?'Privado':'Público');set('#settingsHomeAgeValue',state.profile?.ageVerified?'18+ confirmado':(state.profile?.ageVerificationStatus==='minor'?'Menor de 18':'Não informada'));set('#settingsHomeSensitiveValue',state.profile?.ageVerified&&state.profile?.sensivelPermitido?'Permitido':(state.profile?.minorSensitiveApproved?'Aprovado':'Bloqueado'));set('#settingsHomeDataValue',p.dataSaver?'Economia ativa':'Normal');}
    function filterSettingsHome(){const q=($('#settingsSearch')?.value||'').trim().toLocaleLowerCase('pt-BR');let visible=0;$$('[data-settings-group]').forEach(group=>{let any=false;$$('[data-settings-card]',group).forEach(card=>{const hay=(card.dataset.settingsCard+' '+card.textContent).toLocaleLowerCase('pt-BR'),show=!q||hay.includes(q);card.classList.toggle('hidden',!show);if(show)any=true;});group.classList.toggle('hidden-by-search',!any);