      </section>

      <section class='page' data-page='admin' id='/adm'>
        <div class='admin-page-shell'>
        <div class='admin-hero-pro'>
          <div class='admin-hero-row'>
            <div class='admin-brand-pro'>
              <div class='admin-brand-icon'>&#10022;</div>
              <div class='admin-brand-copy'>
                <h1>Painel administrativo</h1>
                <p>Gerencie o MP SCAN em um único lugar, com dados reais do Firebase.</p>
                <span class='admin-role-pill'>🛡&#65039; <span id='adminRoleText'>Administrador</span></span>
              </div>
            </div>
            <a class='btn ghost route-link' data-route='/perfil' href='#/perfil'>&#8592; Voltar ao perfil</a>
          </div>
        </div>

        <div class='panel' id='adminDenied'>
          <h3>Acesso administrativo não reconhecido</h3>
          <p class='section-sub'>Entre com uma conta autorizada. O MP SCAN agora reconhece ADM pelas mesmas formas previstas nas suas regras: permissão no perfil, UID ou e-mail autorizado.</p>
        </div>

        <div class='hidden' id='adminContent'>
          <div class='admin-quick-stats' id='adminQuickStats'>
            <div class='admin-quick-stat'><strong>&#8212;</strong><span>Obras</span></div>
            <div class='admin-quick-stat'><strong>&#8212;</strong><span>Capítulos</span></div>
            <div class='admin-quick-stat'><strong>&#8212;</strong><span>Usuários</span></div>
            <div class='admin-quick-stat'><strong>&#8212;</strong><span>Leituras</span></div>
          </div>
          <div class='admin-nav'>
            <a class='admin-nav-link active' data-admin-tab='dashboard' data-route='/adm/visao-geral' href='#/adm/visao-geral'><span class='admin-nav-icon'>&#8962;</span><span class='admin-nav-label'>Visão geral</span></a>
            <a class='admin-nav-link' data-admin-tab='works' data-route='/adm/obras' href='#/adm/obras'><span class='admin-nav-icon'>&#9635;</span><span class='admin-nav-label'>Obras</span></a>
            <a class='admin-nav-link' data-admin-tab='chapters' data-route='/adm/capitulos' href='#/adm/capitulos'><span class='admin-nav-icon'>&#9783;</span><span class='admin-nav-label'>Capítulos</span></a>
            <a class='admin-nav-link' data-admin-tab='users' data-route='/adm/usuarios' href='#/adm/usuarios'><span class='admin-nav-icon'>👥</span><span class='admin-nav-label'>Usuários</span></a>
            <a class='admin-nav-link' data-admin-tab='comments' data-route='/adm/comentarios' href='#/adm/comentarios'><span class='admin-nav-icon'>💬</span><span class='admin-nav-label'>Comentários</span></a>
            <a class='admin-nav-link' data-admin-tab='reactions' data-route='/adm/reacoes' href='#/adm/reacoes'><span class='admin-nav-icon'>&#10024;</span><span class='admin-nav-label'>Reações</span></a>
            <a class='admin-nav-link' data-admin-tab='frames' data-route='/adm/molduras' href='#/adm/molduras'><span class='admin-nav-icon'>🖼</span><span class='admin-nav-label'>Molduras</span></a>
            <a class='admin-nav-link' data-admin-tab='banners' data-route='/adm/banners' href='#/adm/banners'><span class='admin-nav-icon'>&#9648;</span><span class='admin-nav-label'>Banners</span></a>
            <a class='admin-nav-link' data-admin-tab='notifications' data-route='/adm/notificacoes' href='#/adm/notificacoes'><span class='admin-nav-icon'>🔔</span><span class='admin-nav-label'>Notificações</span></a>
            <a class='admin-nav-link' data-admin-tab='referrals' data-route='/adm/divulgacao' href='#/adm/divulgacao'><span class='admin-nav-icon'>🎁</span><span class='admin-nav-label'>Divulgação</span></a>
            <a class='admin-nav-link' data-route='/suporte' href='#/suporte'><span class='admin-nav-icon'>🛟</span><span class='admin-nav-label'>Suporte</span></a>
            <a class='admin-nav-link' data-admin-tab='documents' data-route='/adm/documentos' href='#/adm/documentos'><span class='admin-nav-icon'>&#9636;</span><span class='admin-nav-label'>Documentos</span></a>
            <a class='admin-nav-link' data-admin-tab='stats' data-route='/adm/estatisticas' href='#/adm/estatisticas'><span class='admin-nav-icon'>&#8599;</span><span class='admin-nav-label'>Estatísticas</span></a>
          </div>

          <div class='panel admin-panel-stable' id='adminWorks'>
            <div class='admin-section-title'><div><h2>Obras</h2><p>Cadastre uma nova obra ou edite o catálogo existente.</p></div><button class='btn ghost' id='clearWorkFormTop' type='button'>&#65291; Nova obra</button></div>
            <div class='field'><label>Nome</label><input id='workName'/></div>
            <div class='field'><label>Nome alternativo</label><input id='workAltName'/></div>
            <div class='field'><label>Sinopse</label><textarea id='workSynopsis'></textarea></div>
            <div class='field'><label>Tipo</label>
              <select id='workType'>
                <option value='manga'>Mangá</option><option value='manhwa'>Manhwa</option>
                <option value='manhua'>Manhua</option><option value='novel'>Novel</option>
                <option value='webtoon'>Webtoon</option><option value='oneshot'>One-shot</option>
                <option value='hq'>HQ</option><option value='other'>Outro</option>
              </select>
            </div>
            <div class='field'><label>Status</label>
              <select id='workStatus'>
                <option value='ongoing'>Em andamento</option>
                <option value='complete'>Completa</option>
                <option value='paused'>Pausada</option>
                <option value='cancelled'>Cancelada</option>
                <option value='future'>Futura</option>
              </select>
              <div class='work-status-preview' id='workStatusPreview'><i></i><div><strong id='workStatusPreviewTitle'>Em andamento</strong><div id='workStatusPreviewText'>A obra continua recebendo capítulos.</div></div></div>
            </div>
            <div class='field work-update-schedule-field'>
              <label>Dia de atualização</label>
              <div class='work-schedule-editor'>
                <div class='work-schedule-mode-grid'>
                  <button class='work-schedule-mode active' data-work-schedule-mode='none' type='button'><span>&#9675;</span><strong>Sem dia fixo</strong><small>Não mostrar no calendário</small></button>
                  <button class='work-schedule-mode' data-work-schedule-mode='weekly' type='button'><span>7</span><strong>Dias da semana</strong><small>Ex.: terça e sexta</small></button>
                  <button class='work-schedule-mode' data-work-schedule-mode='monthly' type='button'><span>31</span><strong>Dia do mês</strong><small>Ex.: todo dia 9</small></button>
                </div>
                <input id='workUpdateScheduleType' type='hidden' value='none'/>
                <div class='work-schedule-weekly hidden' id='workScheduleWeekly'>
                  <div class='work-schedule-label'>Selecione um ou mais dias</div>
                  <div class='work-weekday-grid'>
                    <button data-work-update-day='0' type='button'>DOM</button><button data-work-update-day='1' type='button'>SEG</button><button data-work-update-day='2' type='button'>TER</button><button data-work-update-day='3' type='button'>QUA</button><button data-work-update-day='4' type='button'>QUI</button><button data-work-update-day='5' type='button'>SEX</button><button data-work-update-day='6' type='button'>SÁB</button>
                  </div>
                </div>
                <div class='work-schedule-monthly hidden' id='workScheduleMonthly'>
                  <div class='work-schedule-label'>Todo dia</div>
                  <div class='work-month-day-row'><input id='workUpdateMonthDay' inputmode='numeric' max='31' min='1' placeholder='Ex.: 9' type='number'/><span>de cada mês</span></div>
                </div>
                <div class='work-schedule-summary' id='workScheduleSummary'>Esta obra não tem um dia fixo de atualização.</div>
              </div>
            </div>
            <div class='field'><label>Autor</label><input id='workAuthor'/></div>
            <div class='field'><label>Artista</label><input id='workArtist'/></div>
            <div class='field'><label>Scan</label><input id='workScan'/></div>
            <div class='field'><label>Idioma</label><input id='workLanguage' value='Português'/></div>
            <div class='field'>
              <label>Gêneros</label>
              <div class='admin-genre-box'>
                <div class='section-sub' style='margin-bottom:9px'>Toque nos gêneros que pertencem à obra. Eles ficam salvos para reutilizar em todas as obras.</div>
                <div class='admin-genre-picker' id='adminGenrePicker'></div>
                <div class='admin-genre-manager'>
                  <div class='admin-genre-create'>
                    <input id='newGenreName' placeholder='Criar novo gênero'/>
                    <button class='btn primary' id='createGenreButton' type='button'>+ Criar</button>
                  </div>
                  <div class='admin-genre-library' id='adminGenreLibrary'></div>
                </div>
              </div>
            </div>
            <div class='field'><label>Tags separadas por vírgula</label><input id='workTags'/></div>
            <div class='field'><label>Capa da obra</label><div class='admin-upload admin-media-upload' id='workCoverUploadBox'><button class='admin-file-pick' data-open-file='workCoverFile' type='button'>🖼&#65039; Escolher capa</button><input accept='image/*' class='admin-file-hidden' id='workCoverFile' type='file'/><div class='admin-file-status-line'><span class='admin-file-state-dot'></span><div class='admin-file-status' id='workCoverStatus'>Nenhuma capa nova selecionada.</div></div><div class='admin-single-preview' id='workCoverPreview'></div></div></div>
            <div class='field'><label>Banner da obra</label><div class='admin-upload admin-media-upload' id='workBannerUploadBox'><button class='admin-file-pick' data-open-file='workBannerFile' type='button'>🌄 Escolher banner</button><input accept='image/*' class='admin-file-hidden' id='workBannerFile' type='file'/><div class='admin-file-status-line'><span class='admin-file-state-dot'></span><div class='admin-file-status' id='workBannerStatus'>Nenhum banner novo selecionado.</div></div><div class='admin-single-preview' id='workBannerPreview'></div></div></div>
            <div class='work-flags-title'>Classificação do conteúdo</div>
            <div class='work-flags-grid'>
              <label class='work-flag-card' for='workSensitive' id='workSensitiveCard'>
                <input id='workSensitive' type='checkbox'/>
                <span class='work-flag-icon'>&#9888;</span>
                <span class='work-flag-copy'><strong>Conteúdo sensível</strong><small>Marca a obra para leitores que ativaram conteúdo sensível.</small></span>
                <span class='work-flag-side'><span class='work-flag-state' id='workSensitiveState'>DESATIVADO</span><span class='work-flag-switch'><i></i></span></span>
              </label>
              <label class='work-flag-card' for='workAdult' id='workAdultCard'>
                <input id='workAdult' type='checkbox'/>
                <span class='work-flag-icon'>18+</span>
                <span class='work-flag-copy'><strong>Conteúdo com restrição etária</strong><small>Restringe a obra conforme a verificação de idade configurada no MP SCAN.</small></span>
                <span class='work-flag-side'><span class='work-flag-state' id='workAdultState'>DESATIVADO</span><span class='work-flag-switch'><i></i></span></span>
              </label>
            </div>
            <input id='editingWorkId' type='hidden'/>
            <div class='row' style='margin-top:12px'>
              <button class='btn' id='saveDraftWork' type='button'>Salvar rascunho</button>
              <button class='btn primary' id='publishWork' type='button'>Publicar</button>
            </div>
            <div class='work-save-status' id='workSaveStatus'>As opções de classificação serão confirmadas aqui quando você ativar e salvar.</div>
            <p class='upload-note'>Capa e banner são gravados sem redimensionamento/compressão intencional. Como esta versão usa Realtime Database, arquivos muito grandes podem ser recusados pelo próprio Firebase.</p>
            <div class='section-head' style='margin-top:22px'><h3 class='section-title'>Obras cadastradas</h3><button class='btn ghost' id='clearWorkForm' type='button'>Nova obra</button></div>
            <div class='admin-grid' id='adminWorksList'></div>
          </div>

          <div class='panel hidden' id='adminPlaceholder'><div id='adminDynamic'><div class='skeleton'></div></div></div>
        </div>
            </div>
      </section>
    </main>
  </div>

  <nav class='bottom-nav'>
    <div class='nav-inner'>
      <a class='nav-btn active' data-nav-root='home' data-route='/inicio' href='#/inicio'><span>&#8962;</span><span>Início</span></a>
      <a class='nav-btn' data-nav-root='search' data-route='/buscar' href='#/buscar'><span>&#8981;</span><span>Buscar</span></a>
      <a class='nav-btn' data-nav-root='library' data-route='/biblioteca' href='#/biblioteca'><span>&#9825;</span><span>Biblioteca</span></a>
      <a class='nav-btn' data-nav-root='profile' data-route='/perfil' href='#/perfil' id='profileNavLink'><span>&#9786;</span><span>Perfil</span></a>
      <a class='nav-btn' data-nav-root='settings' data-route='/configuracoes' href='#/configuracoes'><span>&#9881;</span><span>Ajustes</span></a>
