g,color-mix(in srgb,var(--bg) 28%,transparent),color-mix(in srgb,var(--bg) 72%,transparent))}.appearance-pro-preview-card{position:absolute;left:14px;right:14px;bottom:14px;padding:13px 14px;border:1px solid color-mix(in srgb,var(--accent) 32%,var(--line));border-radius:17px;background:color-mix(in srgb,var(--surface) 82%,transparent);backdrop-filter:blur(12px);box-shadow:0 10px 28px color-mix(in srgb,var(--accent) 18%,transparent)}.appearance-pro-preview-card strong{display:block}.appearance-pro-preview-card span{display:block;margin-top:4px;color:var(--muted);font-size:.72rem}
    .appearance-control-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.appearance-color-control{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:10px;padding:11px;border:1px solid var(--line);border-radius:15px;background:var(--surface-2)}.appearance-color-control strong{display:block;font-size:.78rem}.appearance-color-control small{display:block;color:var(--muted);font-size:.65rem;margin-top:2px}.appearance-color-control input[type=color]{width:48px;height:38px;border:1px solid var(--line);border-radius:11px;background:var(--surface);padding:3px}.appearance-background-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.appearance-background-status{margin-top:8px;font-size:.72rem;color:var(--muted);line-height:1.45}.appearance-bg-preview{height:130px;border-radius:18px;border:1px dashed color-mix(in srgb,var(--accent) 40%,var(--line));overflow:hidden;background:linear-gradient(135deg,var(--surface-2),color-mix(in srgb,var(--accent) 8%,var(--surface)));display:grid;place-items:center;color:var(--muted);font-size:.75rem}.appearance-bg-preview img{width:100%;height:100%;object-fit:cover}.appearance-select-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.appearance-section-note{padding:10px 12px;border:1px solid color-mix(in srgb,var(--accent) 22%,var(--line));border-radius:14px;background:color-mix(in srgb,var(--accent) 7%,var(--surface-2));color:var(--muted);font-size:.72rem;line-height:1.45}

    @media(max-width:759px){
      .topbar-inner{height:60px}.brand{font-size:.9rem;gap:8px}.brand-mark{width:33px;height:33px}.header-action{width:37px;height:37px;border-radius:13px}.top-actions{gap:5px}
      .home-feature{min-height:492px;margin-left:-4px;margin-right:-4px;border-radius:28px}.home-feature-inner{min-height:492px;padding:24px 18px;align-items:flex-end}.home-feature:after{background:linear-gradient(0deg,rgba(7,7,10,.97) 0%,rgba(7,7,10,.67) 52%,rgba(7,7,10,.12) 100%)}.home-feature-poster{display:none}.home-feature-title{font-size:2.35rem}.home-feature-desc{-webkit-line-clamp:2;font-size:.87rem}.home-feature-actions{width:100%}.feature-main-btn,.feature-ghost-btn{flex:1;padding:0 11px}.home-feature-dots{left:18px;right:auto;bottom:15px;transform:translateY(0)}
      .ranking-track{grid-auto-columns:86vw;margin-right:-16px}.rank-card{grid-template-columns:52px 68px minmax(0,1fr)}.rank-number{font-size:3.65rem}.rank-cover{width:68px}
      .continue-reading-pro .home-section-head p{display:none}.continue-track{grid-auto-columns:clamp(132px,38vw,158px);gap:9px;margin-right:-8px;padding-bottom:9px}.continue-card{padding:6px;gap:6px;border-radius:16px}.continue-cover{aspect-ratio:.84;border-radius:12px}.continue-progress-badge{top:6px;right:6px;width:34px;height:34px}.continue-progress-badge::before{inset:3px}.continue-progress-badge b{font-size:.58rem}.continue-ch-pill{left:6px;bottom:6px;padding:5px 7px;font-size:.54rem}.continue-eyebrow{display:none}.continue-copy{gap:3px}.continue-title{font-size:.76rem}.continue-chapter{font-size:.59rem}.continue-page{display:none}.continue-progress{height:4px}.continue-percent{font-size:.59rem}.continue-btn{padding:6px 7px;border-radius:8px;font-size:.55rem}.continue-foot{gap:5px;margin-top:0}
      .updates-modern{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.update-card{gap:8px}.update-cover{border-radius:18px}.update-status-badge{top:8px;left:8px;padding:7px 9px;font-size:.58rem;gap:6px}.update-status-badge:before{width:7px;height:7px}.update-title-link{font-size:.86rem;min-height:2.35em}.update-chapter-button{min-height:43px;padding:0 58px 0 9px;border-radius:13px}.update-chapter-button.no-new{padding-right:9px}.update-chapter-main{font-size:.78rem}.update-new-slot{right:5px;height:29px;padding:0 8px;border-radius:9px;font-size:.57rem;gap:4px}.update-new-slot .update-new-star{font-size:.55rem}.update-date{font-size:.63rem}.home-section-title-fancy{gap:9px}.home-section-star,.home-section-face{width:34px;height:34px}
      .palette-grid{grid-template-columns:1fr 1fr}.appearance-control-grid,.appearance-select-grid{grid-template-columns:1fr}
    }
    @media(min-width:980px){.home-feature-inner{padding:52px 58px}.home-feature-poster{width:190px}.updates-modern{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.update-title-link{font-size:1.16rem}.update-chapter-button{min-height:56px}.continue-track{grid-auto-columns:minmax(178px,195px);gap:14px}}



    @media(max-width:390px){.continue-track{grid-auto-columns:clamp(126px,36vw,142px)}.continue-title{font-size:.72rem}.continue-chapter{font-size:.56rem}.continue-progress-badge{width:32px;height:32px}.continue-btn{font-size:.52rem}.update-new-slot{padding:0 7px;font-size:.54rem}.update-chapter-button{padding-right:55px}.update-chapter-main{font-size:.74rem}}
    /* ===== BUSCA V24 ===== */
    .search-pro{padding:22px 0 8px}
    .search-pro-hero{
      position:relative;overflow:hidden;border:1px solid var(--line);border-radius:28px;
      background:
        radial-gradient(circle at 85% 10%,color-mix(in srgb,var(--accent) 28%,transparent),transparent 34%),
        linear-gradient(145deg,var(--surface),color-mix(in srgb,var(--surface-2) 86%,var(--accent)));
      padding:22px;box-shadow:var(--shadow)
    }
    .search-pro-kicker{font-size:.78rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
    .search-pro-title{margin:6px 0 7px;font-size:clamp(1.6rem,5vw,2.5rem);line-height:1.02}
    .search-pro-sub{margin:0;color:var(--muted);max-width:700px;line-height:1.55}
    .search-pro-bar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;margin-top:18px}
    .search-pro-input{
      min-width:0;height:56px;border:1px solid var(--line);background:color-mix(in srgb,var(--surface-2) 92%,transparent);
      color:var(--text);border-radius:18px;padding:0 17px;font-size:1rem;outline:0;box-shadow:inset 0 1px 0 rgba(255,255,255,.03)
    }
    .search-pro-input:focus{border-color:color-mix(in srgb,var(--accent) 65%,var(--line));box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 13%,transparent)}
    .search-filter-trigger{
      min-width:128px;height:56px;border:1px solid color-mix(in srgb,var(--accent) 42%,var(--line));
      border-radius:18px;background:var(--accent);color:white;font-weight:900;padding:0 16px;display:flex;align-items:center;justify-content:center;gap:8px
    }
    .search-filter-count{display:none;min-width:22px;height:22px;padding:0 6px;border-radius:999px;background:#fff;color:#111;place-items:center;font-size:.72rem;font-weight:950}
    .search-filter-count.show{display:grid}
    .search-summary{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:18px 0 12px}
    .search-summary strong{font-size:1.02rem}.search-summary span{color:var(--muted);font-size:.86rem}
    .search-active-filters{display:flex;gap:8px;overflow:auto;padding-bottom:4px;scrollbar-width:none;margin-bottom:14px}
    .search-active-filters::-webkit-scrollbar{display:none}
    .search-active-chip{
      white-space:nowrap;border:1px solid color-mix(in srgb,var(--accent) 28%,var(--line));background:color-mix(in srgb,var(--accent) 9%,var(--surface));
      color:var(--text);border-radius:999px;padding:8px 11px;font-size:.78rem;font-weight:800
    }
    .search-active-chip b{color:var(--accent);margin-left:5px}
    .search-results-pro{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;padding-bottom:20px}
    .search-result-card{
      display:grid;grid-template-columns:92px minmax(0,1fr);gap:13px;padding:11px;border:1px solid var(--line);border-radius:20px;
      background:var(--surface);min-width:0;transition:.2s transform,.2s border-color,.2s box-shadow
    }
    .search-result-card:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--accent) 38%,var(--line));box-shadow:var(--shadow)}
    .search-result-cover{width:92px;aspect-ratio:3/4;border-radius:14px;overflow:hidden;background:var(--surface-2)}
    .search-result-cover img{width:100%;height:100%;object-fit:cover}
    .search-result-copy{min-width:0;display:flex;flex-direction:column;justify-content:center}
    .search-result-title{font-weight:900;font-size:.98rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .search-result-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px}
    .search-result-pill{padding:5px 8px;border-radius:999px;background:var(--surface-2);border:1px solid var(--line);font-size:.7rem;color:var(--muted);font-weight:750}
    .search-result-pill.accent{background:color-mix(in srgb,var(--accent) 13%,var(--surface-2));color:var(--text);border-color:color-mix(in srgb,var(--accent) 30%,var(--line))}
    .search-result-last{font-size:.76rem;color:var(--muted);margin-top:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

    .search-filter-backdrop{position:fixed;inset:0;z-index:390;background:rgba(0,0,0,.58);display:none;align-items:flex-end;justify-content:center;padding:0}
    .search-filter-backdrop.open{display:flex}
    .search-filter-sheet{
      width:min(100%,760px);max-height:92vh;overflow:auto;background:var(--surface);border:1px solid var(--line);
      border-radius:28px 28px 0 0;padding:18px 18px calc(20px + env(safe-area-inset-bottom));box-shadow:0 -24px 70px rgba(0,0,0,.38)
    }
    .filter-sheet-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;position:sticky;top:-18px;background:var(--surface);z-index:2;padding:18px 0 12px;border-bottom:1px solid var(--line)}
    .filter-sheet-head h2{margin:0;font-size:1.25rem}.filter-sheet-head p{margin:4px 0 0;color:var(--muted);font-size:.82rem}
    .filter-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:16px}
    .filter-field{display:grid;gap:7px}.filter-field.full{grid-column:1/-1}
    .filter-field label{font-size:.78rem;font-weight:850;color:var(--muted)}
    .filter-control{
      width:100%;min-width:0;height:48px;border:1px solid var(--line);border-radius:14px;background:var(--surface-2);color:var(--text);
      padding:0 12px;outline:0
    }
    .filter-control:focus{border-color:color-mix(in srgb,var(--accent) 55%,var(--line))}
    .filter-genre-grid{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
    .filter-genre-chip{
      border:1px solid var(--line);background:var(--surface-2);color:var(--text);padding:9px 11px;border-radius:999px;font-size:.8rem;font-weight:800
    }
    .filter-genre-chip.active{background:var(--accent);border-color:var(--accent);color:white}
    .filter-sheet-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;position:sticky;bottom:-20px;background:linear-gradient(transparent,var(--surface) 28%);padding:30px 0 4px;margin-top:8px}

    .admin-genre-box{border:1px solid var(--line);background:var(--surface-2);border-radius:18px;padding:13px}
    .admin-genre-picker{display:flex;flex-wrap:wrap;gap:8px;min-height:42px}
    .admin-genre-chip{border:1px solid var(--line);background:var(--surface);color:var(--text);border-radius:999px;padding:9px 11px;font-size:.8rem;font-weight:850}
    .admin-genre-chip.active{background:var(--accent);border-color:var(--accent);color:#fff}
    .admin-genre-manager{margin-top:10px;border-top:1px solid var(--line);padding-top:12px}
    .admin-genre-create{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}
    .admin-genre-create input{height:44px;border:1px solid var(--line);border-radius:13px;background:var(--surface);color:var(--text);padding:0 12px;outline:0}
    .admin-genre-library{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
    .admin-genre-library span{padding:6px 9px;border-radius:999px;background:var(--surface);border:1px solid var(--line);font-size:.72rem;color:var(--muted)}

    @media(min-width:760px){
      .search-filter-backdrop{align-items:center;padding:22px}
      .search-filter-sheet{border-radius:28px}
      .search-results-pro{grid-template-columns:repeat(2,minmax(0,1fr))}
    }
    @media(min-width:1050px){
      .search-results-pro{grid-template-columns:repeat(3,minmax(0,1fr))}
    }
    @media(max-width:520px){
      .search-pro-hero{padding:18px;border-radius:23px}
      .search-pro-bar{grid-template-columns:1fr}
      .search-filter-trigger{width:100%}
      .search-results-pro{grid-template-columns:1fr}
      .search-result-card{grid-template-columns:84px minmax(0,1fr)}
      .search-result-cover{width:84px}
      .filter-grid{grid-template-columns:1fr}
      .filter-field.full{grid-column:auto}
    }


    /* ===== MP SCAN v25 — Configurações profissionais ===== */
    :root{--ui-font-scale:1}
    html{font-size:calc(16px * var(--ui-font-scale,1))}
    html[data-reduce-motion='true'] *,html[data-reduce-motion='true'] *::before,html[data-reduce-motion='true'] *::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
    html[data-reduce-motion='true']{scroll-behavior:auto!important}
    html[data-reduce-motion='true'] .profile-rank-intro,html[data-reduce-motion='true'] .app-splash,html[data-reduce-motion='true'] .home-feature-dots{animation:none!important}
    html[data-high-contrast='true']{--line:color-mix(in srgb,var(--text) 48%,transparent);--muted:color-mix(in srgb,var(--text) 86%,transparent)}
    html[data-high-contrast='true'] .settings-section-card,html[data-high-contrast='true'] .settings-pro-group,html[data-high-contrast='true'] .card,html[data-high-contrast='true'] .comment-v2,html[data-high-contrast='true'] input,html[data-high-contrast='true'] select,html[data-high-contrast='true'] textarea,html[data-high-contrast='true'] .btn{border-color:color-mix(in srgb,var(--text) 48%,transparent)!important}
    html[data-high-contrast='true'] .muted,html[data-high-contrast='true'] .tiny,html[data-high-contrast='true'] small{color:color-mix(in srgb,var(--text) 86%,transparent)!important}
    html[data-high-contrast='true'] a:focus-visible,html[data-high-contrast='true'] button:focus-visible,html[data-high-contrast='true'] input:focus-visible,html[data-high-contrast='true'] select:focus-visible,html[data-high-contrast='true'] textarea:focus-visible{outline:3px solid var(--accent)!important;outline-offset:3px!important}
    html[data-readable-font='true'] body,html[data-readable-font='true'] button,html[data-readable-font='true'] input,html[data-readable-font='true'] select,html[data-readable-font='true'] textarea{font-family:Arial,Verdana,system-ui,sans-serif!important;letter-spacing:.012em;word-spacing:.025em}
    html[data-readable-font='true'] p,html[data-readable-font='true'] .section-sub,html[data-readable-font='true'] .settings-option-copy small{line-height:1.58}
    html[data-large-targets='true'] button,html[data-large-targets='true'] .btn,html[data-large-targets='true'] .nav-btn,html[data-large-targets='true'] .settings-pro-card,html[data-large-targets='true'] a[data-route],html[data-large-targets='true'] .reaction-pill,html[data-large-targets='true'] .comment-link-btn,html[data-large-targets='true'] select,html[data-large-targets='true'] input:not([type='checkbox']):not([type='radio']):not([type='range']){min-height:52px!important}
    html[data-large-targets='true'] .icon-btn,html[data-large-targets='true'] .header-action{min-width:48px!important;min-height:48px!important}
    html[data-large-targets='true'] .settings-option-row{min-height:64px;padding-top:15px;padding-bottom:15px}
    html[data-large-targets='true'] .app-toggle{width:54px;height:32px}
    html[data-large-targets='true'] .app-toggle span:after{width:24px;height:24px}
    html[data-large-targets='true'] .app-toggle input:checked+span:after{transform:translateX(22px)}
    html[data-large-targets='true'] input[type='range']{min-height:38px;touch-action:pan-x}
    html[data-compact-ui='true'] .card-body{padding:9px}html[data-compact-ui='true'] .section{margin:20px 0}
    .settings-app{padding:20px 0 34px}
    .settings-pro-hero{position:relative;overflow:hidden;border:1px solid var(--line);border-radius:28px;background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 24%,var(--surface)),var(--surface));padding:22px;box-shadow:var(--shadow);margin-bottom:18px}
    .settings-pro-hero:after{content:'';position:absolute;width:220px;height:220px;border-radius:50%;right:-70px;top:-90px;background:color-mix(in srgb,var(--accent) 22%,transparent);filter:blur(8px);pointer-events:none}
    .settings-pro-user{position:relative;z-index:1;display:flex;align-items:center;gap:14px;min-width:0}
    .settings-pro-avatar{width:58px;height:58px;border-radius:18px;background:var(--surface-2);border:1px solid var(--line);overflow:hidden;display:grid;place-items:center;font-size:1.35rem;flex:0 0 auto}.settings-pro-avatar img{width:100%;height:100%;object-fit:cover}
    .settings-pro-usercopy{min-width:0;flex:1}.settings-pro-usercopy h1{margin:0;font-size:1.45rem;line-height:1.08}.settings-pro-usercopy p{margin:5px 0 0;color:var(--muted);font-size:.82rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .settings-pro-theme{position:relative;z-index:1;border:1px solid color-mix(in srgb,var(--accent) 35%,var(--line));background:var(--accent-soft);color:var(--text);border-radius:15px;padding:10px 12px;font-weight:850;white-space:nowrap}
    .settings-searchbox{display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:var(--surface);border-radius:18px;padding:0 15px;box-shadow:0 8px 24px rgba(0,0,0,.06);margin-bottom:18px}.settings-searchbox input{width:100%;height:52px;background:transparent;border:0;outline:0;color:var(--text);font-size:.95rem}.settings-searchbox span{color:var(--muted)}
    .settings-pro-grid{display:grid;grid-template-columns:1fr;gap:16px}
    .settings-pro-group{background:var(--surface);border:1px solid var(--line);border-radius:24px;overflow:hidden}.settings-pro-group.hidden-by-search{display:none}
    .settings-pro-group-head{display:flex;align-items:center;gap:11px;padding:17px 17px 11px}.settings-pro-group-icon{width:38px;height:38px;border-radius:13px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;font-size:1.08rem}.settings-pro-group-head h2{font-size:.98rem;margin:0}.settings-pro-group-head p{font-size:.72rem;color:var(--muted);margin:3px 0 0}
    .settings-pro-list{display:grid;padding:0 8px 8px}
    .settings-pro-card{display:grid;grid-template-columns:42px minmax(0,1fr) auto;align-items:center;gap:12px;border:0;border-top:1px solid var(--line);background:transparent;color:var(--text);padding:13px 9px;text-align:left;width:100%;text-decoration:none;transition:.18s background,.18s transform}.settings-pro-card:first-child{border-top:0}.settings-pro-card:hover{background:var(--surface-2)}.settings-pro-card:active{transform:scale(.995)}
    .settings-pro-card-icon{width:40px;height:40px;border-radius:13px;background:var(--surface-2);display:grid;place-items:center;font-size:1rem}.settings-pro-card-copy{min-width:0}.settings-pro-card-copy strong{display:block;font-size:.9rem}.settings-pro-card-copy small{display:block;color:var(--muted);font-size:.72rem;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.settings-pro-card-side{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:.72rem}.settings-value-pill{max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:5px 8px;border-radius:999px;background:var(--surface-2);border:1px solid var(--line)}
    .settings-search-empty{padding:32px 18px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:20px;background:var(--surface)}
    .settings-footer-card{margin-top:16px;padding:17px;border:1px solid var(--line);border-radius:21px;background:var(--surface);display:flex;align-items:center;justify-content:space-between;gap:12px}.settings-footer-card strong{display:block}.settings-footer-card small{color:var(--muted)}
    .settings-detail-card{padding:18px 0 32px}.settings-detail-shell{display:grid;gap:14px}.settings-detail-hero{border:1px solid var(--line);border-radius:25px;background:linear-gradient(135deg,var(--surface),color-mix(in srgb,var(--accent) 10%,var(--surface)));padding:20px}.settings-detail-hero-icon{width:48px;height:48px;border-radius:16px;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;font-size:1.35rem;margin-bottom:12px}.settings-detail-hero h2{margin:0;font-size:1.25rem}.settings-detail-hero p{margin:6px 0 0;color:var(--muted);font-size:.82rem;line-height:1.5}
    .settings-section-card{border:1px solid var(--line);border-radius:22px;background:var(--surface);padding:16px}.settings-section-card h3{margin:0 0 4px;font-size:.95rem}.settings-section-card>p{margin:0 0 12px;color:var(--muted);font-size:.77rem}
    .settings-option-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 0;border-top:1px solid var(--line)}.settings-option-row:first-of-type{border-top:0}.settings-option-copy{min-width:0}.settings-option-copy strong{display:block;font-size:.86rem}.settings-option-copy small{display:block;color:var(--muted);font-size:.7rem;margin-top:3px;line-height:1.4}
    .app-toggle{position:relative;width:48px;height:28px;display:inline-block;flex:0 0 auto}.app-toggle input{position:absolute;opacity:0;pointer-events:none}.app-toggle span{position:absolute;inset:0;border-radius:999px;background:var(--surface-2);border:1px solid var(--line);transition:.2s}.app-toggle span:after{content:'';position:absolute;width:20px;height:20px;left:3px;top:3px;border-radius:50%;background:var(--muted);transition:.2s}.app-toggle input:checked+span{background:var(--accent);border-color:var(--accent)}.app-toggle input:checked+span:after{transform:translateX(20px);background:white}
    .settings-range-wrap{display:grid;grid-template-columns:minmax(0,1fr) 54px;align-items:center;gap:10px}.settings-range-wrap input{width:100%}.settings-range-value{text-align:center;padding:6px;border-radius:10px;background:var(--surface-2);font-size:.75rem;font-weight:850}
    .settings-choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.settings-choice{border:1px solid var(--line);background:var(--surface-2);color:var(--text);border-radius:14px;padding:11px;text-align:center;font-size:.78rem;font-weight:800}.settings-choice.active{border-color:var(--accent);background:var(--accent-soft);box-shadow:inset 0 0 0 1px var(--accent)}
    .settings-danger-zone{border-color:color-mix(in srgb,var(--danger) 40%,var(--line));background:color-mix(in srgb,var(--danger) 4%,var(--surface))}.settings-danger-zone h3{color:var(--danger)}
    .settings-info-strip{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:14px;background:var(--surface-2);font-size:.75rem;color:var(--muted)}
    .settings-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:13px}.settings-actions .btn{flex:0 0 auto}
    .settings-stat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.settings-mini-stat{border:1px solid var(--line);background:var(--surface-2);border-radius:15px;padding:12px}.settings-mini-stat strong{display:block;font-size:1.05rem}.settings-mini-stat span{font-size:.69rem;color:var(--muted)}
    @media(min-width:850px){.settings-pro-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.settings-pro-hero{padding:26px}.settings-detail-shell{grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr)}.settings-detail-shell>.settings-detail-hero{grid-column:1/-1}.settings-wide{grid-column:1/-1}}
    @media(max-width:560px){.settings-app{padding-top:14px}.settings-pro-hero{padding:17px;border-radius:23px}.settings-pro-theme{padding:9px;font-size:.76rem}.settings-pro-avatar{width:50px;height:50px;border-radius:16px}.settings-pro-usercopy h1{font-size:1.2rem}.settings-pro-card{grid-template-columns:40px minmax(0,1fr) auto}.settings-pro-card-side .settings-value-pill{display:none}.settings-choice-grid{grid-template-columns:1fr}.settings-stat-grid{grid-template-columns:1fr 1fr}.settings-actions{display:grid;grid-template-columns:1fr}.settings-actions .btn{width:100%}}


    /* ===== MP SCAN v26 — Painel ADM profissional ===== */
    .admin-page-shell{padding-top:18px}
    .admin-hero-pro{
      position:relative;overflow:hidden;border:1px solid var(--line);border-radius:28px;
      background:
        radial-gradient(circle at 86% 20%,color-mix(in srgb,var(--accent) 35%,transparent),transparent 35%),
        linear-gradient(135deg,color-mix(in srgb,var(--surface) 92%,#000),var(--surface-2));
      padding:22px;box-shadow:var(--shadow);margin-bottom:16px
    }
    .admin-hero-pro:after{content:"";position:absolute;inset:auto -80px -110px auto;width:260px;height:260px;border-radius:50%;background:color-mix(in srgb,var(--accent) 16%,transparent);filter:blur(10px)}
    .admin-hero-row{position:relative;z-index:1;display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap}
    .admin-brand-pro{display:flex;align-items:center;gap:13px;min-width:0}
    .admin-brand-icon{width:54px;height:54px;border-radius:18px;background:linear-gradient(135deg,var(--accent),color-mix(in srgb,var(--accent) 55%,#ff4db8));display:grid;place-items:center;font-size:1.35rem;box-shadow:0 14px 30px color-mix(in srgb,var(--accent) 25%,transparent)}
    .admin-brand-copy h1{font-size:clamp(1.45rem,4vw,2rem);margin:0;letter-spacing:-.03em}
    .admin-brand-copy p{margin:5px 0 0;color:var(--muted);font-size:.86rem;line-height:1.45}
    .admin-role-pill{display:inline-flex;align-items:center;gap:7px;margin-top:9px;padding:6px 10px;border-radius:999px;background:color-mix(in srgb,var(--accent) 14%,var(--surface));border:1px solid color-mix(in srgb,var(--accent) 38%,var(--line));font-size:.72rem;font-weight:850;color:var(--text)}
    .admin-quick-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:0 0 14px}
    .admin-quick-stat{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:14px;min-width:0}
    .admin-quick-stat strong{display:block;font-size:1.45rem;line-height:1;margin-bottom:6px}
    .admin-quick-stat span{font-size:.76rem;color:var(--muted)}
    .admin-nav{
      display:grid;grid-auto-flow:column;grid-auto-columns:minmax(130px,1fr);gap:9px;overflow-x:auto;
      padding:4px 1px 10px;margin:0 0 10px;scrollbar-width:none
    }
    .admin-nav::-webkit-scrollbar{display:none}
    .admin-nav-link{
      border:1px solid var(--line);background:var(--surface);color:var(--muted);border-radius:16px;
      min-height:70px;padding:10px 12px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;
      gap:4px;font-weight:800;white-space:nowrap;transition:.2s
    }
    .admin-nav-link .admin-nav-icon{font-size:1.15rem}
    .admin-nav-link .admin-nav-label{font-size:.78rem}
    .admin-nav-link.active{background:linear-gradient(135deg,var(--accent),color-mix(in srgb,var(--accent) 72%,#000));color:#fff;border-color:transparent;box-shadow:0 10px 24px color-mix(in srgb,var(--accent) 22%,transparent)}
    .admin-section-card{border:1px solid var(--line);background:var(--surface);border-radius:24px;padding:18px;margin-top:10px;box-shadow:0 12px 30px rgba(0,0,0,.06)}
    .admin-section-title{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:16px}
    .admin-section-title h2,.admin-section-title h3{margin:0;font-size:1.15rem}
    .admin-section-title p{margin:5px 0 0;color:var(--muted);font-size:.8rem;line-height:1.45}
    .admin-overview-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:14px}
    .admin-action-card{display:flex;align-items:center;gap:11px;padding:14px;border:1px solid var(--line);border-radius:18px;background:var(--surface-2);min-width:0}
    .admin-action-card:hover{border-color:color-mix(in srgb,var(--accent) 45%,var(--line))}
    .admin-action-icon{width:38px;height:38px;border-radius:12px;background:color-mix(in srgb,var(--accent) 13%,var(--surface));display:grid;place-items:center;flex:0 0 auto}
    .admin-action-card strong{display:block;font-size:.82rem}
    .admin-action-card span{display:block;color:var(--muted);font-size:.7rem;margin-top:3px}
    .admin-health{display:flex;align-items:center;gap:8px;font-size:.75rem;color:var(--muted);margin-top:12px}
    .admin-health-dot{width:9px;height:9px;border-radius:50%;background:var(--success);box-shadow:0 0 0 5px color-mix(in srgb,var(--success) 13%,transparent)}
    #adminWorks.panel,#adminPlaceholder.panel{border:0;background:transparent;padding:0;margin:0}
    #adminWorks{background:var(--surface);border:1px solid var(--line)!important;border-radius:24px;padding:18px!important}
    #adminDynamic>.admin-panel-stable,#adminDynamic>.admin-section-card{margin-top:0}
    .admin-grid .admin-item{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:14px;box-shadow:none}
    .admin-grid .admin-item:hover{border-color:color-mix(in srgb,var(--accent) 38%,var(--line))}
    .admin-item h4{font-size:.92rem}
    .admin-item .row .btn{flex:1;min-width:0;text-align:center}
    .admin-work-card-pro{display:grid;grid-template-columns:58px minmax(0,1fr);gap:12px;align-items:center}
    .admin-work-thumb{width:58px;height:78px;border-radius:12px;background:var(--surface-2);overflow:hidden;display:grid;place-items:center;color:var(--muted)}
    .admin-work-thumb img{width:100%;height:100%;object-fit:cover}
    .admin-work-info{min-width:0}
    .admin-work-info h4{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0 0 5px}
    .admin-user-card-head{display:flex;align-items:center;gap:10px;margin-bottom:10px}
    .admin-user-avatar{width:44px;height:44px;border-radius:14px;background:var(--surface-2);overflow:hidden;display:grid;place-items:center;flex:0 0 auto}
    .admin-user-avatar img{width:100%;height:100%;object-fit:cover}
    .admin-user-meta{min-width:0}
    .admin-user-meta strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .admin-user-meta span{display:block;color:var(--muted);font-size:.72rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
    .admin-dashboard-welcome{padding:2px 0 6px}
    .admin-dashboard-welcome h2{margin:0;font-size:1.35rem}
    .admin-dashboard-welcome p{color:var(--muted);font-size:.82rem;line-height:1.5;margin:6px 0 0}
    .admin-launch-btn{background:linear-gradient(135deg,var(--accent),color-mix(in srgb,var(--accent) 65%,#111))!important;color:#fff!important;border-color:transparent!important}
    .admin-access-card{position:relative;z-index:2;margin:18px 0 20px;border:1px solid color-mix(in srgb,var(--accent) 38%,var(--line));background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 12%,var(--surface)),var(--surface));border-radius:22px;padding:18px;display:grid;grid-template-columns:48px minmax(0,1fr) auto;align-items:center;gap:14px;box-shadow:0 14px 34px rgba(0,0,0,.12);overflow:hidden}
    .admin-access-card:before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:linear-gradient(180deg,var(--accent),color-mix(in srgb,var(--accent) 55%,#fff));pointer-events:none}
    .admin-access-icon{width:48px;height:48px;border-radius:15px;display:grid;place-items:center;background:color-mix(in srgb,var(--accent) 16%,var(--surface-2));border:1px solid color-mix(in srgb,var(--accent) 30%,var(--line));font-size:1.25rem}
    .admin-access-copy{min-width:0}.admin-access-card strong{display:block;margin:0 0 4px;font-size:.94rem}.admin-access-card p{margin:0;color:var(--muted);font-size:.78rem;line-height:1.45}
    .admin-access-card .admin-launch-btn{min-height:46px;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;padding:0 16px}
    @media(max-width:640px){.admin-access-card{grid-template-columns:44px minmax(0,1fr);padding:15px;gap:11px}.admin-access-icon{width:44px;height:44px;border-radius:14px}.admin-access-card .admin-launch-btn{grid-column:1/-1;width:100%;min-height:50px;margin-top:2px;font-size:.88rem}}
    @media(min-width:760px){
      .admin-quick-stats{grid-template-columns:repeat(4,minmax(0,1fr))}
      .admin-overview-actions{grid-template-columns:repeat(4,minmax(0,1fr))}
      .admin-nav{grid-auto-flow:unset;grid-template-columns:repeat(4,minmax(0,1fr));overflow:visible}
      .admin-nav-link{min-height:76px}
    }



    body.splash-on{overflow:hidden}
    .app-splash{
      position:fixed;inset:0;z-index:9999;
      display:flex;align-items:flex-end;justify-content:center;
      min-height:100dvh;padding:clamp(18px,4vw,46px);
      color:#fff;
      background-image:
        linear-gradient(180deg,rgba(5,2,7,.12) 0%,rgba(5,2,7,.08) 38%,rgba(5,2,7,.42) 70%,rgba(5,2,7,.82) 100%),
        linear-gradient(90deg,rgba(5,2,7,.38) 0%,transparent 18%,transparent 82%,rgba(5,2,7,.38) 100%),
        url('data:image/jpeg;base64,