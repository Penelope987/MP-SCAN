a'?'/obra/'+btn.dataset.workId:'/capitulo/'+btn.dataset.workId+'/'+btn.dataset.chapterId}).catch(()=>{});
      try{await renderComments(btn.dataset.commentType,btn.dataset.workId,btn.dataset.chapterId,btn.dataset.commentType==='obra'?'#workComments':'#chapterComments');}catch(e){console.warn('refresh comments after reply',e);}
    }
    async function reactReply(btn){if(!requireCommentMember())return;try{const base=commentPath(btn.dataset.commentType,btn.dataset.workId,btn.dataset.chapterId)+'/'+btn.dataset.reactReply+'/respostas/'+btn.dataset.replyId+'/reacoes/'+state.user.uid,current=await dbGet(base);if(current?.tipo===btn.dataset.reaction)await dbRemove(base);else await dbSet(base,{tipo:btn.dataset.reaction,data:now()});if(btn.dataset.owner!==state.user.uid)await sendNotification(btn.dataset.owner,{tipo:'reaction',titulo:'Reação na sua resposta',texto:(state.profile?.nome||'Alguém')+' reagiu '+btn.dataset.reaction+' à sua resposta.',link:btn.dataset.commentType==='obra'?'/obra/'+btn.dataset.workId:'/capitulo/'+btn.dataset.workId+'/'+btn.dataset.chapterId});await renderComments(btn.dataset.commentType,btn.dataset.workId,btn.dataset.chapterId,btn.dataset.commentType==='obra'?'#workComments':'#chapterComments');}catch(e){console.error(e);ui.toast('Não foi possível reagir à resposta.');}}
    function openCommentEdit(btn,isReply=false){if(!requireCommentMember())return;const current=decodeURIComponent(btn.dataset.currentText||''),target=isReply?btn.closest('.reply-bubble')?.querySelector('[data-reply-edit-box="'+btn.dataset.replyId+'"]'):btn.closest('.comment-v2')?.querySelector('[data-comment-edit-box="'+btn.dataset.editComment+'"]');if(!target)return;target.classList.remove('hidden');target.innerHTML="<textarea class='inline-edit-text' data-edit-text='true'>"+escapeHtml(current)+"</textarea><div class='inline-action-row'><button type='button' class='inline-mini-btn' data-cancel-inline='true'>Cancelar</button><button type='button' class='inline-mini-btn primary' "+(isReply?"data-save-reply-edit='"+btn.dataset.editReply+"' data-reply-id='"+btn.dataset.replyId+"'":"data-save-comment-edit='"+btn.dataset.editComment+"'")+" data-comment-type='"+btn.dataset.commentType+"' data-work-id='"+btn.dataset.workId+"' data-chapter-id='"+(btn.dataset.chapterId||'')+"'>Salvar</button></div>";setTimeout(()=>target.querySelector('textarea')?.focus(),30);}
    async function saveCommentEdit(btn,isReply=false){const box=btn.closest('.inline-edit-box'),text=box?.querySelector('[data-edit-text]')?.value.trim();if(!text){ui.toast('O texto não pode ficar vazio.');return;}btn.disabled=true;try{let path=commentPath(btn.dataset.commentType,btn.dataset.workId,btn.dataset.chapterId)+'/'+(isReply?btn.dataset.saveReplyEdit:btn.dataset.saveCommentEdit);if(isReply)path+='/respostas/'+btn.dataset.replyId;await dbUpdate(path,{texto:text,editadoEm:now()});ui.toast('Alteração salva.');await renderComments(btn.dataset.commentType,btn.dataset.workId,btn.dataset.chapterId,btn.dataset.commentType==='obra'?'#workComments':'#chapterComments');}catch(e){console.error(e);ui.toast('Não foi possível editar agora.');btn.disabled=false;}}

    async function toggleFollow(btn){if(!requireMember())return;const target=btn.dataset.followProfile;if(target===state.user.uid)return;const following=btn.dataset.following==='true';try{if(following){await Promise.allSettled([dbRemove('seguindo/'+state.user.uid+'/'+target),dbRemove('seguidores/'+target+'/'+state.user.uid),dbRemove('privateAccess/'+target+'/'+state.user.uid),dbRemove('followRequests/'+target+'/'+state.user.uid)]);btn.dataset.following='false';btn.textContent='Seguir';if(router.current()?.page==='public-profile')await renderPublicProfile(target);return;}const visibility=await dbGet('perfisPublicos/'+target).catch(()=>null);if(visibility?.publico===false){await requestPrivateFollow(target);return;}const p={data:now()};await dbSet('seguindo/'+state.user.uid+'/'+target,p);await dbSet('seguidores/'+target+'/'+state.user.uid,p);await dbRemove('followRequests/'+target+'/'+state.user.uid).catch(()=>{});btn.dataset.following='true';btn.textContent='Deixar de seguir';await sendNotification(target,{tipo:'follower',titulo:'Novo seguidor',texto:(state.profile?.nome||'Alguém')+' começou a seguir você.',link:'/perfil/'+state.user.uid});}catch(err){console.error(err);ui.toast(err?.code==='PERMISSION_DENIED'||String(err?.message||'').toLowerCase().includes('permission')?'O Firebase bloqueou o seguimento. Publique as regras v93 e tente novamente.':'Não foi possível atualizar este seguimento agora. Tente novamente.');}}
    async function reportProfile(target){if(!requireMember())return;const reason=prompt('Explique resumidamente o motivo da denúncia:');if(reason===null||reason.trim().length<3)return;await dbPush('denuncias/usuarios',{denuncianteUid:state.user.uid,alvoUid:target,motivo:reason.trim(),data:now(),status:'aberta'});ui.toast('Denúncia enviada.');}

    function setCollectionPrivacy(value){const v=value==='public'?'public':'private',input=$('#collectionPrivacy');if(input)input.value=v;$$('[data-collection-privacy]').forEach(b=>b.classList.toggle('active',b.dataset.collectionPrivacy===v));}
    function closeCollectionModal(){const m=$('#collectionModal');m?.classList.remove('open');state.editingCollection=null;window.__removeCollectionCover=false;}
    function updateCollectionCoverPreview(src){const p=$('#collectionCoverPreview');if(!p)return;if(src)p.innerHTML="<img src='"+escapeAttr(src)+"' alt='Prévia da coleção'/>";else p.textContent='Sem capa';}
    function openCollectionModal(id=null){if(!requireMember())return;const c=id?state.collections?.[id]||null:null;state.editingCollection=id||null;$('#editingCollectionId').value=id||'';$('#collectionModalTitle').textContent=id?'Editar coleção':'Nova coleção';$('#collectionName').value=c?.nome||'';$('#collectionDescription').value=c?.descricao||'';$('#collectionCoverFile').value='';$('#collectionCoverStatus').textContent='Nenhuma nova capa selecionada.';window.__removeCollectionCover=false;updateCollectionCoverPreview(c?.capa||'');$('#removeCollectionCover').classList.toggle('hidden',!c?.capa);setCollectionPrivacy(c?.publico?'public':'private');$('#collectionModal')?.classList.add('open');setTimeout(()=>$('#collectionName')?.focus(),120);}
    async function saveCollectionFromModal(){if(!requireMember())return;const btn=$('#saveCollectionButton'),name=$('#collectionName').value.trim(),desc=$('#collectionDescription').value.trim(),privacy=$('#collectionPrivacy').value==='public',id=$('#editingCollectionId').value||null;if(!name){ui.toast('Dê um nome para a coleção.');$('#collectionName')?.focus();return;}btn.disabled=true;btn.textContent='Salvando…';try{const current=id?(state.collections?.[id]||await dbGet('colecoes/'+state.user.uid+'/'+id)||{}):{},file=$('#collectionCoverFile')?.files?.[0];let cover=current.capa||'';if(window.__removeCollectionCover)cover='';if(file)cover=await prepareUiImage(file,'cover');const payload={...current,nome:name,descricao:desc,publico:privacy,capa:cover,obras:current.obras||{},data:current.data||now(),atualizadoEm:now()};let cid=id;if(!cid){const p=push(pathRef('colecoes/'+state.user.uid));cid=p.key;await set(p,payload);}else await dbSet('colecoes/'+state.user.uid+'/'+cid,payload);if(privacy)await dbSet('colecoesPublicas/'+state.user.uid+'/'+cid,payload);else await dbRemove('colecoesPublicas/'+state.user.uid+'/'+cid).catch(()=>{});state.publicCollections={};closeCollectionModal();ui.toast(id?'Coleção atualizada.':'Coleção criada.');if(state.collectionPickerWorkId)setTimeout(()=>openCollectionPicker(state.collectionPickerWorkId),100);else if(router.current()?.page==='collection')router.navigate('/colecao/'+state.user.uid+'/'+cid,true);else router.navigate('/biblioteca/colecoes');}catch(err){console.error(err);ui.toast('Não foi possível salvar a coleção.');}finally{btn.disabled=false;btn.textContent='Salvar coleção';}}
    async function createCollection(){openCollectionModal(null);}
    function closeCollectionPicker(){const m=$('#collectionPickerModal');m?.classList.remove('open');state.collectionPickerWorkId=null;state.collectionPickerSelected=new Set();}
    function renderCollectionPicker(){const el=$('#collectionPickerList');if(!el)return;const cols=objEntries(state.collections).map(([id,c])=>({id,...c}));if(!cols.length){el.innerHTML="<div class='empty'>Você ainda não tem coleções. Crie uma e depois escolha onde guardar esta obra.</div>";return;}el.innerHTML=cols.map(c=>{const selected=state.collectionPickerSelected.has(c.id),thumb=c.capa?"<img src='"+escapeAttr(c.capa)+"' alt=''/>":(collectionVisualThumb(c)||'▦');return "<button type='button' class='collection-picker-item "+(selected?'selected':'')+"' data-collection-pick='"+c.id+"'><span class='collection-picker-thumb'>"+thumb+"</span><span class='collection-picker-copy'><strong>"+escapeHtml(c.nome||'Coleção')+"</strong><small>"+(c.publico?'🌐 Pública':'🔒 Privada')+" • "+collectionWorkIds(c).length+" obras</small></span><span class='collection-picker-check'>"+(selected?'✓':'')+"</span></button>";}).join('');}
    function collectionVisualThumb(c){const id=collectionWorkIds(c)[0],w=id&&(state.workMap[id]||state.allWorkMap[id]);return w?.cover?"<img src='"+escapeAttr(w.cover)+"' alt=''/>":'';}
    function openCollectionPicker(workId){if(!requireMember())return;state.collectionPickerWorkId=workId;state.collectionPickerSelected=new Set(objEntries(state.collections).filter(([,c])=>!!c?.obras?.[workId]).map(([id])=>id));renderCollectionPicker();$('#collectionPickerModal')?.classList.add('open');}
    async function saveCollectionPicker(){if(!requireMember()||!state.collectionPickerWorkId)return;const workId=state.collectionPickerWorkId,cols=objEntries(state.collections);const btn=$('#saveCollectionPicker');btn.disabled=true;btn.textContent='Salvando…';try{await Promise.all(cols.map(async([id,c])=>{const want=state.collectionPickerSelected.has(id),has=!!c?.obras?.[workId];if(want&&!has){const entry={data:now()};await dbSet('colecoes/'+state.user.uid+'/'+id+'/obras/'+workId,entry);if(c.publico)await dbSet('colecoesPublicas/'+state.user.uid+'/'+id+'/obras/'+workId,entry);}else if(!want&&has){await dbRemove('colecoes/'+state.user.uid+'/'+id+'/obras/'+workId);if(c.publico)await dbRemove('colecoesPublicas/'+state.user.uid+'/'+id+'/obras/'+workId).catch(()=>{});}}));state.publicCollections={};closeCollectionPicker();ui.toast('Coleções atualizadas.');}catch(err){console.error(err);ui.toast('Não foi possível atualizar as coleções.');}finally{btn.disabled=false;btn.textContent='Salvar alterações';}}
    async function addToCollection(workId){openCollectionPicker(workId);}

    function fileData(file){return new Promise((res,rej)=>{if(!file){rej(new Error('Arquivo ausente'));return;}const r=new FileReader();r.onload=()=>res(String(r.result||''));r.onerror=()=>rej(r.error||new Error('Falha ao ler a imagem'));r.onabort=()=>rej(new Error('Leitura cancelada'));try{r.readAsDataURL(file);}catch(e){rej(e);}});}

    const OFF_DB='mp_scan_offline_v1',OFF_STORE='chapters';function offlineDB(){return new Promise((res,rej)=>{const req=indexedDB.open(OFF_DB,1);req.onupgradeneeded=()=>{if(!req.result.objectStoreNames.contains(OFF_STORE))req.result.createObjectStore(OFF_STORE,{keyPath:'key'});};req.onsuccess=()=>res(req.result);req.onerror=()=>rej(req.error);});}
    async function offlinePut(key,value){const d=await offlineDB();return new Promise((res,rej)=>{const t=d.transaction(OFF_STORE,'readwrite');t.objectStore(OFF_STORE).put({...value,key});t.oncomplete=()=>res();t.onerror=()=>rej(t.error);});}
    async function offlineGet(key){const d=await offlineDB();return new Promise((res,rej)=>{const r=d.transaction(OFF_STORE).objectStore(OFF_STORE).get(key);r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error);});}
    async function offlineAll(){const d=await offlineDB();return new Promise((res,rej)=>{const r=d.transaction(OFF_STORE).objectStore(OFF_STORE).getAll();r.onsuccess=()=>res(r.result||[]);r.onerror=()=>rej(r.error);});}
    async function offlineDelete(key){const d=await offlineDB();return new Promise((res,rej)=>{const t=d.transaction(OFF_STORE,'readwrite');t.objectStore(OFF_STORE).delete(key);t.oncomplete=()=>res();t.onerror=()=>rej(t.error);});}
    async function renderDownloads(){const el=$('#libraryDownloads');if(!el)return;try{const list=await offlineAll();el.innerHTML=list.length?list.map(d=>"<div class='card'><div class='card-body'><div class='card-title'>"+escapeHtml(d.workName||'Obra')+"</div><div class='card-meta'>Capítulo "+escapeHtml(d.chapterNumber||'')+(d.chapterTitle?' — '+escapeHtml(d.chapterTitle):'')+"</div><div class='row' style='margin-top:9px'><a class='btn primary' href='#/capitulo/"+d.workId+"/"+d.chapterId+"' data-route='/capitulo/"+d.workId+"/"+d.chapterId+"'>Ler</a><button type='button' class='btn danger' data-remove-download='"+d.key+"'>Excluir</button></div></div></div>").join(''):"<div class='empty'>Nenhum capítulo baixado neste aparelho.</div>";}catch(e){el.innerHTML="<div class='empty'>O navegador não permitiu abrir os downloads locais.</div>";}}

    function stopReaderTracking(){
      if(window.__mpProgressFn)window.removeEventListener('scroll',window.__mpProgressFn);
      if(window.__readerChromeScroll)window.removeEventListener('scroll',window.__readerChromeScroll);
      window.__mpProgressFn=null;window.__readerChromeScroll=null;window.__readerPages=null;clearTimeout(progressTimer);clearReaderResumeTimers();window.__readerResumeDoneKey=null;window.__readerResuming=false;
      stopReaderAutoScroll();releaseReaderWakeLock().catch(()=>{});
      document.body.classList.remove('reader-active','reader-ui-hidden','reader-ui-fixed','reader-ui-focus','reader-ui-peek','reader-panel-visible');
      document.documentElement.style.removeProperty('--reader-bg');
    }
    async function renderOfflineChapter(workId,id){
      const el=$('#chapterReaderContent');if(!el)return;document.body.classList.add('reader-active');
      try{
        const offline=await offlineGet(workId+'__'+id);
        if(!offline?.pages?.length){el.innerHTML=chapterErrorHtml('Este capítulo não está salvo offline neste aparelho.',workId,id);return;}
        const c={id,workId,number:offline.chapterNumber||'',title:offline.chapterTitle||''},w={id:workId,name:offline.workName||'Obra'},s=readerSettings(),savedHistory=state.history?.[workId],list=state.chapters[workId]||[];
        if(s.mode==='one'&&s.resume==='on'&&savedHistory?.chapterId===id&&!historyIsComplete(savedHistory)&&num(savedHistory.paginaAtual)>0)s.page=Math.max(0,Math.min(offline.pages.length-1,num(savedHistory.paginaAtual)-1));
        el.dataset.workId=workId;el.dataset.chapterId=id;
        el.innerHTML="<div class='reader-v32'>"+readerTopbarHtml(w,c)+"<main class='reader-stage'><div class='reader-stage-inner'><div id='readerPages' data-reader-tap-area='true'></div></div></main><div class='reader-bottom'><div class='reader-bottom-inner'><div class='reader-bottom-nav' style='grid-template-columns:1fr'><a class='reader-nav-button work' href='#"+workRoute(workId)+"' data-route='"+workRoute(workId)+"'><span class='reader-nav-icon'>⌂</span><span class='reader-nav-copy'><small>Obra</small><strong>Voltar para a obra</strong></span></a></div></div></div>"+readerChapterPanelHtml(workId,id,list)+readerSheetHtml(workId,id,s,true)+"</div>";
        bindReaderLocalControls();
        const commentsBtn=$('[data-reader-comments]');if(commentsBtn){commentsBtn.disabled=true;commentsBtn.title='Comentários precisam de conexão';commentsBtn.style.opacity='.45';}
        applyReaderVisualSettings(s);setupReaderChrome(s);renderReaderPages(offline.pages,workId,id,c,s);
      }catch(e){console.error(e);el.innerHTML=chapterErrorHtml('Não foi possível abrir o capítulo salvo neste aparelho.',workId,id);}
    }


    const REFERRAL_FINAL_LIMIT=3;
    const REFERRAL_REWARDS=[
      {tier:10,title:'Moldura personalizada',desc:'Moldura exclusiva criada pelo ADM, com cores e animação escolhidas para você.'},
      {tier:20,title:'Selo Divulgador MP',desc:'Selo especial e personalizável para aparecer no seu perfil e nos comentários.'},
      {tier:30,title:'Banner personalizado',desc:'Banner exclusivo do evento para destacar seu perfil.'},
      {tier:40,title:'Título especial MP',desc:'Um título exclusivo criado pelo ADM para o seu perfil.'},
      {tier:50,title:'Pedido especial de obra completa',desc:'Uma das 3 vagas finais: escolha uma obra para prioridade total de produção e publicação completa.'}
    ];
    function referralNormalizeCode(v){return String(v||'').toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,24);}
    function referralHashPart(value,seed){let h=seed>>>0;for(let i=0;i<value.length;i++){h^=value.charCodeAt(i);h=Math.imul(h,16777619)>>>0;}return h.toString(36).toUpperCase();}
    function referralCodeFromUid(uid,salt=''){const raw=String(uid||'')+'|'+salt;return ('MP'+referralHashPart(raw,2166136261)+referralHashPart(raw.split('').reverse().join(''),2654435761)).replace(/[^A-Z0-9]/g,'').slice(0,14);}
    function referralShareUrl(code){return location.origin+location.pathname+'?ref='+encodeURIComponent(code)+'#/evento-divulgacao';}
    function referralPendingCode(){try{return referralNormalizeCode(new URLSearchParams(location.search).get('ref')||localStorage.getItem('mp_pending_referral_code')||'');}catch(e){return'';}}
    function captureReferralFromUrl(){try{const c=referralNormalizeCode(new URLSearchParams(location.search).get('ref')||'');if(c)localStorage.setItem('mp_pending_referral_code',c);}catch(e){}}
    captureReferralFromUrl();
    function referralWinnerList(slots={}){return [1,2,3].map(i=>slots?.[i]||slots?.[String(i)]||null).filter(Boolean);}
    function referralWinnerState(slots={}){const list=referralWinnerList(slots),uids=new Set(list.map(x=>String(x?.uid||'')));return{list,uids,count:list.length,closed:list.length>=REFERRAL_FINAL_LIMIT};}
    function referralCapHtml(slots={},ownUid=''){const st=referralWinnerState(slots),own=st.list.findIndex(x=>x?.uid===ownUid)+1;return "<div class='referral-cap-card'><div><strong>🏆 Só existem 3 vagas para o prêmio final</strong><span>"+(st.closed?'As 3 vagas já foram conquistadas. O evento não aceita novas indicações.':('Restam '+(REFERRAL_FINAL_LIMIT-st.count)+' vaga'+(REFERRAL_FINAL_LIMIT-st.count===1?'':'s')+' para chegar ao pedido especial de obra.'))+(own?" • Você conquistou a vaga #"+own:'')+"</span></div><div class='referral-cap-dots'>"+[1,2,3].map(i=>"<i class='referral-cap-dot "+(i<=st.count?'filled':'')+"'></i>").join('')+"</div></div>";}
    async function referralSlots(){return await dbGet('eventoDivulgacao/vagas50').catch(()=>({}))||{};}
    async function referralNotify(uid,title,text,link='/evento-divulgacao'){if(!uid)return;try{await dbPush('notificacoes/'+uid,{tipo:'evento-divulgacao',titulo:title,texto:text,link,data:now(),lida:false,fromUid:state.user?.uid||''});}catch(e){console.warn('referral notify',e);}}
    async function claimReferralWinnerSlot(ownerUid,sourceUid=''){
      ownerUid=String(ownerUid||'');if(!ownerUid)return null;
      let slots=await referralSlots(),st=referralWinnerState(slots);const existing=st.list.findIndex(x=>x?.uid===ownerUid);if(existing>=0)return existing+1;if(st.closed)return null;
      for(let i=1;i<=REFERRAL_FINAL_LIMIT;i++){
        try{const r=await tx('eventoDivulgacao/vagas50/'+i,current=>current||{uid:ownerUid,atingiuEm:now(),confirmadoPor:sourceUid||state.user?.uid||ownerUid}),val=r?.snapshot?.val?.()||null;if(val?.uid===ownerUid)return i;}catch(e){console.warn('vaga '+i,e);}
        slots=await referralSlots();st=referralWinnerState(slots);const again=st.list.findIndex(x=>x?.uid===ownerUid);if(again>=0)return again+1;if(st.closed)return null;
      }
      return null;
    }
    async function ensureReferralProfile(){
      if(!isMember())return null;const uid=state.user.uid;let p=await dbGet('eventoDivulgacao/perfis/'+uid).catch(()=>null),code=referralNormalizeCode(p?.codigo||'');
      if(!code){let n=0,owner=null;do{code=referralCodeFromUid(uid,n?String(n):'');owner=await dbGet('eventoDivulgacao/codigos/'+code).catch(()=>null);n++;}while(owner&&owner!==uid&&n<12);if(owner&&owner!==uid)throw new Error('Não foi possível gerar um código exclusivo agora.');await dbSet('eventoDivulgacao/codigos/'+code,uid);}
      const next={uid,codigo:code,nome:state.profile?.nome||state.user.displayName||'Leitor',nomeUsuario:state.profile?.nomeUsuario||'',criadoEm:num(p?.criadoEm)||now(),atualizadoEm:now()};await dbSet('eventoDivulgacao/perfis/'+uid,next);state.referralProfile=next;return next;
    }
    async function repairReferralUse(use){
      if(!isMember()||!use?.ownerUid||use.ownerUid===state.user.uid)return;const path='eventoDivulgacao/indicacoes/'+use.ownerUid+'/'+state.user.uid,exists=await dbGet(path).catch(()=>null);if(!exists)await dbSet(path,{uid:state.user.uid,ownerUid:use.ownerUid,codigo:use.codigo||'',criadoEm:num(use.criadoEm)||now()}).catch(()=>{});
      const invites=await dbGet('eventoDivulgacao/indicacoes/'+use.ownerUid).catch(()=>({}))||{};if(Object.keys(invites).length>=50){const slot=await claimReferralWinnerSlot(use.ownerUid,state.user.uid);if(slot)await referralNotify(use.ownerUid,'Você conquistou uma das 3 vagas finais!','Você chegou a 50 indicações e garantiu a vaga #'+slot+' para pedir uma obra com prioridade total.','/evento-divulgacao');}
    }
    function referralNextReward(count){return REFERRAL_REWARDS.find(r=>count<r.tier)||null;}
    function referralRewardStatusHtml(reward,count,claim,slots={}){
      let unlocked=count>=reward.tier,status=String(claim?.status||''),label=unlocked?'DESBLOQUEADO':'FALTAM '+Math.max(0,reward.tier-count);
      if(reward.tier===50){const ws=referralWinnerState(slots),isWinner=ws.uids.has(state.user?.uid||'');unlocked=unlocked&&isWinner;if(count>=50&&!isWinner&&ws.closed)label='3 VAGAS PREENCHIDAS';else if(count>=50&&isWinner)label='VAGA GARANTIDA';}
      if(status==='pendente')label='SOLICITADO';if(status==='aprovado')label='EM PREPARAÇÃO';if(status==='entregue')label='ENTREGUE ✓';if(status==='recusado')label='REVISAR COM ADM';return{unlocked,status,label};
    }
    function referralRewardsHtml(count,claims,slots={}){return REFERRAL_REWARDS.map(r=>{const claim=claims?.[r.tier]||{},st=referralRewardStatusHtml(r,count,claim,slots),classes=['referral-reward',st.unlocked?'unlocked':'',st.status==='entregue'?'delivered':''].filter(Boolean).join(' ');return "<article class='"+classes+"'><div class='referral-reward-step'>"+r.tier+"</div><strong>"+escapeHtml(r.title)+"</strong><small>"+escapeHtml(r.desc)+"</small><span class='referral-reward-status'>"+escapeHtml(st.label)+"</span></article>";}).join('');}
    function referralWorkStatusLabel(v){return({recebido:'Pedido recebido',pesquisa:'Pesquisa e preparação',producao:'Produção em prioridade total',revisao:'Revisão',publicacao:'Preparando publicação',atrasado:'Prazo atualizado / atraso',concluido:'Obra concluída'})[String(v||'')]||'Pedido recebido';}
    function referralPriorityProgressHtml(c={}){
      if(!c?.status)return'';const history=objEntries(c.historico||{}).map(([id,h])=>({id,...h})).sort((a,b)=>num(b.data)-num(a.data)).slice(0,8),date=c.previsaoLancamento?escapeHtml(c.previsaoLancamento):'Ainda não informada';
      return "<div class='referral-priority-card'><h3>📚 Sua obra prioritária</h3><p class='section-sub'>Este é um dos 3 pedidos finais do evento e tem prioridade total na fila da MP SCAN.</p><div class='referral-priority-meta'><span>"+escapeHtml(referralWorkStatusLabel(c.andamento||'recebido'))+"</span><span>Previsão: "+date+"</span>"+(c.winnerSlot?"<span>Vaga #"+c.winnerSlot+" de 3</span>":'')+"</div>"+(c.mensagemAdm?"<p><strong>Mensagem do ADM:</strong><br/>"+escapeHtml(c.mensagemAdm)+"</p>":'')+(history.length?"<div class='referral-timeline'>"+history.map(h=>"<div class='referral-timeline-item'><strong>"+escapeHtml(referralWorkStatusLabel(h.andamento||c.andamento))+" • "+escapeHtml(fmtDate(h.data)||fmtRelative(h.data))+"</strong><span>"+escapeHtml(h.mensagem||'Atualização do ADM.')+"</span></div>").join('')+"</div>":'')+"</div>";
    }
    function referralRequestForms(count,claims,slots={}){
      const out=[],c10=claims?.[10]||{};if(count>=10&&!c10.status)out.push("<div class='referral-request-card'><strong>🎨 Solicitar sua moldura personalizada</strong><p class='section-sub'>Conte ao ADM suas cores, estilo, personagem e se quer animação. O editor do ADM permite brilho, cristal, neon, aurora, faíscas e mais.</p><textarea id='referralFrameNotes' maxlength='900' placeholder='Ex.: vinho e dourado, brilho suave, personagem X, animação aurora...'></textarea><div class='referral-actions'><button type='button' class='primary' data-referral-request='10'>Solicitar moldura</button></div></div>");
      for(const tier of [20,30,40]){const c=claims?.[tier]||{};if(count>=tier&&!c.status){const r=REFERRAL_REWARDS.find(x=>x.tier===tier);out.push("<div class='referral-request-card'><strong>🎁 "+escapeHtml(r.title)+" desbloqueado</strong><p class='section-sub'>Envie para o ADM preparar uma versão exclusiva para o seu perfil.</p><div class='referral-actions'><button type='button' class='primary' data-referral-request='"+tier+"'>Solicitar prêmio</button></div></div>");}}
      const c50=claims?.[50]||{},ws=referralWinnerState(slots),winner=ws.uids.has(state.user?.uid||'');
      if(count>=50&&winner&&!c50.status)out.push("<div class='referral-request-card'><strong>📚 Você conquistou uma das 3 vagas!</strong><p class='section-sub'>Escolha uma obra. Seu pedido entra como <strong>prioridade total</strong> e a equipe acompanhará a produção até a publicação completa.</p><div class='referral-request-grid'><div class='field'><label>Nome da obra</label><input id='referralWorkName' maxlength='180' placeholder='Nome da obra'/></div><div class='field'><label>Link de referência</label><input id='referralWorkLink' maxlength='600' inputmode='url' placeholder='https://...'/></div></div><div class='field'><label>Observações</label><textarea id='referralWorkNotes' maxlength='1200' placeholder='Nome alternativo, idioma, onde encontrou e outras informações úteis.'></textarea></div><div class='referral-actions'><button type='button' class='primary' data-referral-request='50'>Enviar pedido prioritário</button></div></div>");
      if(c50.status)out.push(referralPriorityProgressHtml(c50));else if(count>=50&&!winner&&ws.closed)out.push("<div class='referral-event-closed'><strong>Você chegou a 50, mas as 3 vagas finais já foram preenchidas.</strong><span>Os prêmios de 10, 20, 30 e 40 continuam válidos. O pedido especial era limitado aos três primeiros participantes que alcançassem 50.</span></div>");
      return out.join('');
    }
    async function useReferralCode(code){
      if(!requireMember())return;if(!state.user?.emailVerified){ui.toast('Confirme seu e-mail antes de usar um código.');return;}code=referralNormalizeCode(code);if(!code){ui.toast('Digite o código de divulgação.');return;}
      const current=await dbGet('eventoDivulgacao/usos/'+state.user.uid).catch(()=>null);if(current){ui.toast('Esta conta já usou um código de divulgação.');return;}const slots=await referralSlots(),ws=referralWinnerState(slots);if(ws.closed){ui.toast('O evento foi encerrado: as 3 vagas finais já foram conquistadas.');return;}
      const ownerUid=await dbGet('eventoDivulgacao/codigos/'+code).catch(()=>null);if(!ownerUid){ui.toast('Código não encontrado. Confira e tente novamente.');return;}if(ownerUid===state.user.uid){ui.toast('Você não pode usar o próprio código.');return;}
      const payload={uid:state.user.uid,ownerUid,codigo:code,criadoEm:now()};try{await dbSet('eventoDivulgacao/usos/'+state.user.uid,payload);await repairReferralUse(payload);try{localStorage.removeItem('mp_pending_referral_code');}catch(e){}ui.toast('Código confirmado. Sua indicação foi registrada.');await renderReferralEvent();}catch(e){console.error('referral use',e);ui.toast('Não foi possível registrar o código. Confira sua conta e tente novamente.');}
    }
    async function requestReferralReward(tier){
      if(!requireMember())return;tier=num(tier);const reward=REFERRAL_REWARDS.find(r=>r.tier===tier);if(!reward)return;const invites=await dbGet('eventoDivulgacao/indicacoes/'+state.user.uid).catch(()=>({}))||{},count=Object.keys(invites).length;if(count<tier){ui.toast('Você ainda não atingiu este prêmio.');return;}const existing=await dbGet('eventoDivulgacao/premios/'+state.user.uid+'/'+tier).catch(()=>null);if(existing){ui.toast('Este prêmio já foi solicitado.');return;}
      const payload={uid:state.user.uid,tier,status:'pendente',titulo:reward.title,data:now(),atualizadoEm:now()};if(tier===10){const notes=String($('#referralFrameNotes')?.value||'').trim();if(notes.length<3){ui.toast('Conte um pouco de como você quer sua moldura.');$('#referralFrameNotes')?.focus();return;}payload.observacoes=notes;}
      if(tier===50){const slots=await referralSlots(),ws=referralWinnerState(slots);let slot=ws.list.findIndex(x=>x?.uid===state.user.uid)+1;if(!slot)slot=await claimReferralWinnerSlot(state.user.uid,state.user.uid);if(!slot){ui.toast('As 3 vagas do pedido especial já foram preenchidas.');await renderReferralEvent();return;}const nome=String($('#referralWorkName')?.value||'').trim(),link=String($('#referralWorkLink')?.value||'').trim(),obs=String($('#referralWorkNotes')?.value||'').trim();if(nome.length<2){ui.toast('Digite o nome da obra.');$('#referralWorkName')?.focus();return;}if(link&&!/^https?:\/\//i.test(link)){ui.toast('O link precisa começar com http:// ou https://');$('#referralWorkLink')?.focus();return;}payload.obraNome=nome;payload.obraLink=link;payload.observacoes=obs;payload.winnerSlot=slot;payload.prioridade='total';payload.obraCompleta=true;payload.andamento='recebido';}
      try{await dbSet('eventoDivulgacao/premios/'+state.user.uid+'/'+tier,payload);ui.toast(tier===50?'Pedido prioritário enviado ao ADM.':'Prêmio solicitado. O ADM recebeu seu pedido.');await renderReferralEvent();}catch(e){console.error(e);ui.toast('Não foi possível solicitar o prêmio agora.');}
    }
    function bindReferralEventActions(root,profile){root.querySelector('[data-referral-copy-code]')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(profile.codigo);ui.toast('Código copiado.');}catch(e){ui.toast('Código: '+profile.codigo);}});root.querySelector('[data-referral-copy-link]')?.addEventListener('click',async()=>{const url=referralShareUrl(profile.codigo);try{await navigator.clipboard.writeText(url);ui.toast('Link de divulgação copiado.');}catch(e){ui.toast('Copie o link pelo navegador.');}});root.querySelector('[data-referral-share]')?.addEventListener('click',async()=>{const url=referralShareUrl(profile.codigo),share={title:'MP SCAN',text:'Conheça a MP SCAN! Use meu código '+profile.codigo+' no evento de divulgação.',url};try{if(navigator.share)await navigator.share(share);else{await navigator.clipboard.writeText(share.text+' '+url);ui.toast('Mensagem de divulgação copiada.');}}catch(e){}});root.querySelector('[data-referral-use]')?.addEventListener('click',()=>useReferralCode($('#referralCodeInput')?.value||''));root.querySelector('#referralCodeInput')?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();useReferralCode(e.currentTarget.value);}});root.querySelectorAll('[data-referral-request]').forEach(b=>b.addEventListener('click',()=>requestReferralReward(b.dataset.referralRequest)));}
    async function renderReferralEvent(){
      const root=$('#referralEventContent');if(!root)return;document.title='Evento de Divulgação — MP SCAN';const hero="<section class='referral-hero'><span class='referral-kicker'>✦ EVENTO MP SCAN</span><h1>Divulgue &amp; Ganhe</h1><p>Compartilhe a MP SCAN com seu código exclusivo. Cada nova conta verificada que usar seu código conta como uma indicação. O prêmio final é limitado aos <strong>3 primeiros</strong> participantes que chegarem a 50.</p><div class='referral-hero-note'><span>✓ 1 código por usuário</span><span>✓ 1 indicação por conta</span><span>✓ E-mail verificado</span><span>🏆 Só 3 vagas no prêmio de 50</span></div></section>";
      if(!state.firebaseReady){root.innerHTML=hero+"<div class='referral-section referral-rules'><strong>Sem conexão</strong><p>O evento precisa do Firebase para validar códigos e contabilizar as indicações.</p></div>";return;}const slots=await referralSlots(),ws=referralWinnerState(slots);
      if(!isMember()){root.innerHTML=hero+referralCapHtml(slots,'')+"<section class='referral-section'><div class='referral-card'><h2>Entre para receber seu código</h2><p class='section-sub'>Cada conta registrada recebe um código diferente. Depois de entrar, seu contador começa em 0 e suas indicações ficam salvas.</p><div class='referral-actions'><button type='button' class='primary open-auth'>Entrar / Criar conta</button></div></div></section><section class='referral-section'><div class='referral-section-head'><div><h2>Prêmios</h2><p>As recompensas de 10 a 40 são cumulativas. A de 50 tem só 3 vagas.</p></div></div><div class='referral-rewards'>"+referralRewardsHtml(0,{},slots)+"</div></section>";return;}
      let profile;try{profile=await ensureReferralProfile();}catch(e){console.error(e);root.innerHTML=hero+"<div class='referral-section referral-rules'><strong>Não foi possível preparar seu código.</strong><p>Tente novamente em alguns instantes ou fale com o ADM.</p></div>";return;}
      const [invites,rewards,used]=await Promise.all([dbGet('eventoDivulgacao/indicacoes/'+state.user.uid).catch(()=>({})),dbGet('eventoDivulgacao/premios/'+state.user.uid).catch(()=>({})),dbGet('eventoDivulgacao/usos/'+state.user.uid).catch(()=>null)]);if(used)await repairReferralUse(used);state.referralInvites=invites||{};state.referralRewards=rewards||{};state.referralUsed=used||null;
      const count=Object.keys(invites||{}).length,next=referralNextReward(count),pct=Math.min(100,(count/50)*100),pending=referralPendingCode(),ownWinner=ws.uids.has(state.user.uid);if(count>=50&&!ownWinner&&!ws.closed){const slot=await claimReferralWinnerSlot(state.user.uid,state.user.uid);if(slot)return renderReferralEvent();}
      const usedHtml=used?"<div class='referral-used-note'>✓ Você já usou o código <strong>"+escapeHtml(used.codigo||'')+"</strong>. Cada conta só pode apoiar um divulgador.</div>":(ws.closed?"<div class='referral-event-closed'><strong>Evento encerrado para novas indicações</strong><span>As 3 vagas finais já foram conquistadas.</span></div>":"<div class='referral-use-form'><input id='referralCodeInput' maxlength='24' autocomplete='off' placeholder='Recebeu um código? Digite aqui' value='"+escapeAttr(pending)+"'/><button type='button' data-referral-use='true'>Usar código</button></div>");
      root.innerHTML=hero+referralCapHtml(slots,state.user.uid)+"<section class='referral-section'><div class='referral-dashboard'><div class='referral-card'><div class='tiny'>SEU CÓDIGO EXCLUSIVO</div><div class='referral-code-box'><div class='referral-code'>"+escapeHtml(profile.codigo)+"</div><button type='button' class='referral-claim-button' data-referral-copy-code='true'>Copiar</button></div><div class='referral-actions'>"+(ws.closed?'':"<button type='button' class='primary' data-referral-share='true'>↗ Compartilhar</button><button type='button' data-referral-copy-link='true'>Copiar link com código</button>")+"</div>"+usedHtml+"</div><div class='referral-card'><div class='tiny'>PESSOAS CONFIRMADAS</div><div class='referral-count'><strong>"+count+"</strong><span>"+(count===1?'pessoa':'pessoas')+"</span></div><div class='referral-progress-track'><span style='width:"+pct+"%'></span></div><div class='referral-next'>"+(ws.closed&&!ws.uids.has(state.user.uid)?'As 3 vagas finais foram preenchidas.':next?"Próximo prêmio em <strong>"+Math.max(0,next.tier-count)+"</strong> indicação"+(next.tier-count===1?'':'ões')+": "+escapeHtml(next.title):"🏆 Você alcançou a meta máxima do evento!")+"</div></div></div></section><section class='referral-section'><div class='referral-section-head'><div><h2>Seus prêmios</h2><p>10, 20, 30, 40 e 50 pessoas confirmadas.</p></div></div><div class='referral-rewards'>"+referralRewardsHtml(count,rewards||{},slots)+"</div>"+referralRequestForms(count,rewards||{},slots)+"</section><section class='referral-section referral-rules'><strong>Como a indicação é confirmada?</strong><p>A pessoa precisa entrar em uma conta com e-mail verificado, abrir esta página e usar seu código. Cada conta só pode apoiar um divulgador e não pode usar o próprio código.</p><p>Contas duplicadas, automações, spam ou tentativas de manipular o contador podem ser desconsideradas pelo ADM.</p><p><strong>Prêmio de 50:</strong> existem somente 3 vagas. Quando a terceira pessoa alcançar 50 indicações confirmadas, novas indicações são encerradas. Os três vencedores podem escolher uma obra para entrar em prioridade total, com acompanhamento do ADM até a conclusão.</p></section>";bindReferralEventActions(root,profile);
    }
    function referralAdminStatusLabel(s){return({pendente:'Pendente',aprovado:'Em preparação',entregue:'Entregue',recusado:'Recusado'})[s]||'Pendente';}
    async function updateReferralRewardAdmin(uid,tier,status){if(!isAdmin())return;try{await dbUpdate('eventoDivulgacao/premios/'+uid+'/'+tier,{status,atualizadoEm:now(),respondidoEm:now(),respondidoPor:state.user.uid});await referralNotify(uid,status==='entregue'?'Prêmio do evento entregue':'Atualização no seu prêmio',status==='entregue'?'Seu prêmio de '+tier+' indicações foi marcado como entregue.':'O ADM atualizou seu prêmio de '+tier+' indicações para: '+referralAdminStatusLabel(status)+'.','/evento-divulgacao');ui.toast('Prêmio atualizado e leitor notificado.');await renderAdminReferralEvent($('#adminDynamic'));}catch(e){console.error(e);ui.toast('Não foi possível atualizar o prêmio.');}}
    function referralStudioFxOptions(selected='shine'){return ['none','pulse','shine','float','aurora','sparkle'].map(v=>"<option value='"+v+"' "+(selected===v?"selected='selected'":'')+">"+({none:'Sem animação',pulse:'Pulso',shine:'Brilho passando',float:'Flutuar',aurora:'Aurora',sparkle:'Faíscas'}[v])+"</option>").join('');}
    function referralStudioPreviewHtml(tier,d={}){if(tier===20)return "<span class='profile-referral-badge"+referralFxClass(d.effect||'shine')+"' style='--rr-bg:"+safeFrameColor(d.bgColor,'#28152f')+";--rr-text:"+safeFrameColor(d.textColor,'#fff')+";--rr-accent:"+safeFrameColor(d.accentColor,'#d875ff')+"'>"+escapeHtml(d.icon||'✦')+" "+escapeHtml(d.text||'DIVULGADOR MP')+"</span>";if(tier===30)return "<div class='profile-referral-banner"+referralFxClass(d.effect||'shine')+"' style=\"--rr-bg:"+safeFrameColor(d.bgColor,'#171222')+";--rr-text:"+safeFrameColor(d.textColor,'#fff')+";--rr-accent:"+safeFrameColor(d.accentColor,'#8d2bff')+"\"><div><small>PRÊMIO DO EVENTO</small><strong>"+escapeHtml(d.text||'Destaque MP SCAN')+"</strong><span>"+escapeHtml(d.subtext||'Divulgador em destaque')+"</span></div><b>✦</b></div>";if(tier===40)return "<div class='profile-referral-title"+referralFxClass(d.effect||'aurora')+"' style='--rr-accent:"+safeFrameColor(d.color,'#d7ae5c')+"'>"+escapeHtml(d.text||'EMBAIXADOR MP')+"</div>";return"<div class='tiny'>Use o editor avançado de molduras para visualizar este prêmio.</div>";}
    function referralStudioDraftFromDom(tier){if(tier===20)return{text:String($('#referralStudioText')?.value||'DIVULGADOR MP').trim(),icon:String($('#referralStudioIcon')?.value||'✦').trim().slice(0,4),bgColor:$('#referralStudioBg')?.value||'#28152f',textColor:$('#referralStudioTextColor')?.value||'#ffffff',accentColor:$('#referralStudioAccent')?.value||'#d875ff',effect:$('#referralStudioEffect')?.value||'shine'};if(tier===30)return{text:String($('#referralStudioText')?.value||'Destaque MP SCAN').trim(),subtext:String($('#referralStudioSub')?.value||'Divulgador em destaque').trim(),bgColor:$('#referralStudioBg')?.value||'#171222',textColor:$('#referralStudioTextColor')?.value||'#ffffff',accentColor:$('#referralStudioAccent')?.value||'#8d2bff',effect:$('#referralStudioEffect')?.value||'shine'};if(tier===40)return{text:String($('#referralStudioText')?.value||'EMBAIXADOR MP').trim(),color:$('#referralStudioAccent')?.value||'#d7ae5c',effect:$('#referralStudioEffect')?.value||'aurora'};return{};}
    function referralRewardStudioHtml(uid,tier,p={},req={}){
      if(!uid||!tier)return'';const who=escapeHtml(p.nome||p.nomeUsuario||uid),close="<button type='button' class='btn ghost' data-referral-studio-close='true'>Fechar</button>";
      if(tier===10)return "<section class='referral-studio'><div class='referral-studio-head'><div><h3>🎨 Estúdio • Moldura personalizada</h3><p>Participante: "+who+". Abra o editor avançado para usar imagem, quatro cores, opacidade, vidro, brilho, expansão e seis animações.</p></div>"+close+"</div>"+(req.observacoes?"<div class='referral-studio-target'><strong>Pedido do leitor</strong><span>"+escapeHtml(req.observacoes)+"</span></div>":'')+"<div class='referral-studio-actions'><button type='button' class='btn primary' data-referral-open-frame='true' data-uid='"+escapeAttr(uid)+"'>Abrir editor avançado de moldura →</button></div></section>";
      if(tier===50){const status=req.andamento||'recebido';return "<section class='referral-studio'><div class='referral-studio-head'><div><h3>📚 Central da obra prioritária</h3><p>Participante: "+who+" • Vaga #"+escapeHtml(req.winnerSlot||'?')+" de 3 • prioridade total.</p></div>"+close+"</div><div class='referral-studio-target'><strong>Obra escolhida: "+escapeHtml(req.obraNome||'—')+"</strong><span>"+(req.obraLink?"<a href='"+escapeAttr(req.obraLink)+"' target='_blank' rel='noopener noreferrer'>Abrir link de referência</a>":'Sem link de referência')+"</span><small>"+escapeHtml(req.observacoes||'Sem observações.')+"</small></div><div class='referral-studio-grid'><div class='field'><label>Etapa atual</label><select id='referralWorkStage'>"+['recebido','pesquisa','producao','revisao','publicacao','atrasado','concluido'].map(v=>"<option value='"+v+"' "+(status===v?"selected='selected'":'')+">"+escapeHtml(referralWorkStatusLabel(v))+"</option>").join('')+"</select></div><div class='field'><label>Previsão de lançamento / conclusão</label><input id='referralWorkEta' type='date' value='"+escapeAttr(req.previsaoLancamento||'')+"'/></div></div><div class='field'><label>Mensagem para o vencedor</label><textarea id='referralWorkAdminMessage' maxlength='1200' placeholder='Ex.: começamos a preparação; previsão para... Se houver atraso, explique aqui.'>"+escapeHtml(req.mensagemAdm||'')+"</textarea></div><div class='referral-studio-actions'><button type='button' class='btn primary' data-referral-work-update='true' data-uid='"+escapeAttr(uid)+"'>Salvar atualização + notificar</button><button type='button' class='btn' data-referral-work-complete='true' data-uid='"+escapeAttr(uid)+"'>✓ Marcar obra concluída + notificar</button></div></section>";}
      const defaults=tier===20?{text:'DIVULGADOR MP',icon:'✦',bg:'#28152f',textc:'#ffffff',accent:'#d875ff',fx:'shine'}:tier===30?{text:'Destaque MP SCAN',sub:'Divulgador em destaque',bg:'#171222',textc:'#ffffff',accent:'#8d2bff',fx:'shine'}:{text:'EMBAIXADOR MP',sub:'',bg:'#171222',textc:'#ffffff',accent:'#d7ae5c',fx:'aurora'};
      return "<section class='referral-studio' data-referral-studio-tier='"+tier+"'><div class='referral-studio-head'><div><h3>✨ Estúdio • "+escapeHtml(REFERRAL_REWARDS.find(r=>r.tier===tier)?.title||'Prêmio')+"</h3><p>Participante: "+who+". Personalize e teste no seu próprio perfil ADM antes de entregar.</p></div>"+close+"</div><div class='referral-studio-grid'><div class='field'><label>Texto</label><input id='referralStudioText' maxlength='80' value='"+defaults.text+"'/></div>"+(tier===20?"<div class='field'><label>Ícone</label><input id='referralStudioIcon' maxlength='4' value='✦'/></div>":tier===30?"<div class='field'><label>Subtexto</label><input id='referralStudioSub' maxlength='120' value='"+defaults.sub+"'/></div>":'')+"<div class='field'><label>Cor principal</label><input id='referralStudioAccent' type='color' value='"+defaults.accent+"'/></div>"+(tier!==40?"<div class='field'><label>Fundo</label><input id='referralStudioBg' type='color' value='"+defaults.bg+"'/></div><div class='field'><label>Texto</label><input id='referralStudioTextColor' type='color' value='"+defaults.textc+"'/></div>":'')+"<div class='field'><label>Animação</label><select id='referralStudioEffect'>"+referralStudioFxOptions(defaults.fx)+"</select></div></div>"+(tier===30?"<div class='field'><label>Imagem opcional do banner</label><input id='referralStudioBannerFile' type='file' accept='image/*'/></div>":'')+"<div class='referral-studio-preview' id='referralStudioPreview'>"+referralStudioPreviewHtml(tier,{text:defaults.text,subtext:defaults.sub,icon:'✦',bgColor:defaults.bg,textColor:defaults.textc,accentColor:defaults.accent,color:defaults.accent,effect:defaults.fx})+"</div><div class='referral-studio-actions'><button type='button' class='btn' data-referral-studio-test='true' data-uid='"+escapeAttr(uid)+"' data-tier='"+tier+"'>Testar no meu perfil ADM</button><button type='button' class='btn primary' data-referral-studio-deliver='true' data-uid='"+escapeAttr(uid)+"' data-tier='"+tier+"'>🎁 Entregar ao participante</button></div></section>";
    }
    async function deliverReferralAsset(uid,tier,draft,test=false){
      if(!isAdmin())return;const target=test?state.user.uid:uid,path=tier===20?'selo':tier===30?'banner':'titulo',payload={...draft,criadoEm:now(),atualizadoEm:now(),origem:test?'teste-adm':'evento-divulgacao'};
      if(tier===30){const file=$('#referralStudioBannerFile')?.files?.[0];if(file)payload.imageUrl=await prepareUiImage(file,'cover');}
      await dbSet('eventoDivulgacao/ativos/'+target+'/'+path,payload);if(!test){await dbUpdate('eventoDivulgacao/premios/'+uid+'/'+tier,{status:'entregue',atualizadoEm:now(),respondidoEm:now(),respondidoPor:state.user.uid});await referralNotify(uid,'Seu prêmio do evento chegou',(REFERRAL_REWARDS.find(r=>r.tier===tier)?.title||'Seu prêmio')+' foi preparado pelo ADM e já aparece no seu perfil.','/perfil');}ui.toast(test?'Prêmio aplicado ao seu perfil ADM para teste.':'Prêmio entregue e leitor notificado.');
    }
    async function updatePriorityWork(uid,complete=false){
      if(!isAdmin())return;const path='eventoDivulgacao/premios/'+uid+'/50',old=await dbGet(path);if(!old)return;const andamento=complete?'concluido':($('#referralWorkStage')?.value||old.andamento||'recebido'),previsao=$('#referralWorkEta')?.value||old.previsaoLancamento||'',mensagem=String($('#referralWorkAdminMessage')?.value||'').trim()||(complete?'A obra foi concluída e o pedido prioritário foi finalizado.':'O ADM atualizou o andamento do seu pedido prioritário.'),hKey=push(pathRef(path+'/historico')).key,updates={andamento,previsaoLancamento:previsao,mensagemAdm:mensagem,atualizadoEm:now(),respondidoEm:now(),respondidoPor:state.user.uid};if(complete)updates.status='entregue';else if(old.status==='pendente')updates.status='aprovado';updates['historico/'+hKey]={andamento,mensagem,previsaoLancamento:previsao,data:now(),por:state.user.uid};await dbUpdate(path,updates);await referralNotify(uid,complete?'Sua obra prioritária foi concluída':'Atualização da sua obra prioritária',mensagem+(previsao?' • Previsão: '+previsao:''),'/evento-divulgacao');ui.toast('Atualização salva e notificação enviada.');await renderAdminReferralEvent($('#adminDynamic'));
    }
    function bindReferralAdminStudio(el){
      el.querySelectorAll('[data-referral-studio-open]').forEach(b=>b.addEventListener('click',()=>{state.referralStudio={uid:b.dataset.uid,tier:num(b.dataset.tier)};renderAdminReferralEvent(el);}));el.querySelector('[data-referral-studio-close]')?.addEventListener('click',()=>{state.referralStudio={uid:'',tier:0};renderAdminReferralEvent(el);});
      el.querySelector('[data-referral-open-frame]')?.addEventListener('click',async e=>{const uid=e.currentTarget.dataset.uid,p=await dbGet('eventoDivulgacao/perfis/'+uid).catch(()=>({})),r=await dbGet('eventoDivulgacao/premios/'+uid+'/10').catch(()=>({}));state.referralFrameTarget={uid,nome:p?.nome||p?.nomeUsuario||uid,observacoes:r?.observacoes||''};state.adminFrameDraft={...state.adminFrameDraft,name:'Moldura exclusiva • '+(p?.nomeUsuario||p?.nome||'Divulgador'),editingId:'',imageUrl:'',file:null};router.navigate('/adm/molduras');});
      const updatePreview=()=>{const box=$('#referralStudioPreview');if(!box)return;const tier=num(el.querySelector('[data-referral-studio-tier]')?.dataset.referralStudioTier);box.innerHTML=referralStudioPreviewHtml(tier,referralStudioDraftFromDom(tier));};el.querySelector('[data-referral-studio-tier]')?.addEventListener('input',updatePreview,true);el.querySelector('[data-referral-studio-tier]')?.addEventListener('change',updatePreview,true);
      el.querySelector('[data-referral-studio-test]')?.addEventListener('click',async e=>{const tier=num(e.currentTarget.dataset.tier);try{await deliverReferralAsset(e.currentTarget.dataset.uid,tier,referralStudioDraftFromDom(tier),true);}catch(err){console.error(err);ui.toast('Não foi possível testar o prêmio.');}});
      el.querySelector('[data-referral-studio-deliver]')?.addEventListener('click',async e=>{const tier=num(e.currentTarget.dataset.tier);try{await deliverReferralAsset(e.currentTarget.dataset.uid,tier,referralStudioDraftFromDom(tier),false);state.referralStudio={uid:'',tier:0};await renderAdminReferralEvent(el);}catch(err){console.error(err);ui.toast('Não foi possível entregar o prêmio.');}});
      el.querySelector('[data-referral-work-update]')?.addEventListener('click',e=>updatePriorityWork(e.currentTarget.dataset.uid,false));el.querySelector('[data-referral-work-complete]')?.addEventListener('click',e=>updatePriorityWork(e.currentTarget.dataset.uid,true));
    }
    async function renderAdminReferralEvent(el){
      if(!el||!isAdmin())return;el.innerHTML="<div class='admin-section-card'><div class='admin-section-title'><div><h2>🎁 Evento de divulgação</h2><p>Acompanhe as 3 vagas finais, participantes, prêmios e obras prioritárias.</p></div><a class='btn ghost' href='#/evento-divulgacao' data-route='/evento-divulgacao'>Abrir evento</a></div><div class='empty'>Carregando participantes…</div></div>";
      const [profiles,invites,rewards,uses,slots]=await Promise.all([dbGet('eventoDivulgacao/perfis').catch(()=>({})),dbGet('eventoDivulgacao/indicacoes').catch(()=>({})),dbGet('eventoDivulgacao/premios').catch(()=>({})),dbGet('eventoDivulgacao/usos').catch(()=>({})),referralSlots()]),ws=referralWinnerState(slots),participants=objEntries(profiles||{}).map(([uid,p])=>({uid,...p,count:Object.keys(invites?.[uid]||{}).length})).sort((a,b)=>b.count-a.count||num(b.criadoEm)-num(a.criadoEm)),requests=[];for(const [uid,userRewards] of objEntries(rewards||{}))for(const [tier,r] of objEntries(userRewards||{}))requests.push({uid,tier:num(tier),...r,profile:profiles?.[uid]||{}});requests.sort((a,b)=>num(b.data)-num(a.data));const pending=requests.filter(r=>r.status==='pendente').length,totalInvites=Object.values(invites||{}).reduce((sum,v)=>sum+Object.keys(v||{}).length,0);
      const participantHtml=participants.length?participants.map(p=>"<div class='referral-admin-item'><h4>"+escapeHtml(p.nome||'Leitor')+" "+(p.nomeUsuario?'@'+escapeHtml(p.nomeUsuario):'')+"</h4><div class='referral-admin-meta'><span>"+escapeHtml(p.codigo||'Sem código')+"</span><span><strong>"+p.count+"</strong> indicações</span>"+(ws.uids.has(p.uid)?"<span>🏆 Vencedor #"+(ws.list.findIndex(x=>x?.uid===p.uid)+1)+"</span>":'')+"</div></div>").join(''):"<div class='empty'>Ainda não há participantes.</div>";
      const requestHtml=requests.length?requests.map(r=>{const reward=REFERRAL_REWARDS.find(x=>x.tier===r.tier),extra=r.tier===50?("<p><strong>Obra:</strong> "+escapeHtml(r.obraNome||'—')+"<br/><strong>Prioridade:</strong> TOTAL • obra completa<br/><strong>Etapa:</strong> "+escapeHtml(referralWorkStatusLabel(r.andamento||'recebido'))+"<br/><strong>Previsão:</strong> "+escapeHtml(r.previsaoLancamento||'não definida')+"<br/><strong>Link:</strong> "+(r.obraLink?"<a href='"+escapeAttr(r.obraLink)+"' target='_blank' rel='noopener noreferrer'>Abrir referência</a>":'—')+"</p>"):(r.observacoes?"<p>"+escapeHtml(r.observacoes)+"</p>":'');return "<div class='referral-admin-item'><h4>"+r.tier+" indicações • "+escapeHtml(reward?.title||r.titulo||'Prêmio')+"</h4><div class='tiny'>"+escapeHtml(r.profile?.nome||r.uid)+" "+(r.profile?.nomeUsuario?'@'+escapeHtml(r.profile.nomeUsuario):'')+"</div>"+extra+"<div class='referral-admin-meta'><span>"+escapeHtml(referralAdminStatusLabel(r.status))+"</span><span>"+fmtRelative(r.data)+"</span></div><div class='row' style='margin-top:10px'><button type='button' class='btn primary' data-referral-studio-open='true' data-uid='"+escapeAttr(r.uid)+"' data-tier='"+r.tier+"'>"+(r.tier===50?'Gerenciar obra':'Preparar prêmio')+"</button><button type='button' class='btn' data-referral-admin-status='aprovado' data-referral-admin-uid='"+escapeAttr(r.uid)+"' data-referral-admin-tier='"+r.tier+"'>Em preparação</button>"+(r.tier!==50?"<button type='button' class='btn danger' data-referral-admin-status='recusado' data-referral-admin-uid='"+escapeAttr(r.uid)+"' data-referral-admin-tier='"+r.tier+"'>Recusar</button>":'')+"</div></div>";}).join(''):"<div class='empty'>Nenhum prêmio solicitado ainda.</div>";
      const studio=state.referralStudio?.uid?referralRewardStudioHtml(state.referralStudio.uid,num(state.referralStudio.tier),profiles?.[state.referralStudio.uid]||{},rewards?.[state.referralStudio.uid]?.[state.referralStudio.tier]||{}):'';
      el.innerHTML="<div class='admin-section-card'><div class='admin-section-title'><div><h2>🎁 Evento de divulgação • 3 vagas finais</h2><p>Crie os prêmios, teste no perfil ADM, entregue aos participantes e acompanhe as obras de prioridade total.</p></div><a class='btn ghost' href='#/evento-divulgacao' data-route='/evento-divulgacao'>Abrir evento</a></div>"+referralCapHtml(slots,'')+"<div class='referral-admin-stats' style='margin-top:14px'><div class='referral-admin-stat'><strong>"+participants.length+"</strong><span>Participantes</span></div><div class='referral-admin-stat'><strong>"+totalInvites+"</strong><span>Indicações</span></div><div class='referral-admin-stat'><strong>"+pending+"</strong><span>Prêmios pendentes</span></div><div class='referral-admin-stat'><strong>"+ws.count+"/3</strong><span>Vagas finais ocupadas</span></div></div>"+(ws.closed?"<div class='referral-event-closed'><strong>Evento encerrado para novas indicações</strong><span>Três participantes já conquistaram as vagas de 50. A entrega dos prêmios e o acompanhamento das obras continuam normalmente.</span></div>":'')+studio+"<div class='referral-admin-grid'><section><div class='section-head'><h3 class='section-title'>Participantes</h3></div><div class='referral-admin-list'>"+participantHtml+"</div></section><section><div class='section-head'><h3 class='section-title'>Solicitações e entregas</h3></div><div class='referral-admin-list'>"+requestHtml+"</div></section></div></div>";
      el.querySelectorAll('[data-referral-admin-status]').forEach(b=>b.addEventListener('click',()=>updateReferralRewardAdmin(b.dataset.referralAdminUid,b.dataset.referralAdminTier,b.dataset.referralAdminStatus)));bindReferralAdminStudio(el);
    }

    function clearSupportListeners(){
      (state.supportUnsubs||[]).forEach(fn=>{try{fn?.();}catch(e){}});state.supportUnsubs=[];
    }
    function supportAdminLabel(){return 'ADM Suporte';}
    function supportProfileData(){const p=state.profile||{};return{uid:state.user?.uid||'',nome:p.nome||state.user?.displayName||'Leitor',nomeUsuario:p.nomeUsuario||'',foto:p.foto||state.user?.photoURL||''};}
    function supportCategoryLabel(v){return({geral:'Suporte geral',capitulo:'Erro de capítulo',obra:'Erro de obra',conta:'Conta ou login',comentarios:'Comentários',leitor:'Leitor ou download',busca:'Busca ou biblioteca',pedido:'Pedido de obra'})[v]||'Suporte geral';}
    function supportStatusHtml(online){return "<span class='support-status "+(online?'online':'offline')+"'><span class='support-status-dot'></span>"+(online?'ADM online':'ADM offline')+"</span>";}
    function supportLocalBotHistory(){try{const v=JSON.parse(localStorage.getItem('mp_support_bot_history')||'[]');return Array.isArray(v)?v:[];}catch(e){return[];}}
    function saveSupportLocalBotTurn(problem,resposta,categoria='geral'){try{const list=supportLocalBotHistory(),item={id:'local_'+now(),problema:String(problem||'').slice(0,1200),resposta:String(resposta||'').slice(0,4000),categoria:String(categoria||'geral'),data:now()};list.unshift(item);localStorage.setItem('mp_support_bot_history',JSON.stringify(list.slice(0,20)));return item;}catch(e){return null;}}
    async function supportSavedOverviewData(){let chat=null,bots=[];if(isMember()&&state.firebaseReady){try{const [c,b]=await Promise.all([dbGet('supportChats/'+state.user.uid).catch(()=>null),dbGet('supportBotSessions/'+state.user.uid).catch(()=>({}))]);chat=c||null;bots=objEntries(b||{}).map(([id,r])=>({id,source:'firebase',...(r||{})})).sort((a,b)=>num(b.data)-num(a.data));}catch(e){console.warn('support saved overview',e);}}if(!bots.length)bots=supportLocalBotHistory().map(r=>({source:'local',...(r||{})})).sort((a,b)=>num(b.data)-num(a.data));return{chat,bots};}
    async function renderSupportSavedHistory(){const el=$('#supportSavedHistory');if(!el)return;const data=await supportSavedOverviewData(),parts=[];const meta=data.chat?.meta||{};if(meta.uid||data.chat?.mensagens){const unread=supportMessagesArray(data.chat?.mensagens||{}).filter(m=>m.papel==='adm'&&!m.lidoUsuario).length;parts.push("<button type='button' class='support-saved-card' data-support-open-chat='"+escapeAttr(meta.categoria||'geral')+"'><span class='support-saved-icon'>🛟</span><span class='support-saved-copy'><strong>Continuar conversa com o ADM</strong><small>"+escapeHtml(meta.ultimaMensagem||'Sua conversa continua salva aqui.')+"</small><span class='support-saved-label'>"+(unread?unread+' nova'+(unread===1?'':'s')+' resposta'+(unread===1?'':'s'):'Conversa salva')+"</span></span><span class='support-saved-go'>›</span></button>");}for(const r of (data.bots||[]).slice(0,5)){const raw=(r.source||'local')+'|'+String(r.id||'');parts.push("<button type='button' class='support-saved-card' data-support-bot-history='"+escapeAttr(raw)+"'><span class='support-saved-icon'>✦</span><span class='support-saved-copy'><strong>Assistente MP SCAN</strong><small>"+escapeHtml(r.problema||'Conversa salva com o assistente')+"</small><span class='support-saved-label'>"+escapeHtml(fmtRelative(r.data||now()))+"</span></span><span class='support-saved-go'>›</span></button>");}el.innerHTML=parts.length?"<div class='support-saved-grid'>"+parts.join('')+"</div><div class='support-history-note' style='margin-top:10px'>Seu chat com o ADM fica salvo na sua conta. As conversas do assistente ficam sincronizadas na conta quando possível e também têm uma cópia neste aparelho.</div>":"<div class='support-empty'>Você ainda não tem atendimentos salvos. Quando conversar com o ADM ou com o assistente, eles aparecerão aqui.</div>";}
    async function supportOpenBotHistory(raw){const [source,id]=String(raw||'').split('|');let r=null;if(source==='firebase'&&isMember()&&state.firebaseReady&&id)r=await dbGet('supportBotSessions/'+state.user.uid+'/'+id).catch(()=>null);if(!r){r=supportLocalBotHistory().find(x=>String(x?.id||'')===String(id||''))||null;}if(!r){ui.toast('Não foi possível abrir esta conversa salva.');return;}supportCaptureRequestDraft();state.supportEditing=false;state.supportView='bot';state.supportTopic=r.categoria||'geral';state.supportBotMessages=[];if(r.problema)state.supportBotMessages.push({role:'user',text:r.problema});if(r.resposta)state.supportBotMessages.push({role:'bot',text:r.resposta});state.supportBotContext={workId:'',workName:'',chapterNumber:'',issue:'',topic:state.supportTopic,lastIntent:'history',attempts:0,lastText:r.problema||'',lastBotQuestion:'',turns:[],previousWorkId:''};state.supportBotSessionId=source==='firebase'?id:'';await renderSupport(true);}
    function supportHeroHtml(title,desc,online,back=true){return "<div class='support-top'>"+(back?"<a class='support-back' href='#/configuracoes' data-route='/configuracoes' aria-label='Voltar'>←</a>":'')+"<div style='min-width:0;flex:1'><div class='support-hero'><h1>"+escapeHtml(title)+"</h1><p>"+escapeHtml(desc)+"</p><div class='support-status-row'>"+supportStatusHtml(!!online)+"<span class='support-status'>🔒 Conversa privada</span></div></div></div></div>";}
    function supportOptionsHtml(){
      const opts=[
        ['capitulo','📖','Erro de capítulo','Página não abre, imagem faltando, capítulo errado ou travando.'],
        ['obra','▣','Erro de obra','Capa, sinopse, informações ou capítulos da obra com problema.'],
        ['conta','👤','Conta ou login','Login, cadastro, confirmação de e-mail ou perfil.'],
        ['comentarios','💬','Comentários','Não consegue comentar, responder, reagir ou editar.'],
        ['leitor','⚙','Leitor ou download','Ajustes do leitor, leitura offline, zoom ou navegação.'],
        ['busca','⌕','Busca ou biblioteca','Filtros, coleções, favoritos ou resultado de busca.']
      ];
      return opts.map(o=>"<button type='button' class='support-option' data-support-bot-topic='"+o[0]+"'><span class='support-option-icon'>"+o[1]+"</span><span><strong>"+o[2]+"</strong><small>"+o[3]+"</small></span></button>").join('');
    }
    async function getSupportOnline(){if(!state.firebaseReady)return false;try{return !!(await dbGet('config/support/adminOnline'));}catch(e){return false;}}
    async function renderSupport(force=false){
      const root=$('#supportContent');if(!root)return;
      const active=document.activeElement,editingHere=!!(active&&root.contains(active)&&/^(INPUT|TEXTAREA|SELECT)$/.test(active.tagName)),expectedView=isAdmin()?'admin':state.supportView;
      if(!force&&(state.supportEditing||editingHere)&&root.dataset.supportView===expectedView)return;
      if(typeof supportCaptureRequestDraft==='function')supportCaptureRequestDraft();
      clearSupportListeners();document.title=(isAdmin()?'ADM Suporte':'Suporte')+' — MP SCAN';
      if(isAdmin())return renderSupportAdmin(root);
      if(state.supportView==='bot')return renderSupportBot(root);
      if(state.supportView==='chat')return renderSupportChat(root);
      if(state.supportView==='request')return renderSupportRequest(root);
      const online=await getSupportOnline();state.supportViewMounted='home';root.dataset.supportView='home';
      root.innerHTML=supportHeroHtml('Central de Suporte','Escolha como você quer resolver o problema. O assistente automático pode ajudar primeiro, e o ADM continua disponível quando você precisar.',online,true)+
      "<section class='support-section'><div class='support-section-head'><div><h2>O que aconteceu?</h2><p>Escolha uma categoria para receber ajuda mais rápida.</p></div></div><div class='support-option-grid'>"+supportOptionsHtml()+"</div></section>"+
      "<section class='support-section'><div class='support-section-head'><div><h2>Atendimento</h2><p>Você escolhe entre ajuda automática ou conversa com a equipe.</p></div></div><div class='support-option-grid'><button type='button' class='support-option featured' data-support-open-bot='geral'><span class='support-option-icon'>✦</span><span><strong>Falar com o Assistente MP SCAN</strong><small>Conte o problema e receba orientações imediatamente, sem esperar o ADM.</small></span></button><button type='button' class='support-option featured' data-support-open-chat='geral'><span class='support-option-icon'>🛟</span><span><strong>Falar com o ADM</strong><small>Abra um chat privado. Mesmo offline, você pode deixar a mensagem normalmente.</small></span></button><button type='button' class='support-option' data-support-open-request='true'><span class='support-option-icon'>＋</span><span><strong>Pedir uma obra</strong><small>Envie o nome e as informações da obra que gostaria de ver no MP SCAN.</small></span></button><a class='support-option' href='#/configuracoes' data-route='/configuracoes'><span class='support-option-icon'>⚙</span><span><strong>Voltar às Configurações</strong><small>Retorne para as demais opções do aplicativo.</small></span></a></div></section>"+      "<section class='support-section'><div class='support-section-head'><div><h2>Meus atendimentos</h2><p>Volte para conversas anteriores sem perder o que já foi falado.</p></div></div><div id='supportSavedHistory'><div class='support-empty'>Carregando seus atendimentos...</div></div></section>";
      renderSupportSavedHistory().catch(e=>{console.warn('support history',e);const el=$('#supportSavedHistory');if(el)el.innerHTML="<div class='support-empty'>Não foi possível carregar o histórico agora.</div>";});
      if(state.firebaseReady){try{state.supportUnsubs.push(onValue(pathRef('config/support'),s=>{const on=!!s.val()?.adminOnline;root.querySelectorAll('.support-status').forEach((el,i)=>{if(i===0)el.outerHTML=supportStatusHtml(on);});}));}catch(e){}}
    }
    function supportBotInitial(topic){
      const label=supportCategoryLabel(topic).toLowerCase();
      return "Oi! 💗 Eu sou o Assistente MP SCAN. Pode falar comigo normalmente — desde um simples ‘oi’ até uma dúvida sobre obra, capítulo, download, leitor, conta ou "+label+".\n\nEu tento entender o assunto pelo que você escrever e mantenho o contexto só quando ele realmente fizer sentido. Se você mudar de assunto, eu acompanho a mudança.";
    }
    function supportBotNormalize(value){
      return String(value||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,' ').replace(/\s+/g,' ').trim();
    }
    function supportBotWords(value){
      const stop=new Set(['a','o','as','os','um','uma','uns','umas','e','eh','de','da','do','das','dos','em','no','na','nos','nas','para','pra','pro','por','com','sem','que','qual','quais','me','meu','minha','meus','minhas','seu','sua','isso','isto','esse','essa','esses','essas','mas','mais','ate','tem','ter','ta','esta','está','aqui','ai','la','lá','eu','voce','voces','vc','vcs','ele','ela']);
      return supportBotNormalize(value).split(' ').filter(w=>w.length>=3&&!stop.has(w));
    }
    function supportBotContext(){
      if(!state.supportBotContext||typeof state.supportBotContext!=='object')state.supportBotContext={workId:'',workName:'',chapterNumber:'',issue:'',topic:state.supportTopic||'geral',lastIntent:'',attempts:0,lastText:'',lastBotQuestion:'',turns:[],previousWorkId:''};
      const ctx=state.supportBotContext;if(!Array.isArray(ctx.turns))ctx.turns=[];return ctx;
    }
    function supportBotRemember(role,text,intent=''){
      const ctx=supportBotContext();ctx.turns.push({role,text:String(text||'').slice(0,500),intent});if(ctx.turns.length>12)ctx.turns=ctx.turns.slice(-12);
    }
    function supportBotVisibleWorks(){return Array.isArray(state.works)?state.works:[];}
    function supportBotEditDistance(a,b){
      a=String(a||'');b=String(b||'');if(a===b)return 0;if(!a.length)return b.length;if(!b.length)return a.length;
      const prev=Array.from({length:b.length+1},(_,i)=>i),cur=new Array(b.length+1);
      for(let i=1;i<=a.length;i++){cur[0]=i;for(let j=1;j<=b.length;j++)cur[j]=Math.min(cur[j-1]+1,prev[j]+1,prev[j-1]+(a[i-1]===b[j-1]?0:1));for(let j=0;j<=b.length;j++)prev[j]=cur[j];}
      return prev[b.length];
    }
    function supportBotWordNear(a,b){
      a=String(a||'');b=String(b||'');if(a===b)return true;if(Math.min(a.length,b.length)<4)return false;const max=Math.max(a.length,b.length),d=supportBotEditDistance(a,b);return 1-d/max>=.74;
    }
    function supportBotFindWork(text){
      const q=supportBotNormalize(text);if(!q)return null;const qWords=supportBotWords(q);let best=null,bestScore=0;
      for(const w of supportBotVisibleWorks()){
        const names=[w?.name,w?.altName].filter(Boolean);let score=0;
        for(const name of names){
          const n=supportBotNormalize(name);if(!n)continue;if(q.includes(n))score=Math.max(score,1300+n.length);
          const words=supportBotWords(n);let hits=0,near=0;
          for(const tw of words){if(qWords.includes(tw))hits++;else if(qWords.some(qw=>supportBotWordNear(tw,qw)))near++;}
          if(words.length&&hits===words.length)score=Math.max(score,220+hits*22);
          else if(words.length&&hits+near===words.length&&hits>=1)score=Math.max(score,150+hits*20+near*10);
          else if(hits>=2)score=Math.max(score,70+hits*18);
          else if(hits===1&&words.length===1&&words[0].length>=5)score=Math.max(score,36);
        }
        if(score>bestScore){bestScore=score;best=w;}
      }
      return bestScore>=36?best:null;
    }
    function supportBotContextWork(){const ctx=supportBotContext();if(!ctx.workId)return null;return supportBotVisibleWorks().find(w=>w.id===ctx.workId)||null;}
    function supportBotExtractChapter(text){
      const q=supportBotNormalize(text);let m=q.match(/(?:capitulo|cap|ch)\s*(?:numero\s*)?(\d+(?:[.,]\d+)?)/i);
      if(!m)m=q.match(/(?:ate|vai ate|chegou no|estou no|parei no)\s+(?:o\s+)?(?:capitulo\s*)?(\d+(?:[.,]\d+)?)/i);
      if(!m&&/^\d+(?:[.,]\d+)?$/.test(q))m=[q,q];
      return m?String(m[1]).replace(',','.'):'';
    }
    function supportBotChapterList(work){if(!work)return[];return (state.chapters?.[work.id]||[]).filter(c=>c&&c.published!==false);}
    function supportBotLatestChapter(work){
      const list=supportBotChapterList(work);if(!list.length)return null;const numeric=list.filter(c=>Number.isFinite(Number(String(c.number).replace(',','.'))));
      if(numeric.length)return numeric.slice().sort((a,b)=>Number(String(b.number).replace(',','.'))-Number(String(a.number).replace(',','.'))||num(b.updatedAt)-num(a.updatedAt))[0];
      return list.slice().sort((a,b)=>num(b.updatedAt||b.createdAt)-num(a.updatedAt||a.createdAt))[0];
    }
    function supportBotFindChapter(work,number){
      if(!work||!number)return null;const n=Number(String(number).replace(',','.'));
      return supportBotChapterList(work).find(c=>{const cn=Number(String(c.number).replace(',','.'));return Number.isFinite(n)&&Number.isFinite(cn)?cn===n:supportBotNormalize(c.number)===supportBotNormalize(number);})||null;
    }
    function supportBotWorkSummary(work){
      if(!work)return'';const latest=supportBotLatestChapter(work),parts=[];if(work.type)parts.push(work.type);if(work.status)parts.push(labelStatus(work.status));
      if(latest)parts.push('capítulo mais recente: '+latest.number+(latest.title?' — '+latest.title:''));else parts.push('sem capítulos publicados');return '“'+work.name+'”'+(parts.length?' • '+parts.join(' • '):'');
    }
    function supportBotGreetingOnly(q){
      if(!q)return false;const compact=q.replace(/\s+/g,' ');
      if(/^(o+i+e*|ola+|opa+|hey+|hello+|salve+|e ai+|eai+|bom dia+|boa tarde+|boa noite+)( tudo bem| tudo bom| como vai| beleza| tudo certo)?$/.test(compact))return true;
      return /^(tudo bem|tudo bom|como vai|como voce esta|beleza|de boa)$/.test(compact);
    }
    function supportBotGreetingPrefix(raw){
      const n=supportBotNormalize(raw);const m=n.match(/^(o+i+e*|ola+|opa+|hey+|hello+|salve+|e ai+|eai+|bom dia+|boa tarde+|boa noite+)\b\s*(.*)$/);return m?{greeting:m[1],rest:(m[2]||'').trim()}:null;
    }
    function supportBotPick(list){const ctx=supportBotContext(),i=(ctx.turns.length+String(ctx.lastText||'').length)%list.length;return list[i];}
    function supportBotDetectIssue(q){
      if(/(?:app|aplicativo|apk).*(?:baix|download|instal)|(?:baix|download|instal).*(?:app|aplicativo|apk)/.test(q))return'app_download';
      if(/volta.*(?:inicio|comeco|primeira)|retom|continuar lendo|pagina salva|ponto salvo|nao volta.*pagina|perde.*progresso|progresso.*some/.test(q))return'resume';
      if(/(?:download|baixando|baixar|offline).*(?:trav|parad|nao|erro|falh|carreg|sum)|nao.*(?:download|baixar)|offline.*(?:nao|erro|falh|abre|funcion)/.test(q))return'download';
      if(/capitulo|pagina|imagem/.test(q)&&/(nao|erro|falh|trav|carreg|preto|branco|sum|falt|abre|bug)/.test(q))return'chapter';
      if(/coment|responder|resposta|reacao|curtir/.test(q)&&/(nao|erro|falh|sum|apag|trav|envia|funcion|bug)/.test(q))return'comments';
      if(/login|entrar|senha|email|e mail|google|cadastro|confirmacao|conta/.test(q)&&/(nao|erro|falh|recus|trav|codigo|verific|entra|acessa|funcion|bug)/.test(q))return'account';
      if(/busca|pesquisa|filtro|biblioteca|colecao|favorit/.test(q)&&/(nao|erro|falh|sum|ach|encontr|aparec|funcion|bug)/.test(q))return'search';
      if(/notifica|sino|aviso/.test(q)&&/(nao|erro|falh|sum|aparec|pres|contador|funcion|bug)/.test(q))return'notification';
      if(/\b18\b|maioridade|sensivel|adulto/.test(q)&&/(nao|erro|falh|sum|aparec|bloque|ativ|funcion|bug)/.test(q))return'age';
      if(/obra|capa|sinopse|autor|artista|genero/.test(q)&&/(err|falt|sum|nao|incorret|troca|errad|bug)/.test(q))return'work';
      return'';
    }
    function supportBotIssueLabel(issue){return({chapter:'capítulo não carrega corretamente',download:'download/offline',resume:'retomada da leitura',comments:'comentários',account:'conta/login',search:'busca ou biblioteca',notification:'notificações',work:'informações da obra',age:'maioridade/conteúdo sensível',app_download:'download do aplicativo'})[issue]||'problema no site';}
    function supportBotIsFollowUp(q){return /^(e |mas |so que |entao |agora |tambem |ainda |esse |essa |isso |ele |ela |o mesmo|a mesma|continua|nao|sim|e o |e no |e na )/.test(q)||/\b(nesse|nessa|desse|dessa|mesmo problema|continua igual|ainda nao)\b/.test(q);}
    function supportBotIsTopicSwitch(q){return /mudando de assunto|outra coisa|outro assunto|agora quero saber|agora e outra|falando de outra|tenho outra duvida/.test(q);}
    function supportBotWorkLead(work,chapterNumber){
      if(!work&&!chapterNumber)return'';if(work&&chapterNumber)return 'Sobre “'+work.name+'”, capítulo '+chapterNumber+': ';
      if(work)return 'Sobre “'+work.name+'”: ';return 'Sobre o capítulo '+chapterNumber+': ';
    }
    function supportBotSecondStep(ctx){
      const work=supportBotContextWork(),lead=supportBotWorkLead(work,ctx.chapterNumber),issue=supportBotIssueLabel(ctx.issue);let extra='';
      if(ctx.issue==='chapter')extra='Como a tentativa anterior não resolveu, teste outro capítulo da mesma obra. Se o outro abrir normalmente, isso indica que o problema está concentrado neste capítulo.';
      else if(ctx.issue==='download')extra='Veja em Biblioteca → Downloads se o capítulo aparece completo. Se estiver incompleto, remova só esse download e tente novamente.';
      else if(ctx.issue==='resume')extra='Abra novamente pelo card “Continuar lendo”. Se ele voltar ao começo outra vez, já considero esse teste como falho e o ADM precisa receber o caso.';
      else if(ctx.issue==='app_download')extra='Se o navegador continua apenas carregando a página sem iniciar o APK, já vale encaminhar o caso ao ADM.';
      else extra='Como já houve uma tentativa sem sucesso, não vou ficar repetindo a mesma instrução.';
      return lead+'entendi, ainda não resolveu o problema de '+issue+'. '+extra+'\n\nSe continuar assim, use “🛟 Ainda preciso falar com o ADM”. Eu envio junto o contexto que você já me contou.';
    }
    function supportBotEscalationSummary(){
      const ctx=supportBotContext(),work=supportBotContextWork(),parts=['Eu tentei o Assistente MP SCAN e ainda preciso de ajuda.'];
      if(work)parts.push('Obra: '+work.name+'.');if(ctx.chapterNumber)parts.push('Capítulo: '+ctx.chapterNumber+'.');if(ctx.issue)parts.push('Problema: '+supportBotIssueLabel(ctx.issue)+'.');
      const recent=ctx.turns.filter(t=>t.role==='user').slice(-3).map(t=>t.text).filter(Boolean);if(recent.length)parts.push('Resumo do que eu disse: '+recent.join(' | '));return parts.join(' ');
    }
    function supportBotGenreMatches(q){
      const genres=new Set();for(const w of supportBotVisibleWorks())for(const g of (w.genres||[]))genres.add(String(g));let found='';
      for(const g of genres){if(q.includes(supportBotNormalize(g))){found=g;break;}}if(!found)return null;
      const list=supportBotVisibleWorks().filter(w=>(w.genres||[]).some(g=>supportBotNormalize(g)===supportBotNormalize(found))).slice(0,5);return{genre:found,list};
    }
    async function supportBotChapterDiagnostic(work,chapterNumber){
      if(!work||!chapterNumber)return null;const c=supportBotFindChapter(work,chapterNumber);if(!c)return{exists:false,pages:null,offline:null,chapter:null};
      let pages=null,offline=null;try{if(state.firebaseReady){const p=await readChapterPages(work.id,c.id);pages=Array.isArray(p)?p.length:null;}}catch(e){}
      try{const o=await offlineGet(work.id+'__'+c.id);offline=o?.pages?.length||0;}catch(e){}
      return{exists:true,pages,offline,chapter:c};
    }
    async function supportBotAnswer(text){
      const raw=String(text||'').trim(),fullQ=supportBotNormalize(raw),ctx=supportBotContext();if(!fullQ)return'Pode escrever normalmente. Estou te ouvindo.';
      ctx.lastText=raw;supportBotRemember('user',raw,'');

      if(supportBotGreetingOnly(fullQ)){
        const ans=supportBotPick(['Oi! 💗 Tudo bem? Pode falar, o que você quer saber?','Oii! 💗 Estou aqui. Pode mandar sua dúvida do jeito que vier.','Oi! ✨ Pode falar comigo normalmente. Se for sobre uma obra, capítulo ou algum problema no site, eu tento entender pelo contexto.']);supportBotRemember('bot',ans,'greeting');return ans;
      }
      if(/^(obrigad[ao]?|valeu|vlw|brigad[ao]?|show|perfeito|boa|beleza)$/.test(fullQ)){
        const ans='Por nada 💗 Se quiser mudar de assunto ou perguntar outra coisa, pode mandar direto.';supportBotRemember('bot',ans,'thanks');return ans;
      }
      if(/^(kk+|kkkk+|rs+|haha+|hahaha+)$/.test(fullQ)){
        const ans='😂 Pode falar, estou acompanhando.';supportBotRemember('bot',ans,'smalltalk');return ans;
      }
      if(/^(quem e voce|quem e vc|o que voce faz|o que vc faz|como voce funciona|como vc funciona)$/.test(fullQ)){
        const ans='Eu sou o Assistente MP SCAN. Posso conversar com você, procurar obras no catálogo visível, verificar qual capítulo está publicado, entender problemas do leitor/download e organizar o contexto para o ADM quando for necessário.';supportBotRemember('bot',ans,'about_bot');return ans;
      }
      if(/o que e (?:o )?mp scan|o que e (?:esse )?site|para que serve (?:o )?mp scan|o que tem no (?:mp scan|site)/.test(fullQ)){
        const ans='O MP SCAN é a plataforma de leitura da scan. Aqui você pode encontrar obras e capítulos publicados, usar busca e biblioteca, acompanhar histórico, comentar e usar recursos do leitor e download/offline quando disponíveis.';supportBotRemember('bot',ans,'about_site');return ans;
      }
      if(/nao resolveu|nao deu certo|continua igual|continua do mesmo jeito|ainda nao|mesmo problema|nao funcionou|continua sem funcionar/.test(fullQ)&&ctx.issue){ctx.attempts=num(ctx.attempts)+1;const ans=supportBotSecondStep(ctx);supportBotRemember('bot',ans,'retry');return ans;}
      if(/^(resolveu|deu certo|funcionou|agora foi|resolvido|consegui)$/.test(fullQ)){
        ctx.issue='';ctx.attempts=0;const ans='Ótimo 💗 Então esse problema ficou resolvido. Pode puxar outro assunto normalmente se quiser.';supportBotRemember('bot',ans,'resolved');return ans;
      }

      const greeting=supportBotGreetingPrefix(raw);const body=greeting&&greeting.rest?greeting.rest:raw,q=supportBotNormalize(body);
      const switched=supportBotIsTopicSwitch(q);if(switched){ctx.issue='';ctx.chapterNumber='';ctx.attempts=0;ctx.lastIntent='';}
      const explicitWork=supportBotFindWork(body);
      if(explicitWork&&ctx.workId&&explicitWork.id!==ctx.workId){ctx.previousWorkId=ctx.workId;ctx.chapterNumber='';ctx.issue='';ctx.attempts=0;ctx.lastIntent='';}
      if(explicitWork){ctx.workId=explicitWork.id;ctx.workName=explicitWork.name;}
      let work=explicitWork||supportBotContextWork();
      const chapterNumber=supportBotExtractChapter(body);if(chapterNumber&&chapterNumber!==ctx.chapterNumber){if(!supportBotIsFollowUp(q)&&!explicitWork)ctx.issue='';ctx.chapterNumber=chapterNumber;}
      const issue=supportBotDetectIssue(q);if(issue){if(ctx.issue&&ctx.issue!==issue)ctx.attempts=0;ctx.issue=issue;ctx.attempts=num(ctx.attempts)+1;}
      const followUp=supportBotIsFollowUp(q),activeIssue=issue||(followUp?ctx.issue:'');

      const asksLatest=/ate qual capitulo|qual o ultimo capitulo|ultimo capitulo|capitulo mais recente|quantos capitulos|vai ate qual|ate que capitulo|qual capitulo tem|qual capitulo esta/.test(q);
      if(asksLatest){
        if(!work){const ans='Consigo verificar. Qual é o nome da obra? Pode escrever só uma parte do título.';ctx.lastIntent='await_work_latest';ctx.lastBotQuestion='work';supportBotRemember('bot',ans,'await_work_latest');return ans;}
        const latest=supportBotLatestChapter(work);ctx.lastIntent='catalog';const ans=!latest?'Encontrei '+supportBotWorkSummary(work)+'. No momento não aparece nenhum capítulo publicado dessa obra para a sua conta.':'“'+work.name+'” está, no catálogo visível para você, até o capítulo '+latest.number+(latest.title?' — '+latest.title:'')+'.';supportBotRemember('bot',ans,'catalog_latest');return ans;
      }

      if(ctx.lastIntent==='await_work_latest'&&work){const latest=supportBotLatestChapter(work),ans=latest?'Encontrei “'+work.name+'”. Ela está até o capítulo '+latest.number+(latest.title?' — '+latest.title:'')+' no catálogo visível para você.':'Encontrei “'+work.name+'”, mas não aparece nenhum capítulo publicado para sua conta.';ctx.lastIntent='catalog';supportBotRemember('bot',ans,'catalog_latest');return ans;}

      if(work&&ctx.chapterNumber&&(/\btem\b|existe|disponivel|publicad|esta no site|capitulo/.test(q))&&!issue&&!/nao|erro|trav|carreg|abre|bug/.test(q)){
        const c=supportBotFindChapter(work,ctx.chapterNumber),latest=supportBotLatestChapter(work);ctx.lastIntent='catalog';const ans=c?'Sim. “'+work.name+'” tem o capítulo '+c.number+(c.title?' — '+c.title:'')+' publicado e visível para você.':'Não encontrei o capítulo '+ctx.chapterNumber+' de “'+work.name+'” entre os capítulos publicados visíveis para a sua conta.'+(latest?' O mais recente que aparece é o '+latest.number+'.':'');supportBotRemember('bot',ans,'catalog_chapter');return ans;
      }

      if(activeIssue==='chapter'){
        const lead=supportBotWorkLead(work,ctx.chapterNumber);let diagnostic='';
        if(work&&ctx.chapterNumber){const d=await supportBotChapterDiagnostic(work,ctx.chapterNumber);if(d&&!d.exists)diagnostic='Eu conferi o catálogo visível e esse capítulo não aparece como publicado para você. ';else if(d?.exists&&d.pages===0)diagnostic='Eu encontrei o capítulo, mas ele está sem páginas disponíveis no banco agora; nesse caso o ADM precisa corrigir a publicação. ';else if(d?.exists&&d.pages>0)diagnostic='Eu encontrei o capítulo e ele tem '+d.pages+' página'+(d.pages===1?'':'s')+' cadastrada'+(d.pages===1?'':'s')+'. ';}
        const network=navigator.onLine===false?'Seu aparelho também está aparecendo como sem conexão neste momento. ':'';
        const ans=lead+diagnostic+network+'Se ele continua carregando, preto/branco ou com imagens faltando, atualize uma vez e teste outro capítulo da mesma obra. Se o outro abrir e este não, o problema provavelmente está só neste capítulo. Depois me diga se resolveu ou não.';ctx.lastIntent='troubleshoot';supportBotRemember('bot',ans,'chapter_issue');return ans;
      }
      if(activeIssue==='resume'){
        const lead=supportBotWorkLead(work,ctx.chapterNumber),h=work?state.history?.[work.id]:null;let saved='';if(h&&(!ctx.chapterNumber||String(h.numero)===String(ctx.chapterNumber)||h.chapterId===supportBotFindChapter(work,ctx.chapterNumber)?.id)){saved='Eu vejo um progresso salvo'+(num(h.paginaAtual)>0?' na página '+num(h.paginaAtual):'')+(num(h.totalPaginas)>0?' de '+num(h.totalPaginas):'')+'. ';}
        const ans=lead+saved+'Abra novamente pelo card “Continuar lendo” e espere as páginas aparecerem antes de rolar. Se ele for ao ponto salvo e depois voltar para o começo, diga “não resolveu”; isso já indica que a retomada está sendo sobrescrita e eu encaminho o contexto ao ADM.';ctx.lastIntent='troubleshoot';supportBotRemember('bot',ans,'resume_issue');return ans;
      }
      if(activeIssue==='download'){
        let extra='';if(work&&ctx.chapterNumber){const c=supportBotFindChapter(work,ctx.chapterNumber);if(c){try{const off=await offlineGet(work.id+'__'+c.id);extra=off?.pages?.length?'Eu encontrei um download local com '+off.pages.length+' página'+(off.pages.length===1?'':'s')+'. ':'Não encontrei esse capítulo salvo por completo neste aparelho. ';}catch(e){}}}
        const ans=supportBotWorkLead(work,ctx.chapterNumber)+extra+(navigator.onLine===false?'Você está sem conexão agora. ':'')+'Se o download fica parado, abra Biblioteca → Downloads. Se estiver incompleto, remova só esse capítulo e tente novamente quando a conexão estiver estável. Se continuar travado, diga “não resolveu”.';ctx.lastIntent='troubleshoot';supportBotRemember('bot',ans,'download_issue');return ans;
      }
      if(activeIssue==='app_download'){
        const ans='Se o botão do aplicativo abre uma página e fica carregando em vez de baixar o APK, tente pelo navegador do aparelho e confira se downloads estão permitidos. Se mesmo assim o arquivo não começar, diga “não resolveu” e eu passo esse caso para o ADM sem você repetir tudo.';ctx.lastIntent='troubleshoot';supportBotRemember('bot',ans,'app_download');return ans;
      }
      if(activeIssue==='work'){
        const ans=supportBotWorkLead(work,ctx.chapterNumber)+'Se capa, sinopse, autor, gênero ou lista de capítulos estiver errada, me diga exatamente qual informação. Se eu reconhecer a obra, consigo comparar com o cadastro que está visível e dizer se é algo que o ADM precisa corrigir.';ctx.lastIntent='troubleshoot';supportBotRemember('bot',ans,'work_issue');return ans;
      }
      if(activeIssue==='account'){
        const ans='Entendi, é sobre a conta. Se for login, me diga o que acontece depois que você toca em entrar — aparece mensagem de erro, volta para a mesma tela ou fica carregando? Não envie senha nem código de verificação.';ctx.lastIntent='troubleshoot';ctx.lastBotQuestion='account_behavior';supportBotRemember('bot',ans,'account_issue');return ans;
      }
      if(activeIssue==='comments'){
        const ans=supportBotWorkLead(work,ctx.chapterNumber)+'Se comentário, resposta ou reação some ou não envia, me diga qual ação você fez e o que aconteceu logo depois. Se o texto apaga ou o botão não responde, eu já trato como falha da tela e posso encaminhar ao ADM.';ctx.lastIntent='troubleshoot';supportBotRemember('bot',ans,'comments_issue');return ans;
      }
      if(activeIssue==='search'){
        const ans='Na Busca/Biblioteca, posso tentar separar se é filtro ou se a obra realmente não está aparecendo. Me diga o nome da obra que você procurou e, se lembrar, quais filtros estavam ativos.';ctx.lastIntent='troubleshoot';ctx.lastBotQuestion='search_work';supportBotRemember('bot',ans,'search_issue');return ans;
      }
      if(activeIssue==='notification'){
        const ans='Entendi, é sobre notificações. Me diga se o problema é: o sino não mostra nada, o contador fica preso, ou a notificação de capítulo novo não chega. Cada caso tem uma causa diferente.';ctx.lastIntent='troubleshoot';ctx.lastBotQuestion='notification_kind';supportBotRemember('bot',ans,'notification_issue');return ans;
      }
      if(activeIssue==='age'){
        const ans='Entendi, é sobre maioridade/conteúdo sensível. Me diga o que aparece em Configurações nessa parte: “verificado”, “não verificado”, ativado ou desativado. Com isso eu consigo separar se é permissão da conta ou só exibição da obra.';ctx.lastIntent='troubleshoot';supportBotRemember('bot',ans,'age_issue');return ans;
      }

      if(work){
        const latest=supportBotLatestChapter(work),genres=(work.genres||[]).slice(0,4).join(', '),asksInfo=/sinopse|sobre o que|do que fala|autor|artista|genero|status|informacao|fala sobre/.test(q);let ans='';
        if(/sinopse|sobre o que|do que fala|fala sobre/.test(q)&&work.synopsis)ans='“'+work.name+'”: '+work.synopsis;
        else if(/autor/.test(q))ans=work.author?'O autor cadastrado de “'+work.name+'” é '+work.author+'.':'Não aparece um autor cadastrado para “'+work.name+'” agora.';
        else if(/artista/.test(q))ans=work.artist?'O artista cadastrado de “'+work.name+'” é '+work.artist+'.':'Não aparece um artista cadastrado para “'+work.name+'” agora.';
        else{ans='Encontrei '+supportBotWorkSummary(work)+'.';if(genres)ans+=' Gêneros: '+genres+'.';if(!asksInfo&&latest)ans+=' Se quiser, pode perguntar por um capítulo específico.';}
        ctx.lastIntent='catalog';supportBotRemember('bot',ans,'work_info');return ans;
      }

      const genre=supportBotGenreMatches(q);if(genre&&(/tem|quais|recomenda|obra|manga|manhwa|manhua|novel|genero/.test(q))){const names=genre.list.map(w=>'“'+w.name+'”');const ans=names.length?'No catálogo visível, encontrei '+genre.genre+' em '+names.join(', ')+(genre.list.length>=5?' e outras.':'.'):'Não encontrei nenhuma obra visível com o gênero '+genre.genre+' agora.';supportBotRemember('bot',ans,'genre');return ans;}
      if(/quais obras|que obras|lista de obras|o que tem para ler|o que tem pra ler|me recomenda|recomenda alguma/.test(q)){
        const list=supportBotVisibleWorks().slice().sort((a,b)=>num(b.updatedAt)-num(a.updatedAt)).slice(0,5);const ans=list.length?'Algumas obras que estão visíveis agora: '+list.map(w=>'“'+w.name+'”').join(', ')+'. Se você me disser um gênero, eu tento filtrar melhor.':'Não apareceu nenhuma obra visível no catálogo agora.';supportBotRemember('bot',ans,'works_list');return ans;
      }
      if(/obra|manga|manhwa|manhua|novel|webtoon/.test(q)&&/(nao acho|nao achei|cade|tem|existe|procuro|procurando|encontrar)/.test(q)){
        const ans='Posso procurar no catálogo. Escreva o nome da obra, mesmo incompleto ou com algum errinho de digitação.';ctx.lastIntent='await_work_lookup';ctx.lastBotQuestion='work';supportBotRemember('bot',ans,'await_work_lookup');return ans;
      }
      if(ctx.lastIntent==='await_work_lookup'&&!work){const ans='Ainda não consegui reconhecer o título. Tente escrever mais uma parte do nome da obra.';supportBotRemember('bot',ans,'await_work_lookup');return ans;}

      if(greeting&&greeting.rest){const ans='Oi! 💗 Sobre o que você escreveu depois do oi: eu ainda não consegui identificar com segurança se é uma obra, capítulo ou problema. Pode continuar a frase do seu jeito que eu acompanho.';supportBotRemember('bot',ans,'clarify');return ans;}
      const topic=state.supportTopic||ctx.topic||'geral';let ans='';
      if(topic==='capitulo')ans='Pode me contar o que aconteceu com o capítulo do seu jeito. Se souber, diga também o nome da obra e o número do capítulo.';
      else if(topic==='leitor')ans='Pode me contar o que o leitor está fazendo de errado — por exemplo se volta para o começo, trava, não baixa ou perde a página.';
      else ans='Pode continuar. Eu não quero chutar uma resposta que não tenha a ver com o que você quis dizer. Se for uma dúvida do MP SCAN, diga o que você quer saber ou o que aconteceu na tela.';
      supportBotRemember('bot',ans,'clarify');return ans;
    }
    async function renderSupportBot(root){
      const online=await getSupportOnline();state.supportViewMounted='bot';root.dataset.supportView='bot';if(!state.supportBotMessages.length)state.supportBotMessages=[{role:'bot',text:supportBotInitial(state.supportTopic||'geral')}];
      root.innerHTML=supportHeroHtml('Assistente MP SCAN','Conversa com contexto, catálogo visível e diagnóstico básico do leitor.',online,true)+"<section class='support-section'><div class='support-bot-head'><div class='support-bot-mark'>✦</div><div><strong>Assistente MP SCAN</strong><div class='tiny'>Conversa naturalmente e acompanha mudanças de assunto</div></div></div><div class='support-bot-quick'><button type='button' data-support-bot-quick='O capítulo não carrega'>📖 Capítulo não carrega</button><button type='button' data-support-bot-quick='Meu download travou'>⬇ Download travou</button><button type='button' data-support-bot-quick='Até qual capítulo tem essa obra?'>🔎 Até qual capítulo?</button></div><div class='support-bot-messages' id='supportBotMessages'></div><div class='support-bot-compose'><textarea id='supportBotInput' maxlength='1200' placeholder='Pode escrever do seu jeito...'>"+escapeHtml(state.supportDraft?.bot||'')+"</textarea><button type='button' class='support-send' data-support-bot-send='true'>Enviar</button></div><div class='support-mini-actions'><button type='button' data-support-bot-quick='Resolveu'>✅ Resolveu</button><button type='button' data-support-bot-quick='Não resolveu'>❌ Não resolveu</button><button type='button' data-support-escalate='true'>🛟 Ainda preciso falar com o ADM</button><button type='button' data-support-home='true'>Voltar às opções</button></div><div class='support-bot-note'>O assistente usa somente dados visíveis do MP SCAN e o contexto desta conversa. Ele não deve pedir senha, código de verificação ou informações secretas.</div></section>";
      renderSupportBotMessages();
    }
    function renderSupportBotMessages(){const el=$('#supportBotMessages');if(!el)return;el.innerHTML=state.supportBotMessages.map(m=>"<div class='support-bot-msg "+(m.role==='user'?'user':'bot')+"'>"+escapeHtml(m.text)+"</div>").join('');el.scrollTop=el.scrollHeight;}
    async function supportBotSend(){const input=$('#supportBotInput'),text=input?.value.trim();if(!text)return;const send=$('[data-support-bot-send]');if(send){send.disabled=true;send.textContent='Pensando…';}input.value='';state.supportDraft.bot='';state.supportBotLastQuestion=text;state.supportBotMessages.push({role:'user',text});renderSupportBotMessages();let answer='';try{answer=await supportBotAnswer(text);}catch(err){console.error('support bot',err);answer='Tive um erro tentando analisar isso. Você pode tentar de novo ou falar com o ADM.';}saveSupportLocalBotTurn(text,answer,state.supportTopic||'geral');setTimeout(()=>{state.supportBotMessages.push({role:'bot',text:answer});renderSupportBotMessages();if(send){send.disabled=false;send.textContent='Enviar';}},220);
      if(state.firebaseReady&&isMember())try{const p=supportProfileData();const ctx=supportBotContext();const r=await dbPush('supportBotSessions/'+p.uid,{uid:p.uid,nome:p.nome,nomeUsuario:p.nomeUsuario||'',problema:text,resposta:answer,categoria:state.supportTopic||'geral',contexto:(ctx.workName?ctx.workName+' • ':'')+(ctx.chapterNumber?'capítulo '+ctx.chapterNumber+' • ':'')+(ctx.issue?supportBotIssueLabel(ctx.issue):''),data:now(),escalado:false});state.supportBotSessionId=r?.key||'';}catch(e){console.warn('support bot log',e);}
    }
    async function renderSupportChat(root){
      state.supportViewMounted='chat';root.dataset.supportView='chat';
      if(!state.firebaseReady){root.innerHTML=supportHeroHtml('Chat com ADM','A conversa com a equipe precisa de conexão com o Firebase.',false,true)+"<section class='support-section'><div class='support-offline-note'>Sem conexão agora. Você ainda pode usar o Assistente MP SCAN.</div><div class='support-mini-actions'><button type='button' data-support-open-bot='geral'>Abrir assistente</button></div></section>";return;}
      if(!isMember()){root.innerHTML=supportHeroHtml('Chat com ADM','Entre na sua conta para manter sua conversa privada e sincronizada.',await getSupportOnline(),true)+"<section class='support-section'><div class='support-empty'>Você precisa estar logado para conversar com o ADM.</div><button type='button' class='btn primary' data-support-login='true'>Entrar na conta</button></section>";return;}
      const online=await getSupportOnline(),p=supportProfileData();
      root.innerHTML=supportHeroHtml('Chat com o ADM',online?'O ADM está online. Envie sua mensagem e acompanhe quando ela for lida.':'ADM offline. Você pode falar normalmente; quando o ADM entrar, ele poderá responder.',online,true)+"<div class='support-chat-card'><div class='support-chat-head'><div class='support-chat-person'><div class='support-chat-avatar'>🛟</div><div><strong>ADM Suporte</strong><small>"+escapeHtml(supportCategoryLabel(state.supportTopic||'geral'))+"</small></div></div>"+supportStatusHtml(online)+"</div><div class='support-messages' id='supportUserMessages'><div class='support-empty'>Carregando conversa...</div></div><div class='support-chat-compose'><textarea id='supportChatInput' maxlength='3000' placeholder='Escreva sua mensagem para o ADM...'>"+escapeHtml(state.supportDraft?.chat||'')+"</textarea><button type='button' class='support-send' data-support-send-user='true'>Enviar</button></div></div><div class='support-mini-actions'><button type='button' data-support-open-bot='"+escapeAttr(state.supportTopic||'geral')+"'>✦ Tentar o assistente</button><button type='button' data-support-home='true'>Voltar às opções</button></div>";
      try{state.supportUnsubs.push(onValue(pathRef('config/support'),s=>{const on=!!s.val()?.adminOnline;const st=root.querySelector('.support-chat-head .support-status');if(st)st.outerHTML=supportStatusHtml(on);}));}catch(e){}
      try{state.supportUnsubs.push(onValue(pathRef('supportChats/'+p.uid+'/mensagens'),s=>{const msgs=s.val()||{};renderSupportUserMessages(msgs);markSupportRead(p.uid,'usuario',msgs).catch(()=>{});}));}catch(e){console.error(e);}
    }
    function supportMessagesArray(v){return objEntries(v||{}).map(([id,m])=>({id,...(m||{})})).sort((a,b)=>num(a.data)-num(b.data));}
    function renderSupportUserMessages(v){const el=$('#supportUserMessages');if(!el)return;const list=supportMessagesArray(v);if(!list.length){el.innerHTML="<div class='support-empty'>Nenhuma mensagem ainda. Conte seu problema para o ADM.</div>";return;}el.innerHTML=list.map(m=>{const mine=m.papel==='usuario',read=mine?!!m.lidoAdm:!!m.lidoUsuario;return "<div class='support-message "+(mine?'mine':'adm')+"'><div class='support-message-name'>"+(mine?'Você':'✦ ADM')+"</div><div class='support-message-text'>"+escapeHtml(m.texto||'')+"</div><div class='support-message-meta'><span>"+escapeHtml(fmtCommentDate(m.data))+"</span>"+(mine?"<span class='support-read "+(read?'read':'')+"'>"+(read?'✓ Lido':'— Não lido')+"</span>":'')+"</div></div>";}).join('');el.scrollTop=el.scrollHeight;}
    async function markSupportRead(uid,reader,msgs){if(!state.firebaseReady)return;const list=supportMessagesArray(msgs);for(const m of list){if(reader==='usuario'&&m.papel==='adm'&&!m.lidoUsuario)await dbUpdate('supportChats/'+uid+'/mensagens/'+m.id,{lidoUsuario:true}).catch(()=>{});if(reader==='adm'&&m.papel==='usuario'&&!m.lidoAdm)await dbUpdate('supportChats/'+uid+'/mensagens/'+m.id,{lidoAdm:true}).catch(()=>{});}}
    async function sendSupportUserMessage(){if(!requireMember())return;const input=$('#supportChatInput'),text=input?.value.trim();if(!text)return;const p=supportProfileData(),base='supportChats/'+p.uid;input.value='';state.supportDraft.chat='';try{const old=await dbGet(base+'/meta')||{};await dbSet(base+'/meta',{...old,uid:p.uid,nome:p.nome,nomeUsuario:p.nomeUsuario||'',foto:p.foto||'',categoria:state.supportTopic||old.categoria||'geral',status:'open',criadoEm:old.criadoEm||now(),atualizadoEm:now(),ultimaMensagem:text.slice(0,180),ultimoAutor:'usuario'});await dbPush(base+'/mensagens',{senderUid:p.uid,papel:'usuario',texto:text,data:now(),lidoUsuario:true,lidoAdm:false});ui.toast('Mensagem enviada ao ADM.');}catch(e){console.error(e);ui.toast('Não foi possível enviar. Confira a conexão ou as regras do suporte.');}}
    function supportCaptureRequestDraft(){
      const d=state.supportDraft||(state.supportDraft={}),read=id=>document.getElementById(id)?.value??'';
      if(document.getElementById('supportRequestName'))d.requestName=read('supportRequestName');
      if(document.getElementById('supportRequestAlt'))d.requestAlt=read('supportRequestAlt');
      if(document.getElementById('supportRequestType'))d.requestType=read('supportRequestType');
      if(document.getElementById('supportRequestLink'))d.requestLink=read('supportRequestLink');
      if(document.getElementById('supportRequestNotes'))d.requestNotes=read('supportRequestNotes');
      if(document.getElementById('supportChatInput'))d.chat=read('supportChatInput');
      if(document.getElementById('supportBotInput'))d.bot=read('supportBotInput');
      const adm=document.getElementById('supportAdminChatInput');if(adm&&state.supportSelectedUid){state.supportAdminDrafts=state.supportAdminDrafts||{};state.supportAdminDrafts[state.supportSelectedUid]=adm.value;}
    }
    function supportRequestTypeButtons(selected=''){
      const types=[['','Não sei'],['Manhwa','Manhwa'],['Mangá','Mangá'],['Manhua','Manhua'],['Novel','Novel'],['Webtoon','Webtoon']];
      return types.map(([value,label])=>"<button type='button' class='support-type-choice "+(String(selected)===value?'active':'')+"' data-support-request-type='"+escapeAttr(value)+"'>"+escapeHtml(label)+"</button>").join('');
    }
    async function renderSupportRequest(root){
      const online=await getSupportOnline();state.supportViewMounted='request';root.dataset.supportView='request';
      if(!isMember()){root.innerHTML=supportHeroHtml('Pedir uma obra','Entre na sua conta para acompanhar o pedido depois.',online,true)+"<section class='support-section'><button type='button' class='btn primary' data-support-login='true'>Entrar na conta</button></section>";return;}
      const d=state.supportDraft||(state.supportDraft={requestName:'',requestAlt:'',requestType:'',requestLink:'',requestNotes:'',chat:'',bot:''});
      root.innerHTML=supportHeroHtml('Pedir uma obra','Envie o máximo de informações que souber. O ADM poderá analisar o pedido na fila de suporte.',online,true)+
      "<section class='support-section'><div class='support-form-card'><div class='support-form-title'><div><h2>Informações da obra</h2><p>Você pode preencher só o que souber. O nome da obra é o único campo obrigatório.</p></div><span class='support-ticket-status'>Pedido</span></div><div class='support-request-form'>"+
      "<div class='support-request-grid'><div class='field'><label>Nome da obra</label><input id='supportRequestName' maxlength='180' autocomplete='off' placeholder='Ex.: Nome da obra' value='"+escapeAttr(d.requestName||'')+"'/></div><div class='field'><label>Nome original ou alternativo</label><input id='supportRequestAlt' maxlength='180' autocomplete='off' placeholder='Opcional' value='"+escapeAttr(d.requestAlt||'')+"'/></div></div>"+
      "<div class='field'><label>Tipo da obra</label><input id='supportRequestType' type='hidden' value='"+escapeAttr(d.requestType||'')+"'/><div class='support-type-grid'>"+supportRequestTypeButtons(d.requestType||'')+"</div><div class='support-draft-note'>Toque em uma opção. Não precisa abrir lista nem digitar o tipo.</div></div>"+
      "<div class='field'><label>Link de referência</label><input id='supportRequestLink' maxlength='500' inputmode='url' autocomplete='off' placeholder='Opcional — link onde encontrou a obra' value='"+escapeAttr(d.requestLink||'')+"'/></div>"+
      "<div class='field'><label>Observações</label><textarea id='supportRequestNotes' maxlength='1500' placeholder='Conte por que gostaria dessa obra ou alguma informação útil.'>"+escapeHtml(d.requestNotes||'')+"</textarea></div>"+
      "<button type='button' class='support-request-submit' data-support-submit-request='true'>＋ Enviar pedido de obra</button><div id='supportRequestStatus' class='tiny'></div></div></div></section>"+
      "<section class='support-section'><div class='support-section-head'><div><h2>Meus pedidos</h2><p>Acompanhe o status das solicitações enviadas.</p></div></div><div id='supportMyRequests' class='support-request-list'><div class='support-empty'>Carregando...</div></div></section>";
      if(state.firebaseReady)try{state.supportUnsubs.push(onValue(pathRef('supportWorkRequests/'+state.user.uid),s=>renderSupportMyRequests(s.val()||{})));}catch(e){console.warn('support requests',e)}
    }
    function renderSupportMyRequests(v){const el=$('#supportMyRequests');if(!el)return;const list=objEntries(v||{}).map(([id,r])=>({id,...r})).sort((a,b)=>num(b.data)-num(a.data));el.innerHTML=list.length?list.map(r=>"<div class='support-request-item'><div class='row' style='justify-content:space-between'><h3>"+escapeHtml(r.nome||'Pedido')+"</h3><span class='support-ticket-status "+(r.status==='concluido'?'done':r.status==='recusado'?'rejected':'')+"'>"+escapeHtml(r.status==='concluido'?'Concluído':r.status==='recusado'?'Recusado':'Pendente')+"</span></div><p>"+escapeHtml(r.tipo||'Tipo não informado')+(r.observacoes?' • '+escapeHtml(r.observacoes):'')+"</p><small class='tiny'>Enviado em "+escapeHtml(fmtCommentDate(r.data))+"</small></div>").join(''):"<div class='support-empty'>Você ainda não enviou nenhum pedido de obra.</div>";}
    async function submitSupportRequest(){
      if(!requireMember())return;supportCaptureRequestDraft();
      const d=state.supportDraft||{},nome=String(d.requestName||'').trim(),alt=String(d.requestAlt||'').trim(),tipo=String(d.requestType||''),link=String(d.requestLink||'').trim(),observacoes=String(d.requestNotes||'').trim();
      if(nome.length<2){ui.toast('Informe o nome da obra.');document.getElementById('supportRequestName')?.focus();return;}
      const p=supportProfileData(),status=document.getElementById('supportRequestStatus'),btn=document.querySelector('[data-support-submit-request]'),old=btn?.textContent;
      if(btn){btn.disabled=true;btn.textContent='Enviando pedido…';}
      try{
        await dbPush('supportWorkRequests/'+p.uid,{uid:p.uid,nomeUsuario:p.nomeUsuario||'',nomeLeitor:p.nome,nome,alternativo:alt,tipo,link,observacoes,status:'pendente',data:now(),atualizadoEm:now()});
        Object.assign(state.supportDraft,{requestName:'',requestAlt:'',requestType:'',requestLink:'',requestNotes:''});
        ['supportRequestName','supportRequestAlt','supportRequestLink','supportRequestNotes'].forEach(id=>{const e=document.getElementById(id);if(e)e.value='';});
        const hidden=document.getElementById('supportRequestType');if(hidden)hidden.value='';document.querySelectorAll('[data-support-request-type]').forEach(b=>b.classList.toggle('active',b.dataset.supportRequestType===''));
        if(status)status.textContent='Pedido enviado com sucesso.';ui.toast('Pedido de obra enviado.');
      }catch(e){console.error(e);if(status)status.textContent='Não foi possível enviar. O que você escreveu continua salvo nesta tela.';ui.toast('Não foi possível enviar o pedido.');}
      finally{if(btn){btn.disabled=false;btn.textContent=old||'＋ Enviar pedido de obra';}}
    }
    async function renderSupportAdmin(root){
      state.supportView='admin';state.supportViewMounted='admin';root.dataset.supportView='admin';
      if(!state.firebaseReady){root.innerHTML=supportHeroHtml(supportAdminLabel(),'O painel de suporte precisa do Firebase para carregar as conversas.',false,true);return;}
      const online=await getSupportOnline();root.innerHTML="<div class='support-top'><a class='support-back' href='#/adm/visao-geral' data-route='/adm/visao-geral'>←</a><div style='min-width:0;flex:1'><div class='support-hero'><h1>ADM Suporte</h1><p>Converse com leitores, acompanhe pedidos de obra e veja quando o assistente automático foi usado.</p><div class='support-status-row'><div class='support-admin-online'>"+supportStatusHtml(online)+"<button type='button' class='support-online-toggle "+(online?'online':'')+"' data-support-admin-online='true'>"+(online?'Ficar offline':'Ficar online')+"</button></div></div></div></div></div><div class='support-admin-layout'><aside class='support-admin-sidebar'><div class='support-admin-tabs'><button type='button' class='support-admin-tab active' data-support-admin-tab='chats'>Conversas</button><button type='button' class='support-admin-tab' data-support-admin-tab='requests'>Pedidos</button><button type='button' class='support-admin-tab' data-support-admin-tab='bot'>Assistente</button></div><div id='supportAdminList' class='support-admin-list'><div class='support-empty'>Carregando...</div></div></aside><section id='supportAdminMain' class='support-chat-card'><div class='support-empty'>Selecione uma conversa ou item da fila.</div></section></div>";
      state.supportAdminTab=state.supportAdminTab||'chats';
      try{state.supportUnsubs.push(onValue(pathRef('config/support'),s=>{const on=!!s.val()?.adminOnline;const holder=root.querySelector('.support-admin-online');if(holder)holder.innerHTML=supportStatusHtml(on)+"<button type='button' class='support-online-toggle "+(on?'online':'')+"' data-support-admin-online='true'>"+(on?'Ficar offline':'Ficar online')+"</button>";}));}catch(e){}
      try{state.supportUnsubs.push(onValue(pathRef('supportChats'),s=>{state.supportAdminChats=s.val()||{};renderSupportAdminList();if(state.supportAdminTab==='chats'&&state.supportSelectedUid){const selected=state.supportAdminChats?.[state.supportSelectedUid];if(selected)renderSupportAdminMessages(selected.mensagens||{});}}));}catch(e){console.error(e)}
      try{state.supportUnsubs.push(onValue(pathRef('supportWorkRequests'),s=>{state.supportAdminRequests=s.val()||{};renderSupportAdminList();}));}catch(e){console.error(e)}
      try{state.supportUnsubs.push(onValue(pathRef('supportBotSessions'),s=>{state.supportBotLogs=s.val()||{};renderSupportAdminList();}));}catch(e){console.error(e)}
      renderSupportAdminList();
    }
    function supportUnreadCount(chat){return supportMessagesArray(chat?.mensagens||{}).filter(m=>m.papel==='usuario'&&!m.lidoAdm).length;}
    function renderSupportAdminList(){const el=$('#supportAdminList');if(!el)return;$$('[data-support-admin-tab]').forEach(b=>b.classList.toggle('active',b.dataset.supportAdminTab===state.supportAdminTab));
      if(state.supportAdminTab==='chats'){const list=objEntries(state.supportAdminChats||{}).map(([uid,c])=>({uid,...c,meta:c?.meta||{}})).sort((a,b)=>num(b.meta.atualizadoEm)-num(a.meta.atualizadoEm));el.innerHTML=list.length?list.map(c=>{const unread=supportUnreadCount(c);return "<button type='button' class='support-thread-item "+(state.supportSelectedUid===c.uid?'active':'')+"' data-support-admin-chat='"+escapeAttr(c.uid)+"'><div class='support-thread-top'><strong>"+escapeHtml(c.meta.nome||c.meta.nomeUsuario||'Leitor')+"</strong>"+(unread?"<span class='support-unread'>"+unread+"</span>":'')+"</div><small>"+escapeHtml(supportCategoryLabel(c.meta.categoria||'geral'))+" • "+escapeHtml(c.meta.ultimaMensagem||'Sem mensagem')+"</small></button>";}).join(''):"<div class='support-empty'>Nenhuma conversa de suporte ainda.</div>";return;}
      if(state.supportAdminTab==='requests'){const list=[];for(const [uid,group] of objEntries(state.supportAdminRequests||{}))for(const [id,r] of objEntries(group||{}))list.push({uid,id,...r});list.sort((a,b)=>num(b.data)-num(a.data));el.innerHTML=list.length?list.map(r=>"<button type='button' class='support-thread-item' data-support-admin-request='"+escapeAttr(r.uid)+"|"+escapeAttr(r.id)+"'><div class='support-thread-top'><strong>"+escapeHtml(r.nome||'Pedido')+"</strong><span class='support-ticket-status "+(r.status==='concluido'?'done':r.status==='recusado'?'rejected':'')+"'>"+escapeHtml(r.status||'pendente')+"</span></div><small>"+escapeHtml(r.nomeLeitor||r.nomeUsuario||r.uid)+" • "+escapeHtml(r.tipo||'Tipo não informado')+"</small></button>").join(''):"<div class='support-empty'>Nenhum pedido de obra.</div>";return;}
      const logs=[];for(const [uid,group] of objEntries(state.supportBotLogs||{}))for(const [id,r] of objEntries(group||{}))logs.push({uid,id,...r});logs.sort((a,b)=>num(b.data)-num(a.data));el.innerHTML=logs.length?logs.slice(0,100).map(r=>"<button type='button' class='support-thread-item' data-support-admin-bot='"+escapeAttr(r.uid)+"|"+escapeAttr(r.id)+"'><strong>"+escapeHtml(r.nome||r.nomeUsuario||'Leitor')+"</strong><small>"+escapeHtml(r.problema||'Usou o assistente')+"</small></button>").join(''):"<div class='support-empty'>Ninguém usou o assistente ainda.</div>";
    }
    function renderSupportAdminSelectedChat(){const main=$('#supportAdminMain'),uid=state.supportSelectedUid,chat=state.supportAdminChats?.[uid];if(!main||!chat)return;const meta=chat.meta||{},msgs=chat.mensagens||{},draft=String(state.supportAdminDrafts?.[uid]||'');main.dataset.supportChatUid=uid;main.innerHTML="<div class='support-chat-head'><div class='support-chat-person'><div class='support-chat-avatar'>"+(meta.foto?"<img src='"+escapeAttr(meta.foto)+"' alt=''/>":'👤')+"</div><div><strong>"+escapeHtml(meta.nome||'Leitor')+"</strong><small>"+escapeHtml((meta.nomeUsuario?'@'+meta.nomeUsuario+' • ':'')+supportCategoryLabel(meta.categoria||'geral'))+"</small></div></div><span class='support-ticket-status'>"+escapeHtml(meta.status||'open')+"</span></div><div class='support-messages' id='supportAdminMessages'></div><div class='support-chat-compose'><textarea id='supportAdminChatInput' maxlength='3000' autocomplete='off' placeholder='Responder como ADM...'>"+escapeHtml(draft)+"</textarea><button type='button' class='support-send' data-support-send-admin='true'>Enviar</button></div><div class='support-admin-draft-status' id='supportAdminDraftStatus'>"+(draft?'Rascunho preservado nesta conversa.':'Sua resposta não será perdida enquanto você digita.')+"</div>";renderSupportAdminMessages(msgs);markSupportRead(uid,'adm',msgs).catch(()=>{});}
    function renderSupportAdminMessages(v){const el=$('#supportAdminMessages');if(!el)return;const list=supportMessagesArray(v);el.innerHTML=list.length?list.map(m=>{const mine=m.papel==='adm',read=mine?!!m.lidoUsuario:!!m.lidoAdm;return "<div class='support-message "+(mine?'mine':'')+"'><div class='support-message-name'>"+(mine?'✦ ADM':'Leitor')+"</div><div class='support-message-text'>"+escapeHtml(m.texto||'')+"</div><div class='support-message-meta'><span>"+escapeHtml(fmtCommentDate(m.data))+"</span>"+(mine?"<span class='support-read "+(read?'read':'')+"'>"+(read?'✓ Lido':'— Não lido')+"</span>":'')+"</div></div>";}).join(''):"<div class='support-empty'>Sem mensagens.</div>";el.scrollTop=el.scrollHeight;}
    async function sendSupportAdminMessage(){if(!isAdmin()||!state.supportSelectedUid)return;const uid=state.supportSelectedUid,input=$('#supportAdminChatInput'),raw=String(input?.value??state.supportAdminDrafts?.[uid]??''),text=raw.trim();if(!text)return;state.supportAdminDrafts=state.supportAdminDrafts||{};state.supportAdminDrafts[uid]=raw;const btn=$('[data-support-send-admin]'),status=$('#supportAdminDraftStatus'),base='supportChats/'+uid,p=supportProfileData();if(btn){btn.disabled=true;btn.textContent='Enviando…';}if(status){status.textContent='Enviando sua resposta sem recarregar a conversa…';status.classList.add('saving');}try{const old=await dbGet(base+'/meta')||{};await dbSet(base+'/meta',{...old,uid,nome:old.nome||'Leitor',nomeUsuario:old.nomeUsuario||'',foto:old.foto||'',categoria:old.categoria||'geral',status:'open',criadoEm:old.criadoEm||now(),atualizadoEm:now(),ultimaMensagem:text.slice(0,180),ultimoAutor:'adm'});await dbPush(base+'/mensagens',{senderUid:p.uid,papel:'adm',texto:text,data:now(),lidoUsuario:false,lidoAdm:true});await dbPush('notificacoes/'+uid,{tipo:'support',titulo:'Resposta do Suporte',texto:text.slice(0,140),link:'/suporte',data:now(),lida:false,fromUid:p.uid}).catch(()=>{});state.supportAdminDrafts[uid]='';if(state.supportSelectedUid===uid){const current=$('#supportAdminChatInput');if(current)current.value='';const st=$('#supportAdminDraftStatus');if(st){st.textContent='Resposta enviada. Você pode continuar escrevendo aqui.';st.classList.remove('saving');}}ui.toast('Resposta enviada ao leitor.');}catch(e){console.error(e);const current=$('#supportAdminChatInput');if(current&&state.supportSelectedUid===uid&&!current.value)current.value=raw;const st=$('#supportAdminDraftStatus');if(st){st.textContent='Não foi possível enviar agora. Seu texto continua salvo nesta conversa.';st.classList.remove('saving');}ui.toast('Não foi possível responder. Seu texto foi preservado.');}finally{if(btn){btn.disabled=false;btn.textContent='Enviar';}}}
    async function toggleSupportAdminOnline(){if(!isAdmin())return;const current=await getSupportOnline();try{await dbUpdate('config/support',{adminOnline:!current,atualizadoEm:now(),atualizadoPor:state.user?.uid||''});ui.toast(!current?'Suporte marcado como online.':'Suporte marcado como offline.');}catch(e){ui.toast('Não foi possível alterar o status.');}}
    function renderSupportAdminRequest(uid,id){const main=$('#supportAdminMain'),r=state.supportAdminRequests?.[uid]?.[id];if(!main||!r)return;main.innerHTML="<div class='support-chat-head'><div><strong>Pedido de obra</strong><small class='tiny'>"+escapeHtml(r.nomeLeitor||r.nomeUsuario||uid)+"</small></div><span class='support-ticket-status'>"+escapeHtml(r.status||'pendente')+"</span></div><div style='padding:17px'><h2 style='margin-top:0'>"+escapeHtml(r.nome||'Sem nome')+"</h2><p class='muted'>"+escapeHtml(r.alternativo||'Sem nome alternativo')+"</p><div class='support-request-item'><p><strong>Tipo:</strong> "+escapeHtml(r.tipo||'Não informado')+"</p><p><strong>Link:</strong> "+escapeHtml(r.link||'Não informado')+"</p><p><strong>Observações:</strong> "+escapeHtml(r.observacoes||'Nenhuma')+"</p></div><div class='support-mini-actions'><button type='button' class='ok' data-support-request-status='"+escapeAttr(uid)+'|'+escapeAttr(id)+"|concluido'>✓ Marcar concluído</button><button type='button' data-support-request-status='"+escapeAttr(uid)+'|'+escapeAttr(id)+"|pendente'>Deixar pendente</button><button type='button' class='danger' data-support-request-status='"+escapeAttr(uid)+'|'+escapeAttr(id)+"|recusado'>Recusar</button></div></div>";}
    function renderSupportAdminBot(uid,id){const main=$('#supportAdminMain'),r=state.supportBotLogs?.[uid]?.[id];if(!main||!r)return;main.innerHTML="<div class='support-chat-head'><div><strong>Uso do Assistente MP SCAN</strong><small class='tiny'>"+escapeHtml(r.nome||r.nomeUsuario||uid)+" • "+escapeHtml(fmtCommentDate(r.data))+"</small></div></div><div style='padding:17px'><div class='support-request-item'><h3>Problema informado</h3><p>"+escapeHtml(r.problema||'')+"</p></div><div class='support-request-item' style='margin-top:10px'><h3>Resposta automática</h3><p>"+escapeHtml(r.resposta||'')+"</p></div><div class='support-mini-actions'><button type='button' data-support-admin-chat='"+escapeAttr(uid)+"'>Abrir conversa desse leitor</button></div></div>";}
    async function setSupportRequestStatus(raw){const [uid,id,status]=String(raw||'').split('|');if(!uid||!id||!status||!isAdmin())return;try{await dbUpdate('supportWorkRequests/'+uid+'/'+id,{status,atualizadoEm:now(),respondidoPor:state.user?.uid||''});ui.toast('Status do pedido atualizado.');renderSupportAdminRequest(uid,id);}catch(e){ui.toast('Não foi possível atualizar o pedido.');}}
    function supportOpenBot(topic='geral'){supportCaptureRequestDraft();state.supportEditing=false;state.supportTopic=topic||'geral';state.supportView='bot';state.supportBotMessages=[];state.supportBotContext={workId:'',workName:'',chapterNumber:'',issue:'',topic:state.supportTopic,lastIntent:'',attempts:0,lastText:'',lastBotQuestion:'',turns:[],previousWorkId:''};state.supportBotSessionId='';renderSupport(true);}
    function supportOpenChat(topic='geral',prefill=''){supportCaptureRequestDraft();state.supportEditing=false;state.supportTopic=topic||'geral';state.supportView='chat';if(prefill)state.supportDraft.chat=prefill;renderSupport(true);}
    function supportOpenRequest(){state.supportEditing=false;state.supportView='request';renderSupport(true);}
    function supportGoHome(){supportCaptureRequestDraft();state.supportEditing=false;state.supportView='home';renderSupport(true);}
    let supportDelegatesWired=false;
    function wireSupportDelegates(){
      if(supportDelegatesWired)return;const root=document.getElementById('supportContent');if(!root)return;supportDelegatesWired=true;
      root.addEventListener('click',function(e){const g=s=>e.target.closest?.(s);let el;
        if(el=g('[data-support-home]')){e.preventDefault();e.stopPropagation();supportGoHome();return;}
        if(el=g('[data-support-bot-topic]')){e.preventDefault();e.stopPropagation();supportOpenBot(el.dataset.supportBotTopic);return;}
        if(el=g('[data-support-open-bot]')){e.preventDefault();e.stopPropagation();supportOpenBot(el.dataset.supportOpenBot||'geral');return;}
        if(el=g('[data-support-open-chat]')){e.preventDefault();e.stopPropagation();supportOpenChat(el.dataset.supportOpenChat||'geral');return;}
        if(el=g('[data-support-open-request]')){e.preventDefault();e.stopPropagation();supportOpenRequest();return;}
        if(el=g('[data-support-request-type]')){e.preventDefault();e.stopPropagation();const value=el.dataset.supportRequestType||'',hidden=document.getElementById('supportRequestType');if(hidden)hidden.value=value;state.supportDraft.requestType=value;root.querySelectorAll('[data-support-request-type]').forEach(b=>b.classList.toggle('active',b===el));return;}
        if(el=g('[data-support-bot-quick]')){e.preventDefault();e.stopPropagation();const input=document.getElementById('supportBotInput');if(input){input.value=el.dataset.supportBotQuick||'';state.supportDraft.bot=input.value;}supportBotSend();return;}
        if(el=g('[data-support-bot-history]')){e.preventDefault();e.stopPropagation();supportOpenBotHistory(el.dataset.supportBotHistory);return;}
        if(el=g('[data-support-bot-send]')){e.preventDefault();e.stopPropagation();supportBotSend();return;}
        if(el=g('[data-support-escalate]')){e.preventDefault();e.stopPropagation();if(state.supportBotSessionId&&state.firebaseReady&&isMember())dbUpdate('supportBotSessions/'+state.user.uid+'/'+state.supportBotSessionId,{escalado:true}).catch(()=>{});supportOpenChat(state.supportTopic||'geral',supportBotEscalationSummary());return;}
        if(el=g('[data-support-send-user]')){e.preventDefault();e.stopPropagation();sendSupportUserMessage();return;}
        if(el=g('[data-support-submit-request]')){e.preventDefault();e.stopPropagation();submitSupportRequest();return;}
        if(el=g('[data-support-login]')){e.preventDefault();e.stopPropagation();ui.openAuth?.('login');return;}
        if(el=g('[data-support-admin-online]')){e.preventDefault();e.stopPropagation();toggleSupportAdminOnline();return;}
        if(el=g('[data-support-admin-tab]')){e.preventDefault();e.stopPropagation();state.supportAdminTab=el.dataset.supportAdminTab;state.supportSelectedUid='';const main=document.getElementById('supportAdminMain');if(main)main.innerHTML="<div class='support-empty'>Selecione um item da fila.</div>";renderSupportAdminList();return;}
        if(el=g('[data-support-admin-chat]')){e.preventDefault();e.stopPropagation();supportCaptureRequestDraft();state.supportAdminTab='chats';state.supportSelectedUid=el.dataset.supportAdminChat;renderSupportAdminList();renderSupportAdminSelectedChat();return;}
        if(el=g('[data-support-send-admin]')){e.preventDefault();e.stopPropagation();sendSupportAdminMessage();return;}
        if(el=g('[data-support-admin-request]')){e.preventDefault();e.stopPropagation();const [uid,id]=el.dataset.supportAdminRequest.split('|');renderSupportAdminRequest(uid,id);return;}
        if(el=g('[data-support-request-status]')){e.preventDefault();e.stopPropagation();setSupportRequestStatus(el.dataset.supportRequestStatus);return;}
        if(el=g('[data-support-admin-bot]')){e.preventDefault();e.stopPropagation();const [uid,id]=el.dataset.supportAdminBot.split('|');renderSupportAdminBot(uid,id);return;}
      });
      root.addEventListener('input',e=>{const id=e.target?.id;if(!id)return;state.supportEditing=true;if(id==='supportRequestName')state.supportDraft.requestName=e.target.value;else if(id==='supportRequestAlt')state.supportDraft.requestAlt=e.target.value;else if(id==='supportRequestLink')state.supportDraft.requestLink=e.target.value;else if(id==='supportRequestNotes')state.supportDraft.requestNotes=e.target.value;else if(id==='supportChatInput')state.supportDraft.chat=e.target.value;else if(id==='supportBotInput')state.supportDraft.bot=e.target.value;else if(id==='supportAdminChatInput'&&state.supportSelectedUid){state.supportAdminDrafts=state.supportAdminDrafts||{};state.supportAdminDrafts[state.supportSelectedUid]=e.target.value;const st=$('#supportAdminDraftStatus');if(st){st.textContent='Rascunho preservado enquanto você digita.';st.classList.remove('saving');}}});
      root.addEventListener('pointerdown',e=>{if(e.target?.id==='supportAdminChatInput'||e.target?.id==='supportChatInput'||e.target?.id==='supportBotInput')state.supportEditing=true;},true);
      root.addEventListener('focusin',()=>{state.supportEditing=true;});
      root.addEventListener('focusout',()=>setTimeout(()=>{if(!root.contains(document.activeElement))state.supportEditing=false;},500));
      root.addEventListener('keydown',e=>{if(e.key!=='Enter'||e.shiftKey)return;if(e.target?.id==='supportChatInput'){e.preventDefault();sendSupportUserMessage();}else if(e.target?.id==='supportAdminChatInput'){e.preventDefault();sendSupportAdminMessage();}});
    }
    wireSupportDelegates();

    // Mantém a sessão do editor intacta enquanto o Firebase/autenticação atualiza a tela.
    // Também registra toda alteração visual como pendente, inclusive arquivos, cor e privacidade.
    document.addEventListener('change',e=>{
      const id=e.target?.id;
      if(id==='editProfilePrivate'){markProfileEditDirty();updateProfilePrivacyUI();}
      if((id==='editProfilePhoto'||id==='editProfileCover')&&e.target.files?.[0])markProfileEditDirty();
    });
    document.addEventListener('click',e=>{
      const privacyButton=e.target.closest?.('#profilePrivacyCard');
      if(privacyButton){e.preventDefault();const input=$('#editProfilePrivate');if(input){input.checked=!input.checked;markProfileEditDirty();updateProfilePrivacyUI();}return;}
      if(e.target.closest?.('[data-remove-profile-photo],[data-remove-profile-cover],[data-profile-accent]'))markProfileEditDirty();
    });
    document.addEventListener('mp:route',e=>{if(e.detail?.page!=='profile-edit')resetProfileEditSession();});

    function clearStuckVisualOverlays(){
      // Só remove a animação decorativa do ranking. Modais reais continuam sob controle normal.
      document.querySelectorAll('.profile-rank-intro').forEach(x=>x.remove());
    }
    // Se o usuário tocar durante a animação, ela sai imediatamente e o toque continua livre.
    document.addEventListener('pointerdown',()=>{if(document.querySelector('.profile-rank-intro'))clearStuckVisualOverlays();},{passive:true,capture:true});
    document.addEventListener('touchstart',()=>{if(document.querySelector('.profile-rank-intro'))clearStuckVisualOverlays();},{passive:true,capture:true});
    window.addEventListener('blur',clearStuckVisualOverlays,{passive:true});

    async function handleRoute(info){if(!info)return;
      const settingsPage=['settings','settings-detail','age-settings','sensitive-settings'].includes(info.page);
      if(settingsPage){prepareSettingsInteractionSurface();await refreshSettingsProfileSnapshot();updateSettingsHome();}
      const profileRouteKey=info.page==='profile'?'self':(info.page==='public-profile'?'public:'+String(info.id||''):'');
      if(profileRouteKey){
        if(window.__mpProfileRouteKey!==profileRouteKey){window.__mpProfileRouteKey=profileRouteKey;window.__mpProfileRouteVisitId=profileRouteKey+':'+now()+':'+Math.random().toString(36).slice(2,7);window.__mpProfileRankIntroShownVisit='';clearStuckVisualOverlays();}
      }else if(window.__mpProfileRouteKey){window.__mpProfileRouteKey='';window.__mpProfileRouteVisitId='';window.__mpProfileRankIntroShownVisit='';clearStuckVisualOverlays();}
      if(info.page!=='support')clearSupportListeners();if(info.page!=='chapter'){stopReaderTracking();$('#readerSheetBackdrop')?.classList.remove('open');$('#readerChapterPanel')?.classList.remove('open');$('#readerCommentsPanel')?.classList.remove('open');}if(info.page==='home'){renderHome();document.title='MP SCAN';return;}if(info.page==='calendar'){renderCalendar();return;}if(info.page==='settings'){updateSettingsHome();filterSettingsHome();document.title='Configurações — MP SCAN';return;}if(info.page==='profile'){await renderMyProfile();return;}if(info.page==='age-settings'){updateAgeSettingsUI();document.title='Verificação etária — MP SCAN';return;}if(info.page==='sensitive-settings'){setSensitiveStatus('');updateSensitiveSettingsUI();document.title='Conteúdo sensível — MP SCAN';return;}if(info.page==='settings-detail'){await renderSettingsDetail(info.sub);return;}if(info.page==='support'){await renderSupport();return;}if(info.page==='referral'){await renderReferralEvent();return;}if(info.page==='notifications'){renderNotifications();if(isMember()&&getAppSettings().autoMarkNotifications!==false)setTimeout(()=>markAllNotifications().catch(()=>{}),500);return;}if(info.page==='library'){await renderLibrary();return;}if(!state.firebaseReady){if(info.page==='chapter'){await renderOfflineChapter(info.workId,info.id);return;}const targets={work:'#workDetailContent','public-profile':'#publicProfileContent',collection:'#collectionDetailContent'},selector=targets[info.page];if(selector){const target=$(selector);if(target)target.innerHTML="<div class='empty'>Esta tela precisa de conexão com o Firebase para carregar os dados. A navegação continua funcionando.</div>";}return;}if(info.page==='work')await renderWorkPage(info.id);else if(info.page==='chapter')await renderChapterPage(info.workId,info.id);else if(info.page==='public-profile')await renderPublicProfile(info.id);else if(info.page==='profile-edit')await renderProfileEdit();else if(info.page==='collection')await renderCollection(info.parts[1],info.parts[2]||info.id);else if(info.page==='admin'&&isAdmin())await renderAdmin(info.sub||'visao-geral');}
    setInterval(()=>{if(!state.firebaseReady||!isMember()||document.visibilityState!=='visible'||router.current()?.page!=='chapter')return;const uid=state.user.uid;tx('usuarios/'+uid+'/tempoLeituraSegundos',v=>num(v)+60).then(()=>{state.profile={...(state.profile||{}),tempoLeituraSegundos:num(state.profile?.tempoLeituraSegundos)+60};}).catch(()=>{});},60000);
    document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible'&&router.current()?.page==='chapter' &&window.__readerPages?.s?.keepAwake)requestReaderWakeLock(false).catch(()=>{});});
    document.addEventListener('keydown',e=>{const d=window.__readerPages;if(!d||router.current()?.page!=='chapter'||d.s.keyboard==='off')return;if(d.s.mode==='one'&&(e.key==='ArrowLeft'||e.key==='ArrowRight'||e.key==='PageUp'||e.key==='PageDown')){e.preventDefault();let goNext;if(e.key==='PageDown')goNext=true;else if(e.key==='PageUp')goNext=false;else goNext=d.s.direction==='rtl'?e.key==='ArrowLeft':e.key==='ArrowRight';readerGoPage(goNext?1:-1);}});
    window.addEventListener('wheel',()=>{if(window.__readerAutoScrollActive)stopReaderAutoScroll();},{passive:true});window.addEventListener('touchstart',()=>{if(window.__readerAutoScrollActive)stopReaderAutoScroll();},{passive:true});
    document.addEventListener('input',e=>{const input=e.target.closest?.('[data-reader-chapter-search]');if(!input)return;const q=String(input.value||'').trim().toLowerCase();let visible=0;$$('[data-reader-chapter-item]',input.closest('.reader-side-panel')).forEach(item=>{const ok=!q||String(item.dataset.readerChapterSearchText||'').includes(q);item.classList.toggle('hidden',!ok);if(ok)visible++;});const empty=input.closest('.reader-side-panel')?.querySelector('[data-reader-chapter-no-results]');if(empty)empty.classList.toggle('hidden',visible>0);});
    window.addEventListener('beforeunload',()=>{if(document.getElementById('adminDocumentsEditor')&&state.adminDocDirty)captureAdminDocumentDrafts();});
    document.addEventListener('mp:route',e=>{handleRoute(e.detail).then(()=>splashScreen.hide()).catch(err=>{console.error(err);splashScreen.hide(true);ui.toast('Esta tela encontrou um erro, mas o restante do site continua funcionando.');});});


    const splashScreen={
      el:null,
      start:Date.now(),
      hidden:false,
      init(){this.el=document.getElementById('appSplash');this.start=Date.now();document.body.classList.add('splash-on');},
      hide(force=false){
        if(this.hidden)return;
        const wait=force?0:Math.max(0,380-(Date.now()-this.start));
        setTimeout(()=>{
          if(this.hidden)return;
          this.hidden=true;
          this.el?.classList.add('hide');
          document.body.classList.remove('splash-on');
          setTimeout(()=>this.el?.remove(),380);
        },wait);
      }
    };
    splashScreen.init();
    window.__hideSplash=()=>splashScreen.hide();

    const firstAccessGuide={
      key:'mp_first_access_guide_v1',
      el:document.getElementById('firstAccessGuide'),
      completed(){try{return localStorage.getItem(this.key)==='done';}catch(e){return false;}},
      finish(){try{localStorage.setItem(this.key,'done');}catch(e){}this.el?.classList.remove('open');},
      show(){if(!this.completed())this.el?.classList.add('open');}
    };
    document.getElementById('finishFirstAccessGuide')?.addEventListener('click',()=>firstAccessGuide.finish());
    document.querySelectorAll('[data-first-guide-route]').forEach(link=>link.addEventListener('click',event=>{event.preventDefault();const route=link.dataset.firstGuideRoute;firstAccessGuide.finish();if(route)router.navigate(route);}));

    const androidAppPromotion={
      key:'mp_android_app_promo_dismissed_v1',
      card:document.getElementById('downloadAndroidAppCard'),
      dismissed(){try{return localStorage.getItem(this.key)==='1';}catch(e){return false;}},
      apply(){this.card?.classList.toggle('hidden',this.dismissed());},
      dismiss(){try{localStorage.setItem(this.key,'1');}catch(e){}this.apply();ui.toast('O aviso foi ocultado. O aplicativo continua disponível em Configurações.');}
    };
    document.getElementById('dismissAndroidAppCard')?.addEventListener('click',()=>androidAppPromotion.dismiss());
    androidAppPromotion.apply();

    wireGlobalButtons();
    bootFirebase();
    setTimeout(()=>splashScreen.hide(),1800);
    setTimeout(()=>firstAccessGuide.show(),2050);


//]]>
</script>

</body>
</html>